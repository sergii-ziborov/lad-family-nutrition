{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lad private family profile (schema only; no personal data)",
  "type": "object",
  "required": ["members"],
  "additionalProperties": false,
  "properties": {
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "name", "ageYears", "goal", "portion", "allergies"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "ageYears": {"type": "integer", "minimum": 0, "maximum": 120},
          "goal": {"type": "string"},
          "portion": {"type": "number", "minimum": 0.5, "maximum": 1.6},
          "allergies": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
