{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lad private recipe catalog",
  "type": "object",
  "required": ["recipes"],
  "additionalProperties": false,
  "properties": {
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "caption", "cuisine", "minutes", "allergens", "allergensVerified", "ingredients", "steps"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
          "title": {"type": "string", "minLength": 1},
          "caption": {"type": "string"},
          "cuisine": {"type": "string"},
          "minutes": {"type": "integer", "minimum": 1},
          "kcal": {"type": "integer", "minimum": 0},
          "protein": {"type": "integer", "minimum": 0},
          "imageId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
          "allergens": {"type": "array", "items": {"type": "string"}},
          "allergensVerified": {"type": "boolean"},
          "mealKinds": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 2}},
          "nutrients": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["amount", "unit", "source", "coverage"],
              "additionalProperties": false,
              "properties": {
                "amount": {"type": "number", "minimum": 0},
                "unit": {"type": "string", "minLength": 1},
                "source": {"type": "string", "minLength": 1},
                "coverage": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "amount", "unit", "category"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string"},
                "amount": {"type": "number", "minimum": 0},
                "unit": {"type": "string"},
                "category": {"type": "string"}
              }
            }
          },
          "unquantifiedIngredients": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "unit", "category"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "unit": {"type": "string", "minLength": 1},
                "category": {"type": "string"}
              }
            }
          },
          "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
