"Чечевичные блинчики с йогуртом и огурцом" = "Сочевичні млинці з йогуртом та огірком";
"Горячие тосты с яйцом и моцареллой" = "Гарячі тости з яйцем і моцарелою";
"Пшённая каша с тыквой и йогуртом" = "Пшоняна каша з гарбузом та йогуртом";
"Тосты с запечённым лососем и авокадо" = "Тости із запеченим лососем та авокадо";

/* Expanded breakfast recipe instructions */
"Если включён перекус, его ориентир — за час до указанного времени обеда." = "Якщо перекус увімкнено, його орієнтир — за годину до вказаного часу обіду.";
"Измельчите хлопья, смешайте с яйцом и водой. Оставьте на 5 минут." = "Подрібніть пластівці, змішайте з яйцем і водою. Залиште на 5 хвилин.";
"Смажьте сковороду отмеренным маслом. Испеките блин на среднем огне с двух сторон до полной готовности яйца." = "Змастіть сковороду відміряною олією. Спечіть млинець з обох боків на середньому вогні до повної готовності яйця.";
"Наполните творогом и нарезанными томатами, сложите пополам." = "Наповніть кисломолочним сиром і нарізаними томатами, складіть навпіл.";
"Промойте гречку и сварите в воде по инструкции упаковки. Масса крупы указана в сухом виде." = "Промийте гречку й зваріть у воді за інструкцією на упаковці. Масу крупи вказано сухою.";
"Грибы нарежьте, приготовьте с отмеренным маслом. Добавьте шпинат и прогрейте до мягкости." = "Наріжте гриби, приготуйте з відміряною олією. Додайте шпинат і прогрійте до м’якості.";
"Яйцо отварите до полной готовности. Соберите гречку, овощи и яйцо в миске, подайте с йогуртом." = "Яйце відваріть до повної готовності. Зберіть гречку, овочі та яйце в мисці, подайте з йогуртом.";
"Смешайте хлопья, йогурт, молоко и корицу в закрывающемся контейнере." = "Змішайте пластівці, йогурт, молоко й корицю в контейнері з кришкою.";
"Уберите в холодильник минимум на 6 часов. Время в карточке — только активная подготовка." = "Поставте в холодильник щонайменше на 6 годин. Час у картці — лише активна підготовка.";
"Утром добавьте вымытое нарезанное яблоко и отмеренные орехи." = "Вранці додайте вимите нарізане яблуко й відміряні горіхи.";
"Смешайте хлопья, творог, яйцо, молоко и корицу. Яблоко вымойте и нарежьте кубиками." = "Змішайте пластівці, кисломолочний сир, яйце, молоко й корицю. Яблуко вимийте та наріжте кубиками.";
"Переложите смесь с яблоком в небольшую форму на пергамент." = "Перекладіть суміш із яблуком у невелику форму на пергамент.";
"Запекайте при 180 °C около 25–30 минут, пока середина полностью не схватится. Дайте немного остыть." = "Запікайте за 180 °C приблизно 25–30 хвилин, доки середина повністю не схопиться. Дайте трохи охолонути.";
"Подсушите хлеб; по возможности выберите цельнозерновой. Огурец и зелень вымойте." = "Підсушіть хліб; за можливості оберіть цільнозерновий. Огірок і зелень вимийте.";
"Разомните творог с отмеренным оливковым маслом и рубленым укропом." = "Розімніть кисломолочний сир із відміряною оливковою олією та подрібненим кропом.";
"Распределите творог по тостам, добавьте нарезанный огурец." = "Розподіліть сир по тостах, додайте нарізаний огірок.";
"Нут замочите заранее в холодильнике, промойте и сварите в воде до мягкости по упаковке. Масса нута указана сухая." = "Нут заздалегідь замочіть у холодильнику, промийте й зваріть у воді до м’якості за упаковкою. Масу нуту вказано сухою.";
"Прогрейте томаты с отмеренным маслом, добавьте готовый нут и шпинат." = "Прогрійте томати з відміряною олією, додайте готовий нут і шпинат.";
"Сделайте углубление, добавьте яйцо и готовьте под крышкой до полностью схватившихся белка и желтка. Подайте с подсушенным хлебом." = "Зробіть заглиблення, додайте яйце й готуйте під кришкою до повної готовності білка та жовтка. Подайте з підсушеним хлібом.";
"Красную чечевицу промойте, залейте водой и оставьте на 2 часа в холодильнике. Слейте воду; время замачивания не входит в активное время." = "Червону сочевицю промийте, залийте водою й залиште на 2 години в холодильнику. Злийте воду; замочування не входить в активний час.";
"Измельчите чечевицу с 90 мл свежей воды и чесноком. Испеките тонкие блинчики на отмеренном масле с двух сторон, чтобы внутри не осталось сырой массы." = "Подрібніть сочевицю з 90 мл свіжої води й часником. Спечіть тонкі млинці на відміряній олії з обох боків без сирої маси всередині.";
"Смешайте йогурт с рубленой петрушкой, подайте с блинчиками и вымытым нарезанным огурцом." = "Змішайте йогурт із подрібненою петрушкою, подайте з млинцями та вимитим нарізаним огірком.";
"Разогрейте духовку до 180 °C. Хлеб слегка смажьте отмеренным маслом; предпочтителен цельнозерновой." = "Розігрійте духовку до 180 °C. Хліб злегка змастіть відміряною олією; бажано взяти цільнозерновий.";
"Яйцо взбейте. Распределите по хлебу вместе с нарезанными томатами и моцареллой на противне с пергаментом." = "Яйце збийте. Розподіліть по хлібу разом із нарізаними томатами й моцарелою на деку з пергаментом.";
"Запекайте около 12–15 минут до полной готовности яйца и расплавления сыра." = "Запікайте приблизно 12–15 хвилин до повної готовності яйця й розплавлення сиру.";
"Пшено тщательно промойте. Тыкву очистите и нарежьте маленькими кубиками; крупа указана сухая, тыква — очищенная." = "Пшоно ретельно промийте. Гарбуз очистіть і наріжте дрібними кубиками; крупу вказано сухою, гарбуз — очищеним.";
"Сварите пшено с тыквой в воде и молоке на слабом огне до мягкости, около 20–25 минут. При необходимости долейте воду." = "Зваріть пшоно з гарбузом у воді й молоці на слабкому вогні до м’якості, приблизно 20–25 хвилин. За потреби долийте води.";
"Дайте каше немного остыть, добавьте йогурт и отмеренные орехи." = "Дайте каші трохи охолонути, додайте йогурт і відміряні горіхи.";
"Лосось запеките при 180 °C до полной готовности: мякоть должна легко разделяться на волокна. Удалите кости." = "Лосось запечіть за 180 °C до повної готовності: м’якоть має легко розділятися на волокна. Видаліть кістки.";
"Подсушите хлеб; предпочтителен цельнозерновой. Авокадо разомните с лимонным соком." = "Підсушіть хліб; бажано взяти цільнозерновий. Авокадо розімніть із лимонним соком.";
"Распределите авокадо и приготовленную рыбу по тостам, подайте с вымытым нарезанным огурцом." = "Розподіліть авокадо й готову рибу по тостах, подайте з вимитим нарізаним огірком.";

"Порции основных блюд учитывают включённый перекус. Размер перекуса и напитков не увеличивается автоматически. Покупки и готовка используют те же порции." = "Порції основних страв враховують увімкнений перекус. Розмір перекусу й напоїв автоматично не збільшується. Покупки та приготування використовують ті самі порції.";

"%@ · ориентир %@, за час до обеда" = "%@ · орієнтир %@, за годину до обіду";

/* EmLadno TestFlight branding */
"ЕМЛАДНО · ЕДИМ ВМЕСТЕ" = "ЕМЛАДНО · ЇМО РАЗОМ";
"Облако ЕмЛадно" = "Хмара ЕмЛадно";

// Original default-course variants, October 2026.
"Меню на каждый день" = "Меню на щодень";
"Измельчите хлопья и смешайте с яйцом и водой. Оставьте на 5 минут." = "Подрібніть пластівці та змішайте з яйцем і водою. Залиште на 5 хвилин.";
"Смажьте сковороду отмеренным маслом и испеките блин с двух сторон до готовности яйца." = "Змастіть сковороду відміряною олією та спечіть млинець з обох боків до готовності яйця.";
"Добавьте шпинат и моцареллу, сложите пополам и прогрейте под крышкой до расплавления сыра." = "Додайте шпинат і моцарелу, складіть навпіл та прогрійте під кришкою до розплавлення сиру.";
"Овсяноблин со шпинатом и моцареллой" = "Вівсяномлинець зі шпинатом і моцарелою";
"Измельчите хлопья, разомните банан и смешайте с яйцом и молоком." = "Подрібніть пластівці, розімніть банан і змішайте з яйцем та молоком.";
"Отмеренным маслом смажьте сковороду. Жарьте небольшие панкейки на умеренном огне с обеих сторон до готовности внутри." = "Змастіть сковороду відміряною олією. Смажте невеликі панкейки на помірному вогні з обох боків до готовності всередині.";
"Подайте с отмеренным йогуртом." = "Подайте з відміряним йогуртом.";
"Овсяные панкейки с бананом и йогуртом" = "Вівсяні панкейки з бананом і йогуртом";
"Промойте сухую гречку и сварите в отмеренной воде под крышкой до мягкости." = "Промийте суху гречку та зваріть у відміряній воді під кришкою до м’якості.";
"Дайте гречке немного остыть. Вымойте яблоко, удалите сердцевину и отмерьте мякоть." = "Дайте гречці трохи охолонути. Вимийте яблуко, видаліть серцевину та відміряйте м’якоть.";
"Соберите боул с йогуртом, яблоком, измельчёнными орехами и корицей." = "Зберіть боул з йогуртом, яблуком, подрібненими горіхами й корицею.";
"Гречневый боул с яблоком и йогуртом" = "Гречаний боул з яблуком і йогуртом";
"Промойте булгур и варите в отмеренной воде до мягкости." = "Промийте булгур та варіть у відміряній воді до м’якості.";
"Сварите яйцо до плотного белка и желтка. Нарежьте томаты, смешайте йогурт с укропом." = "Зваріть яйце до щільного білка й жовтка. Наріжте томати, змішайте йогурт з кропом.";
"Подайте булгур с яйцом, томатами, соусом и отмеренным маслом." = "Подайте булгур з яйцем, томатами, соусом і відміряною олією.";
"Булгур с яйцом и йогуртовым соусом" = "Булгур з яйцем та йогуртовим соусом";
"Промойте пшено и сварите в отмеренной воде до мягкости. Немного остудите." = "Промийте пшоно та зваріть у відміряній воді до м’якості. Трохи остудіть.";
"Смешайте пшено с творогом, яйцом и молоком. Переложите в форму, сверху разложите сливы без косточек." = "Змішайте пшоно із сиром, яйцем і молоком. Перекладіть у форму, зверху викладіть сливи без кісточок.";
"Запекайте при 180 °C около 25 минут, пока яичная смесь полностью не схватится." = "Запікайте за 180 °C близько 25 хвилин, доки яєчна суміш повністю не схопиться.";
"Пшённая запеканка с творогом и сливами" = "Пшоняна запіканка із сиром і сливами";
"Натрите цукини и слегка отожмите. Взбейте яйца с творогом, добавьте цукини и нарезанные томаты." = "Натріть цукіні й злегка відіжміть. Збийте яйця із сиром, додайте цукіні та нарізані томати.";
"Смажьте небольшую форму отмеренным маслом и запекайте смесь при 180 °C 20–25 минут до полной готовности яйца." = "Змастіть невелику форму відміряною олією та запікайте суміш за 180 °C 20–25 хвилин до готовності яйця.";
"Подайте с подсушенным хлебом." = "Подайте з підсушеним хлібом.";
"Фриттата с цукини и творогом" = "Фритата із цукіні та кисломолочним сиром";
"Смешайте муку, яйцо, воду и 70 г йогурта. Остальной йогурт оставьте для подачи." = "Змішайте борошно, яйце, воду та 70 г йогурту. Решту йогурту залиште для подавання.";
"Смажьте сковороду отмеренным маслом. Готовьте небольшие оладьи на умеренном огне с обеих сторон до готовности внутри." = "Змастіть сковороду відміряною олією. Готуйте невеликі оладки на помірному вогні з обох боків до готовності всередині.";
"Подайте с оставшимся йогуртом и вымытыми ягодами." = "Подайте з рештою йогурту та вимитими ягодами.";
"Ржаные оладьи с йогуртом и ягодами" = "Житні оладки з йогуртом і ягодами";
"Замочите сухой нут на 8–12 часов в холодильнике. Слейте воду, промойте и варите в свежей воде 60–90 минут до мягкости; замачивание не входит во время готовки." = "Замочіть сухий нут у холодильнику на 8–12 годин. Злийте воду, промийте й варіть у свіжій воді 60–90 хвилин до м’якості; замочування не входить у час готування.";
"Слейте отвар. Разомните нут с лимонным соком и отмеренным маслом, добавляя немного воды при необходимости." = "Злийте відвар. Розімніть нут з лимонним соком і відміряною олією, за потреби додайте трохи води.";
"Подсушите хлеб, распределите нутовую пасту, добавьте фету и нарезанный огурец." = "Підсушіть хліб, розподіліть нутову пасту, додайте фету та нарізаний огірок.";
"Тосты с нутом и фетой" = "Тости з нутом і фетою";
"Промойте чечевицу и разварите в отмеренной воде. Немного остудите, добавьте тёртую морковь и яйцо." = "Промийте сочевицю та розваріть у відміряній воді. Трохи остудіть, додайте терту моркву й яйце.";
"Сформируйте небольшие котлетки на пергаменте, смажьте отмеренным маслом и запекайте при 190 °C около 20 минут до готовности яйца." = "Сформуйте невеликі котлетки на пергаменті, змастіть відміряною олією та запікайте за 190 °C близько 20 хвилин до готовності яйця.";
"Подайте с йогуртом." = "Подайте з йогуртом.";
"Чечевичные котлетки с морковью и яйцом" = "Сочевичні котлетки з морквою та яйцем";
"Измельчите индейку, цветную капусту и лук. Смешайте с яйцом и сформируйте небольшие тефтели." = "Подрібніть індичку, цвітну капусту та цибулю. Змішайте з яйцем і сформуйте невеликі тефтелі.";
"Переложите в форму с нарезанными томатами и маслом. Запекайте под крышкой при 190 °C 25–30 минут; температура в центре индейки должна достичь 74 °C." = "Викладіть у форму з нарізаними томатами та олією. Запікайте під кришкою за 190 °C 25–30 хвилин; температура в центрі індички має досягти 74 °C.";
"Отдельно сварите гречку в отмеренной воде и подайте с тефтелями и соусом." = "Окремо зваріть гречку у відміряній воді та подайте з тефтелями й соусом.";
"Тефтели из индейки с цветной капустой" = "Тефтелі з індички та цвітної капусти";
"Промойте пшено. Нарежьте курицу и овощи небольшими кусочками." = "Промийте пшоно. Наріжте курку й овочі невеликими шматочками.";
"В кипящую воду добавьте курицу, пшено и овощи. Варите около 25 минут до мягкости крупы и температуры курицы 74 °C." = "У киплячу воду додайте курку, пшоно та овочі. Варіть близько 25 хвилин до м’якості крупи й температури курки 74 °C.";
"Добавьте отмеренное масло и укроп. Подайте весь рассчитанный объём как одну порцию." = "Додайте відміряну олію та кріп. Подайте весь розрахований об’єм як одну порцію.";
"Куриный суп с пшеном и овощами" = "Курячий суп із пшоном та овочами";
"Промойте бурый рис и варите в отмеренной воде до мягкости. Филе минтая проверьте на кости, брокколи разделите на небольшие соцветия." = "Промийте бурий рис та варіть у відміряній воді до м’якості. Перевірте філе минтая на кістки, броколі розділіть на дрібні суцвіття.";
"Смешайте молоко с рисовой мукой. Уложите рыбу и брокколи в форму, залейте смесью и посыпьте сыром." = "Змішайте молоко з рисовим борошном. Викладіть рибу й броколі у форму, залийте сумішшю та посипте сиром.";
"Запекайте при 190 °C около 25 минут, до температуры рыбы 63 °C. Подайте с рисом." = "Запікайте за 190 °C близько 25 хвилин, до температури риби 63 °C. Подайте з рисом.";
"Минтай с брокколи и сыром" = "Минтай з броколі та сиром";
"Нарежьте говядину небольшими кубиками. Тушите с луком, томатами, маслом и 150 мл воды под крышкой 60–75 минут до мягкости." = "Наріжте яловичину дрібними кубиками. Тушкуйте під кришкою з цибулею, томатами, олією та 150 мл води 60–75 хвилин до м’якості.";
"Добавьте цукини и тушите ещё 10–15 минут. Если нужно, добавляйте немного воды без дополнительного масла." = "Додайте цукіні й тушкуйте ще 10–15 хвилин. За потреби доливайте трохи води без додаткової олії.";
"Отдельно сварите булгур в оставшейся воде и подайте с мясом и овощами." = "Окремо зваріть булгур у решті води та подайте з м’ясом і овочами.";
"Говядина с цукини в томатном соусе" = "Яловичина із цукіні в томатному соусі";
"Промойте чечевицу. Нарежьте тыкву, томаты, лук и морковь." = "Промийте сочевицю. Наріжте гарбуз, томати, цибулю та моркву.";
"Варите чечевицу и овощи в отмеренной воде около 25 минут до мягкости. Добавьте отмеренное масло и измельчите суп." = "Варіть сочевицю й овочі у відміряній воді близько 25 хвилин до м’якості. Додайте відміряну олію та подрібніть суп.";
"Дайте супу немного остыть и подайте с йогуртом." = "Дайте супу трохи охолонути й подайте з йогуртом.";
"Суп-пюре из чечевицы и тыквы" = "Суп-пюре із сочевиці та гарбуза";
"Сварите рис до полуготовности, размягчите капустные листья в горячей воде. Измельчите индейку и лук, смешайте с рисом." = "Відваріть рис до напівготовності, розм’якшіть капустяні листки в гарячій воді. Подрібніть індичку й цибулю, змішайте з рисом.";
"Заверните начинку в листья. Уложите в кастрюлю с морковью, томатами, отмеренным маслом и водой." = "Загорніть начинку в листки. Викладіть у каструлю з морквою, томатами, відміряною олією та водою.";
"Тушите под крышкой 35–40 минут до мягкости капусты и температуры начинки 74 °C." = "Тушкуйте під кришкою 35–40 хвилин до м’якості капусти й температури начинки 74 °C.";
"Голубцы с индейкой и бурым рисом" = "Голубці з індичкою та бурим рисом";
"Сварите гречку в отмеренной воде. Разрежьте цукини вдоль и выньте часть мякоти." = "Зваріть гречку у відміряній воді. Розріжте цукіні вздовж та вийміть частину м’якоті.";
"Мелко нарежьте курицу, мякоть цукини, томаты и лук. Смешайте с гречкой и маслом, наполните лодочки." = "Дрібно наріжте курку, м’якоть цукіні, томати й цибулю. Змішайте з гречкою та олією, наповніть човники.";
"Посыпьте сыром и запекайте при 190 °C около 30 минут до температуры курицы 74 °C." = "Посипте сиром і запікайте за 190 °C близько 30 хвилин до температури курки 74 °C.";
"Лодочки из цукини с курицей и гречкой" = "Човники із цукіні з куркою та гречкою";
"Нарежьте говядину и тушите с луком, маслом и 200 мл воды под крышкой 60–75 минут до мягкости." = "Наріжте яловичину й тушкуйте під кришкою з цибулею, олією та 200 мл води 60–75 хвилин до м’якості.";
"Добавьте нарезанные перец и морковь, промытый булгур и оставшуюся воду." = "Додайте нарізані перець і моркву, промитий булгур та решту води.";
"Готовьте под крышкой ещё 15–20 минут, пока крупа не станет мягкой." = "Готуйте під кришкою ще 15–20 хвилин до м’якості крупи.";
"Говядина с булгуром и сладким перцем" = "Яловичина з булгуром і солодким перцем";
"Промойте рис. Нарежьте курицу, тыкву, лук и морковь небольшими кусочками." = "Промийте рис. Наріжте курку, гарбуз, цибулю та моркву невеликими шматочками.";
"Смешайте в форме с отмеренным маслом и горячей водой, плотно накройте крышкой или фольгой." = "Змішайте у формі з відміряною олією й гарячою водою, щільно накрийте кришкою або фольгою.";
"Запекайте при 190 °C 50–60 минут до мягкости риса и температуры курицы 74 °C. При необходимости долейте немного воды." = "Запікайте за 190 °C 50–60 хвилин до м’якості рису й температури курки 74 °C. За потреби долийте трохи води.";
"Рис с курицей и тыквой в духовке" = "Рис із куркою та гарбузом у духовці";
"Разрежьте филе на тонкие пласты и слегка отбейте. Выложите шпинат и моцареллу, сверните рулетики." = "Розріжте філе на тонкі пласти та злегка відбийте. Викладіть шпинат і моцарелу, згорніть рулетики.";
"Переложите в форму с томатами и отмеренным маслом. Запекайте при 190 °C 25–30 минут до температуры курицы 74 °C." = "Перекладіть у форму з томатами та відміряною олією. Запікайте за 190 °C 25–30 хвилин до температури курки 74 °C.";
"Сварите булгур в отмеренной воде и подайте с рулетиками. Удалите шпажки перед едой." = "Зваріть булгур у відміряній воді та подайте з рулетиками. Приберіть шпажки перед їжею.";
"Куриные рулетики со шпинатом и сыром" = "Курячі рулетики зі шпинатом і сиром";
"Нарежьте индейку и цукини. Смешайте кефир с измельчённым чесноком." = "Наріжте індичку й цукіні. Змішайте кефір із подрібненим часником.";
"Переложите всё в форму и запекайте под крышкой при 190 °C около 30 минут до температуры индейки 74 °C." = "Перекладіть усе у форму та запікайте під кришкою за 190 °C близько 30 хвилин до температури індички 74 °C.";
"Посыпьте укропом и подайте вместе с соусом." = "Посипте кропом і подайте разом із соусом.";
"Индейка с цукини в кефире" = "Індичка із цукіні в кефірі";
"Проверьте филе на кости. Выложите в форму лук, шпинат и рыбу." = "Перевірте філе на кістки. Викладіть у форму цибулю, шпинат та рибу.";
"Добавьте воду и отмеренное масло. Запекайте под крышкой при 190 °C 20–25 минут до температуры рыбы 63 °C." = "Додайте воду й відміряну олію. Запікайте під кришкою за 190 °C 20–25 хвилин до температури риби 63 °C.";
"Перед подачей полейте лимонным соком." = "Перед подаванням полийте лимонним соком.";
"Хек со шпинатом и лимоном" = "Хек зі шпинатом і лимоном";
"Разделите брокколи на мелкие соцветия и прогрейте на пару 3–4 минуты." = "Розділіть броколі на дрібні суцвіття та прогрійте на парі 3–4 хвилини.";
"Смешайте творог, яйцо и йогурт. Добавьте брокколи и переложите в небольшую форму." = "Змішайте сир, яйце та йогурт. Додайте броколі й перекладіть у невелику форму.";
"Запекайте при 180 °C 25–30 минут до полной готовности яйца. Подайте с укропом." = "Запікайте за 180 °C 25–30 хвилин до готовності яйця. Подайте з кропом.";
"Творожная запеканка с брокколи" = "Сирна запіканка з броколі";
"Сварите гречку в 120 мл воды. Грибы и стручковую фасоль тушите с оставшейся водой и отмеренным маслом до мягкости." = "Зваріть гречку в 120 мл води. Гриби й стручкову квасолю тушкуйте з рештою води та відміряною олією до м’якості.";
"Смешайте творог с йогуртом и укропом до консистенции соуса." = "Змішайте сир з йогуртом і кропом до консистенції соусу.";
"Подайте гречку с горячими овощами и творожным соусом." = "Подайте гречку з гарячими овочами та сирним соусом.";
"Гречка с грибами, фасолью и творожным соусом" = "Гречка з грибами, квасолею та сирним соусом";
"Запекайте свёклу в закрытой форме при 190 °C 50–60 минут до мягкости. Немного остудите и очистите." = "Запікайте буряк у закритій формі за 190 °C 50–60 хвилин до м’якості. Трохи остудіть та очистьте.";
"Натрите свёклу. Смешайте творог с йогуртом и укропом." = "Натріть буряк. Змішайте сир з йогуртом і кропом.";
"Распределите творог и свёклу по хлебцам, посыпьте измельчёнными орехами." = "Розподіліть сир та буряк по хлібцях, посипте подрібненими горіхами.";
"Хлебцы со свёклой и творогом" = "Хлібці з буряком і кисломолочним сиром";
"Вымойте яблоко, разрежьте пополам и удалите сердцевину. Отмерьте съедобную мякоть." = "Вимийте яблуко, розріжте навпіл і видаліть серцевину. Відміряйте їстівну м’якоть.";
"Наполните половинки творогом и измельчёнными орехами. Запекайте при 180 °C 25–30 минут до мягкости яблока." = "Наповніть половинки сиром та подрібненими горіхами. Запікайте за 180 °C 25–30 хвилин до м’якості яблука.";
"Подайте с йогуртом и корицей." = "Подайте з йогуртом і корицею.";
"Печёное яблоко с творогом и орехами" = "Печене яблуко із сиром і горіхами";
"Сварите рис в отмеренной воде. Натрите цукини и слегка отожмите." = "Зваріть рис у відміряній воді. Натріть цукіні та злегка відіжміть.";
"Смешайте рис с цукини, яйцом, фетой и нарезанными томатами. Переложите в форму, смазанную отмеренным маслом." = "Змішайте рис із цукіні, яйцем, фетою та нарізаними томатами. Перекладіть у форму, змащену відміряною олією.";
"Запекайте при 180 °C около 25 минут до полной готовности яйца." = "Запікайте за 180 °C близько 25 хвилин до готовності яйця.";
"Рисовая запеканка с цукини и яйцом" = "Рисова запіканка із цукіні та яйцем";
"Сварите яйцо до плотного белка и желтка, остудите и нарежьте полосками. Вымойте и нарежьте овощи." = "Зваріть яйце до щільного білка й жовтка, остудіть та наріжте смужками. Вимийте й наріжте овочі.";
"Смешайте творог с йогуртом и укропом. Распределите по нори, оставив край свободным." = "Змішайте сир з йогуртом і кропом. Розподіліть по норі, залишивши край вільним.";
"Добавьте яйцо и овощи, сверните плотный рулет и нарежьте. Подайте сразу." = "Додайте яйце та овочі, згорніть щільний рулет і наріжте. Подайте одразу.";
"Роллы нори с яйцом и творогом" = "Роли норі з яйцем і кисломолочним сиром";
"Промойте чечевицу, нарежьте овощи небольшими кусочками." = "Промийте сочевицю, наріжте овочі невеликими шматочками.";
"Варите чечевицу и овощи в отмеренной воде 20–25 минут до мягкости. Добавьте отмеренное масло." = "Варіть сочевицю й овочі у відміряній воді 20–25 хвилин до м’якості. Додайте відміряну олію.";
"Дайте супу немного остыть, добавьте йогурт в тарелку перед подачей." = "Дайте супу трохи охолонути, додайте йогурт у тарілку перед подаванням.";
"Овощной суп с чечевицей и йогуртом" = "Овочевий суп із сочевицею та йогуртом";
"Проверьте рыбу на кости и измельчите. Натрите цукини и морковь, слегка отожмите. Смешайте с рыбой, хлопьями и яйцом." = "Перевірте рибу на кістки та подрібніть. Натріть цукіні й моркву, злегка відіжміть. Змішайте з рибою, пластівцями та яйцем.";
"Дайте смеси постоять 5 минут, сформируйте небольшие котлетки и готовьте на пару 20–25 минут до температуры в центре 71 °C." = "Дайте суміші постояти 5 хвилин, сформуйте невеликі котлетки й готуйте на парі 20–25 хвилин до температури в центрі 71 °C.";
"Подайте с йогуртом и укропом." = "Подайте з йогуртом і кропом.";
"Рыбные котлетки с цукини на пару" = "Рибні котлетки із цукіні на парі";

