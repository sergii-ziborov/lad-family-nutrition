"Гречка · Яйцо · Шампиньоны" = "Гречка · Яйце · Печериці";
"Овсяные хлопья · Йогурт греческий · Молоко" = "Вівсяні пластівці · Грецький йогурт · Молоко";
"Овсяные хлопья · Творог · Яйцо" = "Вівсяні пластівці · Кисломолочний сир · Яйце";
"Творог · Хлеб · Огурец" = "Кисломолочний сир · Хліб · Огірок";
"Нут · Яйцо · Томаты" = "Нут · Яйце · Помідори";
"Чечевица красная · Йогурт греческий · Огурец" = "Червона сочевиця · Грецький йогурт · Огірок";
"Хлеб · Яйцо · Моцарелла" = "Хліб · Яйце · Моцарела";
"Пшено · Молоко · Тыква" = "Пшоно · Молоко · Гарбуз";
"Лосось · Хлеб · Авокадо" = "Лосось · Хліб · Авокадо";
"Порубите филе в фарш. Отдельно мелко нарежьте грибы, лук и сельдерей; натрите сыр." = "Посічіть філе на фарш. Окремо дрібно наріжте гриби, цибулю й селеру; натріть сир.";
"На отмеренном масле выпарите влагу из грибов с луком и сельдереем. Снимите с огня, вмешайте майонез, сыр и приправы." = "На відміряній олії випаруйте вологу з грибів із цибулею та селерою. Зніміть з вогню, додайте майонез, сир і приправи.";
"Сделайте из фарша чашечки, наполните грибами. Запекайте при 190 °C около 30 минут до 74 °C внутри; добавьте зелень." = "Зробіть із фаршу кошички, наповніть грибами. Запікайте за 190 °C близько 30 хвилин до 74 °C усередині; додайте зелень.";
"Куриное филе · Шампиньоны · Лук" = "Куряче філе · Печериці · Цибуля";
"Филе нарежьте небольшими кусочками, морковь и сельдерей — тонкими ломтиками, лук — мелко." = "Філе наріжте невеликими шматочками, моркву й селеру — тонкими скибками, цибулю — дрібно.";
"Вскипятите указанную воду с овощами и пряностями. Добавьте курицу, варите на слабом огне до 74 °C в середине кусочков." = "Закип’ятіть зазначену воду з овочами та прянощами. Додайте курку, варіть на слабкому вогні до 74 °C у середині шматочків.";
"Положите лапшу за время, указанное на её упаковке, до конца варки. Уберите лавровый лист и горошины перца, добавьте зелень." = "Покладіть локшину наприкінці, врахувавши час на пакованні. Приберіть лавровий лист і горошини перцю, додайте зелень.";
"Куриное филе · Морковь · Лук" = "Куряче філе · Морква · Цибуля";
"Нарежьте морковь, лук, перец и сельдерей одинаковыми небольшими кусочками. Рис промойте." = "Наріжте моркву, цибулю, перець і селеру однаковими невеликими шматочками. Рис промийте.";
"В посуде с толстым дном прогрейте овощи с несколькими ложками отмеренной воды. Всыпьте рис, приправы и вложите головку чеснока." = "У товстостінній посудині прогрійте овочі з кількома ложками відміряної води. Всипте рис, приправи й покладіть головку часнику.";
"Добавьте оставшуюся воду. Томите под крышкой 30–40 минут до мягкости риса; при необходимости доливайте горячую воду. Дайте постоять 5 минут, добавьте зелень." = "Додайте решту води. Томіть під кришкою 30–40 хвилин до м’якості рису, за потреби доливаючи гарячу воду. Залиште на 5 хвилин, додайте зелень.";
"Морковь · Лук · Сладкий перец" = "Морква · Цибуля · Солодкий перець";
"Мелко порубите оба вида капусты, сельдерей и лук. Сыр натрите, яйца взбейте вилкой." = "Дрібно посічіть обидва види капусти, селеру й цибулю. Сир натріть, яйця збийте виделкою.";
"Соедините овощи с сыром, яйцами, рисовой мукой и аджикой. Приправьте и разложите небольшими плоскими котлетами на пергаменте." = "З’єднайте овочі із сиром, яйцями, рисовим борошном та аджикою. Приправте й викладіть невеликі пласкі котлети на пергамент.";
"Запекайте при 190 °C примерно 20–25 минут до мягкости овощей и 74 °C в центре. Переворачивайте только после схватывания низа." = "Запікайте за 190 °C приблизно 20–25 хвилин до м’якості овочів і 74 °C у центрі. Перевертайте лише після схоплення низу.";
"Цветная капуста · Брокколи · Сельдерей" = "Цвітна капуста · Броколі · Селера";
"Разотрите творог с йогуртом. Добавьте тёртый сыр, рубленую зелень, соль и приправы." = "Розітріть кисломолочний сир із йогуртом. Додайте натертий твердий сир, посічену зелень, сіль і приправи.";
"Вмешайте ржаную муку с разрыхлителем. Прижмите небольшие порции теста в тонкие кружочки на пергаменте." = "Вмішайте житнє борошно з розпушувачем. Невеликі порції тіста розплющте в тонкі кружальця на пергаменті.";
"Пеките при 180 °C 18–22 минуты до сухой поверхности и румяных краёв. Остудите на решётке: печенье станет плотнее." = "Печіть за 180 °C 18–22 хвилини до сухої поверхні та рум’яних країв. Остудіть на решітці, щоб печиво ущільнилося.";
"Творог · Йогурт натуральный · Ржаная мука" = "Кисломолочний сир · Натуральний йогурт · Житнє борошно";
"Проверьте филе на кости. Тонко нарежьте лук и томат, сыр натрите." = "Перевірте філе на кістки. Тонко наріжте цибулю й томат, сир натріть.";
"Выложите рыбу в небольшую форму. Распределите сметану и приправы, накройте луком, томатом и сыром." = "Викладіть рибу в невелику форму. Розподіліть сметану й приправи, накрийте цибулею, томатом і сиром.";
"Запекайте при 190 °C около 20 минут. Рыба должна достичь 63 °C в самой толстой части и легко разделяться вилкой." = "Запікайте за 190 °C близько 20 хвилин. Найтовстіша частина риби має досягти 63 °C і легко розділятися виделкою.";
"Минтай · Лук · Сметана" = "Минтай · Цибуля · Сметана";
"Промойте гречку и сварите в воде до мягкости по упаковке. Оставьте под крышкой, пока готовите салат." = "Промийте гречку й зваріть у воді до м’якості за пакованням. Залиште під кришкою, поки готуєте салат.";
"Капусту тонко нашинкуйте и слегка разомните с солью. Добавьте огурец, зелёный лук, укроп и лимонный сок; подайте рядом с гречкой." = "Капусту тонко нашаткуйте й злегка помніть із сіллю. Додайте огірок, зелену цибулю, кріп і лимонний сік; подайте поруч із гречкою.";
"Огурец · Гречка · Капуста" = "Огірок · Гречка · Капуста";
"Измельчите цветную капусту, грибы и лук до мелких кусочков. Соедините с фаршем, рисовой мукой и приправами." = "Подрібніть цвітну капусту, гриби й цибулю на дрібні шматочки. З’єднайте з фаршем, рисовим борошном і приправами.";
"Сформуйте котлеты одинаковой толщины. Выложите на пергамент и запекайте при 190 °C около 30 минут; для смешанного фарша ориентируйтесь на 74 °C внутри." = "Сформуйте котлети однакової товщини. Викладіть на пергамент і запікайте за 190 °C близько 30 хвилин; для змішаного фаршу орієнтуйтеся на 74 °C усередині.";
"Мясной фарш · Цветная капуста · Шампиньоны" = "М'ясний фарш · Цвітна капуста · Печериці";
"Натрите цукини и отожмите сок. Мелко нарежьте лук, натрите морковь и чеснок; смешайте с цукини, творогом, яйцом и приправами." = "Натріть цукіні й відіжміть сік. Дрібно наріжте цибулю, натріть моркву й часник; змішайте з цукіні, сиром, яйцем і приправами.";
"Разложите тонкими оладьями на пергаменте. Пеките при 190 °C 20–25 минут до 74 °C в середине, затем дайте схватиться 3 минуты." = "Викладіть тонкі оладки на пергамент. Печіть за 190 °C 20–25 хвилин до 74 °C у середині, потім дайте схопитися 3 хвилини.";
"Соедините йогурт с укропом и сушёным чесноком. Подайте соус и нарезанный томат отдельно от горячих оладий." = "З’єднайте йогурт із кропом і сушеним часником. Подайте соус і нарізаний томат окремо від гарячих оладок.";
"Цукини · Творог · Яйцо" = "Цукіні · Кисломолочний сир · Яйце";
"Нарежьте цукини широкими кружками и сделайте неглубокие выемки. Мякоть мелко порубите с луком и чесноком." = "Наріжте цукіні широкими кружальцями й зробіть неглибокі заглиблення. М’якуш дрібно посічіть із цибулею й часником.";
"Смешайте овощную крошку с фаршем и приправами. Смажьте форму отмеренным маслом, заполните кружки фаршем и посыпьте сыром." = "Змішайте овочеву крихту з фаршем і приправами. Змастіть форму відміряною олією, наповніть кружальця фаршем і посипте сиром.";
"Запекайте при 190 °C 25–30 минут. Проверьте центр начинки термометром: для смешанного фарша — 74 °C." = "Запікайте за 190 °C 25–30 хвилин. Перевірте центр начинки термометром: для змішаного фаршу — 74 °C.";
"Цукини · Мясной фарш · Лук" = "Цукіні · М'ясний фарш · Цибуля";
"Нарежьте говядину поперёк волокон небольшими кусочками, овощи — кубиками. Подрумяньте мясо с отмеренным маслом в толстостенной посуде." = "Наріжте яловичину впоперек волокон невеликими шматочками, овочі — кубиками. Підрум’яньте м’ясо з відміряною олією у товстостінній посудині.";
"Добавьте лук, перец, томаты и паприку. Влейте указанную воду и томите под крышкой 45–60 минут, пока мясо не станет мягким." = "Додайте цибулю, перець, томати й паприку. Влийте зазначену воду та томіть під кришкою 45–60 хвилин до м’якості м’яса.";
"Гречку сварите отдельно. Приправьте подливу и распределите мясо, овощи и гарнир между порциями." = "Гречку зваріть окремо. Приправте підливу й розподіліть м’ясо, овочі та гарнір між порціями.";
"Говядина · Сладкий перец · Томаты" = "Яловичина · Солодкий перець · Помідори";
"Тонко нашинкуйте капусту. Натрите сырые свёклу, морковь и яблоко, измельчите чеснок и зелень." = "Тонко нашаткуйте капусту. Натріть сирі буряк, моркву та яблуко, подрібніть часник і зелень.";
"Перемешайте всё с лимонным соком и солью. Оставьте на 5 минут и ещё раз перемешайте перед подачей." = "Перемішайте все з лимонним соком і сіллю. Залиште на 5 хвилин і ще раз перемішайте перед подаванням.";
"Капуста · Свёкла · Морковь" = "Капуста · Буряк · Морква";
"Очень мелко порубите сырую цветную капусту и лук. Вымешайте с фаршем, яйцом, солью и приправами." = "Дуже дрібно посічіть сиру цвітну капусту й цибулю. Вимішайте з фаршем, яйцем, сіллю та приправами.";
"Сформуйте плоские котлеты на пергаменте. Пеките при 190 °C 20–25 минут, проверив 74 °C в центре для смешанного фарша." = "Сформуйте пласкі котлети на пергаменті. Печіть за 190 °C 20–25 хвилин, перевіривши 74 °C у центрі для змішаного фаршу.";
"Мясной фарш · Цветная капуста · Яйцо" = "М'ясний фарш · Цвітна капуста · Яйце";
"Сделайте на толстом филе несколько неглубоких надрезов. Покройте кефиром с майораном и солью; выдержите 40 минут в холодильнике." = "Зробіть на товстому філе кілька неглибоких надрізів. Покрийте кефіром із майораном і сіллю; витримайте 40 хвилин у холодильнику.";
"Переложите вместе с маринадом в небольшую форму. Запекайте при 190 °C 25–35 минут до 74 °C в толстой части." = "Перекладіть разом із маринадом в невелику форму. Запікайте за 190 °C 25–35 хвилин до 74 °C у товстій частині.";
"Куриное филе · Кефир · Майоран" = "Куряче філе · Кефір · Майоран";
"Нарежьте картофель небольшими дольками. Перемешайте с отмеренным маслом, паприкой, солью и перцем." = "Наріжте картоплю невеликими часточками. Перемішайте з відміряною олією, паприкою, сіллю й перцем.";
"Распределите одним слоем и пеките при 200 °C 30–35 минут до мягкой середины. Йогурт смешайте с укропом и чесноком, подайте отдельно." = "Розкладіть одним шаром і печіть за 200 °C 30–35 хвилин до м’якої середини. Йогурт змішайте з кропом і часником, подайте окремо.";
"Картофель · Йогурт натуральный · Укроп" = "Картопля · Натуральний йогурт · Кріп";
"Нарежьте овощи для супа одинаковыми небольшими кусочками. Вскипятите воду с морковью, сельдереем, луком и перцем." = "Наріжте овочі для супу однаковими невеликими шматочками. Закип’ятіть воду з морквою, селерою, цибулею та перцем.";
"Через 10 минут добавьте цукини, капусту, томаты, чеснок и аджику. Варите ещё 10–15 минут; посолите и добавьте йогурт уже в тарелки." = "Через 10 хвилин додайте цукіні, капусту, томати, часник та аджику. Варіть ще 10–15 хвилин; посоліть і додайте йогурт уже в тарілки.";
"Томаты · Пекинская капуста · Цукини" = "Помідори · Пекінська капуста · Цукіні";
"Нашинкуйте свежую капусту, квашеную отожмите; яблоко нарежьте тонко. Смешайте вино с горчицей, тёртым имбирём, чесноком и приправами." = "Нашаткуйте свіжу капусту, квашену відіжміть; яблуко наріжте тонко. Змішайте вино з гірчицею, тертим імбиром, часником і приправами.";
"Уложите капусту и яблоко в форму, сверху — филе с заправкой. Накройте и запекайте при 190 °C 35–45 минут до 74 °C внутри курицы." = "Покладіть капусту й яблуко у форму, зверху — філе із заправкою. Накрийте й запікайте за 190 °C 35–45 хвилин до 74 °C усередині курки.";
"Куриное филе · Красное сухое вино · Капуста" = "Куряче філе · Червоне сухе вино · Капуста";
"Удалите косточки слив и сердцевину яблок. Нарежьте фрукты небольшими кусочками примерно одного размера." = "Видаліть кісточки слив і серцевину яблук. Наріжте фрукти невеликими шматочками приблизно одного розміру.";
"Распределите фрукты по креманкам и добавьте отмеренный йогурт. Перемешивайте непосредственно перед едой." = "Розподіліть фрукти по креманках і додайте відміряний йогурт. Перемішуйте безпосередньо перед їжею.";
"Сливы · Яблоко · Йогурт натуральный" = "Сливи · Яблуко · Натуральний йогурт";
"Нарежьте лук, перец и чеснок. Прогрейте их с отмеренным маслом в сковороде, пока лук не станет мягким." = "Наріжте цибулю, перець і часник. Прогрійте їх із відміряною олією на сковороді до м’якості цибулі.";
"Добавьте томаты, пасту, аджику и соль. Тушите 8–10 минут; сделайте углубления и распределите в них яйца." = "Додайте томати, пасту, аджику й сіль. Тушкуйте 8–10 хвилин; зробіть заглиблення й розподіліть у них яйця.";
"Накройте и готовьте на слабом огне до плотного белка и желтка. Подавайте вместе с томатным соусом из сковороды." = "Накрийте й готуйте на слабкому вогні до щільних білка та жовтка. Подавайте разом із томатним соусом зі сковороди.";
"Яйцо · Томаты · Сладкий перец" = "Яйце · Помідори · Солодкий перець";
"Разморозьте сырые креветки в холодильнике. Вскипятите воду с укропом и солью; опустите креветки." = "Розморозьте сирі креветки в холодильнику. Закип’ятіть воду з кропом і сіллю; опустіть креветки.";
"Варите до непрозрачной мякоти, обычно 2–4 минуты после восстановления кипения. Слейте воду и соедините с лимонным соком и измельчённым чесноком." = "Варіть до непрозорого м’яса, зазвичай 2–4 хвилини після відновлення кипіння. Злийте воду й з’єднайте з лимонним соком та подрібненим часником.";
"Креветки · Укроп · Лимонный сок" = "Креветки · Кріп · Лимонний сік";
"Очистите перцы от семян. Мелко нарежьте капусту и лук, натрите морковь; прогрейте лук и морковь с ложкой воды." = "Очистіть перці від насіння. Дрібно наріжте капусту й цибулю, натріть моркву; прогрійте цибулю та моркву з ложкою води.";
"Соедините овощи с фаршем, уже сваренным рисом и приправами. Неплотно наполните перцы, поставьте в форму и подлейте томатный сок." = "З’єднайте овочі з фаршем, уже звареним рисом і приправами. Нещільно наповніть перці, поставте у форму й підлийте томатний сік.";
"Накройте и запекайте при 190 °C 45–55 минут. Проверьте 74 °C в центре мясной начинки; при подсыхании подливайте горячую воду." = "Накрийте й запікайте за 190 °C 45–55 хвилин. Перевірте 74 °C у центрі м’ясної начинки; при підсиханні підливайте гарячу воду.";
"Сладкий перец · Капуста · Мясной фарш" = "Солодкий перець · Капуста · М'ясний фарш";
"Смажьте криспы творожным сыром, распределите сверху тонко нарезанный твёрдый сыр." = "Змастіть хлібці вершковим сиром, розподіліть зверху тонко нарізаний твердий сир.";
"Прогрейте при 180 °C 3–5 минут, только до плавления сыра. Добавьте зелень и подавайте, пока основа хрустит." = "Прогрійте за 180 °C 3–5 хвилин, лише до плавлення сиру. Додайте зелень і подавайте, поки основа хрумка.";
"Ржаные криспы · Творожный сыр · Сыр" = "Житні кріспи · Вершковий сир · Твердий сир";
"Нарежьте вырезку порционно, слегка отбейте. Овощи и грибы нарежьте тонкими ломтиками, сыр натрите." = "Наріжте вирізку порційно, злегка відбийте. Овочі й гриби наріжте тонкими скибками, сир натріть.";
"Распределите мясо и овощи в форме, полейте соевым соусом. Накройте и запекайте при 190 °C около 30 минут, затем добавьте сыр." = "Розподіліть м’ясо й овочі у формі, полийте соєвим соусом. Накрийте й запікайте за 190 °C близько 30 хвилин, потім додайте сир.";
"Дождитесь мягкости овощей и не менее 63 °C внутри свинины. После духовки выдержите мясо 3 минуты перед подачей." = "Дочекайтеся м’якості овочів і щонайменше 63 °C усередині свинини. Після духовки витримайте м’ясо 3 хвилини перед подаванням.";
"Свиная вырезка · Шампиньоны · Томаты" = "Свиняча вирізка · Печериці · Помідори";
"Разотрите творог с яйцом и ванилином. Нарежьте яблоко тонко, мандарин разберите на небольшие кусочки без косточек." = "Розітріть кисломолочний сир із яйцем і ваніліном. Яблуко наріжте тонко, мандарин розділіть на невеликі шматочки без кісточок.";
"Разложите творог небольшими лепёшками на пергаменте и добавьте фрукты сверху. Пеките при 190 °C около 20 минут до 74 °C в центре; слегка остудите." = "Викладіть сир невеликими коржиками на пергамент і додайте фрукти зверху. Печіть за 190 °C близько 20 хвилин до 74 °C у центрі; трохи остудіть.";
"Творог · Яйцо · Ванилин" = "Кисломолочний сир · Яйце · Ванілін";
"Нарежьте говядину небольшими кубиками, лук — полукольцами. Подрумяньте мясо с отмеренным маслом, добавьте лук." = "Наріжте яловичину невеликими кубиками, цибулю — півкільцями. Підрум’яньте м’ясо з відміряною олією, додайте цибулю.";
"Влейте воду, накройте и поддерживайте едва заметное кипение 1,5–2 часа. Мясо готово, когда легко разделяется вилкой; следите, чтобы соус не выкипел." = "Влийте воду, накрийте й підтримуйте ледь помітне кипіння 1,5–2 години. М’ясо готове, коли легко розділяється виделкою; стежте, щоб соус не википів.";
"Говядина · Лук · Растительное масло" = "Яловичина · Цибуля · Рослинна олія";
"Залейте яйца холодной водой. После закипания убавьте нагрев и варите 9–11 минут до плотного желтка." = "Залийте яйця холодною водою. Після закипання зменште нагрів і варіть 9–11 хвилин до щільного жовтка.";
"Охладите яйца в холодной воде, очистите и разрежьте. Разложите порции и посыпьте свежей зеленью." = "Охолодіть яйця в холодній воді, почистьте й розріжте. Розкладіть порції та посипте свіжою зеленню.";
"Яйцо · Зелень" = "Яйце · Зелень";
"Промойте пшено горячей водой. Нарежьте овощи; лук и чеснок прогрейте с отмеренным маслом в кастрюле." = "Промийте пшоно гарячою водою. Наріжте овочі; цибулю й часник прогрійте з відміряною олією в каструлі.";
"Влейте воду, добавьте морковь, сельдерей, томаты, пшено и лавровый лист. Варите 15 минут, затем положите рыбу без костей и лимон." = "Влийте воду, додайте моркву, селеру, томати, пшоно й лавровий лист. Варіть 15 хвилин, потім покладіть рибу без кісток і лимон.";
"Доварите до мягкости крупы и 63 °C внутри рыбы. Уберите лавровый лист, приправьте лимонным соком и зеленью." = "Доваріть до м’якості крупи й 63 °C усередині риби. Приберіть лавровий лист, приправте лимонним соком і зеленню.";
"Минтай · Лук · Чеснок" = "Минтай · Цибуля · Часник";
"Мелко натрите яблоки и слегка отожмите. Разотрите творог с яйцом, корицей, ванилином и разрыхлителем; вмешайте яблоко." = "Дрібно натріть яблука й злегка відіжміть. Розітріть сир із яйцем, корицею, ваніліном і розпушувачем; вмішайте яблуко.";
"Разложите небольшими лепёшками в силиконовых формочках. Пеките при 180 °C 25–30 минут до 74 °C в центре; извлекайте после короткого остывания." = "Розкладіть невеликими коржиками в силіконові формочки. Печіть за 180 °C 25–30 хвилин до 74 °C у центрі; виймайте після короткого охолодження.";
"Творог · Яблоко · Яйцо" = "Кисломолочний сир · Яблуко · Яйце";
"Нарежьте курицу кубиками, грибы — пластинками. На отмеренном масле прогрейте грибы до уменьшения влаги, добавьте курицу." = "Наріжте курку кубиками, гриби — пластинками. На відміряній олії прогрійте гриби до зменшення вологи, додайте курку.";
"Разведите рисовую муку в холодном молоке и влейте в сковороду. Томите 15–20 минут, помешивая, до загустения соуса и 74 °C внутри курицы; приправьте." = "Розведіть рисове борошно в холодному молоці й влийте у сковороду. Томіть 15–20 хвилин, помішуючи, до загустіння соусу та 74 °C усередині курки; приправте.";
"Шампиньоны · Куриное филе · Молоко" = "Печериці · Куряче філе · Молоко";
"Разомните творог с измельчёнными чесноком, укропом и зеленью. Огурец и перец нарежьте узкими полосками." = "Розімніть сир із подрібненими часником, кропом і зеленню. Огірок та перець наріжте вузькими смужками.";
"На нори распределите творог, оставив край свободным. Уложите овощи, плотно сверните, смочите край водой; нарежьте и подайте с отмеренным соевым соусом." = "На норі розподіліть сир, залишивши край вільним. Викладіть овочі, щільно згорніть, змочіть край водою; наріжте й подайте з відміряним соєвим соусом.";
"Нори · Творог · Укроп" = "Норі · Кисломолочний сир · Кріп";
"Нашинкуйте капусту, лук и морковь. Прогрейте с отмеренным маслом, добавьте пасту, кориандр, лавровый лист и немного воды; тушите до мягкости, лавр уберите." = "Нашаткуйте капусту, цибулю й моркву. Прогрійте з відміряною олією, додайте пасту, коріандр, лавровий лист і трохи води; тушкуйте до м’якості, лавр приберіть.";
"Взбейте кефир с яйцами, рисовой мукой и разрыхлителем. Перемешайте с остывшей начинкой и приправами; переложите в форму с пергаментом." = "Збийте кефір із яйцями, рисовим борошном і розпушувачем. Змішайте з охолодженою начинкою та приправами; перекладіть у форму з пергаментом.";
"Запекайте при 180 °C 30–40 минут до плотного центра и 74 °C внутри. Дайте постоять 10 минут перед нарезкой." = "Запікайте за 180 °C 30–40 хвилин до щільного центру й 74 °C усередині. Дайте постояти 10 хвилин перед нарізанням.";
"Капуста · Лук · Морковь" = "Капуста · Цибуля · Морква";
"Смешайте кефир с чесноком, майораном, солью и перцем. Покройте филе и маринуйте 1,5 часа в холодильнике." = "Змішайте кефір із часником, майораном, сіллю й перцем. Покрийте філе та маринуйте 1,5 години в холодильнику.";
"Положите филе с маринадом в форму. Пеките при 190 °C 25–35 минут до 74 °C в толстой части; нарезайте поперёк волокон." = "Покладіть філе з маринадом у форму. Печіть за 190 °C 25–35 хвилин до 74 °C у товстій частині; нарізайте впоперек волокон.";
"Куриное филе · Кефир · Чеснок" = "Куряче філе · Кефір · Часник";
"Нарежьте тыкву, морковь, лук, томаты и чеснок. Лук с чесноком прогрейте с отмеренным маслом, затем добавьте остальные овощи." = "Наріжте гарбуз, моркву, цибулю, томати й часник. Цибулю з часником прогрійте з відміряною олією, потім додайте решту овочів.";
"Влейте бульон, всыпьте промытый рис и варите до мягкости крупы и овощей. Снимите с огня и пробейте погружным блендером, избегая брызг." = "Влийте бульйон, всипте промитий рис і варіть до м’якості крупи та овочів. Зніміть з вогню й збийте занурювальним блендером, уникаючи бризок.";
"Посолите и поперчите по списку. При подаче распределите тёртый сыр и свежую зелень по тарелкам." = "Посоліть і поперчіть за списком. При подаванні розподіліть натертий сир і свіжу зелень по тарілках.";
"Тыква · Томаты · Пропаренный рис" = "Гарбуз · Помідори · Пропарений рис";
"Желатин замочите в отмеренной воде по его упаковке. Яблоки без сердцевины прогрейте до мягкости; сделайте пюре и слегка остудите." = "Желатин замочіть у відміряній воді за його пакованням. Яблука без серцевини прогрійте до м’якості; зробіть пюре й трохи остудіть.";
"Распустите желатин при мягком нагреве, не кипятите. Взбейте с яблочным пюре и творогом; чернослив и мандарин мелко нарежьте." = "Розчиніть желатин за слабкого нагріву, не кип’ятіть. Збийте з яблучним пюре й сиром; чорнослив і мандарин дрібно наріжте.";
"Разложите массу и фрукты слоями в небольшие формы. Уберите в холодильник минимум на 2 часа, до полного застывания." = "Викладіть масу й фрукти шарами в невеликі форми. Поставте в холодильник щонайменше на 2 години до повного застигання.";
"Желатин · Яблоко · Творог" = "Желатин · Яблуко · Кисломолочний сир";
"Картофель нарежьте дольками одинаковой толщины. Перемешайте с оливковым маслом, паприкой, сушёным чесноком и приправами." = "Картоплю наріжте часточками однакової товщини. Перемішайте з оливковою олією, паприкою, сушеним часником і приправами.";
"Пеките при 200 °C 30–40 минут до мягкости, затем посыпьте сыром и дайте ему расплавиться. Йогурт соедините с укропом и свежим чесноком; подайте рядом." = "Печіть за 200 °C 30–40 хвилин до м’якості, потім посипте сиром і дайте йому розплавитися. Йогурт з’єднайте з кропом і свіжим часником; подайте поруч.";
"Картофель · Сыр · Йогурт греческий" = "Картопля · Твердий сир · Грецький йогурт";
"Поставьте вариться промытый бурый рис. Цукини и лук нарежьте мелко, морковь натрите." = "Поставте варитися промитий бурий рис. Цукіні й цибулю наріжте дрібно, моркву натріть.";
"Овощи залейте томатным соком и тушите под крышкой 20–25 минут до мягкости, затем разомните. Посолите и подайте с рисом, добавляя воду при варке по необходимости." = "Овочі залийте томатним соком і тушкуйте під кришкою 20–25 хвилин до м’якості, потім розімніть. Посоліть і подайте з рисом, додаючи воду під час варіння за потреби.";
"Цукини · Томатный сок · Лук" = "Цукіні · Томатний сік · Цибуля";
"Нарежьте свинину тонкими пластами и отбейте. Смешайте тёртый сыр, укроп, чеснок и майонез; приправьте мясо." = "Наріжте свинину тонкими пластами й відбийте. Змішайте натертий сир, кріп, часник і майонез; приправте м’ясо.";
"Заверните начинку в мясо, уложите швом вниз и смажьте йогуртом. Запекайте при 190 °C 25–35 минут до 74 °C в центре рулетиков." = "Загорніть начинку в м’ясо, покладіть швом донизу й змастіть йогуртом. Запікайте за 190 °C 25–35 хвилин до 74 °C у центрі рулетиків.";
"Свиная вырезка · Сыр · Укроп" = "Свиняча вирізка · Твердий сир · Кріп";
"Промойте рис. Мелко нарежьте капусту, лук, морковь, перец и сельдерей; смешайте в форме с рисом и приправами." = "Промийте рис. Дрібно наріжте капусту, цибулю, моркву, перець і селеру; змішайте у формі з рисом і приправами.";
"Влейте томатный сок и горячую воду до покрытия риса. Плотно накройте, запекайте при 190 °C 35–40 минут; проверьте мягкость крупы и дайте постоять 5 минут." = "Влийте томатний сік і гарячу воду до покриття рису. Щільно накрийте, запікайте за 190 °C 35–40 хвилин; перевірте м’якість крупи й дайте постояти 5 хвилин.";
"Пропаренный рис · Капуста · Морковь" = "Пропарений рис · Капуста · Морква";
"Взбейте яйца с майонезом и тёртым сыром. Разлейте тонким прямоугольником на пергаменте, пеките при 180 °C 8–10 минут до схватывания." = "Збийте яйця з майонезом і натертим сиром. Розподіліть тонким прямокутником на пергаменті, печіть за 180 °C 8–10 хвилин до схоплення.";
"В фарш вмешайте мелко нарезанный лук, чеснок и приправы. Распределите по слегка остывшему омлету и сверните плотным рулетом с помощью пергамента." = "У фарш вмішайте дрібно нарізану цибулю, часник і приправи. Розподіліть по трохи охолодженому омлету та щільно згорніть за допомогою пергаменту.";
"Пеките швом вниз при 180 °C ещё 25–35 минут до 74 °C в середине начинки. Перед нарезкой выдержите 5 минут." = "Печіть швом донизу за 180 °C ще 25–35 хвилин до 74 °C у середині начинки. Перед нарізанням витримайте 5 хвилин.";
"Яйцо · Сыр · Майонез" = "Яйце · Твердий сир · Майонез";
"Разберите капусту на соцветия, отварите в воде до очень мягкой сердцевины и тщательно слейте воду." = "Розберіть капусту на суцвіття, відваріть у воді до дуже м’якої серцевини й ретельно злийте воду.";
"Прогрейте молоко и постепенно введите в капусту при измельчении. Добавьте соль и перец; регулируйте гладкость пюре, не добавляя сливочное масло." = "Прогрійте молоко й поступово введіть у капусту під час подрібнення. Додайте сіль і перець; регулюйте гладкість пюре, не додаючи вершкового масла.";
"Цветная капуста · Молоко" = "Цвітна капуста · Молоко";
"Яйца сварите вкрутую. Морковь и стручковую фасоль отварите до мягкости, слейте воду и остудите." = "Яйця зваріть круто. Моркву й стручкову квасолю відваріть до м’якості, злийте воду та остудіть.";
"Нарежьте уже сваренную говядину, яйца, овощи, огурцы и лук небольшими кубиками. Заправьте йогуртом перед подачей; храните салат в холодильнике." = "Наріжте вже зварену яловичину, яйця, овочі, огірки й цибулю невеликими кубиками. Заправте йогуртом перед подаванням; зберігайте салат у холодильнику.";
"Говядина варёная · Яйцо · Морковь" = "Відварена яловичина · Яйце · Морква";
"Нарежьте мясо небольшими кусочками поперёк волокон. Уложите в кастрюлю с нарезанным луком, кориандром, лавровым листом и отмеренной водой." = "Наріжте м’ясо невеликими шматочками впоперек волокон. Покладіть у каструлю з нарізаною цибулею, коріандром, лавровим листом і відміряною водою.";
"Томите под крышкой без масла 1,5–2 часа до мягкости. Следите за уровнем воды; в конце уберите лавр и добавьте соль с перцем." = "Томіть під кришкою без олії 1,5–2 години до м’якості. Стежте за рівнем води; наприкінці приберіть лавр і додайте сіль із перцем.";
"Говядина · Лук · Кориандр" = "Яловичина · Цибуля · Коріандр";
"Нарежьте и слегка отбейте свинину. Выложите в форму с тонко нарезанным луком, соевым соусом, майонезом и приправами." = "Наріжте й злегка відбийте свинину. Викладіть у форму з тонко нарізаною цибулею, соєвим соусом, майонезом і приправами.";
"Запекайте при 190 °C около 30 минут, добавив сыр в конце. Проверьте минимум 63 °C внутри мяса и выдержите 3 минуты; гречку сварите отдельно." = "Запікайте за 190 °C близько 30 хвилин, додавши сир наприкінці. Перевірте щонайменше 63 °C усередині м’яса й витримайте 3 хвилини; гречку зваріть окремо.";
"Свиная вырезка · Лук · Сыр" = "Свиняча вирізка · Цибуля · Твердий сир";
"Смешайте творог, йогурт и яйцо. Натрите яблоко, мелко нарежьте чернослив и добавьте вместе с корицей." = "Змішайте сир, йогурт і яйце. Натріть яблуко, дрібно наріжте чорнослив і додайте разом із корицею.";
"Переложите в небольшую форму с пергаментом. Запекайте при 180 °C 30–35 минут до 74 °C в центре; подождите 10 минут перед делением на порции." = "Перекладіть у невелику форму з пергаментом. Запікайте за 180 °C 30–35 хвилин до 74 °C у центрі; зачекайте 10 хвилин перед поділом на порції.";
"Творог · Йогурт натуральный · Яйцо" = "Кисломолочний сир · Натуральний йогурт · Яйце";
"Вскипятите воду с промытым рисом, нарезанными морковью, луком и лавровым листом. Варите 15 минут." = "Закип’ятіть воду з промитим рисом, нарізаними морквою, цибулею й лавровим листом. Варіть 15 хвилин.";
"Добавьте томат и кусочки рыбы без костей. Доварите до мягкости риса и 63 °C в рыбе, затем уберите лавр и приправьте." = "Додайте томат і шматочки риби без кісток. Доваріть до м’якості рису та 63 °C у рибі, потім приберіть лавр і приправте.";
"Минтай · Пропаренный рис · Лук" = "Минтай · Пропарений рис · Цибуля";
"Сварите гречку в воде по упаковке. Капусту нашинкуйте тонко, морковь натрите, лук и укроп порубите." = "Зваріть гречку у воді за пакованням. Капусту нашаткуйте тонко, моркву натріть, цибулю та кріп посічіть.";
"Разомните капусту с отмеренной солью, перемешайте с остальными овощами и лимонным соком. Разложите рядом с гречкой, без масляной заправки." = "Розімніть капусту з відміряною сіллю, перемішайте з рештою овочів і лимонним соком. Викладіть поруч із гречкою, без олійної заправки.";
"Капуста · Морковь · Зелёный лук" = "Капуста · Морква · Зелена цибуля";
"Промойте колотый горох. Залейте указанной водой и варите под приоткрытой крышкой до мягкости, снимая пену и при необходимости доливая воду." = "Промийте колотий горох. Залийте зазначеною водою й варіть під прочиненою кришкою до м’якості, знімаючи піну та за потреби доливаючи воду.";
"Лук мелко нарежьте и размягчите на отмеренном масле. Соедините с горохом, добавьте соль и перец; для густоты часть гороха разомните." = "Цибулю дрібно наріжте й розм’якшіть на відміряній олії. З’єднайте з горохом, додайте сіль і перець; для густоти частину гороху розімніть.";
"Гороховая крупа · Лук · Растительное масло" = "Колотий горох · Цибуля · Рослинна олія";
"Промойте рис и сварите в отмеренной воде до мягкости по упаковке; при необходимости продлите варку и долейте горячую воду." = "Промийте рис і зваріть у відміряній воді до м’якості за пакованням; за потреби подовжте варіння й долийте гарячу воду.";
"Яблоко нарежьте, апельсин очистите и разделите на кусочки без косточек. Подавайте фрукты рядом с рисом, сохраняя указанные порции." = "Яблуко наріжте, апельсин почистьте й розділіть на шматочки без кісточок. Подавайте фрукти поруч із рисом, зберігаючи зазначені порції.";
"Бурый рис · Яблоко · Апельсин" = "Бурий рис · Яблуко · Апельсин";
"Приправьте говядину солью и перцем. Положите в небольшую форму, подлейте немного воды и плотно накройте." = "Приправте яловичину сіллю й перцем. Покладіть у невелику форму, підлийте трохи води та щільно накрийте.";
"Запекайте при 170 °C около 2 часов до мягкости, проверяя жидкость. Пшено промойте горячей водой, сварите отдельно; подайте с нарезанным мясом и его соком." = "Запікайте за 170 °C близько 2 годин до м’якості, перевіряючи рідину. Пшоно промийте гарячою водою, зваріть окремо; подайте з нарізаним м’ясом і його соком.";
"Говядина · Пшено" = "Яловичина · Пшоно";
"Удалите сердцевину яблока, очистите апельсин и киви. Нарежьте мякоть и чернослив кусочками для одной ложки." = "Видаліть серцевину яблука, почистьте апельсин і ківі. Наріжте м’якуш і чорнослив шматочками на одну ложку.";
"Разделите фрукты между порциями и полейте йогуртом. Подавайте сразу, чтобы киви не успел изменить вкус молочной заправки." = "Розділіть фрукти між порціями й полийте йогуртом. Подавайте відразу, щоб ківі не встиг змінити смак молочної заправки.";
"Яблоко · Апельсин · Киви" = "Яблуко · Апельсин · Ківі";
"Смешайте фарш с рисовой мукой, частью мелко нарезанного лука и приправами. Скатайте небольшие одинаковые фрикадельки." = "Змішайте фарш із рисовим борошном, частиною дрібно нарізаної цибулі та приправами. Скачайте невеликі однакові фрикадельки.";
"Вскипятите воду с рисом, томатами, оставшимся луком и лавровым листом. Через 10 минут опустите фрикадельки; варите до мягкости риса и 74 °C в центре фарша." = "Закип’ятіть воду з рисом, томатами, рештою цибулі й лавровим листом. Через 10 хвилин опустіть фрикадельки; варіть до м’якості рису та 74 °C у центрі фаршу.";
"Удалите лавровый лист. Размешайте суп и распределите фрикадельки поровну, посыпьте укропом." = "Видаліть лавровий лист. Розмішайте суп і розподіліть фрикадельки порівну, посипте кропом.";
"Мясной фарш · Томаты · Лук" = "М'ясний фарш · Помідори · Цибуля";
"Промокните вяленые томаты от лишнего масла и нарежьте мелко. Разотрите творог с йогуртом, яйцом, разрыхлителем и солью." = "Промокніть в’ялені томати від зайвої олії й наріжте дрібно. Розітріть сир із йогуртом, яйцем, розпушувачем і сіллю.";
"Вмешайте томаты и переложите в небольшую форму. Запекайте при 180 °C 25–30 минут до 74 °C в центре; немного остудите для ровной нарезки." = "Вмішайте томати й перекладіть у невелику форму. Запікайте за 180 °C 25–30 хвилин до 74 °C у центрі; трохи остудіть для рівного нарізання.";
"Мелко нарежьте говядину, лук и морковь. Мясо подрумяньте на отмеренном масле, добавьте овощи, паприку и кориандр." = "Дрібно наріжте яловичину, цибулю й моркву. М’ясо підрум’яньте на відміряній олії, додайте овочі, паприку й коріандр.";
"Подлейте немного воды и потушите до мягкости мяса. Разложите сверху промытый рис и чеснок, влейте отмеренную воду, посолите." = "Підлийте трохи води й потушкуйте до м’якості м’яса. Розкладіть зверху промитий рис і часник, влийте відміряну воду, посоліть.";
"Готовьте под крышкой на слабом огне около 20 минут до мягкости риса. При необходимости добавьте горячую воду; после выключения подождите 10 минут и перемешайте." = "Готуйте під кришкою на слабкому вогні близько 20 хвилин до м’якості рису. За потреби додайте гарячу воду; після вимкнення зачекайте 10 хвилин і перемішайте.";
"Говядина · Морковь · Лук" = "Яловичина · Морква · Цибуля";
"Снимите плёнки и нарежьте печень ломтиками толщиной около 1 см. Осторожно расплющите через плёнку, приправьте солью и перцем." = "Зніміть плівки й наріжте печінку скибками завтовшки близько 1 см. Обережно розплющте через плівку, приправте сіллю й перцем.";
"Готовьте на хорошо прогретой антипригарной сковороде без добавления масла по 3–4 минуты с каждой стороны. Проверьте не менее 71 °C в середине ломтика." = "Готуйте на добре прогрітій антипригарній сковороді без додавання олії по 3–4 хвилини з кожного боку. Перевірте щонайменше 71 °C у середині скибки.";
"Говяжья печень" = "Яловича печінка";
"Нарежьте свинину тонкими порционными пластами, слегка отбейте и приправьте. Лук нарежьте полукольцами, сыр натрите." = "Наріжте свинину тонкими порційними пластами, злегка відбийте й приправте. Цибулю наріжте півкільцями, сир натріть.";
"В форме накройте мясо луком, майонезом и сыром. Пеките при 190 °C 25–30 минут до 63 °C внутри свинины; дайте ей отдохнуть 3 минуты." = "У формі накрийте м’ясо цибулею, майонезом і сиром. Печіть за 190 °C 25–30 хвилин до 63 °C усередині свинини; дайте їй відпочити 3 хвилини.";
"Свиная вырезка · Лук · Майонез" = "Свиняча вирізка · Цибуля · Майонез";
"Яблоки без сердцевины нарежьте кубиками и запеките в закрытой форме при 180 °C около 15 минут до мягкости. Дайте остыть." = "Яблука без серцевини наріжте кубиками й запечіть у закритій формі за 180 °C близько 15 хвилин до м’якості. Дайте охолонути.";
"Мандарин очистите от кожуры и косточек. Разложите яблоки, мандарин и йогурт слоями; не добавляйте сахар или сироп." = "Мандарин очистіть від шкірки й кісточок. Викладіть яблука, мандарин і йогурт шарами; не додавайте цукор або сироп.";
"Яблоко · Мандарин · Йогурт натуральный" = "Яблуко · Мандарин · Натуральний йогурт";
"Нарежьте баклажан длинными тонкими пластами. Запеките на пергаменте при 200 °C 12–15 минут, чтобы пласты стали гибкими." = "Наріжте баклажан довгими тонкими пластами. Запечіть на пергаменті за 200 °C 12–15 хвилин, щоб пласти стали гнучкими.";
"Разотрите творог с тёртым сыром, чесноком и приправами. Заверните начинку в баклажан и прогрейте рулетики в духовке ещё 5–7 минут." = "Розітріть кисломолочний сир із натертим твердим сиром, часником і приправами. Загорніть начинку в баклажан і прогрійте рулетики в духовці ще 5–7 хвилин.";
"Баклажан · Сыр · Творог" = "Баклажан · Твердий сир · Кисломолочний сир";
"Уберите у рыбы внутренности и кости. Нарежьте лук полукольцами, лимон — тонкими ломтиками; смешайте йогурт с солью и перцем." = "Приберіть у риби нутрощі й кістки. Наріжте цибулю півкільцями, лимон — тонкими скибками; змішайте йогурт із сіллю й перцем.";
"Уложите рыбу на лук, смажьте йогуртом и добавьте лимон. Запекайте при 190 °C 25–30 минут до 63 °C в толстой части." = "Покладіть рибу на цибулю, змастіть йогуртом і додайте лимон. Запікайте за 190 °C 25–30 хвилин до 63 °C у товстій частині.";
"Скумбрия · Лук · Лимон" = "Скумбрія · Цибуля · Лимон";
"Отожмите апельсин, смешайте сок с соевым соусом, корицей и перцем. Покройте утку маринадом и выдержите 20 минут в холодильнике." = "Вичавіть апельсин, змішайте сік із соєвим соусом, корицею й перцем. Покрийте качку маринадом і витримайте 20 хвилин у холодильнику.";
"Переложите утку с маринадом в форму. Запекайте при 180 °C около 45–60 минут до 74 °C внутри, прикрывая верх при сильном подрумянивании." = "Перекладіть качку з маринадом у форму. Запікайте за 180 °C близько 45–60 хвилин до 74 °C усередині, прикриваючи верх при сильному підрум’яненні.";
"Утка · Апельсин · Корица" = "Качка · Апельсин · Кориця";
"Промойте гречку, залейте указанной водой и добавьте соль. Варите под крышкой на слабом огне около 15 минут." = "Промийте гречку, залийте зазначеною водою й додайте сіль. Варіть під кришкою на слабкому вогні близько 15 хвилин.";
"Подождите 5 минут без нагрева и разрыхлите крупу вилкой. Нарежьте томаты и разложите рядом; масло в этот вариант не добавляется." = "Зачекайте 5 хвилин без нагріву й розпушіть крупу виделкою. Наріжте томати та викладіть поруч; олія до цього варіанта не додається.";
"Гречка · Томаты" = "Гречка · Помідори";
"Удалите семена перцев. Смешайте фарш с уже сваренным рисом, тёртой морковью, мелким луком, солью и перцем." = "Видаліть насіння перців. Змішайте фарш із уже звареним рисом, тертою морквою, дрібною цибулею, сіллю й перцем.";
"Наполните перцы без уплотнения и поставьте в тесную кастрюлю. Влейте томатный сок и воду; тушите под крышкой 35–45 минут до 74 °C в начинке." = "Наповніть перці без ущільнення й поставте в тісну каструлю. Влийте томатний сік і воду; тушкуйте під кришкою 35–45 хвилин до 74 °C у начинці.";
"Перец сладкий · Мясной фарш · Рис варёный" = "Солодкий перець · М'ясний фарш · Відварений рис";
"Разотрите творог с рубленой зеленью и отмеренной солью. Сыр натрите или нарежьте очень тонко." = "Розітріть кисломолочний сир із посіченою зеленню й відміряною сіллю. Твердий сир натріть або наріжте дуже тонко.";
"Распределите творог по криспам, добавьте сыр. Прогрейте 3–4 минуты при 180 °C до плавления верхнего слоя и сразу подавайте." = "Розподіліть кисломолочний сир по хлібцях, додайте твердий сир. Прогрійте 3–4 хвилини за 180 °C до плавлення верхнього шару й відразу подавайте.";
"Ржаные криспы · Сыр · Творог" = "Житні кріспи · Твердий сир · Кисломолочний сир";
"Проверьте рыбу на кости, нарежьте небольшими плоскими кусочками и обсушите. Смешайте яйцо, рисовую муку, соль и перец." = "Перевірте рибу на кістки, наріжте невеликими пласкими шматочками й обсушіть. Змішайте яйце, рисове борошно, сіль і перець.";
"Распределите отмеренное масло по антипригарной сковороде. Обмакните рыбу в кляр и готовьте примерно по 3–4 минуты с каждой стороны до 63 °C внутри." = "Розподіліть відміряну олію по антипригарній сковороді. Занурте рибу в кляр і готуйте приблизно по 3–4 хвилини з кожного боку до 63 °C усередині.";
"Минтай · Яйцо · Рисовая мука" = "Минтай · Яйце · Рисове борошно";
"Из рыбы удалите кости, измельчите с луком. Вмешайте яйцо, соль и перец; дайте массе постоять 5 минут." = "Із риби видаліть кістки, подрібніть із цибулею. Вмішайте яйце, сіль і перець; дайте масі постояти 5 хвилин.";
"Разложите небольшими плоскими котлетами на пергаменте. Запекайте при 190 °C 15–20 минут до 74 °C в центре яично-рыбной массы." = "Викладіть невеликі пласкі котлети на пергамент. Запікайте за 190 °C 15–20 хвилин до 74 °C у центрі яєчно-рибної маси.";
"Минтай · Лук · Яйцо" = "Минтай · Цибуля · Яйце";
"Мелко нарежьте капусту, лук и перец, натрите морковь. Тушите овощи в томатном соке под крышкой 20–25 минут, добавив паприку." = "Дрібно наріжте капусту, цибулю й перець, натріть моркву. Тушкуйте овочі в томатному соку під кришкою 20–25 хвилин, додавши паприку.";
"Параллельно сварите гречку в воде. Когда овощи станут мягкими, приправьте и смешайте с готовой крупой либо разложите рядом." = "Паралельно зваріть гречку у воді. Коли овочі стануть м’якими, приправте й змішайте з готовою крупою або викладіть поруч.";
"Капуста · Перец сладкий · Морковь" = "Капуста · Солодкий перець · Морква";
"В фарш вмешайте часть измельчённого лука, рисовую муку, соль и перец. Сделайте маленькие фрикадельки." = "У фарш вмішайте частину подрібненої цибулі, рисове борошно, сіль і перець. Зробіть маленькі фрикадельки.";
"В кипящую воду добавьте промытую гречку, морковь, оставшийся лук и лавровый лист. Через 10 минут положите фрикадельки и варите до 74 °C в их центре." = "У киплячу воду додайте промиту гречку, моркву, решту цибулі й лавровий лист. Через 10 хвилин покладіть фрикадельки та варіть до 74 °C у їхньому центрі.";
"Проверьте мягкость гречки, удалите лавр. Перемешайте суп перед делением, чтобы крупа и мясо попали в каждую порцию." = "Перевірте м’якість гречки, видаліть лавр. Перемішайте суп перед поділом, щоб крупа й м’ясо потрапили в кожну порцію.";
"Мясной фарш · Гречка · Лук" = "М'ясний фарш · Гречка · Цибуля";
"Переберите и промойте крупу. Соедините с указанной водой и солью, доведите до кипения." = "Переберіть і промийте крупу. З’єднайте із зазначеною водою та сіллю, доведіть до кипіння.";
"Варите под крышкой на слабом огне 12–15 минут до впитывания воды и мягкости. Снимите с плиты, дайте постоять 5 минут и разрыхлите вилкой." = "Варіть під кришкою на слабкому вогні 12–15 хвилин до вбирання води й м’якості. Зніміть із плити, дайте постояти 5 хвилин і розпушіть виделкою.";
"Гречка" = "Гречка";
"Удалите сердцевину яблок, нарежьте мякоть. Прогрейте с отмеренной водой под крышкой 10–15 минут до мягкости, затем разомните." = "Видаліть серцевину яблук, наріжте м’якуш. Прогрійте з відміряною водою під кришкою 10–15 хвилин до м’якості, потім розімніть.";
"Дайте яблочному пюре остыть до тёплого. Разложите вместе с творогом слоями или перемешайте непосредственно перед подачей." = "Дайте яблучному пюре охолонути до теплого. Викладіть разом із сиром шарами або перемішайте безпосередньо перед подаванням.";
"Творог · Яблоко" = "Кисломолочний сир · Яблуко";
"Прогрейте антипригарную сковороду на умеренном огне. Аккуратно распределите яйца и посолите отмеренной солью." = "Прогрійте антипригарну сковороду на помірному вогні. Обережно розподіліть яйця й посоліть відміряною сіллю.";
"Накройте крышкой и убавьте нагрев. Готовьте без масла до полностью плотных белков и желтков, обычно 5–7 минут." = "Накрийте кришкою й зменште нагрів. Готуйте без олії до повністю щільних білків і жовтків, зазвичай 5–7 хвилин.";
"Яйцо" = "Яйце";
"Промойте чечевицу, уберите посторонние частицы. Залейте указанной водой и доведите до слабого кипения." = "Промийте сочевицю, приберіть сторонні частинки. Залийте зазначеною водою й доведіть до слабкого кипіння.";
"Варите до мягкости по времени на упаковке, обычно 15–25 минут. При необходимости доливайте воду; посолите в конце и слейте только избыток жидкости." = "Варіть до м’якості за часом на пакованні, зазвичай 15–25 хвилин. За потреби доливайте воду; посоліть наприкінці й злийте лише надлишок рідини.";
"Чечевица" = "Сочевиця";
"Салат с моцареллой и кремом из авокадо" = "Салат із моцарелою та кремом з авокадо";
"Обсушите вымытые листья салата и черри. Нарежьте томаты и моцареллу, мякоть авокадо разомните с лимонным соком." = "Обсушіть вимиті листя салату й чері. Наріжте томати та моцарелу, м’якуш авокадо розімніть із лимонним соком.";
"Взбейте авокадо с отмеренными маслом, водой, чесноком и приправами. Соедините с листьями, томатами и сыром перед подачей." = "Збийте авокадо з відміряними олією, водою, часником і приправами. З’єднайте з листям, томатами й сиром перед подаванням.";
"Листья салата · Томаты черри · Моцарелла" = "Листя салату · Помідори чері · Моцарела";
"Вымойте редис и огурец, срежьте кончики. Нарежьте тонкими полукружьями, зелёный лук мелко порубите." = "Вимийте редис і огірок, зріжте кінчики. Наріжте тонкими півкружальцями, зелену цибулю дрібно посічіть.";
"Смешайте йогурт, сметану, соль и перец. Заправьте овощи перед едой, чтобы они оставались хрустящими." = "Змішайте йогурт, сметану, сіль і перець. Заправте овочі перед їжею, щоб вони залишалися хрумкими.";
"Редис · Огурец · Зелёный лук" = "Редиска · Огірок · Зелена цибуля";
"Вымойте огурцы, нарежьте вдоль на четвертинки. Положите в пищевой пакет или закрывающийся контейнер с чесноком, петрушкой и отмеренной солью." = "Вимийте огірки, наріжте вздовж на четвертинки. Покладіть у харчовий пакет або контейнер із кришкою з часником, петрушкою й відміряною сіллю.";
"Перемешайте встряхиванием и уберите в холодильник минимум на 2 часа, перевернув один раз. Это быстрая закуска, не заготовка для хранения без охлаждения." = "Перемішайте струшуванням і поставте в холодильник щонайменше на 2 години, перевернувши один раз. Це швидка закуска, а не заготівля для зберігання без охолодження.";
"Огурец · Петрушка · Чеснок" = "Огірок · Петрушка · Часник";
"Тонко нашинкуйте пекинскую капусту, морковь натрите длинной соломкой. Нарежьте зелёный лук, имбирь натрите мелко." = "Тонко нашаткуйте пекінську капусту, моркву натріть довгою соломкою. Наріжте зелену цибулю, імбир натріть дрібно.";
"Соедините соевый соус, винный уксус, кунжутное масло и имбирь. Полейте овощи, перемешайте и подавайте сразу." = "З’єднайте соєвий соус, винний оцет, кунжутну олію та імбир. Полийте овочі, перемішайте й подавайте відразу.";
"Пекинская капуста · Морковь · Зелёный лук" = "Пекінська капуста · Морква · Зелена цибуля";
"Нарежьте авокадо и томаты крупными кусочками. Авокадо сразу сбрызните отмеренным лимонным соком." = "Наріжте авокадо й томати великими шматочками. Авокадо відразу збризніть відміряним лимонним соком.";
"Растолките чеснок, смешайте с маслом, соевым соусом и приправами. Осторожно перемешайте с овощами, сохраняя форму авокадо." = "Розітріть часник, змішайте з олією, соєвим соусом і приправами. Обережно перемішайте з овочами, зберігаючи форму авокадо.";
"Авокадо · Томаты · Чеснок" = "Авокадо · Помідори · Часник";
"Нарежьте баклажан, кабачок и перец крупными кусочками, лук — дольками; мелкие грибы оставьте целыми. Перемешайте с чесноком, маслом, соевым соусом и лимонным соком." = "Наріжте баклажан, кабачок і перець великими шматочками, цибулю — часточками; дрібні гриби залиште цілими. Перемішайте з часником, олією, соєвим соусом і лимонним соком.";
"Разложите одним слоем на противне. Запекайте при 200 °C 30–35 минут, один раз перевернув, до мягкости баклажана и румяных краёв." = "Розкладіть одним шаром на деку. Запікайте за 200 °C 30–35 хвилин, один раз перевернувши, до м’якості баклажана й рум’яних країв.";
"Сладкий перец · Шампиньоны · Баклажан" = "Солодкий перець · Печериці · Баклажан";
"Нарежьте томаты дольками, фету раскрошите руками или вилкой. Укроп мелко порубите." = "Наріжте томати часточками, фету розкришіть руками або виделкою. Кріп дрібно посічіть.";
"Уложите на тарелки и распределите отмеренное масло. Добавьте укроп и перец; соль используйте с учётом солёности феты." = "Викладіть на тарілки й розподіліть відміряну олію. Додайте кріп і перець; сіль використовуйте з урахуванням солоності фети.";
"Томаты · Фета · Укроп" = "Помідори · Фета · Кріп";
"Обсушите листья салата, порвите на небольшие части. Нарежьте томаты, огурец и сладкий перец." = "Обсушіть листя салату, порвіть на невеликі частини. Наріжте томати, огірок і солодкий перець.";
"Размешайте горчицу с лимонным соком, маслом, солью и перцем до однородности. Полейте салат непосредственно перед подачей." = "Розмішайте гірчицю з лимонним соком, олією, сіллю й перцем до однорідності. Полийте салат безпосередньо перед подаванням.";
"Листья салата · Томаты · Огурец" = "Листя салату · Помідори · Огірок";
"Кабачок нарежьте маленькими кубиками, морковь натрите, лук измельчите. На отмеренном масле размягчите лук и морковь." = "Кабачок наріжте маленькими кубиками, моркву натріть, цибулю подрібніть. На відміряній олії розм’якшіть цибулю й моркву.";
"Добавьте кабачок, томатный сок и приправы. Тушите 30–40 минут, помешивая; разомните до желаемой текстуры. Остатки быстро охладите и храните в холодильнике." = "Додайте кабачок, томатний сік і приправи. Тушкуйте 30–40 хвилин, помішуючи; розімніть до бажаної текстури. Залишки швидко охолодіть і зберігайте в холодильнику.";
"Кабачок · Морковь · Лук" = "Кабачок · Морква · Цибуля";
"Свёклу очистите, нарежьте небольшими кубиками и отварите до мягкости. Слейте воду и полностью остудите." = "Буряк почистьте, наріжте невеликими кубиками й відваріть до м’якості. Злийте воду та повністю остудіть.";
"Нарежьте томаты и зелёный лук, соедините со свёклой. Добавьте отмеренное масло и соль; перемешайте перед подачей." = "Наріжте томати й зелену цибулю, з’єднайте з буряком. Додайте відміряну олію та сіль; перемішайте перед подаванням.";
"Томаты · Свёкла · Зелёный лук" = "Помідори · Буряк · Зелена цибуля";
"Тонко нарежьте капусту и слегка разомните с солью. Огурец нарежьте соломкой, укроп и зелёный лук порубите." = "Тонко наріжте капусту й злегка розімніть із сіллю. Огірок наріжте соломкою, кріп і зелену цибулю посічіть.";
"Смешайте лимонный сок с маслом и перцем. Соедините с овощами и подавайте без длительного настаивания." = "Змішайте лимонний сік з олією й перцем. З’єднайте з овочами та подавайте без тривалого настоювання.";
"Капуста · Огурец · Укроп" = "Капуста · Огірок · Кріп";
"Огуречно-томатный салат со сладким перцем" = "Огірково-томатний салат із солодким перцем";
"Нарежьте томаты, огурец и сладкий перец одинаковыми кубиками. Зелень обсушите и порубите." = "Наріжте томати, огірок і солодкий перець однаковими кубиками. Зелень обсушіть і посічіть.";
"Перемешайте овощи с зеленью, отмеренным оливковым маслом, солью и перцем. Разложите по порциям сразу после заправки." = "Перемішайте овочі із зеленню, відміряною оливковою олією, сіллю й перцем. Розкладіть порції відразу після заправляння.";
"Томаты · Огурец · Сладкий перец" = "Помідори · Огірок · Солодкий перець";
"Баклажаны проколите и запеките при 200 °C до мягкости, около 35–45 минут. Лук, морковь и перец мелко нарежьте." = "Баклажани проколіть і запечіть за 200 °C до м’якості, близько 35–45 хвилин. Цибулю, моркву й перець дрібно наріжте.";
"На отмеренном масле размягчите нарезанные овощи, добавьте томатный сок и приправы. Вмешайте мякоть запечённого баклажана, тушите ещё 10 минут и разомните." = "На відміряній олії розм’якшіть нарізані овочі, додайте томатний сік і приправи. Вмішайте м’якуш запеченого баклажана, тушкуйте ще 10 хвилин і розімніть.";
"Баклажан · Сладкий перец · Лук" = "Баклажан · Солодкий перець · Цибуля";
"Обсушите салат и рукколу. Черри разрежьте пополам, сливы — на дольки без косточек, сыр — небольшими кусочками." = "Обсушіть салат і руколу. Чері розріжте навпіл, сливи — на часточки без кісточок, сир — невеликими шматочками.";
"Смешайте горчицу, лимонный сок, кунжутное масло, соевый соус и приправы. Заправьте листья и фрукты, сыр разложите сверху." = "Змішайте гірчицю, лимонний сік, кунжутну олію, соєвий соус і приправи. Заправте листя й фрукти, сир викладіть зверху.";
"Листья салата · Руккола · Томаты черри" = "Листя салату · Рукола · Помідори чері";
"Нарежьте очищенную свёклу небольшими кусочками, отварите до мягкости и остудите. Подготовьте листья салата, черри, солёный огурец и лук." = "Наріжте почищений буряк невеликими шматочками, відваріть до м’якості й остудіть. Підготуйте листя салату, чері, солоний огірок і цибулю.";
"Взбейте ореховое масло с яблочным уксусом и чесноком. Смешайте овощи, полейте заправкой и добавьте раскрошенную фету." = "Збийте горіхову олію з яблучним оцтом і часником. Змішайте овочі, полийте заправкою й додайте розкришену фету.";
"Листья салата · Томаты черри · Солёные огурцы" = "Листя салату · Помідори чері · Солоні огірки";
"Мясо нарежьте небольшими кубиками, баклажан — чуть крупнее. Лук и чеснок измельчите; разогрейте отмеренное масло в толстостенной кастрюле." = "М’ясо наріжте невеликими кубиками, баклажан — трохи більшими. Цибулю й часник подрібніть; розігрійте відміряну олію в товстостінній каструлі.";
"Подрумяньте мясо, добавьте лук, чеснок, томаты, баклажан и сухие приправы. Накройте и томите около часа до мягкости мяса; при необходимости подливайте воду." = "Підрум’яньте м’ясо, додайте цибулю, часник, томати, баклажан і сухі приправи. Накрийте й томіть близько години до м’якості м’яса; за потреби підливайте воду.";
"Выньте лавровый лист и распределите рагу по порциям. Свежую зелень добавьте уже после выключения нагрева." = "Вийміть лавровий лист і розподіліть рагу між порціями. Свіжу зелень додайте вже після вимкнення нагріву.";
"Говядина · Свинина · Баклажан" = "Яловичина · Свинина · Баклажан";
"Натрите цукини и отожмите. Грибы и лук мелко порубите, смешайте с фаршем, яйцом, рисовой мукой и приправами." = "Натріть цукіні й відіжміть. Гриби та цибулю дрібно посічіть, змішайте з фаршем, яйцем, рисовим борошном і приправами.";
"Сформуйте небольшие котлеты, смажьте отмеренным маслом. Запекайте при 190 °C 25–30 минут до 74 °C внутри смешанного фарша." = "Сформуйте невеликі котлети, змастіть відміряною олією. Запікайте за 190 °C 25–30 хвилин до 74 °C усередині змішаного фаршу.";
"Мясной фарш · Цукини · Шампиньоны" = "М'ясний фарш · Цукіні · Печериці";
"Удалите у печени прожилки, нарежьте небольшими кусочками. Лук нарежьте полукольцами, яблоко без сердцевины — дольками." = "Видаліть у печінки прожилки, наріжте невеликими шматочками. Цибулю наріжте півкільцями, яблуко без серцевини — часточками.";
"Размягчите лук на отмеренном масле, добавьте печень и яблоки. Готовьте на умеренном огне, перемешивая, до 74 °C в толстой части печени; приправьте." = "Розм’якшіть цибулю на відміряній олії, додайте печінку й яблука. Готуйте на помірному вогні, перемішуючи, до 74 °C у товстій частині печінки; приправте.";
"Печень индейки · Лук · Яблоко" = "Печінка індички · Цибуля · Яблуко";
"Обсушите вымытые листья, нарежьте томаты. Мелко порубите чеснок и смешайте с отмеренными солью и перцем." = "Обсушіть вимите листя, наріжте томати. Дрібно посічіть часник і змішайте з відміряними сіллю та перцем.";
"Уложите овощи на тарелки, добавьте творог отдельными ложками. Приправьте чесночной смесью и подавайте без дополнительной заправки." = "Викладіть овочі на тарілки, додайте сир окремими ложками. Приправте часниковою сумішшю й подавайте без додаткової заправки.";
"Томаты · Листья салата · Творог" = "Помідори · Листя салату · Кисломолочний сир";
"Нарежьте тыкву, морковь, лук и чеснок. Положите в бульон с промытым рисом и варите 15 минут; при необходимости долейте воду." = "Наріжте гарбуз, моркву, цибулю й часник. Покладіть у бульйон із промитим рисом і варіть 15 хвилин; за потреби долийте воду.";
"Добавьте брокколи и фасоль, доварите до мягкости всех овощей. Снимите с огня, аккуратно измельчите; вмешайте сыр и приправы, посыпьте зеленью." = "Додайте броколі й квасолю, доваріть до м’якості всіх овочів. Зніміть з вогню, обережно подрібніть; вмішайте сир і приправи, посипте зеленню.";
"Мясной бульон · Пропаренный рис · Тыква" = "М’ясний бульйон · Пропарений рис · Гарбуз";
"Взбейте яйца с молоком, мелким укропом и солью. Прогрейте антипригарную сковороду на умеренном огне." = "Збийте яйця з молоком, дрібним кропом і сіллю. Прогрійте антипригарну сковороду на помірному вогні.";
"Наливайте смесь тонким слоем и готовьте без масла с обеих сторон до полной плотности. Складывайте блинчики стопкой и разделите на порции." = "Наливайте суміш тонким шаром і готуйте без олії з обох боків до повної щільності. Складайте млинці стосом і розділіть на порції.";
"Яйцо · Молоко · Укроп" = "Яйце · Молоко · Кріп";
"Натрите картофель, цукини и лук, тщательно отожмите жидкость. Вмешайте яйцо, тёртый сыр, рубленый укроп, соль и перец." = "Натріть картоплю, цукіні й цибулю, ретельно відіжміть рідину. Вмішайте яйце, натертий сир, посічений кріп, сіль і перець.";
"Выложите тонкие оладьи на пергамент. Запекайте при 200 °C 25–30 минут до мягкости картофеля и 74 °C в центре, перевернув после схватывания." = "Викладіть тонкі оладки на пергамент. Запікайте за 200 °C 25–30 хвилин до м’якості картоплі й 74 °C у центрі, перевернувши після схоплення.";
"Йогурт перемешайте с майонезом и измельчённым чесноком. Подайте отмеренный соус отдельно." = "Йогурт перемішайте з майонезом і подрібненим часником. Подайте відміряний соус окремо.";
"Цукини · Картофель · Лук" = "Цукіні · Картопля · Цибуля";
"Натрите и отожмите цукини, мелко нарежьте морковь, грибы, перец и лук. Протушите с ложкой воды до мягкости и остудите." = "Натріть і відіжміть цукіні, дрібно наріжте моркву, гриби, перець і цибулю. Протушкуйте з ложкою води до м’якості й остудіть.";
"Смешайте овощи с яйцами, рисовой мукой и сухими приправами. Разложите тонким прямоугольником на пергаменте, пеките при 180 °C 20–25 минут до 74 °C внутри." = "Змішайте овочі з яйцями, рисовим борошном і сухими приправами. Розподіліть тонким прямокутником на пергаменті, печіть за 180 °C 20–25 хвилин до 74 °C усередині.";
"Разотрите брынзу и сыр с йогуртом, майонезом, чесноком и зеленью. Смажьте тёплый овощной пласт, сверните с помощью бумаги и дайте уплотниться перед нарезкой." = "Розітріть бринзу й твердий сир з йогуртом, майонезом, часником і зеленню. Змастіть теплий овочевий пласт, згорніть за допомогою паперу й дайте ущільнитися перед нарізанням.";
"Цукини · Морковь · Шампиньоны" = "Цукіні · Морква · Печериці";
"Разотрите творог с тёртым сыром и ржаной мукой. Соберите плотное тесто, скатайте небольшие жгутики и нарежьте кусочками." = "Розітріть кисломолочний сир із натертим твердим сиром і житнім борошном. Зберіть щільне тісто, скачайте невеликі джгутики й наріжте шматочками.";
"Вскипятите воду с солью, варите вареники небольшими партиями 2–3 минуты после всплытия. Достаньте шумовкой и подайте с отмеренным йогуртом." = "Закип’ятіть воду із сіллю, варіть вареники невеликими партіями 2–3 хвилини після спливання. Дістаньте шумівкою й подайте з відміряним йогуртом.";
"Творог · Ржаная мука · Сыр" = "Кисломолочний сир · Житнє борошно · Твердий сир";
"Смешайте горчицу, вино, паприку, соль и перец. Покройте окорочок и положите в форму с небольшим количеством отмеренной воды." = "Змішайте гірчицю, вино, паприку, сіль і перець. Покрийте стегенце й покладіть у форму з невеликою кількістю відміряної води.";
"Запекайте при 190 °C 45–55 минут до 74 °C в самой толстой части, не касаясь кости термометром. Гречку сварите на оставшейся воде." = "Запікайте за 190 °C 45–55 хвилин до 74 °C у найтовстішій частині, не торкаючись кістки термометром. Гречку зваріть на решті води.";
"Удалите кости, распределите съедобное мясо и гречку по порциям. Добавьте нарезанный свежий томат." = "Видаліть кістки, розподіліть їстівне м’ясо й гречку між порціями. Додайте нарізаний свіжий томат.";
"Куриный окорочок · Горчица · Белое сухое вино" = "Курячий окорок · Гірчиця · Біле сухе вино";
"Очистите подготовленные ножки, говядину и индейку от мелких осколков костей. Залейте холодной водой, доведите до кипения и снимите пену." = "Очистіть підготовлені ніжки, яловичину й індичку від дрібних уламків кісток. Залийте холодною водою, доведіть до кипіння та зніміть піну.";
"Варите при очень слабом кипении 4–5 часов до отделения мяса от костей. Лук, морковь, соль и пряности добавьте на последний час." = "Варіть за дуже слабкого кипіння 4–5 годин до відділення м’яса від кісток. Цибулю, моркву, сіль і прянощі додайте на останню годину.";
"Выньте мясо, тщательно удалите все кости и разложите мякоть в неглубокие контейнеры. Процедите бульон, снимите избыток жира и залейте мясо." = "Вийміть м’ясо, ретельно видаліть усі кістки й розкладіть м’якуш у неглибокі контейнери. Процідіть бульйон, зніміть надлишок жиру й залийте м’ясо.";
"Начните охлаждение сразу, при необходимости в ледяной бане. Уберите в холодильник в пределах 2 часов, а при температуре помещения выше 32 °C — часа. Охлаждайте до полного застывания." = "Почніть охолодження відразу, за потреби в крижаній бані. Поставте в холодильник у межах 2 годин, а за температури приміщення вище 32 °C — години. Охолоджуйте до повного застигання.";
"Свиные ножки · Говядина на кости · Голень индейки" = "Свинячі ніжки · Яловичина на кістці · Гомілка індички";
"Яблоко очистите от сердцевины, у слив удалите косточки. Нарежьте фрукты небольшими ломтиками." = "Яблуко очистіть від серцевини, зі слив видаліть кісточки. Наріжте фрукти невеликими скибками.";
"Творог разомните только слегка, сохраняя зёрна. Распределите вместе с фруктами между порциями и подавайте без дополнительной заправки." = "Сир розімніть лише злегка, зберігаючи зерна. Розподіліть разом із фруктами між порціями й подавайте без додаткової заправки.";
"Творог · Яблоко · Сливы" = "Кисломолочний сир · Яблуко · Сливи";
"Разотрите творог с йогуртом, ржаной мукой, солью и приправами. Сформуйте плоские овальные лепёшки с невысокими бортиками на пергаменте." = "Розітріть сир із йогуртом, житнім борошном, сіллю й приправами. Сформуйте пласкі овальні коржики з невисокими бортиками на пергаменті.";
"В углубления распределите тёртый сыр. Пеките при 190 °C 20–25 минут до устойчивой формы и румяного верха; добавьте зелень после духовки." = "У заглиблення розподіліть натертий сир. Печіть за 190 °C 20–25 хвилин до стійкої форми та рум’яного верху; додайте зелень після духовки.";
"Нарежьте баклажан длинными пластами, запеките при 200 °C 12–15 минут до гибкости. Филе измельчите в фарш, сливы без косточек нарежьте мелко." = "Наріжте баклажан довгими пластами, запечіть за 200 °C 12–15 хвилин до гнучкості. Філе подрібніть на фарш, сливи без кісточок наріжте дрібно.";
"Смешайте курицу с творожным сыром, сливами, чесноком и солью. Заверните в баклажан, уложите швом вниз, покройте йогуртом и тёртым сыром." = "Змішайте курку з вершковим сиром, сливами, часником і сіллю. Загорніть у баклажан, покладіть швом донизу, покрийте йогуртом і натертим сиром.";
"Запекайте при 190 °C 20–25 минут, проверив 74 °C в центре куриной начинки. При необходимости готовьте дольше; время зависит от толщины рулетиков." = "Запікайте за 190 °C 20–25 хвилин, перевіривши 74 °C у центрі курячої начинки. За потреби готуйте довше; час залежить від товщини рулетиків.";
"Баклажан · Куриное филе · Сливы" = "Баклажан · Куряче філе · Сливи";
"Очищенную свёклу натрите, лук и перец нарежьте мелко. Сложите в сотейник с отмеренной водой, лавровым листом и приправами." = "Почищений буряк натріть, цибулю й перець наріжте дрібно. Складіть у сотейник із відміряною водою, лавровим листом і приправами.";
"Тушите под крышкой 25–35 минут до мягкости, помешивая и подливая воду при необходимости. Уберите лавр, вмешайте чеснок и подайте с рисовыми хлебцами." = "Тушкуйте під кришкою 25–35 хвилин до м’якості, помішуючи й підливаючи воду за потреби. Приберіть лавр, вмішайте часник і подайте з рисовими хлібцями.";
"Свёкла · Лук · Сладкий перец" = "Буряк · Цибуля · Солодкий перець";
"Свинину нарежьте порционно и слегка отбейте. Тыкву нарежьте тонкими пластами, лук — полукольцами; смешайте йогурт с чесноком и приправами." = "Свинину наріжте порційно й злегка відбийте. Гарбуз наріжте тонкими пластами, цибулю — півкільцями; змішайте йогурт із часником і приправами.";
"Смажьте форму отмеренным маслом. Выложите мясо, тыкву и лук, покройте йогуртом; пеките при 190 °C около 30 минут, добавив сыр в конце." = "Змастіть форму відміряною олією. Викладіть м’ясо, гарбуз і цибулю, покрийте йогуртом; печіть за 190 °C близько 30 хвилин, додавши сир наприкінці.";
"Убедитесь, что тыква мягкая, а свинина достигла минимум 63 °C. Дайте постоять 3 минуты перед подачей." = "Переконайтеся, що гарбуз м’який, а свинина досягла щонайменше 63 °C. Дайте постояти 3 хвилини перед подаванням.";
"Свиная вырезка · Тыква · Лук" = "Свиняча вирізка · Гарбуз · Цибуля";
"Разберите брокколи на небольшие соцветия и отварите 3–5 минут до желаемой мягкости. Слейте воду, быстро охладите и обсушите." = "Розберіть броколі на невеликі суцвіття й відваріть 3–5 хвилин до бажаної м’якості. Злийте воду, швидко охолодіть і обсушіть.";
"Смешайте йогурт с мелко нарезанными луком, укропом, петрушкой и приправами. Соедините с остывшей брокколи и разделите на порции." = "Змішайте йогурт із дрібно нарізаними цибулею, кропом, петрушкою та приправами. З’єднайте з охолодженою броколі й розділіть на порції.";
"Брокколи · Йогурт греческий · Зелёный лук" = "Броколі · Грецький йогурт · Зелена цибуля";
"Вымешайте фарш с яйцом, очень мелким луком, солью и перцем. Сформуйте маленькие фрикадельки одинакового размера." = "Вимішайте фарш із яйцем, дуже дрібною цибулею, сіллю й перцем. Сформуйте маленькі фрикадельки однакового розміру.";
"Вскипятите воду в небольшой кастрюле. Опустите фрикадельки и варите при слабом кипении 12–15 минут до 74 °C в центре; добавьте зелень в тарелки." = "Закип’ятіть воду в невеликій каструлі. Опустіть фрикадельки й варіть за слабкого кипіння 12–15 хвилин до 74 °C у центрі; додайте зелень в тарілки.";
"Мясной фарш · Яйцо · Лук" = "М'ясний фарш · Яйце · Цибуля";
