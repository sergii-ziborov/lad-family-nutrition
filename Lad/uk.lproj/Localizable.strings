/* Cooking steps rewritten in plain kitchen language, 24 November 2026 */
"Разбейте яйцо в чашку и взбейте вилкой. В миске разомните творог вилкой до однородной массы без комков, влейте яйцо и вмешайте муку. Оставьте тесто на 5 минут, чтобы мука набухла." = "Розбийте яйце в чашку й збийте виделкою. У мисці розімніть кисломолочний сир виделкою до однорідної маси без грудочок, влийте яйце та вмішайте борошно. Залиште тісто на 5 хвилин, щоб борошно набухло.";
"Мокрыми руками скатайте из теста шарики диаметром 4–5 см и расплющьте в лепёшки толщиной 1,5 см. Разогрейте антипригарную сковороду на среднем огне без масла, выложите сырники и накройте крышкой. Жарьте по 3–4 минуты с каждой стороны, пока сырники не зарумянятся, а в центре не будет 74 °C." = "Мокрими руками скачайте з тіста кульки діаметром 4–5 см і розплющте їх у коржики завтовшки 1,5 см. Розігрійте антипригарну сковороду на середньому вогні без олії, викладіть сирники й накрийте кришкою. Смажте по 3–4 хвилини з кожного боку, доки сирники не зарум'яняться, а в центрі не буде 74 °C.";
"Ягоды промойте в дуршлаге под холодной водой и обсушите на бумажном полотенце. Разложите горячие сырники по тарелкам и посыпьте ягодами." = "Ягоди промийте в друшляку під холодною водою та обсушіть на паперовому рушнику. Розкладіть гарячі сирники по тарілках і посипте ягодами.";
"Всыпьте овсяные хлопья в небольшую кастрюлю и залейте молоком. Поставьте на средний огонь и, помешивая, доведите до слабого кипения — это займёт 3–4 минуты." = "Всипте вівсяні пластівці в невелику каструлю й залийте молоком. Поставте на середній вогонь і, помішуючи, доведіть до слабкого кипіння — це займе 3–4 хвилини.";
"Убавьте огонь до слабого и варите 5–6 минут, постоянно помешивая, пока хлопья не станут мягкими, а каша не загустеет. Если каша стала густой, как тесто, влейте немного горячей воды и размешайте. Банан очистите, нарежьте кружками 0,5 см и выложите на кашу в тарелке." = "Зменште вогонь до слабкого й варіть 5–6 хвилин, постійно помішуючи, доки пластівці не стануть м'якими, а каша не загусне. Якщо каша стала густою, як тісто, влийте трохи гарячої води й розмішайте. Банан очистьте, наріжте кружальцями 0,5 см і викладіть на кашу в тарілці.";
"Томаты нарежьте кубиками 1 см. Выложите их в антипригарную сковороду, добавьте немного воды и прогрейте на среднем огне 3–4 минуты, пока томаты не размягчатся и не пустят сок." = "Помідори наріжте кубиками 1 см. Викладіть їх в антипригарну сковороду, додайте трохи води й прогрійте на середньому вогні 3–4 хвилини, доки помідори не розм'якнуть і не пустять сік.";
"Разбейте яйца прямо на томаты, накройте сковороду крышкой и готовьте на слабом огне 6–8 минут, пока белок и желток полностью не схватятся. Тем временем подсушите хлеб в тостере 2 минуты до золотистого цвета. Подайте яйца с томатами и тостом." = "Розбийте яйця просто на помідори, накрийте сковороду кришкою й готуйте на слабкому вогні 6–8 хвилин, доки білок і жовток повністю не схопляться. Тим часом підсушіть хліб у тостері 2 хвилини до золотистого кольору. Подайте яйця з помідорами й тостом.";
"Свежие ягоды переберите, промойте в дуршлаге под холодной водой и обсушите на бумажном полотенце. Замороженные ягоды разморозьте заранее в холодильнике и слейте выделившийся сок." = "Свіжі ягоди переберіть, промийте в друшляку під холодною водою та обсушіть на паперовому рушнику. Заморожені ягоди заздалегідь розморозьте в холодильнику й злийте сік, що виділився.";
"Грецкие орехи крупно порубите ножом на доске. Выложите йогурт в глубокую миску, сверху распределите ягоды и орехи." = "Волоські горіхи крупно порубайте ножем на дошці. Викладіть йогурт у глибоку миску, зверху розподіліть ягоди й горіхи.";
"Посыпьте корицей тонким слоем, растирая её между пальцами. Подавайте сразу, пока орехи хрустят." = "Посипте тонким шаром кориці, розтираючи її між пальцями. Подавайте одразу, поки горіхи хрумтять.";
"Налейте в маленькую кастрюлю кипяток из чайника, поставьте на средний огонь, осторожно опустите яйцо ложкой и варите 9–10 минут. Переложите яйцо в миску с холодной водой на 1–2 минуты и очистите. Пока яйцо варится, подсушите хлеб в тостере 2 минуты до золотистого цвета." = "Налийте в маленьку каструлю окріп із чайника, поставте на середній вогонь, обережно опустіть яйце ложкою й варіть 9–10 хвилин. Перекладіть яйце в миску з холодною водою на 1–2 хвилини та очистьте. Поки яйце вариться, підсушіть хліб у тостері 2 хвилини до золотистого кольору.";
"Разрежьте авокадо пополам, удалите косточку, выньте мякоть ложкой в миску и разомните вилкой с лимонным соком и солью. Шпинат промойте и обсушите бумажным полотенцем." = "Розріжте авокадо навпіл, вийміть кісточку, виберіть м'якоть ложкою в миску й розімніть виделкою з лимонним соком і сіллю. Шпинат промийте та обсушіть паперовим рушником.";
"Намажьте тёплый тост пастой из авокадо и выложите сверху листья шпината. Нарежьте яйцо кружками и разложите поверх шпината." = "Намастіть теплий тост пастою з авокадо й викладіть зверху листя шпинату. Наріжте яйце кружальцями та розкладіть поверх шпинату.";
"Всыпьте булгур в небольшую кастрюлю с толстым дном, залейте водой и молоком и размешайте. Поставьте на средний огонь и, помешивая, доведите до слабого кипения — около 3–4 минут." = "Всипте булгур у невелику каструлю з товстим дном, залийте водою й молоком і розмішайте. Поставте на середній вогонь і, помішуючи, доведіть до слабкого кипіння — приблизно 3–4 хвилини.";
"Убавьте огонь до слабого, накройте крышкой и варите 12–14 минут, помешивая каждые 3–4 минуты, чтобы молоко не пригорело. Каша готова, когда зёрна мягкие, а жидкость почти впиталась." = "Зменште вогонь до слабкого, накрийте кришкою й варіть 12–14 хвилин, помішуючи кожні 3–4 хвилини, щоб молоко не пригоріло. Каша готова, коли зерна м'які, а рідина майже вбралася.";
"Банан очистите и нарежьте кружками, грецкие орехи крупно порубите. Разложите кашу по тарелкам, сверху выложите банан и орехи и посыпьте корицей." = "Банан очистьте й наріжте кружальцями, волоські горіхи крупно порубайте. Розкладіть кашу по тарілках, зверху викладіть банан і горіхи та посипте корицею.";
"Включите духовку на 180 °C. Брокколи разберите на соцветия по 2–3 см, томаты нарежьте кубиками 1 см, шпинат промойте и крупно порвите руками. Разогрейте оливковое масло в сковороде на среднем огне, жарьте брокколи 3 минуты, затем добавьте томаты и шпинат и готовьте ещё 1–2 минуты, пока шпинат не опадёт." = "Увімкніть духовку на 180 °C. Броколі розберіть на суцвіття по 2–3 см, помідори наріжте кубиками 1 см, шпинат промийте й крупно порвіть руками. Розігрійте оливкову олію в сковороді на середньому вогні, смажте броколі 3 хвилини, потім додайте помідори й шпинат і готуйте ще 1–2 хвилини, доки шпинат не зів'яне.";
"В миске взбейте вилкой яйца с молоком и солью до однородности. Переложите овощи в небольшую жаропрочную форму, залейте яичной смесью и раскрошите сверху фету." = "У мисці збийте виделкою яйця з молоком і сіллю до однорідності. Перекладіть овочі в невелику жаростійку форму, залийте яєчною сумішшю й покришіть зверху фету.";
"Поставьте форму на средний уровень духовки и запекайте 13–15 минут. Фриттата готова, когда середина полностью схватилась и не дрожит, а нож, воткнутый в центр, выходит сухим." = "Поставте форму на середній рівень духовки й запікайте 13–15 хвилин. Фриттата готова, коли середина повністю схопилася й не тремтить, а ніж, встромлений у центр, виходить сухим.";
"Накануне залейте нут в миске холодной водой на 5 см выше и уберите в холодильник на ночь. Слейте воду, промойте нут, переложите в кастрюлю, залейте свежей водой и доведите до кипения на сильном огне. Варите на слабом огне под крышкой 60–70 минут, пока горошины не станут мягкими и не будут легко раздавливаться пальцами. Отлейте в чашку немного отвара, остальное слейте." = "Напередодні залийте нут у мисці холодною водою на 5 см вище й поставте в холодильник на ніч. Злийте воду, промийте нут, перекладіть у каструлю, залийте свіжою водою й доведіть до кипіння на сильному вогні. Варіть на слабкому вогні під кришкою 60–70 хвилин, доки горошини не стануть м'якими й не почнуть легко розчавлюватися пальцями. Відлийте в чашку трохи відвару, решту злийте.";
"Очистите чеснок. Сложите в блендер нут, оливковое масло, лимонный сок, чеснок и соль и измельчайте 2–3 минуты, понемногу подливая отвар, пока паста не станет гладкой и мягкой, как густая сметана." = "Очистьте часник. Складіть у блендер нут, оливкову олію, лимонний сік, часник і сіль та подрібнюйте 2–3 хвилини, потроху підливаючи відвар, доки паста не стане гладенькою й м'якою, як густа сметана.";
"Подсушите хлеб в тостере 2 минуты до хруста. Огурец нарежьте тонкими кружками, петрушку мелко порубите. Намажьте тосты нутовой пастой, сверху выложите огурец и посыпьте петрушкой." = "Підсушіть хліб у тостері 2 хвилини до хрусткості. Огірок наріжте тонкими кружальцями, петрушку дрібно порубайте. Намастіть тости нутовою пастою, зверху викладіть огірок і посипте петрушкою.";
"Измельчите овсяные хлопья в блендере 20–30 секунд до крупной муки. В миске взбейте вилкой яйцо с водой, всыпьте хлопья и перемешайте до однородного жидкого теста. Оставьте на 5 минут, чтобы хлопья набухли." = "Подрібніть вівсяні пластівці в блендері 20–30 секунд до крупного борошна. У мисці збийте виделкою яйце з водою, всипте пластівці й перемішайте до однорідного рідкого тіста. Залиште на 5 хвилин, щоб пластівці набухли.";
"Смажьте антипригарную сковороду диаметром 20 см оливковым маслом с помощью бумажного полотенца и разогрейте на среднем огне. Вылейте тесто, разровняйте и жарьте под крышкой 3–4 минуты, пока верх не схватится, а низ не подрумянится. Переверните лопаткой и жарьте ещё 2–3 минуты, пока блин не станет упругим." = "Змастіть антипригарну сковороду діаметром 20 см оливковою олією за допомогою паперового рушника й розігрійте на середньому вогні. Вилийте тісто, розрівняйте й смажте під кришкою 3–4 хвилини, доки верх не схопиться, а низ не підрум'яниться. Переверніть лопаткою й смажте ще 2–3 хвилини, доки млинець не стане пружним.";
"Томаты нарежьте тонкими ломтиками. Выложите блин на тарелку, на одну половину распределите творог и томаты и накройте второй половиной." = "Помідори наріжте тонкими скибочками. Викладіть млинець на тарілку, на одну половину розподіліть кисломолочний сир і помідори та накрийте другою половиною.";
"Промойте гречку в сите под краном, переложите в маленькую кастрюлю, залейте водой, посолите и доведите до кипения. Накройте крышкой и варите на слабом огне 15 минут, пока вода не впитается, а зёрна не станут мягкими. Одновременно во второй кастрюле вскипятите воду, опустите яйцо ложкой и варите 9–10 минут, затем остудите в холодной воде и очистите." = "Промийте гречку в ситі під краном, перекладіть у маленьку каструлю, залийте водою, посоліть і доведіть до кипіння. Накрийте кришкою й варіть на слабкому вогні 15 хвилин, доки вода не вбереться, а зерна не стануть м'якими. Водночас у другій каструлі закип'ятіть воду, опустіть яйце ложкою й варіть 9–10 хвилин, потім остудіть у холодній воді та очистьте.";
"Шампиньоны нарежьте ломтиками 0,5 см. Разогрейте оливковое масло в сковороде на среднем огне и жарьте грибы 4 минуты, помешивая, пока они не подрумянятся. Добавьте шпинат и прогревайте 1 минуту, пока листья не опадут." = "Печериці наріжте скибочками 0,5 см. Розігрійте оливкову олію в сковороді на середньому вогні й смажте гриби 4 хвилини, помішуючи, доки вони не підрум'яняться. Додайте шпинат і прогрівайте 1 хвилину, доки листя не зів'яне.";
"Выложите гречку в тарелку, рядом положите грибы со шпинатом и разрезанное пополам яйцо. Полейте всё йогуртом." = "Викладіть гречку в тарілку, поруч покладіть гриби зі шпинатом і розрізане навпіл яйце. Полийте все йогуртом.";
"В банке или контейнере с крышкой смешайте овсяные хлопья, йогурт, молоко и корицу. Хорошо размешайте ложкой, чтобы не осталось сухих хлопьев." = "У банці чи контейнері з кришкою змішайте вівсяні пластівці, йогурт, молоко й корицю. Добре розмішайте ложкою, щоб не лишилося сухих пластівців.";
"Плотно закройте крышкой и поставьте в холодильник на ночь. За это время хлопья впитают жидкость и станут мягкими." = "Щільно закрийте кришкою й поставте в холодильник на ніч. За цей час пластівці вберуть рідину й стануть м'якими.";
"Утром вымойте яблоко, удалите сердцевину и нарежьте кубиками 1 см. Выложите яблоко на кашу и посыпьте рублеными грецкими орехами." = "Уранці вимийте яблуко, видаліть серцевину й наріжте кубиками 1 см. Викладіть яблуко на кашу й посипте порубаними волоськими горіхами.";
"Включите духовку на 180 °C. В миске разомните творог вилкой, вмешайте яйцо, молоко, овсяные хлопья и корицу и оставьте на 5 минут, чтобы хлопья набухли. Тем временем вымойте яблоко, удалите сердцевину и нарежьте кубиками 1 см." = "Увімкніть духовку на 180 °C. У мисці розімніть кисломолочний сир виделкою, вмішайте яйце, молоко, вівсяні пластівці й корицю та залиште на 5 хвилин, щоб пластівці набухли. Тим часом вимийте яблуко, видаліть серцевину й наріжте кубиками 1 см.";
"Застелите небольшую форму пергаментом. Вмешайте яблоко в творожную массу, переложите в форму и разровняйте ложкой слоем 3–4 см." = "Застеліть невелику форму пергаментом. Вмішайте яблуко в сирну масу, перекладіть у форму й розрівняйте ложкою шаром 3–4 см.";
"Запекайте на среднем уровне 20–22 минуты, пока верх не зарумянится, а середина не перестанет дрожать при покачивании формы. Дайте постоять 3 минуты, чтобы запеканка стала плотнее." = "Запікайте на середньому рівні 20–22 хвилини, доки верх не зарум'яниться, а середина не перестане тремтіти, якщо похитати форму. Дайте постояти 3 хвилини, щоб запіканка стала щільнішою.";
"Подсушите хлеб в тостере или на сухой сковороде на среднем огне по 1–2 минуты с каждой стороны, до золотистого цвета. Огурец и укроп вымойте и обсушите бумажным полотенцем." = "Підсушіть хліб у тостері або на сухій сковороді на середньому вогні по 1–2 хвилини з кожного боку до золотистого кольору. Огірок і кріп вимийте та обсушіть паперовим рушником.";
"Укроп мелко порубите. В миске разомните творог вилкой с оливковым маслом и укропом до мягкой однородной пасты." = "Кріп дрібно порубайте. У мисці розімніть кисломолочний сир виделкою з оливковою олією й кропом до м'якої однорідної пасти.";
"Огурец нарежьте тонкими кружками. Намажьте тосты творожной пастой толстым слоем и выложите сверху огурец." = "Огірок наріжте тонкими кружальцями. Намастіть тости сирною пастою товстим шаром і викладіть зверху огірок.";
"Накануне вечером замочите нут в миске с холодной водой, налив её на 5 см выше горошин, и уберите в холодильник. Перед готовкой слейте воду, промойте нут, переложите в кастрюлю, залейте свежей водой и доведите до кипения. Варите под крышкой на слабом огне 55–65 минут, пока горошины не станут мягкими и легко раздавливаются пальцами, затем откиньте на сито." = "Напередодні ввечері замочіть нут у мисці з холодною водою, налийте її на 5 см вище горошин і поставте в холодильник. Перед готуванням злийте воду, промийте нут, перекладіть у каструлю, залийте свіжою водою й доведіть до кипіння. Варіть під кришкою на слабкому вогні 55–65 хвилин, доки горошини не стануть м'якими й не почнуть легко розчавлюватися пальцями, потім відкиньте на сито.";
"Томаты нарежьте кубиками 1 см. Разогрейте оливковое масло в сковороде на среднем огне и тушите томаты 4–5 минут, пока они не пустят сок. Добавьте нут и шпинат и прогревайте 2 минуты, помешивая, пока шпинат не опадёт." = "Помідори наріжте кубиками 1 см. Розігрійте оливкову олію в сковороді на середньому вогні й тушкуйте помідори 4–5 хвилин, доки вони не пустять сік. Додайте нут і шпинат і прогрівайте 2 хвилини, помішуючи, доки шпинат не зів'яне.";
"Сделайте ложкой углубление в центре сковороды и разбейте туда яйцо. Накройте крышкой и готовьте на слабом огне 6–8 минут, пока белок и желток полностью не схватятся. Пока яйцо готовится, подсушите хлеб в тостере 2 минуты и подайте вместе с нутом." = "Зробіть ложкою заглибину в центрі сковороди й розбийте туди яйце. Накрийте кришкою й готуйте на слабкому вогні 6–8 хвилин, доки білок і жовток повністю не схопляться. Поки яйце готується, підсушіть хліб у тостері 2 хвилини й подайте разом із нутом.";
"Заранее, за 2 часа до готовки, промойте красную чечевицу в сите под краном, пока стекающая струя не станет прозрачной. Замочите её в миске так, чтобы она была покрыта на 3 см, и уберите в холодильник. Перед готовкой откиньте чечевицу на сито и дайте стечь." = "Заздалегідь, за 2 години до готування, промийте червону сочевицю в ситі під краном, доки вода, що стікає, не стане прозорою. Замочіть її в мисці так, щоб вона була вкрита на 3 см, і поставте в холодильник. Перед готуванням відкиньте сочевицю на сито й дайте стекти.";
"Очистите чеснок. Сложите в блендер чечевицу, чеснок и свежую воду и измельчите 1–2 минуты до гладкого жидкого теста. Смажьте антипригарную сковороду оливковым маслом, разогрейте на среднем огне и выпекайте тонкие блинчики диаметром 12 см по 2–3 минуты с каждой стороны, пока края не зарумянятся, а внутри не останется сырой массы." = "Очистьте часник. Складіть у блендер сочевицю, часник і свіжу воду та подрібніть 1–2 хвилини до гладенького рідкого тіста. Змастіть антипригарну сковороду оливковою олією, розігрійте на середньому вогні й випікайте тонкі млинці діаметром 12 см по 2–3 хвилини з кожного боку, доки краї не зарум'яняться, а всередині не залишиться сирої маси.";
"Петрушку мелко порубите и вмешайте в йогурт. Огурец вымойте и нарежьте кружками. Подайте горячие блинчики с йогуртовым соусом и огурцом." = "Петрушку дрібно порубайте й вмішайте в йогурт. Огірок вимийте та наріжте кружальцями. Подайте гарячі млинці з йогуртовим соусом і огірком.";
"Включите духовку на 180 °C. Подсушите хлеб в тостере 1–2 минуты, чтобы основа потом не размокла. Выложите ломтики на противень с пергаментом и тонко смажьте сверху оливковым маслом." = "Увімкніть духовку на 180 °C. Підсушіть хліб у тостері 1–2 хвилини, щоб основа потім не розмокла. Викладіть скибки на деко з пергаментом і тонко змастіть зверху оливковою олією.";
"Томаты и моцареллу нарежьте ломтиками 0,5 см, яйцо взбейте вилкой в чашке. Ложкой слегка вдавите середину каждого ломтика хлеба, чтобы получилась ямка, и налейте туда яйцо. Сверху разложите томаты и моцареллу." = "Помідори й моцарелу наріжте скибочками 0,5 см, яйце збийте виделкою в чашці. Ложкою злегка втисніть середину кожної скибки хліба, щоб утворилася ямка, і налийте туди яйце. Зверху розкладіть помідори й моцарелу.";
"Запекайте на среднем уровне 10–12 минут, пока яйцо полностью не схватится, а моцарелла не расплавится и не начнёт румяниться по краям. Подавайте горячими." = "Запікайте на середньому рівні 10–12 хвилин, доки яйце повністю не схопиться, а моцарела не розплавиться й не почне рум'яніти по краях. Подавайте гарячими.";
"Промойте пшено в сите под горячей струёй из крана 1–2 минуты, перетирая зёрна пальцами, пока стекающая струя не станет прозрачной — так уйдёт горечь. Тыкву очистите от кожуры и семян и нарежьте кубиками 1 см." = "Промийте пшоно в ситі під гарячим струменем із крана 1–2 хвилини, перетираючи зерна пальцями, доки вода, що стікає, не стане прозорою, — так зникне гіркота. Гарбуз очистьте від шкірки й насіння та наріжте кубиками 1 см.";
"Сложите пшено и тыкву в кастрюлю, залейте водой и молоком и доведите до кипения на среднем огне, помешивая. Убавьте огонь до слабого, накройте крышкой и варите 18–20 минут, помешивая каждые 5 минут, пока пшено не разварится, а тыква не станет мягкой." = "Складіть пшоно й гарбуз у каструлю, залийте водою й молоком і доведіть до кипіння на середньому вогні, помішуючи. Зменште вогонь до слабкого, накрийте кришкою й варіть 18–20 хвилин, помішуючи кожні 5 хвилин, доки пшоно не розвариться, а гарбуз не стане м'яким.";
"Снимите кашу с огня и дайте постоять 2 минуты. Разложите по тарелкам, добавьте сверху йогурт и посыпьте рублеными грецкими орехами." = "Зніміть кашу з вогню й дайте постояти 2 хвилини. Розкладіть по тарілках, додайте зверху йогурт і посипте порубаними волоськими горіхами.";
"Разогрейте духовку до 180 °C. Выложите лосось кожей вниз на противень с пергаментом и запекайте 12–15 минут, пока мякоть не станет непрозрачной и не начнёт легко расслаиваться вилкой, а в самой толстой части не будет 63 °C. Снимите кожу и выньте кости." = "Розігрійте духовку до 180 °C. Викладіть лосось шкірою донизу на деко з пергаментом і запікайте 12–15 хвилин, доки м'якоть не стане непрозорою й не почне легко розшаровуватися виделкою, а в найтовщій частині не буде 63 °C. Зніміть шкіру й вийміть кістки.";
"Подсушите хлеб в тостере 2–3 минуты до хруста. Разрежьте авокадо, удалите косточку, выньте мякоть ложкой и разомните вилкой с лимонным соком." = "Підсушіть хліб у тостері 2–3 хвилини до хрусткості. Розріжте авокадо, вийміть кісточку, виберіть м'якоть ложкою й розімніть виделкою з лимонним соком.";
"Огурец вымойте и нарежьте тонкими кружками. Намажьте тосты авокадо, сверху разложите кусочки лосося, а огурец подайте рядом." = "Огірок вимийте й наріжте тонкими кружальцями. Намастіть тости авокадо, зверху розкладіть шматочки лосося, а огірок подайте поруч.";
"Куриное филе нарежьте кусочками и измельчите в блендере в фарш или мелко порубите ножом. Посыпьте фарш солью и чёрным перцем и перемешайте. Шампиньоны, лук и сельдерей нарежьте мелкими кубиками 0,5 см, сыр натрите на крупной тёрке." = "Куряче філе наріжте шматочками й подрібніть у блендері на фарш або дрібно порубайте ножем. Посипте фарш сіллю й чорним перцем і перемішайте. Печериці, цибулю й селеру наріжте дрібними кубиками 0,5 см, сир натріть на крупній тертці.";
"Включите духовку на 190 °C. Разогрейте растительное масло в сковороде на среднем огне и жарьте шампиньоны с луком и сельдереем 5–6 минут, помешивая, пока жидкость не испарится. Снимите с огня, дайте остыть 1 минуту и вмешайте майонез, сыр и любисток." = "Увімкніть духовку на 190 °C. Розігрійте олію в сковороді на середньому вогні й смажте печериці з цибулею та селерою 5–6 хвилин, помішуючи, доки рідина не випарується. Зніміть з вогню, дайте охолонути 1 хвилину й вмішайте майонез, сир і любисток.";
"Застелите противень пергаментом. Мокрыми руками разделите фарш на 4–6 частей, сформуйте из каждой лепёшку толщиной 1 см с бортиком по краю и выложите в центр грибную начинку. Запекайте на среднем уровне 22–25 минут, пока края не зарумянятся, а в центре мяса не будет 74 °C, затем посыпьте рубленой зеленью." = "Застеліть деко пергаментом. Мокрими руками розділіть фарш на 4–6 частин, сформуйте з кожної коржик завтовшки 1 см із бортиком по краю й викладіть у центр грибну начинку. Запікайте на середньому рівні 22–25 хвилин, доки краї не зарум'яняться, а в центрі м'яса не буде 74 °C, потім посипте порубаною зеленню.";
"Куриное филе нарежьте кубиками 2 см. Морковь и сельдерей нарежьте тонкими кружками 0,5 см, лук — мелкими кубиками." = "Куряче філе наріжте кубиками 2 см. Моркву й селеру наріжте тонкими кружальцями 0,5 см, цибулю — дрібними кубиками.";
"Налейте воду в кастрюлю, положите морковь, сельдерей, лук, лавровый лист, душистый и чёрный перец горошком и доведите до кипения на сильном огне. Опустите курицу, снимите пену шумовкой и варите под крышкой на слабом огне 15–20 минут, пока в самом толстом кусочке не будет 74 °C, а сок не станет прозрачным." = "Налийте воду в каструлю, покладіть моркву, селеру, цибулю, лавровий лист, духмяний і чорний перець горошком і доведіть до кипіння на сильному вогні. Опустіть курку, зніміть піну шумівкою й варіть під кришкою на слабкому вогні 15–20 хвилин, доки в найтовщому шматочку не буде 74 °C, а сік не стане прозорим.";
"Опустите рисовую лапшу в кипящий суп, посолите и варите 4–6 минут, пока лапша не станет мягкой. Выловите лавровый лист и горошины перца, посыпьте рубленой зеленью и сразу разлейте по тарелкам, пока лапша не разбухла." = "Опустіть рисову локшину в киплячий суп, посоліть і варіть 4–6 хвилин, доки локшина не стане м'якою. Виловіть лавровий лист і горошини перцю, посипте порубаною зеленню й одразу розлийте по тарілках, поки локшина не розбухла.";
"Морковь, лук, сладкий перец и сельдерей нарежьте одинаковыми кубиками 1 см. Бурый рис промойте в сите под краном, пока стекающая струя не станет почти прозрачной." = "Моркву, цибулю, солодкий перець і селеру наріжте однаковими кубиками 1 см. Бурий рис промийте в ситі під краном, доки вода, що стікає, не стане майже прозорою.";
"Налейте в кастрюлю с толстым дном немного воды слоем 0,5 см, выложите овощи и тушите под крышкой на среднем огне 5 минут, пока лук не станет мягким. Всыпьте рис и специи для плова, перемешайте и вдавите в центр целую головку чеснока, сняв с неё только верхнюю шелуху." = "Налийте в каструлю з товстим дном трохи води шаром 0,5 см, викладіть овочі й тушкуйте під кришкою на середньому вогні 5 хвилин, доки цибуля не стане м'якою. Всипте рис і спеції для плову, перемішайте й втисніть у центр цілу головку часнику, знявши з неї лише верхнє лушпиння.";
"Влейте оставшуюся воду, добавьте соль и доведите до кипения на сильном огне. Накройте плотной крышкой и томите на слабом огне 35 минут, не перемешивая, пока рис не станет мягким, а вода не впитается. Снимите с огня, дайте постоять под крышкой 5 минут, перемешайте и посыпьте рубленой зеленью." = "Влийте решту води, додайте сіль і доведіть до кипіння на сильному вогні. Накрийте щільною кришкою й томіть на слабкому вогні 35 хвилин, не перемішуючи, доки рис не стане м'яким, а вода не вбереться. Зніміть з вогню, дайте постояти під кришкою 5 хвилин, перемішайте й посипте порубаною зеленню.";
"Включите духовку на 190 °C. Цветную капусту, брокколи, сельдерей и лук измельчите в блендере импульсами по 2–3 секунды до кусочков 3–5 мм или очень мелко порубите ножом. Сыр натрите на мелкой тёрке, яйца взбейте вилкой в большой миске." = "Увімкніть духовку на 190 °C. Цвітну капусту, броколі, селеру й цибулю подрібніть у блендері імпульсами по 2–3 секунди до шматочків 3–5 мм або дуже дрібно порубайте ножем. Сир натріть на дрібній тертці, яйця збийте виделкою у великій мисці.";
"Добавьте к яйцам овощи, сыр, рисовую муку, аджику, соль и чёрный перец и хорошо перемешайте. Застелите противень пергаментом, выкладывайте массу ложкой и придавливайте в лепёшки толщиной 1,5 см." = "Додайте до яєць овочі, сир, рисове борошно, аджику, сіль і чорний перець і добре перемішайте. Застеліть деко пергаментом, викладайте масу ложкою й притискайте в коржики завтовшки 1,5 см.";
"Запекайте на среднем уровне 12 минут, пока низ не схватится и не подрумянится, затем осторожно переверните котлетки лопаткой. Пеките ещё 8–10 минут, пока овощи внутри не станут мягкими, а в центре не будет 74 °C." = "Запікайте на середньому рівні 12 хвилин, доки низ не схопиться й не підрум'яниться, потім обережно переверніть котлетки лопаткою. Печіть ще 8–10 хвилин, доки овочі всередині не стануть м'якими, а в центрі не буде 74 °C.";
"Включите духовку на 180 °C. Сыр натрите на мелкой тёрке, зелень мелко порубите. В миске разотрите творог с йогуртом вилкой 1–2 минуты до гладкости, затем вмешайте сыр, зелень, соль и специи." = "Увімкніть духовку на 180 °C. Твердий сир натріть на дрібній тертці, зелень дрібно порубайте. У мисці розітріть кисломолочний сир із йогуртом виделкою 1–2 хвилини до гладкості, потім вмішайте твердий сир, зелень, сіль і спеції.";
"Смешайте ржаную муку с разрыхлителем и вмешайте в творожную массу до мягкого липкого теста. Застелите противень пергаментом, выкладывайте тесто ложкой небольшими порциями и придавите мокрыми пальцами в кружки толщиной 0,5 см." = "Змішайте житнє борошно з розпушувачем і вмішайте в сирну масу до м'якого липкого тіста. Застеліть деко пергаментом, викладайте тісто ложкою невеликими порціями й притисніть мокрими пальцями в кружечки завтовшки 0,5 см.";
"Пеките на среднем уровне 16–18 минут, пока поверхность не станет сухой, а края не зарумянятся. Переложите печенье на решётку и остудите 2 минуты — так оно станет плотнее." = "Печіть на середньому рівні 16–18 хвилин, доки поверхня не стане сухою, а краї не зарум'яняться. Перекладіть печиво на решітку й остудіть 2 хвилини — так воно стане щільнішим.";
"Включите духовку на 190 °C и, пока она греется, за 5 минут подготовьте продукты. Проведите пальцами по филе минтая и выньте оставшиеся кости. Лук нарежьте тонкими полукольцами, томат — кружками 0,5 см, сыр натрите на крупной тёрке." = "Увімкніть духовку на 190 °C і, поки вона гріється, за 5 хвилин підготуйте продукти. Проведіть пальцями по філе минтаю й вийміть кістки, що залишилися. Цибулю наріжте тонкими півкільцями, помідор — кружальцями 0,5 см, сир натріть на крупній тертці.";
"Выложите филе в небольшую форму и посыпьте солью и чёрным перцем. Смажьте рыбу сметаной, посыпьте майораном, любистком и сушёным чесноком, затем выложите слоями лук, томат и сыр." = "Викладіть філе в невелику форму й посипте сіллю та чорним перцем. Змастіть рибу сметаною, посипте майораном, любистком і сушеним часником, потім викладіть шарами цибулю, помідор і сир.";
"Запекайте на среднем уровне 18–20 минут, пока сыр не расплавится и не зарумянится. Рыба готова, когда в самой толстой части 63 °C, а мякоть легко расслаивается вилкой." = "Запікайте на середньому рівні 18–20 хвилин, доки сир не розплавиться й не зарум'яниться. Риба готова, коли в найтовщій частині 63 °C, а м'якоть легко розшаровується виделкою.";
"Промойте гречку в сите под краном и переложите в кастрюлю. Залейте водой, слегка посолите и доведите до кипения на сильном огне. Накройте крышкой и варите на слабом огне 15–18 минут, пока вода не впитается, а зёрна не станут мягкими, затем оставьте под крышкой." = "Промийте гречку в ситі під краном і перекладіть у каструлю. Залийте водою, злегка посоліть і доведіть до кипіння на сильному вогні. Накрийте кришкою й варіть на слабкому вогні 15–18 хвилин, доки вода не вбереться, а зерна не стануть м'якими, потім залиште під кришкою.";
"Капусту тонко нашинкуйте, посыпьте солью и разминайте руками 1 минуту, пока она не станет мягче. Огурец нарежьте тонкими полукружьями, зелёный лук и укроп мелко порубите. Смешайте всё с капустой, полейте лимонным соком и подайте рядом с тёплой гречкой." = "Капусту тонко нашаткуйте, посипте сіллю й розминайте руками 1 хвилину, доки вона не стане м'якшою. Огірок наріжте тонкими півкружальцями, зелену цибулю й кріп дрібно порубайте. Змішайте все з капустою, полийте лимонним соком і подайте поруч із теплою гречкою.";
"Включите духовку на 190 °C. Цветную капусту, шампиньоны и лук измельчите в блендере импульсами по 2–3 секунды или очень мелко порубите ножом до кусочков 3–5 мм. В миске соедините овощи с фаршем, рисовой мукой, солью, чёрным перцем и кориандром и вымешивайте руками 2 минуты до однородности." = "Увімкніть духовку на 190 °C. Цвітну капусту, печериці й цибулю подрібніть у блендері імпульсами по 2–3 секунди або дуже дрібно порубайте ножем до шматочків 3–5 мм. У мисці з'єднайте овочі з фаршем, рисовим борошном, сіллю, чорним перцем і коріандром і вимішуйте руками 2 хвилини до однорідності.";
"Мокрыми руками сформуйте котлеты толщиной 2 см и выложите на противень с пергаментом. Запекайте на среднем уровне 25–30 минут, пока котлеты не зарумянятся, а в центре не будет 74 °C и выделяющийся сок не станет прозрачным." = "Мокрими руками сформуйте котлети завтовшки 2 см і викладіть на деко з пергаментом. Запікайте на середньому рівні 25–30 хвилин, доки котлети не зарум'яняться, а в центрі не буде 74 °C і сік, що виділяється, не стане прозорим.";
"Включите духовку на 190 °C. Цукини натрите на крупной тёрке, оставьте на 5 минут и крепко отожмите руками сок. Морковь и чеснок натрите на мелкой тёрке, лук мелко нарежьте; смешайте в миске с цукини, творогом, яйцом, солью и чёрным перцем." = "Увімкніть духовку на 190 °C. Цукіні натріть на крупній тертці, залиште на 5 хвилин і міцно відтисніть руками сік. Моркву й часник натріть на дрібній тертці, цибулю дрібно наріжте; змішайте в мисці з цукіні, кисломолочним сиром, яйцем, сіллю й чорним перцем.";
"Застелите противень пергаментом и выложите массу ложкой тонкими оладьями толщиной 1 см. Пеките на среднем уровне 18–20 минут, пока края не зарумянятся, а в середине не будет 74 °C. Оставьте оладьи на противне на 3 минуты, чтобы они схватились." = "Застеліть деко пергаментом і викладіть масу ложкою тонкими оладками завтовшки 1 см. Печіть на середньому рівні 18–20 хвилин, доки краї не зарум'яняться, а в середині не буде 74 °C. Залиште оладки на деку на 3 хвилини, щоб вони схопилися.";
"Укроп мелко порубите и смешайте с йогуртом и сушёным чесноком. Томат нарежьте дольками. Подайте горячие оладьи, а соус и томат — отдельно." = "Кріп дрібно порубайте й змішайте з йогуртом і сушеним часником. Помідор наріжте часточками. Подайте гарячі оладки, а соус і помідор — окремо.";
"Включите духовку на 190 °C и, пока она нагревается, за 5–6 минут подготовьте цукини. Нарежьте его кружками толщиной 3 см и ложкой выберите середину, оставив дно 1 см. Мякоть, лук и чеснок мелко порубите." = "Увімкніть духовку на 190 °C і, поки вона нагрівається, за 5–6 хвилин підготуйте цукіні. Наріжте його кружальцями завтовшки 3 см і ложкою виберіть середину, залишивши дно 1 см. М'якоть, цибулю й часник дрібно порубайте.";
"Смешайте рубленые овощи с фаршем, солью, чёрным перцем и кориандром. Смажьте форму растительным маслом, поставьте в неё кружки цукини, плотно заполните их фаршем горкой и посыпьте сыром, натёртым на крупной тёрке." = "Змішайте подрібнені овочі з фаршем, сіллю, чорним перцем і коріандром. Змастіть форму олією, поставте в неї кружальця цукіні, щільно заповніть їх фаршем гіркою й посипте сиром, натертим на крупній тертці.";
"Запекайте на среднем уровне 22–25 минут, пока сыр не зарумянится, а цукини не станут мягкими. Проверьте термометром центр начинки: там должно быть 74 °C." = "Запікайте на середньому рівні 22–25 хвилин, доки сир не зарум'яниться, а цукіні не стануть м'якими. Перевірте термометром центр начинки: там має бути 74 °C.";
"Нарежьте говядину поперёк волокон кубиками 2–3 см, а лук, мякоть сладкого перца и томаты — кубиками 1,5 см. Разогрейте растительное масло в толстостенной кастрюле на сильном огне и обжарьте мясо 5–6 минут, переворачивая, пока со всех сторон не появится румяная корочка." = "Наріжте яловичину впоперек волокон кубиками 2–3 см, а цибулю, м'якоть солодкого перцю й помідори — кубиками 1,5 см. Розігрійте олію в каструлі з товстими стінками на сильному вогні й обсмажте м'ясо 5–6 хвилин, перевертаючи, доки з усіх боків не з'явиться рум'яна скоринка.";
"Добавьте к мясу овощи и паприку и жарьте 2 минуты, помешивая. Влейте воду, чтобы она почти покрыла мясо, накройте крышкой и тушите на слабом огне 50–55 минут, пока говядина не станет мягкой. Тем временем промойте гречку, залейте в маленькой кастрюле водой на 1 см выше крупы, посолите и варите под крышкой на слабом огне 15–18 минут." = "Додайте до м'яса овочі й паприку та смажте 2 хвилини, помішуючи. Влийте воду, щоб вона майже вкрила м'ясо, накрийте кришкою й тушкуйте на слабкому вогні 50–55 хвилин, доки яловичина не стане м'якою. Тим часом промийте гречку, залийте в маленькій каструлі водою на 1 см вище крупи, посоліть і варіть під кришкою на слабкому вогні 15–18 хвилин.";
"Приправьте подливу солью и чёрным перцем, перемешайте и прогрейте 2 минуты. Разложите гречку по тарелкам, рядом выложите мясо с овощами и полейте подливой." = "Приправте підливу сіллю й чорним перцем, перемішайте й прогрійте 2 хвилини. Розкладіть гречку по тарілках, поруч викладіть м'ясо з овочами й полийте підливою.";
"Капусту тонко нашинкуйте. Свёклу и морковь очистите и натрите на крупной тёрке, затем так же натрите яблоко вместе с кожурой, обходя сердцевину. Чеснок и зелень мелко порубите." = "Капусту тонко нашаткуйте. Буряк і моркву очистьте й натріть на крупній тертці, потім так само натріть яблуко разом зі шкіркою, оминаючи серцевину. Часник і зелень дрібно порубайте.";
"Сложите всё в большую миску, добавьте лимонный сок и соль и перемешайте руками, слегка сжимая капусту. Оставьте на 5 минут, чтобы салат пустил сок, и перемешайте ещё раз перед подачей." = "Складіть усе у велику миску, додайте лимонний сік і сіль та перемішайте руками, злегка стискаючи капусту. Залиште на 5 хвилин, щоб салат пустив сік, і ще раз перемішайте перед подачею.";
"Включите духовку на 190 °C. Цветную капусту и лук очень мелко порубите ножом или измельчите в блендере короткими импульсами по 2–3 секунды. Сложите в миску с фаршем, яйцом, солью и специями и вымешивайте руками 2 минуты, пока масса не станет однородной и липкой." = "Увімкніть духовку на 190 °C. Цвітну капусту й цибулю дуже дрібно порубайте ножем або подрібніть у блендері короткими імпульсами по 2–3 секунди. Складіть у миску з фаршем, яйцем, сіллю й спеціями та вимішуйте руками 2 хвилини, доки маса не стане однорідною й липкою.";
"Мокрыми руками сформуйте плоские котлеты толщиной 1,5 см и разложите на противне с пергаментом. Запекайте на среднем уровне 20–22 минуты, пока котлеты не подрумянятся, а термометр в центре не покажет 74 °C." = "Мокрими руками сформуйте пласкі котлети завтовшки 1,5 см і розкладіть на деку з пергаментом. Запікайте на середньому рівні 20–22 хвилини, доки котлети не підрум'яняться, а термометр у центрі не покаже 74 °C.";
"Сделайте ножом на курином филе 3–4 неглубоких надреза. В миске смешайте кефир с майораном и солью, опустите курицу и переверните, чтобы маринад покрыл её со всех сторон. Накройте и уберите в холодильник на 40 минут, а за 10 минут до конца включите духовку на 190 °C." = "Зробіть ножем на курячому філе 3–4 неглибокі надрізи. У мисці змішайте кефір з майораном і сіллю, опустіть курку й переверніть, щоб маринад вкрив її з усіх боків. Накрийте й поставте в холодильник на 40 хвилин, а за 10 хвилин до кінця увімкніть духовку на 190 °C.";
"Переложите курицу вместе с маринадом в небольшую форму. Запекайте на среднем уровне 25–35 минут, пока в самой толстой части не будет 74 °C, а сок при надрезе не станет прозрачным. Дайте постоять 3 минуты перед нарезкой." = "Перекладіть курку разом із маринадом у невелику форму. Запікайте на середньому рівні 25–35 хвилин, доки в найтовщій частині не буде 74 °C, а сік на надрізі не стане прозорим. Дайте постояти 3 хвилини перед нарізанням.";
"Включите духовку на 200 °C. Картофель вымойте щёткой и, не очищая, нарежьте дольками толщиной 2 см. В большой миске перемешивайте дольки с растительным маслом, паприкой, солью и чёрным перцем 1 минуту, чтобы специи покрыли каждую." = "Увімкніть духовку на 200 °C. Картоплю вимийте щіткою й, не очищаючи, наріжте часточками завтовшки 2 см. У великій мисці перемішуйте часточки з олією, паприкою, сіллю й чорним перцем 1 хвилину, щоб спеції вкрили кожну.";
"Разложите картофель в один слой на одном или двух противнях с пергаментом и запекайте 28–30 минут, пока дольки не зарумянятся, а нож не будет легко входить в середину. Пока картофель печётся, натрите чеснок, мелко порубите укроп и смешайте с йогуртом; подайте соус отдельно." = "Розкладіть картоплю в один шар на одному чи двох деках із пергаментом і запікайте 28–30 хвилин, доки часточки не зарум'яняться, а ніж не входитиме легко в середину. Поки картопля печеться, натріть часник, дрібно порубайте кріп і змішайте з йогуртом; соус подайте окремо.";
"Морковь, сельдерей, лук и сладкий перец нарежьте кубиками 1 см, цукини и томаты — кубиками 1,5 см, пекинскую капусту — полосками 1 см, чеснок мелко порубите. Вскипятите воду в кастрюле на сильном огне, опустите морковь, сельдерей, лук и перец и варите на среднем огне 10 минут." = "Моркву, селеру, цибулю й солодкий перець наріжте кубиками 1 см, цукіні й помідори — кубиками 1,5 см, пекінську капусту — смужками 1 см, часник дрібно порубайте. Закип'ятіть воду в каструлі на сильному вогні, опустіть моркву, селеру, цибулю й перець і варіть на середньому вогні 10 хвилин.";
"Добавьте цукини, капусту, томаты, чеснок и аджику и варите ещё 10–12 минут, пока цукини и морковь не станут мягкими. Добавьте соль, попробуйте и разлейте суп по тарелкам, а йогурт положите в каждую тарелку уже при подаче." = "Додайте цукіні, капусту, помідори, часник і аджику та варіть ще 10–12 хвилин, доки цукіні й морква не стануть м'якими. Додайте сіль, скуштуйте й розлийте суп по тарілках, а йогурт покладіть у кожну тарілку вже під час подачі.";
"Включите духовку на 190 °C — она прогреется за 10–12 минут, пока вы готовите овощи. Свежую капусту тонко нашинкуйте, квашеную отожмите руками от рассола, яблоко без сердцевины нарежьте дольками 0,5 см. Имбирь и чеснок натрите на мелкой тёрке и смешайте с вином, горчицей, солью и чёрным перцем." = "Увімкніть духовку на 190 °C — вона прогріється за 10–12 хвилин, поки ви готуєте овочі. Свіжу капусту тонко нашаткуйте, квашену відтисніть руками від розсолу, яблуко без серцевини наріжте часточками 0,5 см. Імбир і часник натріть на дрібній тертці та змішайте з вином, гірчицею, сіллю й чорним перцем.";
"Выложите капусту и яблоко ровным слоем в форму, сверху положите куриное филе и полейте заправкой. Накройте фольгой и запекайте на среднем уровне 35–45 минут, пока в самой толстой части курицы не будет 74 °C, а капуста не станет мягкой." = "Викладіть капусту та яблуко рівним шаром у форму, зверху покладіть куряче філе й полийте заправкою. Накрийте фольгою й запікайте на середньому рівні 35–45 хвилин, доки в найтовщій частині курки не буде 74 °C, а капуста не стане м'якою.";
"Сливы и яблоки вымойте. Сливы разрежьте пополам и выньте косточки, яблоки разрежьте на четвертинки и вырежьте сердцевину. Нарежьте все фрукты кубиками 1,5 см." = "Сливи й яблука вимийте. Сливи розріжте навпіл і вийміть кісточки, яблука розріжте на четвертинки й виріжте серцевину. Наріжте всі фрукти кубиками 1,5 см.";
"Разложите фрукты по креманкам или небольшим мискам и полейте сверху йогуртом. Перемешайте прямо перед едой, чтобы фрукты не успели пустить сок." = "Розкладіть фрукти по креманках або невеликих мисках і полийте зверху йогуртом. Перемішайте просто перед їдою, щоб фрукти не встигли пустити сік.";
"Лук нарежьте тонкими полукольцами, сладкий перец — полосками 1 см, чеснок мелко порубите. Разогрейте растительное масло в сковороде на среднем огне и жарьте лук с перцем 5–6 минут, помешивая, пока лук не станет мягким; чеснок добавьте за 1 минуту до конца." = "Цибулю наріжте тонкими півкільцями, солодкий перець — смужками 1 см, часник дрібно порубайте. Розігрійте олію в сковороді на середньому вогні й смажте цибулю з перцем 5–6 хвилин, помішуючи, доки цибуля не стане м'якою; часник додайте за 1 хвилину до кінця.";
"Томаты нарежьте кубиками 1,5 см и добавьте в сковороду вместе с томатной пастой, аджикой и солью. Тушите на среднем огне 7–8 минут, помешивая, пока соус не загустеет. Сделайте ложкой углубления по числу яиц и разбейте в каждое по яйцу." = "Помідори наріжте кубиками 1,5 см і додайте в сковороду разом із томатною пастою, аджикою та сіллю. Тушкуйте на середньому вогні 7–8 хвилин, помішуючи, доки соус не загусне. Зробіть ложкою заглибини за кількістю яєць і розбийте в кожну по яйцю.";
"Накройте сковороду крышкой и готовьте на слабом огне 6–7 минут, пока белок и желток полностью не схватятся. Подавайте прямо из сковороды, зачерпывая яйца вместе с томатным соусом." = "Накрийте сковороду кришкою й готуйте на слабкому вогні 6–7 хвилин, доки білок і жовток повністю не схопляться. Подавайте просто зі сковороди, набираючи яйця разом із томатним соусом.";
"Замороженные креветки заранее, с вечера, переложите в холодильник, чтобы они разморозились. Налейте воду в кастрюлю, добавьте веточки укропа и соль и доведите до кипения на сильном огне — это займёт 6–7 минут." = "Заморожені креветки заздалегідь, звечора, перекладіть у холодильник, щоб вони розморозилися. Налийте воду в каструлю, додайте гілочки кропу й сіль і доведіть до кипіння на сильному вогні — це займе 6–7 хвилин.";
"Опустите креветки в кипящую воду и, когда она снова закипит, варите 2–3 минуты, пока креветки не станут розовыми и непрозрачными. Откиньте на дуршлаг, выбросьте укроп и сразу перемешайте креветки в миске с лимонным соком и мелко натёртым чесноком." = "Опустіть креветки в окріп і, коли вода знову закипить, варіть 2–3 хвилини, доки креветки не стануть рожевими й непрозорими. Відкиньте на друшляк, викиньте кріп і одразу перемішайте креветки в мисці з лимонним соком і дрібно натертим часником.";
"Включите духовку на 190 °C. Срежьте у сладких перцев верхушки и выньте семена. Капусту мелко нашинкуйте, лук нарежьте мелкими кубиками, морковь натрите на крупной тёрке. Прогрейте лук с морковью в сковороде с небольшим количеством воды на среднем огне 5 минут, пока они не станут мягкими." = "Увімкніть духовку на 190 °C. Зріжте із солодких перців верхівки й вийміть насіння. Капусту дрібно нашаткуйте, цибулю наріжте дрібними кубиками, моркву натріть на крупній тертці. Прогрійте цибулю з морквою в сковороді з невеликою кількістю води на середньому вогні 5 хвилин, доки вони не стануть м'якими.";
"В миске смешайте фарш, капусту, лук с морковью, уже сваренный рис, соль и чёрный перец. Неплотно наполните перцы начинкой, поставьте их стоя в форму и влейте на дно томатный сок." = "У мисці змішайте фарш, капусту, цибулю з морквою, уже зварений рис, сіль і чорний перець. Нещільно наповніть перці начинкою, поставте їх вертикально у форму й влийте на дно томатний сік.";
"Накройте форму фольгой и запекайте на среднем уровне 45–55 минут, пока перцы не станут мягкими, а в центре начинки не будет 74 °C. Если дно формы стало сухим, подлейте немного горячей воды. Дайте постоять 5 минут перед подачей." = "Накрийте форму фольгою й запікайте на середньому рівні 45–55 хвилин, доки перці не стануть м'якими, а в центрі начинки не буде 74 °C. Якщо дно форми стало сухим, підлийте трохи гарячої води. Дайте постояти 5 хвилин перед подачею.";
"Включите духовку на 180 °C. Пока она греется 3–4 минуты, намажьте ржаные криспы тонким слоем творожного сыра и разложите сверху тонкие ломтики твёрдого сыра." = "Увімкніть духовку на 180 °C. Поки вона гріється 3–4 хвилини, намастіть житні кріспи тонким шаром вершкового сиру й розкладіть зверху тонкі скибочки твердого сиру.";
"Выложите криспы на противень с пергаментом и прогрейте 4–5 минут, только пока сыр не расплавится. Посыпьте рубленой зеленью и подавайте сразу, пока основа хрустит." = "Викладіть кріспи на деко з пергаментом і прогрійте 4–5 хвилин, лише доки сир не розплавиться. Посипте порубаною зеленню й подавайте одразу, поки основа хрумтить.";
"Включите духовку на 190 °C, за 10 минут нарезки она прогреется. Нарежьте свиную вырезку поперёк волокон медальонами 1,5 см, накройте плёнкой и слегка отбейте молотком до толщины 1 см. Баклажан и томаты нарежьте кружками 0,5 см, лук — тонкими полукольцами, сладкий перец — полосками, шампиньоны — пластинками; сыр натрите на крупной тёрке." = "Увімкніть духовку на 190 °C — за 10 хвилин нарізання вона прогріється. Наріжте свинячу вирізку впоперек волокон медальйонами по 1,5 см, накрийте плівкою і злегка відбийте молоточком до товщини 1 см. Баклажан і помідори наріжте кружальцями по 0,5 см, цибулю — тонкими півкільцями, солодкий перець — смужками, печериці — пластинками; сир натріть на великій тертці.";
"Уложите мясо в форму для запекания в один слой, сверху распределите овощи и грибы и полейте всё соевым соусом. Накройте форму фольгой и запекайте при 190 °C на среднем уровне 25 минут, пока овощи не начнут оседать. Снимите фольгу и посыпьте мясо и овощи тёртым сыром." = "Викладіть м’ясо у форму для запікання в один шар, зверху розподіліть овочі та гриби й полийте все соєвим соусом. Накрийте форму фольгою і запікайте за температури 190 °C на середньому рівні 25 хвилин, доки овочі не почнуть осідати. Зніміть фольгу й посипте м’ясо та овочі тертим сиром.";
"Верните форму в духовку без фольги на 5–7 минут, пока сыр не расплавится и не зарумянится, а баклажан не станет мягким. Проверьте термометром самую толстую часть свинины: должно быть не меньше 63 °C. Дайте мясу постоять 3 минуты и подавайте с овощами." = "Поверніть форму в духовку без фольги на 5–7 хвилин, доки сир не розплавиться й не підрум’яниться, а баклажан не стане м’яким. Перевірте термометром найтовщу частину свинини: має бути щонайменше 63 °C. Дайте м’ясу постояти 3 хвилини й подавайте з овочами.";
"Включите духовку на 190 °C и застелите противень пергаментом. В миске разотрите вилкой творог с яйцом и ванилином 2 минуты, до густой однородной массы. Яблоко вымойте, удалите сердцевину и нарежьте тонкими ломтиками 2–3 мм; мандарин очистите, разберите на дольки, разрежьте каждую на 2–3 кусочка и выньте косточки." = "Увімкніть духовку на 190 °C і застеліть деко пергаментом. У мисці розітріть виделкою кисломолочний сир з яйцем і ваніліном 2 хвилини, до густої однорідної маси. Яблуко вимийте, видаліть серцевину й наріжте тонкими скибочками по 2–3 мм; мандарин очистьте, розберіть на часточки, розріжте кожну на 2–3 шматочки й вийміть кісточки.";
"Выложите творожную массу ложкой на пергамент кружками диаметром 8 см и толщиной 1 см, сверху разложите яблоко и мандарин. Пеките при 190 °C на среднем уровне 15 минут, пока края не зарумянятся, а в центре не будет 74 °C. Дайте мини-пиццам остыть на противне 3 минуты и снимите их лопаткой." = "Викладіть сирну масу ложкою на пергамент кружками діаметром 8 см і завтовшки 1 см, зверху розкладіть яблуко й мандарин. Печіть за температури 190 °C на середньому рівні 15 хвилин, доки краї не підрум’яняться, а в центрі не буде 74 °C. Дайте міні-піцам охолонути на деку 3 хвилини й зніміть їх лопаткою.";
"Нарежьте говядину кубиками 2–3 см и обсушите бумажным полотенцем, лук — тонкими полукольцами. В кастрюле с толстым дном разогрейте растительное масло на сильном огне и обжарьте мясо 5–6 минут, переворачивая, пока со всех сторон не появится корочка. Добавьте лук, убавьте огонь до среднего и жарьте ещё 4 минуты, пока он не станет мягким." = "Наріжте яловичину кубиками по 2–3 см і обсушіть паперовим рушником, цибулю — тонкими півкільцями. У каструлі з товстим дном розігрійте олію на сильному вогні й обсмажте м’ясо 5–6 хвилин, перевертаючи, доки з усіх боків не з’явиться скоринка. Додайте цибулю, зменште вогонь до середнього й смажте ще 4 хвилини, доки вона не стане м’якою.";
"Влейте горячую воду, доведите до кипения и убавьте огонь до самого слабого. Накройте крышкой и томите 1,5–2 часа, помешивая каждые 30 минут; если соус опустился ниже мяса, подлейте немного кипятка. За 10 минут до конца посолите по вкусу; гуляш готов, когда кусок мяса легко разделяется вилкой." = "Влийте гарячу воду, доведіть до кипіння й зменште вогонь до найслабшого. Накрийте кришкою і томіть 1,5–2 години, помішуючи кожні 30 хвилин; якщо соус опустився нижче за м’ясо, долийте трохи окропу. За 10 хвилин до кінця посоліть до смаку; гуляш готовий, коли шматок м’яса легко розділяється виделкою.";
"Положите яйца в небольшую кастрюлю и залейте холодной водой так, чтобы она покрывала их на 2 см. Доведите до кипения на сильном огне, это займёт 3–4 минуты. Убавьте огонь до среднего и варите 9–10 минут, пока желток не станет плотным." = "Покладіть яйця в невелику каструлю й залийте холодною водою так, щоб вона покривала їх на 2 см. Доведіть до кипіння на сильному вогні, це займе 3–4 хвилини. Зменште вогонь до середнього й варіть 9–10 хвилин, доки жовток не стане щільним.";
"Переложите яйца ложкой в миску с холодной водой на 2 минуты, затем постучите ими о стол и очистите. Мелко порубите зелень. Разрежьте яйца пополам, разложите по тарелкам и посыпьте зеленью." = "Перекладіть яйця ложкою в миску з холодною водою на 2 хвилини, потім постукайте ними об стіл і очистьте. Дрібно посічіть зелень. Розріжте яйця навпіл, розкладіть по тарілках і посипте зеленню.";
"Промойте пшено в сите под горячей струёй из крана, растирая пальцами, 1 минуту. Лук и чеснок мелко нарежьте, морковь — кружками 0,5 см, сельдерей — кубиками 1 см, томаты — кубиками 1,5 см. В кастрюле разогрейте растительное масло на среднем огне и обжарьте лук с чесноком 3 минуты, помешивая, пока лук не станет мягким." = "Промийте пшоно в ситі під гарячим струменем з-під крана, перетираючи пальцями, 1 хвилину. Цибулю й часник дрібно наріжте, моркву — кружальцями по 0,5 см, селеру — кубиками по 1 см, помідори — кубиками по 1,5 см. У каструлі розігрійте олію на середньому вогні й обсмажте цибулю з часником 3 хвилини, помішуючи, доки цибуля не стане м’якою.";
"Влейте горячую воду, добавьте морковь, сельдерей, томаты, пшено и лавровый лист и доведите до кипения на сильном огне. Убавьте огонь до среднего и варите 12 минут, чтобы суп слегка булькал. Тем временем нарежьте минтай кусками 3–4 см, удалив кости, и опустите в суп вместе с ломтиком лимона." = "Влийте гарячу воду, додайте моркву, селеру, помідори, пшоно й лавровий лист і доведіть до кипіння на сильному вогні. Зменште вогонь до середнього й варіть 12 хвилин, щоб суп ледь булькав. Тим часом наріжте минтай шматками по 3–4 см, видаливши кістки, і опустіть у суп разом зі скибочкою лимона.";
"Варите ещё 7–8 минут на слабом огне, пока пшено не станет мягким, а рыба в самом толстом куске не прогреется до 63 °C и не начнёт расслаиваться. Выньте лавровый лист и лимон, приправьте солью и чёрным перцем. Снимите с огня, влейте лимонный сок и посыпьте мелко порубленной зеленью." = "Варіть ще 7–8 хвилин на слабкому вогні, доки пшоно не стане м’яким, а риба в найтовщому шматку не прогріється до 63 °C і не почне розшаровуватися. Вийміть лавровий лист і лимон, приправте сіллю й чорним перцем. Зніміть з вогню, влийте лимонний сік і посипте дрібно посіченою зеленню.";
"Включите духовку на 180 °C. Яблоки вымойте, удалите сердцевину, натрите на мелкой тёрке и отожмите руками лишний сок, чтобы масса не была жидкой. В миске разотрите вилкой творог с яйцом, корицей, ванилином и разрыхлителем 2–3 минуты до однородности и вмешайте яблоко." = "Увімкніть духовку на 180 °C. Яблука вимийте, видаліть серцевину, натріть на дрібній тертці й відтисніть руками зайвий сік, щоб маса не була рідкою. У мисці розітріть виделкою кисломолочний сир з яйцем, корицею, ваніліном і розпушувачем 2–3 хвилини до однорідності та вмішайте яблуко.";
"Разложите массу ложкой по силиконовым формочкам для кексов почти доверху и разровняйте верх. Пеките при 180 °C на среднем уровне 25–30 минут, пока верх не зарумянится, а в центре не будет 74 °C. Дайте сырникам остыть в формочках 3 минуты, тогда они выйдут целыми." = "Розкладіть масу ложкою по силіконових формочках для кексів майже доверху й розрівняйте верх. Печіть за температури 180 °C на середньому рівні 25–30 хвилин, доки верх не підрум’яниться, а в центрі не буде 74 °C. Дайте сирникам охолонути у формочках 3 хвилини, тоді вони вийдуть цілими.";
"Нарежьте куриное филе кубиками 2 см, шампиньоны — пластинками 0,5 см. В широкой сковороде разогрейте растительное масло на среднем огне, выложите грибы и жарьте 7–8 минут, помешивая, пока выделившийся сок не испарится. Добавьте курицу и жарьте ещё 5 минут, пока кусочки не побелеют со всех сторон." = "Наріжте куряче філе кубиками по 2 см, печериці — пластинками по 0,5 см. У широкій сковороді розігрійте олію на середньому вогні, викладіть гриби й смажте 7–8 хвилин, помішуючи, доки сік, що виділився, не випарується. Додайте курку й смажте ще 5 хвилин, доки шматочки не побіліють з усіх боків.";
"В чашке размешайте рисовую муку с холодным молоком до гладкости, без комков, и влейте в сковороду. Убавьте огонь до слабого и томите 15–18 минут, часто помешивая, пока соус не загустеет, а в самом крупном кусочке курицы не будет 74 °C и сок не станет прозрачным. В конце приправьте солью и чёрным перцем." = "У чашці розмішайте рисове борошно з холодним молоком до гладкості, без грудочок, і влийте в сковороду. Зменште вогонь до слабкого й томіть 15–18 хвилин, часто помішуючи, доки соус не загусне, а в найбільшому шматочку курки не буде 74 °C і сік не стане прозорим. Наприкінці приправте сіллю й чорним перцем.";
"Чеснок натрите на мелкой тёрке, укроп и зелень мелко порубите. В миске разомните вилкой творог с чесноком, укропом, зеленью и солью до однородной пасты. Огурец и сладкий перец без семян нарежьте длинной соломкой толщиной 0,5 см." = "Часник натріть на дрібній тертці, кріп і зелень дрібно посічіть. У мисці розімніть виделкою кисломолочний сир з часником, кропом, зеленню та сіллю до однорідної пасти. Огірок і солодкий перець без насіння наріжте довгою соломкою завтовшки 0,5 см.";
"Положите лист нори блестящей стороной вниз на доску и распределите творог тонким слоем, оставив свободной полосу 2 см у дальнего края. Уложите овощи полосой у ближнего края, плотно сверните и смочите свободный край водой, чтобы он приклеился. Нарежьте мокрым ножом на кусочки шириной 2–3 см и подайте с соевым соусом для макания." = "Покладіть аркуш норі блискучим боком донизу на дошку й розподіліть сир тонким шаром, залишивши вільну смугу 2 см біля дальнього краю. Викладіть овочі смугою біля ближнього краю, щільно згорніть і змочіть вільний край водою, щоб він приклеївся. Наріжте мокрим ножем на шматочки завширшки 2–3 см і подайте із соєвим соусом для вмочування.";
"Капусту тонко нашинкуйте, лук мелко нарежьте, морковь натрите на крупной тёрке. В глубокой сковороде на среднем огне обжарьте лук с морковью в растительном масле 3 минуты. Добавьте капусту, томатную пасту, кориандр, лавровый лист и немного воды, накройте и тушите на слабом огне 12–15 минут до мягкости капусты, затем выньте лавровый лист." = "Капусту тонко нашаткуйте, цибулю дрібно наріжте, моркву натріть на великій тертці. У глибокій сковороді на середньому вогні обсмажте цибулю з морквою на олії 3 хвилини. Додайте капусту, томатну пасту, коріандр, лавровий лист і трохи води, накрийте й тушкуйте на слабкому вогні 12–15 хвилин до м’якості капусти, потім вийміть лавровий лист.";
"Включите духовку на 180 °C, форму застелите пергаментом. В миске взбейте венчиком кефир с яйцами 1 минуту, всыпьте рисовую муку и разрыхлитель и размешайте до гладкого жидкого теста. Вмешайте тёплую начинку, приправьте солью и чёрным перцем и вылейте всё в форму." = "Увімкніть духовку на 180 °C, форму застеліть пергаментом. У мисці збийте вінчиком кефір з яйцями 1 хвилину, всипте рисове борошно й розпушувач і розмішайте до гладкого рідкого тіста. Вмішайте теплу начинку, приправте сіллю й чорним перцем і вилийте все у форму.";
"Запекайте при 180 °C на среднем уровне 30–35 минут, пока верх не зарумянится, а центр не станет упругим: деревянная шпажка выходит сухой, внутри 74 °C. Выньте пирог и дайте ему постоять в форме 5 минут, тогда он не развалится при нарезке." = "Запікайте за температури 180 °C на середньому рівні 30–35 хвилин, доки верх не підрум’яниться, а центр не стане пружним: дерев’яна шпажка виходить сухою, усередині 74 °C. Вийміть пиріг і дайте йому постояти у формі 5 хвилин, тоді він не розвалиться під час нарізання.";
"Чеснок натрите на мелкой тёрке и смешайте в миске с кефиром, майораном, солью и чёрным перцем. Обсушите куриное филе бумажным полотенцем и обваляйте в маринаде со всех сторон. Накройте миску плёнкой и уберите в холодильник на 1,5 часа." = "Часник натріть на дрібній тертці й змішайте в мисці з кефіром, майораном, сіллю та чорним перцем. Обсушіть куряче філе паперовим рушником і обваляйте в маринаді з усіх боків. Накрийте миску плівкою й поставте в холодильник на 1,5 години.";
"Включите духовку на 190 °C и дайте ей прогреться 10–15 минут. Переложите филе с маринадом в небольшую форму и запекайте на среднем уровне 25–30 минут, пока в самой толстой части не будет 74 °C, а сок при надрезе не станет прозрачным. Дайте мясу полежать 5 минут и нарежьте поперёк волокон ломтиками 1 см." = "Увімкніть духовку на 190 °C і дайте їй прогрітися 10–15 хвилин. Перекладіть філе з маринадом у невелику форму й запікайте на середньому рівні 25–30 хвилин, доки в найтовщій частині не буде 74 °C, а сік на розрізі не стане прозорим. Дайте м’ясу полежати 5 хвилин і наріжте впоперек волокон скибочками завтовшки 1 см.";
"Тыкву очистите и нарежьте кубиками 2 см, морковь — тонкими кружками, томаты — крупными кубиками, лук и чеснок мелко порубите. В кастрюле разогрейте растительное масло на среднем огне и обжарьте лук с чесноком 3 минуты до мягкости. Добавьте тыкву, морковь и томаты и прогревайте ещё 2 минуты, помешивая." = "Гарбуз очистьте й наріжте кубиками по 2 см, моркву — тонкими кружальцями, помідори — великими кубиками, цибулю й часник дрібно посічіть. У каструлі розігрійте олію на середньому вогні й обсмажте цибулю з часником 3 хвилини до м’якості. Додайте гарбуз, моркву й помідори та прогрівайте ще 2 хвилини, помішуючи.";
"Влейте мясной бульон, всыпьте промытый в сите рис и доведите до кипения. Убавьте огонь до слабого, накройте крышкой и варите 18–20 минут, пока рис и тыква не станут совсем мягкими. Снимите кастрюлю с огня и пробейте суп погружным блендером до гладкости, держа насадку у дна, чтобы не брызгало." = "Влийте м’ясний бульйон, всипте промитий у ситі рис і доведіть до кипіння. Зменште вогонь до слабкого, накрийте кришкою й варіть 18–20 хвилин, доки рис і гарбуз не стануть зовсім м’якими. Зніміть каструлю з вогню й збийте суп занурювальним блендером до гладкості, тримаючи насадку біля дна, щоб не бризкало.";
"Приправьте суп солью и чёрным перцем, размешайте и попробуйте. Сыр натрите на мелкой тёрке, зелень мелко порубите. Разлейте суп по тарелкам и посыпьте каждую порцию сыром и зеленью." = "Приправте суп сіллю й чорним перцем, розмішайте й скуштуйте. Сир натріть на дрібній тертці, зелень дрібно посічіть. Розлийте суп по тарілках і посипте кожну порцію сиром і зеленню.";
"Высыпьте желатин в небольшую миску, залейте холодной водой, размешайте и оставьте набухать на 15 минут. Тем временем яблоки очистите, удалите сердцевину и нарежьте кубиками 2 см. Тушите их в кастрюле под крышкой на слабом огне 10–12 минут, помешивая, пока не станут мягкими, затем разомните в пюре и остудите до тёплого." = "Висипте желатин у невелику миску, залийте холодною водою, розмішайте й залиште набухати на 15 хвилин. Тим часом яблука очистьте, видаліть серцевину й наріжте кубиками по 2 см. Тушкуйте їх у каструлі під кришкою на слабкому вогні 10–12 хвилин, помішуючи, доки не стануть м’якими, потім розімніть у пюре й остудіть до теплого.";
"Переложите набухший желатин в маленький ковшик и прогрейте на слабом огне 1–2 минуты, помешивая, пока он полностью не растворится; не кипятите. Влейте его в тёплое яблочное пюре, добавьте творог и взбейте блендером 1–2 минуты до гладкости. Чернослив нарежьте кусочками 0,5 см; мандарин очистите, выньте косточки и нарежьте кусочками 1 см." = "Перекладіть набухлий желатин у маленький ківшик і прогрійте на слабкому вогні 1–2 хвилини, помішуючи, доки він повністю не розчиниться; не кип’ятіть. Влийте його в тепле яблучне пюре, додайте кисломолочний сир і збийте блендером 1–2 хвилини до гладкості. Чорнослив наріжте шматочками по 0,5 см; мандарин очистьте, вийміть кісточки й наріжте шматочками по 1 см.";
"Разложите в небольшие формочки или креманки слоями: суфле, мандарин с черносливом, снова суфле, сверху немного фруктов. Накройте плёнкой и уберите в холодильник минимум на 2 часа, пока масса не застынет и не перестанет дрожать при наклоне формочки." = "Розкладіть у невеликі формочки або креманки шарами: суфле, мандарин із чорносливом, знову суфле, зверху трохи фруктів. Накрийте плівкою й поставте в холодильник щонайменше на 2 години, доки маса не застигне й не перестане тремтіти, якщо нахилити формочку.";
"Включите духовку на 200 °C, за 10 минут подготовки она прогреется. Картофель вымойте щёткой и, не очищая, разрежьте вдоль на дольки толщиной 2 см. На противне с пергаментом перемешайте их с оливковым маслом, паприкой, сушёным чесноком, солью и чёрным перцем и разложите в один слой. Свежий чеснок для соуса натрите на мелкой тёрке." = "Увімкніть духовку на 200 °C — за 10 хвилин підготовки вона прогріється. Картоплю вимийте щіткою і, не очищаючи, розріжте вздовж на часточки завтовшки 2 см. На деку з пергаментом перемішайте їх з оливковою олією, паприкою, сушеним часником, сіллю та чорним перцем і розкладіть в один шар. Свіжий часник для соусу натріть на дрібній тертці.";
"Запекайте при 200 °C на среднем уровне 30 минут, через 15 минут переверните дольки лопаткой; картофель готов, когда края зарумянились, а нож входит легко. Сыр натрите на крупной тёрке, посыпьте им картофель и верните в духовку на 3 минуты, чтобы он расплавился. Пока картофель печётся, смешайте йогурт с рубленым укропом и тёртым чесноком и подайте соус рядом." = "Запікайте за температури 200 °C на середньому рівні 30 хвилин, через 15 хвилин переверніть часточки лопаткою; картопля готова, коли краї підрум’янилися, а ніж входить легко. Сир натріть на великій тертці, посипте ним картоплю й поверніть у духовку на 3 хвилини, щоб він розплавився. Поки картопля печеться, змішайте йогурт із посіченим кропом і тертим часником і подайте соус поруч.";
"Промойте бурый рис в сите, переложите в кастрюлю, залейте холодной водой, посолите и доведите до кипения на сильном огне. Убавьте огонь до самого слабого, накройте крышкой и оставьте вариться. За первые 10 минут варки нарежьте цукини и лук кубиками 0,5 см, а морковь натрите на крупной тёрке." = "Промийте бурий рис у ситі, перекладіть у каструлю, залийте холодною водою, посоліть і доведіть до кипіння на сильному вогні. Зменште вогонь до найслабшого, накрийте кришкою й залиште варитися. За перші 10 хвилин варіння наріжте цукіні й цибулю кубиками по 0,5 см, а моркву натріть на великій тертці.";
"Сложите овощи в глубокую сковороду, залейте томатным соком, накройте и тушите на слабом огне 20–25 минут, помешивая, пока они не станут совсем мягкими. Разомните икру толкушкой и приправьте солью. Проверьте рис: когда зёрна мягкие, а вода впиталась, снимите его с огня и подайте рядом с икрой." = "Перекладіть овочі в глибоку сковороду, залийте томатним соком, накрийте й тушкуйте на слабкому вогні 20–25 хвилин, помішуючи, доки вони не стануть зовсім м’якими. Розімніть ікру товкачиком і приправте сіллю. Перевірте рис: коли зерна м’які, а вода вбралася, зніміть його з вогню й подайте поруч з ікрою.";
"Включите духовку на 190 °C: ей хватит 15 минут, пока вы готовите рулетики. Нарежьте свиную вырезку поперёк волокон пластами 1 см, накройте плёнкой, отбейте до 0,5 см и приправьте с обеих сторон солью и чёрным перцем. Сыр натрите на мелкой тёрке, укроп и чеснок мелко порубите и смешайте с сыром и майонезом." = "Увімкніть духовку на 190 °C: їй вистачить 15 хвилин, поки ви готуєте рулетики. Наріжте свинячу вирізку впоперек волокон пластами по 1 см, накрийте плівкою, відбийте до 0,5 см і приправте з обох боків сіллю та чорним перцем. Сир натріть на дрібній тертці, кріп і часник дрібно посічіть і змішайте з сиром та майонезом.";
"Разложите начинку полоской по каждому пласту, плотно сверните рулетики и уложите в форму швом вниз. Смажьте верх йогуртом. Запекайте при 190 °C на среднем уровне 20–25 минут, пока рулетики не зарумянятся, а в центре не будет 74 °C." = "Викладіть начинку смужкою на кожен пласт, щільно згорніть рулетики й покладіть у форму швом донизу. Змастіть верх йогуртом. Запікайте за температури 190 °C на середньому рівні 20–25 хвилин, доки рулетики не підрум’яняться, а в центрі не буде 74 °C.";
"Включите духовку на 190 °C — пока вы 10 минут режете овощи, она прогреется. Промойте рис в сите до прозрачной воды. Капусту тонко нашинкуйте, лук, морковь, сладкий перец и сельдерей нарежьте кубиками 0,5–1 см и перемешайте в форме для запекания с рисом, солью и чёрным перцем." = "Увімкніть духовку на 190 °C — поки ви 10 хвилин ріжете овочі, вона прогріється. Промийте рис у ситі до прозорої води. Капусту тонко нашаткуйте, цибулю, моркву, солодкий перець і селеру наріжте кубиками по 0,5–1 см і перемішайте у формі для запікання з рисом, сіллю та чорним перцем.";
"Влейте томатный сок и долейте горячую воду, чтобы жидкость покрыла рис и овощи на 1 см, перемешайте. Плотно накройте форму фольгой и запекайте при 190 °C на среднем уровне 35 минут, пока рис не впитает жидкость и не станет мягким. Дайте постоять под фольгой 5 минут и перемешайте вилкой." = "Влийте томатний сік і долийте гарячу воду, щоб рідина покривала рис і овочі на 1 см, перемішайте. Щільно накрийте форму фольгою й запікайте за температури 190 °C на середньому рівні 35 хвилин, доки рис не вбере рідину й не стане м’яким. Дайте постояти під фольгою 5 хвилин і перемішайте виделкою.";
"Разогрейте духовку до 180 °C и застелите противень пергаментом. Сыр натрите на мелкой тёрке, в миске взбейте вилкой яйца с майонезом и сыром. Вылейте смесь на пергамент ровным прямоугольником толщиной 0,5 см и пеките 8–10 минут, пока омлет не схватится и не перестанет блестеть сверху." = "Розігрійте духовку до 180 °C і застеліть деко пергаментом. Сир натріть на дрібній тертці, у мисці збийте виделкою яйця з майонезом і сиром. Вилийте суміш на пергамент рівним прямокутником завтовшки 0,5 см і печіть 8–10 хвилин, доки омлет не схопиться й не перестане блищати зверху.";
"Лук и чеснок измельчите как можно мельче и вымешайте рукой с куриным фаршем, солью, чёрным перцем, паприкой и кориандром. Дайте омлету остыть 2 минуты и распределите по нему фарш слоем 1 см, отступив от краёв на 1–2 см. Плотно сверните рулет с длинной стороны, приподнимая пергамент, и переложите швом вниз." = "Цибулю й часник подрібніть якомога дрібніше й вимісіть рукою з курячим фаршем, сіллю, чорним перцем, паприкою та коріандром. Дайте омлету охолонути 2 хвилини й розподіліть по ньому фарш шаром 1 см, відступивши від країв на 1–2 см. Щільно згорніть рулет з довгого боку, піднімаючи пергамент, і перекладіть швом донизу.";
"Пеките рулет при 180 °C на среднем уровне 25–30 минут, пока он не зарумянится, а в середине начинки не будет 74 °C и сок не станет прозрачным. Выньте и дайте постоять 5 минут, затем нарежьте острым ножом ломтиками 2 см." = "Печіть рулет за температури 180 °C на середньому рівні 25–30 хвилин, доки він не підрум’яниться, а в середині начинки не буде 74 °C і сік не стане прозорим. Вийміть і дайте постояти 5 хвилин, потім наріжте гострим ножем скибочками по 2 см.";
"Разберите цветную капусту на соцветия по 3–4 см, толстую кочерыжку нарежьте тонкими ломтиками. В большой кастрюле вскипятите воду, опустите капусту и варите на среднем огне 10–12 минут, пока нож не будет входить в кочерыжку без усилия. Слейте воду через дуршлаг и дайте капусте постоять 2 минуты, чтобы ушёл пар." = "Розберіть цвітну капусту на суцвіття по 3–4 см, товсте стебло наріжте тонкими скибочками. У великій каструлі закип’ятіть воду, опустіть капусту й варіть на середньому вогні 10–12 хвилин, доки ніж не входитиме в стебло без зусиль. Злийте воду через друшляк і дайте капусті постояти 2 хвилини, щоб вийшла пара.";
"Молоко прогрейте в ковшике на слабом огне 1–2 минуты до горячего, не кипятите. Пробейте капусту погружным блендером прямо в кастрюле, вливая молоко понемногу, пока пюре не станет гладким и густым. Приправьте солью и чёрным перцем и перемешайте." = "Молоко прогрійте в ківшику на слабкому вогні 1–2 хвилини до гарячого, не кип’ятіть. Збийте капусту занурювальним блендером просто в каструлі, підливаючи молоко потроху, доки пюре не стане гладким і густим. Приправте сіллю й чорним перцем і перемішайте.";
"Морковь очистите и нарежьте кубиками 1 см, стручковую фасоль — кусочками 2 см. Яйца положите в кастрюлю, залейте холодной водой, доведите до кипения на сильном огне, всыпьте морковь и варите на среднем огне 4 минуты. Добавьте фасоль и варите ещё 5–6 минут, пока овощи не станут мягкими; откиньте всё на дуршлаг, а яйца переложите в холодную воду на 5 минут." = "Моркву очистьте й наріжте кубиками по 1 см, стручкову квасолю — шматочками по 2 см. Яйця покладіть у каструлю, залийте холодною водою, доведіть до кипіння на сильному вогні, всипте моркву й варіть на середньому вогні 4 хвилини. Додайте квасолю й варіть ще 5–6 хвилин, доки овочі не стануть м’якими; відкиньте все на друшляк, а яйця перекладіть у холодну воду на 5 хвилин.";
"Очистите яйца. Варёную говядину, яйца и солёные огурцы нарежьте кубиками 1 см, лук — мелкими кубиками, и сложите в миску вместе с остывшими морковью и фасолью. Заправьте салат йогуртом прямо перед подачей и перемешайте; остатки храните в холодильнике под крышкой." = "Очистьте яйця. Варену яловичину, яйця й солоні огірки наріжте кубиками по 1 см, цибулю — дрібними кубиками, і складіть у миску разом з охололими морквою та квасолею. Заправте салат йогуртом безпосередньо перед подачею й перемішайте; залишки зберігайте в холодильнику під кришкою.";
"Нарежьте говядину поперёк волокон кубиками 2–3 см, лук — полукольцами. Сложите мясо и лук в кастрюлю с толстым дном, добавьте кориандр и лавровый лист и залейте холодной водой. Доведите до кипения на сильном огне, около 5 минут, и снимите шумовкой серую пену." = "Наріжте яловичину впоперек волокон кубиками по 2–3 см, цибулю — півкільцями. Складіть м’ясо й цибулю в каструлю з товстим дном, додайте коріандр і лавровий лист і залийте холодною водою. Доведіть до кипіння на сильному вогні, близько 5 хвилин, і зніміть шумівкою сіру піну.";
"Убавьте огонь до самого слабого, накройте крышкой и томите без масла 1,5–2 часа, чтобы поверхность лишь слегка дрожала. Каждые 30 минут проверяйте: если жидкость опустилась ниже мяса, подлейте немного кипятка. Когда мясо легко разделяется вилкой, выньте лавровый лист, приправьте солью и чёрным перцем и прогрейте ещё 2 минуты." = "Зменште вогонь до найслабшого, накрийте кришкою й томіть без олії 1,5–2 години, щоб поверхня лише ледь тремтіла. Кожні 30 хвилин перевіряйте: якщо рідина опустилася нижче за м’ясо, долийте трохи окропу. Коли м’ясо легко розділяється виделкою, вийміть лавровий лист, приправте сіллю й чорним перцем і прогрійте ще 2 хвилини.";
"Включите духовку на 190 °C, на подготовку мяса уйдёт около 15 минут. Нарежьте свиную вырезку поперёк волокон медальонами 1,5 см, накройте плёнкой, отбейте до 1 см и приправьте солью и чёрным перцем. Уложите мясо в форму в один слой, сверху разложите тонкие полукольца лука, полейте соевым соусом и смажьте тонким слоем майонеза." = "Увімкніть духовку на 190 °C, на підготовку м’яса піде близько 15 хвилин. Наріжте свинячу вирізку впоперек волокон медальйонами по 1,5 см, накрийте плівкою, відбийте до 1 см і приправте сіллю та чорним перцем. Викладіть м’ясо у форму в один шар, зверху розкладіть тонкі півкільця цибулі, полийте соєвим соусом і змастіть тонким шаром майонезу.";
"Запекайте при 190 °C на среднем уровне 25 минут, посыпьте тёртым сыром и запекайте ещё 5–7 минут, пока сыр не расплавится, а в толстой части мяса не будет 63 °C; дайте постоять 3 минуты. Пока мясо в духовке, промойте гречку, залейте водой в кастрюле, посолите и варите под крышкой на слабом огне 15–18 минут, пока вода не впитается." = "Запікайте за температури 190 °C на середньому рівні 25 хвилин, посипте тертим сиром і запікайте ще 5–7 хвилин, доки сир не розплавиться, а в найтовщій частині м’яса не буде 63 °C; дайте постояти 3 хвилини. Поки м’ясо в духовці, промийте гречку, залийте водою в каструлі, посоліть і варіть під кришкою на слабкому вогні 15–18 хвилин, доки вода не вбереться.";
"Включите духовку на 180 °C и застелите небольшую форму пергаментом. В миске разотрите вилкой творог с йогуртом и яйцом 2 минуты, до однородной массы. Яблоко натрите на крупной тёрке, обходя сердцевину, чернослив нарежьте кусочками 0,5 см и вмешайте в творог вместе с корицей." = "Увімкніть духовку на 180 °C і застеліть невелику форму пергаментом. У мисці розітріть виделкою кисломолочний сир з йогуртом і яйцем 2 хвилини, до однорідної маси. Яблуко натріть на великій тертці, оминаючи серцевину, чорнослив наріжте шматочками по 0,5 см і вмішайте в сир разом із корицею.";
"Переложите массу в форму и разровняйте ложкой. Запекайте при 180 °C на среднем уровне 25–30 минут, пока края не зарумянятся, а центр не перестанет дрожать и не прогреется до 74 °C. Дайте запеканке постоять 5–7 минут, тогда она ровно разрежется на порции." = "Перекладіть масу у форму й розрівняйте ложкою. Запікайте за температури 180 °C на середньому рівні 25–30 хвилин, доки краї не підрум’яняться, а центр не перестане тремтіти й не прогріється до 74 °C. Дайте запіканці постояти 5–7 хвилин, тоді вона рівно розріжеться на порції.";
"Промойте рис в сите, морковь нарежьте тонкими кружками, лук — мелкими кубиками. В кастрюле вскипятите воду на сильном огне, всыпьте рис, морковь, лук и лавровый лист и варите на среднем огне 15 минут. Пока суп варится, нарежьте томаты кубиками 1 см, а минтай без костей — кусками 3–4 см." = "Промийте рис у ситі, моркву наріжте тонкими кружальцями, цибулю — дрібними кубиками. У каструлі закип’ятіть воду на сильному вогні, всипте рис, моркву, цибулю й лавровий лист і варіть на середньому вогні 15 хвилин. Поки суп вариться, наріжте помідори кубиками по 1 см, а минтай без кісток — шматками по 3–4 см.";
"Опустите в суп томаты и рыбу, убавьте огонь до слабого и варите 8–10 минут, пока рис не станет мягким, а рыба не начнёт легко расслаиваться вилкой и в толстой части не прогреется до 63 °C. Выньте лавровый лист, приправьте уху солью и чёрным перцем и сразу снимите с огня." = "Опустіть у суп помідори й рибу, зменште вогонь до слабкого й варіть 8–10 хвилин, доки рис не стане м’яким, а риба не почне легко розшаровуватися виделкою й у найтовщій частині не прогріється до 63 °C. Вийміть лавровий лист, приправте юшку сіллю й чорним перцем і одразу зніміть з вогню.";
"Промойте гречку в сите, залейте в кастрюле холодной водой, посолите и доведите до кипения, затем накройте и варите на слабом огне 15–18 минут, пока вода не впитается. Пока гречка варится, тонко нашинкуйте капусту, морковь натрите на крупной тёрке, зелёный лук и укроп мелко порубите." = "Промийте гречку в ситі, залийте в каструлі холодною водою, посоліть і доведіть до кипіння, потім накрийте й варіть на слабкому вогні 15–18 хвилин, доки вода не вбереться. Поки гречка вариться, тонко нашаткуйте капусту, моркву натріть на великій тертці, зелену цибулю й кріп дрібно посічіть.";
"Сложите капусту в миску, посыпьте солью и мните руками 1–2 минуты, пока она не пустит сок и не станет мягче. Добавьте морковь, зелёный лук, укроп и лимонный сок и перемешайте. Разрыхлите гречку вилкой, разложите по тарелкам и положите салат рядом." = "Складіть капусту в миску, посипте сіллю й мніть руками 1–2 хвилини, доки вона не пустить сік і не стане м’якшою. Додайте моркву, зелену цибулю, кріп і лимонний сік і перемішайте. Розпушіть гречку виделкою, розкладіть по тарілках і покладіть салат поруч.";
"Промойте гороховую крупу в сите, пока вода не станет почти прозрачной, переложите в кастрюлю и залейте водой. Доведите до кипения на сильном огне и снимите пену шумовкой. Варите на слабом огне под приоткрытой крышкой 45–50 минут, помешивая каждые 10 минут, пока горох не станет мягким и не начнёт разваливаться; если вода выкипит раньше, подлейте кипятка." = "Промийте горохову крупу в ситі, доки вода не стане майже прозорою, перекладіть у каструлю й залийте водою. Доведіть до кипіння на сильному вогні й зніміть піну шумівкою. Варіть на слабкому вогні під прочиненою кришкою 45–50 хвилин, помішуючи кожні 10 хвилин, доки горох не стане м’яким і не почне розварюватися; якщо вода випарується раніше, долийте окропу.";
"Лук нарежьте мелкими кубиками и жарьте в сковороде на растительном масле на среднем огне 6–7 минут, пока он не станет мягким и золотистым. Слейте с гороха лишнюю жидкость, если она осталась, добавьте лук, соль и чёрный перец. Разомните часть гороха толкушкой прямо в кастрюле, чтобы гарнир стал гуще, и перемешайте." = "Цибулю наріжте дрібними кубиками й смажте на олії в сковороді на середньому вогні 6–7 хвилин, доки вона не стане м’якою й золотистою. Злийте з гороху зайву рідину, якщо вона залишилася, додайте цибулю, сіль і чорний перець. Розімніть частину гороху товкачиком просто в каструлі, щоб гарнір став густішим, і перемішайте.";
"Промойте бурый рис в сите под холодной струёй, перебирая пальцами, пока стекающая вода не станет почти прозрачной. Вскипятите воду в кастрюле на сильном огне, посолите и всыпьте рис. Убавьте огонь до слабого, накройте и варите 35–40 минут, пока зёрна не станут мягкими, но целыми; оставшуюся воду слейте через сито." = "Промийте бурий рис у ситі під холодним струменем, перебираючи пальцями, доки вода, що стікає, не стане майже прозорою. Закип’ятіть воду в каструлі на сильному вогні, посоліть і всипте рис. Зменште вогонь до слабкого, накрийте й варіть 35–40 хвилин, доки зерна не стануть м’якими, але цілими; решту води злийте через сито.";
"Яблоко вымойте, разрежьте на четыре части, вырежьте сердцевину и нарежьте тонкими дольками. Апельсин очистите от кожуры и белой плёнки, разделите на дольки и выньте косточки. Разложите тёплый рис по тарелкам, а фрукты положите рядом на отдельное блюдце." = "Яблуко вимийте, розріжте на чотири частини, виріжте серцевину й наріжте тонкими часточками. Апельсин очистьте від шкірки та білої плівки, розділіть на часточки й вийміть кісточки. Розкладіть теплий рис по тарілках, а фрукти покладіть поруч на окреме блюдце.";
"Включите духовку на 170 °C — за 10 минут, пока вы готовите мясо, она прогреется. Обсушите говядину бумажным полотенцем и натрите со всех сторон солью и чёрным перцем. Положите кусок в небольшую форму или утятницу, подлейте воды на 1 см и плотно закройте крышкой или фольгой." = "Увімкніть духовку на 170 °C — за 10 хвилин, поки ви готуєте м’ясо, вона прогріється. Обсушіть яловичину паперовим рушником і натріть з усіх боків сіллю та чорним перцем. Покладіть шматок у невелику форму чи гусятницю, долийте води на 1 см і щільно закрийте кришкою або фольгою.";
"Запекайте при 170 °C на среднем уровне около 2 часов, раз в 40 минут подливая немного горячей воды, чтобы дно не высыхало; мясо готово, когда вилка входит легко. За 25 минут до конца промойте пшено, залейте водой в кастрюле, посолите и варите под крышкой на слабом огне 15–20 минут, пока вода не впитается. Нарежьте мясо поперёк волокон и подайте с пшеном и соком из формы." = "Запікайте за температури 170 °C на середньому рівні близько 2 годин, раз на 40 хвилин підливаючи трохи гарячої води, щоб дно не висихало; м’ясо готове, коли виделка входить легко. За 25 хвилин до кінця промийте пшоно, залийте водою в каструлі, посоліть і варіть під кришкою на слабкому вогні 15–20 хвилин, доки вода не вбереться. Наріжте м’ясо впоперек волокон і подайте з пшоном і соком із форми.";
"Яблоко вымойте, разрежьте на четвертинки, удалите сердцевину и нарежьте кубиками 1,5 см. Апельсин и киви очистите от кожуры, апельсин разберите на дольки без косточек и нарежьте вместе с киви такими же кубиками. Чернослив разрежьте на 3–4 части." = "Яблуко вимийте, розріжте на четвертинки, видаліть серцевину й наріжте кубиками по 1,5 см. Апельсин і ківі очистьте від шкірки, апельсин розберіть на часточки без кісточок і наріжте разом із ківі такими самими кубиками. Чорнослив розріжте на 3–4 частини.";
"Разложите фрукты и чернослив по мискам и полейте сверху йогуртом. Подавайте сразу: если салат постоит, киви даст сок и йогурт начнёт горчить." = "Розкладіть фрукти й чорнослив по мисках і полийте зверху йогуртом. Подавайте одразу: якщо салат постоїть, ківі пустить сік і йогурт почне гірчити.";
"Лук мелко нарежьте. В миске вымешайте рукой мясной фарш с мукой, третью лука, солью и чёрным перцем 1 минуту, до однородности. Мокрыми руками скатайте одинаковые фрикадельки размером с грецкий орех и выложите на тарелку." = "Цибулю дрібно наріжте. У мисці вимісіть рукою фарш із рисовим борошном, третиною цибулі, сіллю та чорним перцем 1 хвилину, до однорідності. Мокрими руками скачайте однакові фрикадельки завбільшки з волоський горіх і викладіть на тарілку.";
"Вскипятите воду в кастрюле, а пока она греется, нарежьте томаты кубиками 1,5 см. Всыпьте в кипяток промытый рис, оставшийся лук, томаты и лавровый лист и варите на среднем огне 10 минут. Опустите фрикадельки по одной и после нового закипания варите на слабом огне 8–10 минут, пока рис не станет мягким, а в центре фрикадельки не будет 74 °C." = "Закип’ятіть воду в каструлі, а поки вона гріється, наріжте помідори кубиками по 1,5 см. Всипте в окріп промитий рис, решту цибулі, помідори й лавровий лист і варіть на середньому вогні 10 хвилин. Опускайте фрикадельки по одній і після повторного закипання варіть на слабкому вогні 8–10 хвилин, доки рис не стане м’яким, а в центрі фрикадельки не буде 74 °C.";
"Мелко порубите укроп и выньте из супа лавровый лист. Разлейте суп по тарелкам, раскладывая фрикадельки поровну, и посыпьте каждую порцию укропом." = "Дрібно посічіть кріп і вийміть із супу лавровий лист. Розлийте суп по тарілках, розкладаючи фрикадельки порівну, і посипте кожну порцію кропом.";
"Включите духовку на 180 °C, небольшую форму застелите пергаментом. Вяленые томаты промокните бумажным полотенцем от масла и нарежьте кусочками 0,5 см. В миске разотрите вилкой творог с йогуртом, яйцом, разрыхлителем и солью 2 минуты, до однородной массы." = "Увімкніть духовку на 180 °C, невелику форму застеліть пергаментом. В’ялені томати промокніть паперовим рушником від олії й наріжте шматочками по 0,5 см. У мисці розітріть виделкою кисломолочний сир з йогуртом, яйцем, розпушувачем і сіллю 2 хвилини, до однорідної маси.";
"Вмешайте томаты в творожную массу, переложите в форму и разровняйте. Запекайте при 180 °C на среднем уровне 20–25 минут, пока верх не зарумянится, а в центре не будет 74 °C. Дайте запеканке остыть в форме 2 минуты, тогда она ровно нарежется." = "Вмішайте томати в сирну масу, перекладіть у форму й розрівняйте. Запікайте за температури 180 °C на середньому рівні 20–25 хвилин, доки верх не підрум’яниться, а в центрі не буде 74 °C. Дайте запіканці охолонути у формі 2 хвилини, тоді вона рівно наріжеться.";
"Нарежьте говядину кубиками 1,5 см, лук — полукольцами, морковь — соломкой толщиной 0,5 см. В казане или кастрюле с толстым дном разогрейте растительное масло на сильном огне и обжарьте мясо 5 минут до румяной корочки. Добавьте лук и жарьте 3 минуты до прозрачности, затем морковь, паприку и кориандр и жарьте ещё 4 минуты, помешивая." = "Наріжте яловичину кубиками по 1,5 см, цибулю — півкільцями, моркву — соломкою завтовшки 0,5 см. У казані або каструлі з товстим дном розігрійте олію на сильному вогні й обсмажте м’ясо 5 хвилин до рум’яної скоринки. Додайте цибулю й смажте 3 хвилини до прозорості, потім моркву, паприку й коріандр і смажте ще 4 хвилини, помішуючи.";
"Подлейте кипятка так, чтобы он едва покрывал мясо, накройте крышкой и тушите на слабом огне 40 минут, пока говядина не станет мягкой. Промойте рис в сите до прозрачной воды и выложите ровным слоем поверх мяса, не перемешивая. Вдавите в рис неочищенные зубчики чеснока, аккуратно влейте воду по краю и добавьте соль." = "Долийте окропу так, щоб він ледь покривав м’ясо, накрийте кришкою й тушкуйте на слабкому вогні 40 хвилин, доки яловичина не стане м’якою. Промийте рис у ситі до прозорої води й викладіть рівним шаром поверх м’яса, не перемішуючи. Втисніть у рис неочищені зубчики часнику, обережно влийте воду по краю й додайте сіль.";
"Доведите до кипения на сильном огне, затем убавьте огонь до самого слабого, плотно накройте и готовьте 20 минут, не открывая крышку, пока рис не впитает воду и не станет мягким. Снимите с огня и дайте плову постоять под крышкой 10 минут. Перемешайте плов снизу вверх и подавайте вместе с мягким чесноком." = "Доведіть до кипіння на сильному вогні, потім зменште вогонь до найслабшого, щільно накрийте й готуйте 20 хвилин, не відкриваючи кришку, доки рис не вбере воду й не стане м’яким. Зніміть з вогню й дайте плову постояти під кришкою 10 хвилин. Перемішайте плов знизу догори й подавайте разом із м’яким часником.";
"Снимите с печени плёнку и вырежьте крупные протоки, затем нарежьте её ломтиками толщиной 1 см. Накройте пищевой плёнкой и слегка расплющьте плоской стороной молотка до 0,7 см, не разрывая. Приправьте ломтики с обеих сторон солью и чёрным перцем." = "Зніміть із печінки плівку й виріжте великі протоки, потім наріжте її скибочками завтовшки 1 см. Накрийте харчовою плівкою й злегка розплющте пласким боком молоточка до 0,7 см, не розриваючи. Приправте скибочки з обох боків сіллю та чорним перцем.";
"Разогрейте антипригарную сковороду без масла на среднем огне 2 минуты. Выложите ломтики в один слой и жарьте по 3–4 минуты с каждой стороны, пока снаружи не появится корочка. Проверьте термометром середину самого толстого ломтика: должно быть не меньше 71 °C, сок без красноты." = "Розігрійте антипригарну сковороду без олії на середньому вогні 2 хвилини. Викладіть скибочки в один шар і смажте по 3–4 хвилини з кожного боку, доки зовні не з’явиться скоринка. Перевірте термометром середину найтовщої скибочки: має бути щонайменше 71 °C, сік без червоного кольору.";
"Включите духовку на 190 °C, она прогреется за 12 минут подготовки. Нарежьте свиную вырезку поперёк волокон пластами 1,5 см, накройте плёнкой, слегка отбейте до 1 см и приправьте солью и чёрным перцем. Лук нарежьте тонкими полукольцами, сыр натрите на крупной тёрке." = "Увімкніть духовку на 190 °C, вона прогріється за 12 хвилин підготовки. Наріжте свинячу вирізку впоперек волокон пластами по 1,5 см, накрийте плівкою, злегка відбийте до 1 см і приправте сіллю та чорним перцем. Цибулю наріжте тонкими півкільцями, сир натріть на великій тертці.";
"Уложите мясо в форму в один слой, сверху разложите лук, смажьте тонким слоем майонеза и посыпьте сыром. Запекайте при 190 °C на среднем уровне 20–25 минут, пока сыр не зарумянится, а в самой толстой части свинины не будет 63 °C. Дайте мясу отдохнуть 3 минуты перед подачей." = "Викладіть м’ясо у форму в один шар, зверху розкладіть цибулю, змастіть тонким шаром майонезу й посипте сиром. Запікайте за температури 190 °C на середньому рівні 20–25 хвилин, доки сир не підрум’яниться, а в найтовщій частині свинини не буде 63 °C. Дайте м’ясу відпочити 3 хвилини перед подачею.";
"Разогрейте духовку до 180 °C. Яблоки вымойте, удалите сердцевину и нарежьте кубиками 2 см, сложите в небольшую форму и накройте фольгой. Запекайте 15 минут, пока кубики не станут мягкими, затем снимите фольгу и дайте яблокам остыть 5 минут." = "Розігрійте духовку до 180 °C. Яблука вимийте, видаліть серцевину й наріжте кубиками по 2 см, складіть у невелику форму й накрийте фольгою. Запікайте 15 хвилин, доки кубики не стануть м’якими, потім зніміть фольгу й дайте яблукам охолонути 5 хвилин.";
"Мандарины очистите от кожуры, разберите на дольки и выньте косточки. В креманки выложите слоями тёплые яблоки, йогурт и мандарины, сверху снова немного йогурта, и подавайте сразу." = "Мандарини очистьте від шкірки, розберіть на часточки й вийміть кісточки. У креманки викладіть шарами теплі яблука, йогурт і мандарини, зверху знову трохи йогурту, і подавайте одразу.";
"Включите духовку на 200 °C, противень застелите пергаментом. Баклажан нарежьте вдоль на длинные пласты толщиной 0,5 см и разложите на пергаменте в один слой. Запекайте 12–15 минут, пока пласты не станут мягкими и гибкими, а края не начнут румяниться." = "Увімкніть духовку на 200 °C, деко застеліть пергаментом. Баклажан наріжте вздовж на довгі пласти завтовшки 0,5 см і розкладіть на пергаменті в один шар. Запікайте 12–15 хвилин, доки пласти не стануть м’якими й гнучкими, а краї не почнуть рум’янитися.";
"Сыр и чеснок натрите на мелкой тёрке и разотрите вилкой с творогом, солью и чёрным перцем. Выложите начинку полоской на широкий край каждого пласта и сверните рулетиком. Уложите рулетики швом вниз на тот же противень и прогрейте в духовке 5–7 минут, пока сыр внутри не начнёт плавиться." = "Твердий сир і часник натріть на дрібній тертці й розітріть виделкою з кисломолочним сиром, сіллю та чорним перцем. Викладіть начинку смужкою на широкий край кожного пласта й згорніть рулетиком. Покладіть рулетики швом донизу на те саме деко й прогрійте в духовці 5–7 хвилин, доки сир усередині не почне плавитися.";
"Включите духовку на 190 °C: пока вы 12 минут разделываете рыбу, она прогреется. У скумбрии отрежьте голову, удалите внутренности и тёмную плёнку в брюшке, промойте и обсушите; разрежьте по брюшку, раскройте и выньте хребет с костями. Лук нарежьте тонкими полукольцами, лимон — тонкими кружками, йогурт смешайте с солью и чёрным перцем." = "Увімкніть духовку на 190 °C: поки ви 12 хвилин розбираєте рибу, вона прогріється. У скумбрії відріжте голову, видаліть нутрощі й темну плівку в черевці, промийте й обсушіть; розріжте по черевцю, розкрийте й вийміть хребет із кістками. Цибулю наріжте тонкими півкільцями, лимон — тонкими кружальцями, йогурт змішайте із сіллю та чорним перцем.";
"Разложите лук ровным слоем в форме, сверху положите рыбу кожей вниз, смажьте йогуртом и накройте кружками лимона. Запекайте при 190 °C на среднем уровне 20–25 минут, пока мякоть не станет непрозрачной и не начнёт легко отделяться, а в самой толстой части не будет 63 °C." = "Розкладіть цибулю рівним шаром у формі, зверху покладіть рибу шкірою донизу, змастіть йогуртом і накрийте кружальцями лимона. Запікайте за температури 190 °C на середньому рівні 20–25 хвилин, доки м’якуш не стане непрозорим і не почне легко відділятися, а в найтовщій частині не буде 63 °C.";
"Выжмите сок из апельсина и смешайте в миске с соевым соусом, корицей, солью и чёрным перцем. Утку обсушите бумажным полотенцем, надрежьте кожу сеточкой, не задевая мясо, обваляйте в маринаде и уберите в холодильник на 20 минут. Пока утка маринуется, разогрейте духовку до 180 °C." = "Вичавіть сік з апельсина й змішайте в мисці із соєвим соусом, корицею, сіллю та чорним перцем. Качку обсушіть паперовим рушником, надріжте шкіру сіточкою, не зачіпаючи м’ясо, обваляйте в маринаді й поставте в холодильник на 20 хвилин. Поки качка маринується, розігрійте духовку до 180 °C.";
"Переложите утку с маринадом в небольшую форму кожей вверх. Запекайте при 180 °C на среднем уровне 45–55 минут, поливая соком из формы каждые 15 минут; если кожа темнеет слишком быстро, накройте её фольгой. Утка готова, когда в самой толстой части 74 °C, а сок при проколе прозрачный." = "Перекладіть качку з маринадом у невелику форму шкірою догори. Запікайте за температури 180 °C на середньому рівні 45–55 хвилин, поливаючи соком із форми кожні 15 хвилин; якщо шкіра темніє занадто швидко, накрийте її фольгою. Качка готова, коли в найтовщій частині 74 °C, а сік під час проколювання прозорий.";
"Переберите гречку, промойте в сите и переложите в кастрюлю, залейте холодной водой и добавьте соль. Доведите до кипения на сильном огне, убавьте огонь до слабого, накройте крышкой и варите 15 минут, пока вода не впитается, а зёрна не станут мягкими." = "Переберіть гречку, промийте в ситі й перекладіть у каструлю, залийте холодною водою й додайте сіль. Доведіть до кипіння на сильному вогні, зменште вогонь до слабкого, накрийте кришкою й варіть 15 хвилин, доки вода не вбереться, а зерна не стануть м’якими.";
"Снимите кастрюлю с огня и оставьте гречку под крышкой на 5 минут, затем разрыхлите вилкой. Тем временем вымойте томаты и нарежьте дольками. Разложите гречку по тарелкам, а томаты положите рядом." = "Зніміть каструлю з вогню й залиште гречку під кришкою на 5 хвилин, потім розпушіть виделкою. Тим часом вимийте помідори й наріжте часточками. Розкладіть гречку по тарілках, а помідори покладіть поруч.";
"Срежьте у сладкого перца верхушки с плодоножкой, удалите семена и белые перегородки и промойте перцы внутри. Морковь натрите на мелкой тёрке, лук нарежьте очень мелко. В миске вымешайте мясной фарш с варёным рисом, морковью, луком, солью и чёрным перцем до однородности." = "Зріжте із солодкого перцю верхівки з плодоніжкою, видаліть насіння й білі перегородки та промийте перці всередині. Моркву натріть на дрібній тертці, цибулю наріжте дуже дрібно. У мисці вимісіть фарш із вареним рисом, морквою, цибулею, сіллю та чорним перцем до однорідності.";
"Наполните перцы начинкой, не утрамбовывая, и поставьте вертикально в кастрюлю, где они стоят плотно друг к другу. Влейте томатный сок и воду и доведите до кипения на среднем огне. Накройте крышкой и тушите на слабом огне 35 минут, пока перцы не станут мягкими, а в центре начинки не будет 74 °C." = "Наповніть перці начинкою, не утрамбовуючи, і поставте вертикально в каструлю, де вони стоять щільно один до одного. Влийте томатний сік і воду й доведіть до кипіння на середньому вогні. Накрийте кришкою й тушкуйте на слабкому вогні 35 хвилин, доки перці не стануть м’якими, а в центрі начинки не буде 74 °C.";
"Включите духовку на 180 °C, ей нужно около 10 минут, чтобы прогреться. Тем временем мелко порубите зелень и разотрите её вилкой в миске с творогом и солью. Сыр натрите на крупной тёрке или нарежьте очень тонкими ломтиками." = "Увімкніть духовку на 180 °C, їй потрібно близько 10 хвилин, щоб прогрітися. Тим часом дрібно посічіть зелень і розітріть її виделкою в мисці з кисломолочним сиром і сіллю. Твердий сир натріть на великій тертці або наріжте дуже тонкими скибочками.";
"Намажьте творог на ржаные криспы ровным слоем и сверху разложите сыр. Выложите криспы на противень и прогрейте при 180 °C на среднем уровне 3–4 минуты, пока сыр не расплавится. Подавайте сразу, пока криспы хрустят." = "Намажте кисломолочний сир рівним шаром на житні хлібці й зверху розкладіть твердий сир. Викладіть хлібці на деко й прогрійте за температури 180 °C на середньому рівні 3–4 хвилини, доки сир не розплавиться. Подавайте одразу, поки хлібці хрумкі.";
"Прощупайте минтай пальцами и выньте все кости, затем нарежьте его плоскими кусочками примерно 4 на 6 см и толщиной 1–1,5 см. Обсушите рыбу бумажным полотенцем со всех сторон. В миске взбейте вилкой яйцо с рисовой мукой, солью и чёрным перцем до гладкого кляра без комочков." = "Промацайте минтай пальцями й вийміть усі кістки, потім наріжте його пласкими шматочками приблизно 4 на 6 см завтовшки 1–1,5 см. Обсушіть рибу паперовим рушником з усіх боків. У мисці збийте виделкою яйце з рисовим борошном, сіллю та чорним перцем до гладкого кляру без грудочок.";
"Разогрейте антипригарную сковороду на среднем огне 2 минуты и смажьте дно растительным маслом с помощью бумажного полотенца. Обмакните каждый кусочек рыбы в кляр, дайте лишнему стечь и выложите на сковороду. Жарьте по 3–4 минуты с каждой стороны, пока кляр не зарумянится, а рыба не станет белой и не начнёт легко расслаиваться; в самой толстой части 63 °C." = "Розігрійте антипригарну сковороду на середньому вогні 2 хвилини й змастіть дно олією за допомогою паперового рушника. Вмочіть кожен шматочок риби в кляр, дайте надлишку стекти й викладіть на сковороду. Смажте по 3–4 хвилини з кожного боку, доки кляр не зарум’яниться, а риба не стане білою й не почне легко розшаровуватися; у найтовщій частині 63 °C.";
"Разогрейте духовку до 190 °C. Удалите из минтая все кости, нарежьте его кусками, лук очистите и разрежьте на четвертинки. Измельчите рыбу с луком в блендере или мясорубке в однородный фарш, вмешайте яйцо, соль и чёрный перец и оставьте массу на 5 минут, чтобы она загустела." = "Розігрійте духовку до 190 °C. Видаліть із минтаю всі кістки, наріжте його шматками, цибулю очистіть і розріжте на чвертинки. Подрібніть рибу з цибулею в блендері або м’ясорубці до однорідного фаршу, вмішайте яйце, сіль і чорний перець та залиште масу на 5 хвилин, щоб вона загусла.";
"Застелите противень пергаментом. Мокрыми руками сформуйте небольшие плоские котлеты толщиной около 1,5 см и выложите их с промежутками. Запекайте на среднем уровне 15–20 минут, пока верх не подрумянится, а в центре котлеты не будет 74 °C; на разрезе масса белая и плотная." = "Застеліть деко пергаментом. Мокрими руками сформуйте невеликі пласкі котлети завтовшки близько 1,5 см і викладіть їх із проміжками. Запікайте на середньому рівні 15–20 хвилин, доки верх не підрум’яниться, а в центрі котлети не буде 74 °C; на розрізі маса біла й щільна.";
"Капусту нашинкуйте тонкой соломкой, лук нарежьте мелкими кубиками, у сладкого перца удалите семена и нарежьте его полосками, морковь натрите на крупной тёрке. Сложите овощи в сотейник с толстым дном, залейте томатным соком, добавьте паприку и доведите до кипения. Тушите под крышкой на слабом огне 20–25 минут, помешивая, пока капуста не станет мягкой." = "Капусту нашаткуйте тонкою соломкою, цибулю наріжте дрібними кубиками, із солодкого перцю видаліть насіння й наріжте його смужками, моркву натріть на великій тертці. Складіть овочі в сотейник із товстим дном, залийте томатним соком, додайте паприку й доведіть до кипіння. Тушкуйте під кришкою на слабкому вогні 20–25 хвилин, помішуючи, доки капуста не стане м’якою.";
"Снимите сотейник с огня, не открывая крышку. Вскипятите воду в небольшой кастрюле, посолите, всыпьте промытую гречку и варите без крышки на среднем огне 15–18 минут, пока зёрна не станут мягкими, затем слейте остаток воды через сито. Добавьте в овощи соль и чёрный перец, перемешайте и подайте рядом с гречкой или смешайте их." = "Зніміть сотейник із вогню, не відкриваючи кришки. Закип’ятіть воду в невеликій каструлі, посоліть, всипте промиту гречку й варіть без кришки на середньому вогні 15–18 хвилин, доки зерна не стануть м’якими, потім злийте залишок води через сито. Додайте до овочів сіль і чорний перець, перемішайте й подайте поруч із гречкою або змішайте їх.";
"Лук очистите и мелко нарежьте, половину сразу вмешайте в мясной фарш вместе с рисовой мукой, солью и чёрным перцем. Хорошо вымесите фарш руками и мокрыми ладонями скатайте фрикадельки размером с грецкий орех, около 2,5 см. Сложите их на тарелку." = "Цибулю очистіть і дрібно наріжте, половину одразу вмішайте в м’ясний фарш разом із рисовим борошном, сіллю та чорним перцем. Добре вимісіть фарш руками й мокрими долонями скачайте фрикадельки завбільшки з волоський горіх, близько 2,5 см. Складіть їх на тарілку.";
"Вскипятите воду в большой кастрюле, морковь нарежьте мелкими кубиками. Всыпьте в кипящую воду промытую гречку, морковь, оставшийся лук и лавровый лист и варите на среднем огне 10 минут. Опустите фрикадельки по одной, после закипания убавьте огонь до слабого и варите 12–15 минут, снимая пену; в центре фрикадельки 74 °C, на разрезе нет розового." = "Закип’ятіть воду у великій каструлі, моркву наріжте дрібними кубиками. Всипте в окріп промиту гречку, моркву, решту цибулі та лавровий лист і варіть на середньому вогні 10 хвилин. Опускайте фрикадельки по одній, після закипання зменште вогонь до слабкого й варіть 12–15 хвилин, знімаючи піну; у центрі фрикадельки 74 °C, на розрізі немає рожевого.";
"Попробуйте гречку: зёрна должны быть мягкими. Выньте лавровый лист, попробуйте суп на соль и перед раскладкой перемешайте его половником со дна, чтобы в каждую тарелку попали и крупа, и фрикадельки." = "Скуштуйте гречку: зерна мають бути м’якими. Вийміть лавровий лист, скуштуйте суп на сіль і перед розкладанням перемішайте його ополоником із дна, щоб у кожну тарілку потрапили і крупа, і фрикадельки.";
"Высыпьте гречку на тарелку, уберите тёмные зёрна и мусор, затем промойте её в сите под холодной водой. Переложите в маленькую кастрюлю с толстым дном, залейте холодной водой, добавьте соль и доведите до кипения на сильном огне, около 2–3 минут." = "Висипте гречку на тарілку, приберіть темні зерна й сміття, потім промийте її в ситі під холодною водою. Перекладіть у маленьку каструлю з товстим дном, залийте холодною водою, додайте сіль і доведіть до кипіння на сильному вогні, близько 2–3 хвилин.";
"Сразу убавьте огонь до слабого, накройте кастрюлю крышкой и варите 15 минут, не помешивая, пока вода полностью не впитается, а зёрна не станут мягкими. Снимите кастрюлю с плиты, подержите под крышкой ещё 5 минут и разрыхлите гречку вилкой." = "Одразу зменште вогонь до слабкого, накрийте каструлю кришкою й варіть 15 хвилин, не помішуючи, доки вода повністю не вбереться, а зерна не стануть м’якими. Зніміть каструлю з плити, потримайте під кришкою ще 5 хвилин і розпушіть гречку виделкою.";
"Яблоки вымойте, разрежьте на четвертинки, удалите сердцевину и нарежьте кубиками около 2 см; кожуру можно срезать. Сложите их в маленькую кастрюлю, влейте воду, накройте крышкой и прогрейте на слабом огне 10–15 минут, помешивая, пока кусочки не станут мягкими. Разомните яблоки вилкой или толкушкой в пюре." = "Яблука помийте, розріжте на чвертинки, видаліть серцевину й наріжте кубиками близько 2 см; шкірку можна зрізати. Складіть їх у маленьку каструлю, влийте воду, накрийте кришкою й прогрійте на слабкому вогні 10–15 хвилин, помішуючи, доки шматочки не стануть м’якими. Розімніть яблука виделкою або товкачиком у пюре.";
"Переложите пюре в миску и оставьте на 10 минут, чтобы оно остыло до тёплого. Разложите творог и яблочное пюре по креманкам слоями или перемешайте их прямо перед подачей." = "Перекладіть пюре в миску й залиште на 10 хвилин, щоб воно охололо до теплого. Розкладіть кисломолочний сир і яблучне пюре в креманки шарами або перемішайте їх безпосередньо перед подаванням.";
"Поставьте антипригарную сковороду на средний огонь и прогрейте её 1–2 минуты без масла. Аккуратно разбейте в неё яйца, не повредив желтки, и посыпьте их солью." = "Поставте антипригарну сковороду на середній вогонь і прогрійте її 1–2 хвилини без олії. Обережно розбийте в неї яйця, не пошкодивши жовтків, і посипте їх сіллю.";
"Накройте сковороду крышкой и убавьте огонь до слабого. Готовьте 5–6 минут, пока белок полностью не схватится и не станет белым, а желток не станет плотным, без жидкой середины. Снимите яичницу лопаткой на тарелку." = "Накрийте сковороду кришкою й зменште вогонь до слабкого. Готуйте 5–6 хвилин, доки білок повністю не схопиться й не стане білим, а жовток не стане щільним, без рідкої серединки. Зніміть яєчню лопаткою на тарілку.";
"Переберите чечевицу на светлой тарелке, убирая камешки и тёмные зёрна, и промойте её в сите под холодной водой. Переложите в небольшую кастрюлю, залейте холодной водой и доведите до кипения на сильном огне, это займёт около 3 минут." = "Переберіть сочевицю на світлій тарілці, прибираючи камінці й темні зерна, і промийте її в ситі під холодною водою. Перекладіть у невелику каструлю, залийте холодною водою й доведіть до кипіння на сильному вогні, це триватиме близько 3 хвилин.";
"Снимите пену, убавьте огонь до слабого, накройте крышкой, оставив щель, и варите 25–30 минут, пока зёрна не станут мягкими, но сохранят форму. Если вода выкипит раньше, долейте немного кипятка. В конце добавьте соль, перемешайте и слейте остаток жидкости через сито." = "Зніміть піну, зменште вогонь до слабкого, накрийте кришкою, залишивши щілину, і варіть 25–30 хвилин, доки зерна не стануть м’якими, але збережуть форму. Якщо вода википить раніше, долийте трохи окропу. Наприкінці додайте сіль, перемішайте й злийте залишок рідини через сито.";
"Вымойте листья салата и черри, обсушите салат полотенцем и порвите руками на крупные кусочки. Черри разрежьте пополам, моцареллу нарежьте кубиками 1,5 см. Разрежьте авокадо, выньте косточку, выберите мякоть ложкой в миску и сразу разомните её вилкой с лимонным соком." = "Помийте листя салату й черрі, обсушіть салат рушником і порвіть руками на великі шматочки. Черрі розріжте навпіл, моцарелу наріжте кубиками 1,5 см. Розріжте авокадо, вийміть кісточку, виберіть м’якоть ложкою в миску й одразу розімніть її виделкою з лимонним соком.";
"Чеснок очистите, мелко натрите и добавьте к авокадо вместе с оливковым маслом, водой, солью и чёрным перцем. Взбейте вилкой или блендером в гладкий густой крем. Разложите листья, томаты и моцареллу по тарелкам, а крем из авокадо выложите сверху прямо перед подачей." = "Часник очистіть, дрібно натріть і додайте до авокадо разом з оливковою олією, водою, сіллю та чорним перцем. Збийте виделкою або блендером у гладкий густий крем. Розкладіть листя, помідори й моцарелу по тарілках, а крем з авокадо викладіть зверху безпосередньо перед подаванням.";
"Вымойте редис и огурец и срежьте у них кончики. Нарежьте овощи тонкими полукружьями толщиной 2–3 мм и сложите в миску. Зелёный лук мелко порубите и добавьте туда же." = "Помийте редиску й огірок і зріжте в них кінчики. Наріжте овочі тонкими півкружальцями завтовшки 2–3 мм і складіть у миску. Зелену цибулю дрібно посічіть і додайте туди ж.";
"В отдельной чашке размешайте йогурт со сметаной, солью и чёрным перцем до гладкости. Полейте овощи соусом и перемешайте прямо перед едой: если заправить заранее, огурец пустит сок и салат перестанет хрустеть." = "В окремій чашці розмішайте йогурт зі сметаною, сіллю та чорним перцем до гладкості. Полийте овочі соусом і перемішайте безпосередньо перед їжею: якщо заправити заздалегідь, огірок пустить сік і салат перестане хрумтіти.";
"Вымойте огурцы, срежьте кончики и разрежьте каждый вдоль на 4 части. Чеснок очистите и раздавите плоской стороной ножа, петрушку крупно порвите руками. Сложите огурцы, чеснок и петрушку в плотный пакет с застёжкой или контейнер с крышкой и посыпьте солью." = "Помийте огірки, зріжте кінчики й розріжте кожен уздовж на 4 частини. Часник очистіть і роздавіть пласким боком ножа, петрушку грубо порвіть руками. Складіть огірки, часник і петрушку в щільний пакет із застібкою або контейнер із кришкою та посипте сіллю.";
"Закройте пакет, выпустив воздух, и потрясите его 1 минуту, чтобы соль разошлась по огурцам. Уберите в холодильник минимум на 2 часа, через час переверните пакет. Это быстрая закуска, а не заготовка: храните её только в холодильнике." = "Закрийте пакет, випустивши повітря, і струшуйте його 1 хвилину, щоб сіль розійшлася по огірках. Приберіть у холодильник щонайменше на 2 години, через годину переверніть пакет. Це швидка закуска, а не заготовка: зберігайте її тільки в холодильнику.";
"Пекинскую капусту тонко нашинкуйте поперёк кочана полосками около 0,5 см. Морковь очистите и натрите на тёрке для корейской моркови или нарежьте тонкой соломкой, зелёный лук нарежьте колечками. Имбирь очистите краем ложки и натрите на мелкой тёрке." = "Пекінську капусту тонко нашаткуйте впоперек качана смужками близько 0,5 см. Моркву очистіть і натріть на тертці для корейської моркви або наріжте тонкою соломкою, зелену цибулю наріжте кружальцями. Імбир очистіть краєм ложки й натріть на дрібній тертці.";
"В маленькой миске размешайте соевый соус, винный уксус, кунжутное масло и тёртый имбирь. Сложите овощи в салатник, полейте заправкой, перемешайте и подавайте сразу, пока капуста хрустит." = "У маленькій мисці розмішайте соєвий соус, винний оцет, кунжутну олію й тертий імбир. Складіть овочі в салатник, полийте заправкою, перемішайте й подавайте одразу, поки капуста хрумтить.";
"Разрежьте авокадо вдоль, выньте косточку, снимите кожуру и нарежьте мякоть кубиками 2 см. Сразу сбрызните её лимонным соком, чтобы она не потемнела. Томаты вымойте, вырежьте место крепления плодоножки и нарежьте такими же кубиками." = "Розріжте авокадо вздовж, вийміть кісточку, зніміть шкірку й наріжте м’якоть кубиками 2 см. Одразу збризніть її лимонним соком, щоб вона не потемніла. Помідори помийте, виріжте місце кріплення плодоніжки й наріжте такими самими кубиками.";
"Чеснок очистите и раздавите прессом, смешайте в чашке с оливковым маслом, соевым соусом, солью и чёрным перцем. Полейте авокадо и томаты и осторожно перемешайте ложкой снизу вверх, чтобы кубики авокадо не превратились в пюре." = "Часник очистіть і роздавіть пресом, змішайте в чашці з оливковою олією, соєвим соусом, сіллю та чорним перцем. Полийте авокадо й помідори та обережно перемішайте ложкою знизу вгору, щоб кубики авокадо не перетворилися на пюре.";
"Включите духовку на 200 °C: пока вы режете овощи, за 10 минут она как раз прогреется. Баклажан, кабачок и сладкий перец без семян нарежьте кусками около 3 см, лук — дольками; мелкие шампиньоны оставьте целыми. В большой миске перемешайте овощи с измельчённым чесноком, оливковым маслом, соевым соусом и лимонным соком." = "Увімкніть духовку на 200 °C: поки ви ріжете овочі, за 10 хвилин вона якраз прогріється. Баклажан, кабачок і солодкий перець без насіння наріжте шматками близько 3 см, цибулю — часточками; дрібні печериці залиште цілими. У великій мисці перемішайте овочі з подрібненим часником, оливковою олією, соєвим соусом і лимонним соком.";
"Выложите овощи одним слоем на противень, застеленный пергаментом. Запекайте на среднем уровне 30–35 минут, через 15 минут переверните их лопаткой. Овощи готовы, когда баклажан мягкий, а края у кусочков зарумянились." = "Викладіть овочі одним шаром на деко, застелене пергаментом. Запікайте на середньому рівні 30–35 хвилин, через 15 хвилин переверніть їх лопаткою. Овочі готові, коли баклажан м’який, а краї шматочків зарум’янилися.";
"Томаты вымойте и нарежьте дольками, удалив жёсткое место у плодоножки. Фету раскрошите руками или вилкой на кусочки около 1 см. Укроп обсушите и мелко порубите." = "Помідори помийте й наріжте часточками, видаливши тверде місце біля плодоніжки. Фету розкришіть руками або виделкою на шматочки близько 1 см. Кріп обсушіть і дрібно посічіть.";
"Разложите томаты по тарелкам, посыпьте фетой и укропом и полейте оливковым маслом. Поперчите чёрным перцем, а соль добавляйте только после пробы и не больше щепотки, потому что фета сама солёная." = "Розкладіть помідори по тарілках, посипте фетою й кропом і полийте оливковою олією. Поперчіть чорним перцем, а сіль додавайте лише після проби й не більше дрібки, бо фета сама солона.";
"Вымойте листья салата, тщательно обсушите и порвите руками на кусочки 3–4 см. Томаты нарежьте дольками, огурец — полукружьями толщиной 0,5 см, у сладкого перца удалите семена и нарежьте его тонкими полосками." = "Помийте листя салату, ретельно обсушіть і порвіть руками на шматочки 3–4 см. Помідори наріжте часточками, огірок — півкружальцями завтовшки 0,5 см, із солодкого перцю видаліть насіння й наріжте його тонкими смужками.";
"В маленькой банке или чашке размешайте вилкой горчицу с лимонным соком, затем добавьте оливковое масло, соль и чёрный перец и мешайте, пока заправка не станет однородной. Сложите овощи в салатник, полейте заправкой и перемешайте прямо перед подачей, чтобы листья не обмякли." = "У маленькій баночці або чашці розмішайте виделкою гірчицю з лимонним соком, потім додайте оливкову олію, сіль і чорний перець і мішайте, доки заправка не стане однорідною. Складіть овочі в салатник, полийте заправкою й перемішайте безпосередньо перед подаванням, щоб листя не зів’яло.";
"Кабачок вымойте и нарежьте мелкими кубиками 1 см; толстую кожуру срежьте. Морковь натрите на крупной тёрке, лук мелко нарежьте. Разогрейте растительное масло в сотейнике с толстым дном на среднем огне и обжаривайте лук с морковью 5–7 минут, помешивая, пока лук не станет мягким и прозрачным." = "Кабачок помийте й наріжте дрібними кубиками 1 см; товсту шкірку зріжте. Моркву натріть на великій тертці, цибулю дрібно наріжте. Розігрійте олію в сотейнику з товстим дном на середньому вогні й обсмажуйте цибулю з морквою 5–7 хвилин, помішуючи, доки цибуля не стане м’якою й прозорою.";
"Добавьте кабачок, томатный сок, сушёный чеснок, соль и чёрный перец и доведите до кипения. Тушите под крышкой на слабом огне 30 минут, помешивая каждые 10 минут, затем снимите крышку и тушите ещё 10 минут, пока кабачок не станет совсем мягким, а лишняя жидкость не выпарится. Разомните толкушкой или блендером до нужной густоты; остатки быстро остудите и уберите в холодильник." = "Додайте кабачок, томатний сік, сушений часник, сіль і чорний перець і доведіть до кипіння. Тушкуйте під кришкою на слабкому вогні 30 хвилин, помішуючи кожні 10 хвилин, потім зніміть кришку й тушкуйте ще 10 хвилин, доки кабачок не стане зовсім м’яким, а зайва рідина не випарується. Розімніть товкачиком або блендером до потрібної густоти; залишки швидко остудіть і приберіть у холодильник.";
"Свёклу вымойте, очистите и нарежьте кубиками 1 см. Сложите в кастрюлю, залейте холодной водой так, чтобы она покрывала кубики, и после закипания варите на среднем огне 15–20 минут, пока нож не будет входить легко. Слейте воду и разложите свёклу на тарелке, чтобы она полностью остыла, около 15 минут." = "Буряк помийте, очистіть і наріжте кубиками 1 см. Складіть у каструлю, залийте холодною водою так, щоб вона покривала кубики, і після закипання варіть на середньому вогні 15–20 хвилин, доки ніж не входитиме легко. Злийте воду й розкладіть буряк на тарілці, щоб він повністю охолов, близько 15 хвилин.";
"Томаты нарежьте кубиками такого же размера, зелёный лук порубите колечками. Соедините их со свёклой в миске, добавьте оливковое масло и соль и перемешайте прямо перед подачей, чтобы томаты не пустили много сока." = "Помідори наріжте кубиками такого самого розміру, зелену цибулю посічіть кружальцями. З’єднайте їх із буряком у мисці, додайте оливкову олію й сіль і перемішайте безпосередньо перед подаванням, щоб помідори не пустили багато соку.";
"Капусту нашинкуйте как можно тоньше, сложите в миску, посыпьте солью и 1 минуту мните руками, пока она не станет мягче и влажной. Огурец нарежьте тонкой соломкой, укроп и зелёный лук мелко порубите." = "Капусту нашаткуйте якомога тонше, складіть у миску, посипте сіллю й 1 хвилину розминайте її руками, доки вона не стане м’якшою й вологою. Огірок наріжте тонкою соломкою, кріп і зелену цибулю дрібно посічіть.";
"Размешайте в чашке лимонный сок с растительным маслом и чёрным перцем. Добавьте к капусте огурец, укроп и лук, полейте заправкой, перемешайте и сразу подавайте, не оставляя салат настаиваться." = "Розмішайте в чашці лимонний сік з олією та чорним перцем. Додайте до капусти огірок, кріп і цибулю, полийте заправкою, перемішайте й одразу подавайте, не залишаючи салат настоюватися.";
"Вымойте овощи. Томаты и огурец нарежьте кубиками около 1,5 см, у сладкого перца удалите семена и нарежьте его такими же кубиками. Зелень промойте, обсушите полотенцем и мелко порубите." = "Помийте овочі. Помідори й огірок наріжте кубиками близько 1,5 см, із солодкого перцю видаліть насіння й наріжте його такими самими кубиками. Зелень промийте, обсушіть рушником і дрібно посічіть.";
"Сложите овощи и зелень в миску, добавьте оливковое масло, соль и чёрный перец. Аккуратно перемешайте и сразу разложите по тарелкам, пока овощи не пустили сок." = "Складіть овочі й зелень у миску, додайте оливкову олію, сіль і чорний перець. Обережно перемішайте й одразу розкладіть по тарілках, поки овочі не пустили сік.";
"Разогрейте духовку до 200 °C. Баклажаны вымойте, проколите вилкой в нескольких местах, положите на противень и запекайте 35–45 минут, пока кожура не сморщится, а мякоть не станет совсем мягкой. Пока они запекаются, мелко нарежьте лук, у сладкого перца удалите семена и нарежьте его кубиками 0,5 см, морковь натрите на мелкой тёрке." = "Розігрійте духовку до 200 °C. Баклажани помийте, проколіть виделкою в кількох місцях, покладіть на деко й запікайте 35–45 хвилин, доки шкірка не зморщиться, а м’якоть не стане зовсім м’якою. Поки вони запікаються, дрібно наріжте цибулю, із солодкого перцю видаліть насіння й наріжте його кубиками 0,5 см, моркву натріть на дрібній тертці.";
"Остудите баклажаны 5 минут, разрежьте вдоль и выберите мякоть ложкой. Разогрейте растительное масло в сотейнике на среднем огне и обжаривайте лук, морковь и перец 7–8 минут до мягкости. Добавьте мякоть баклажана, томатный сок, паприку, сушёный чеснок, орегано, соль и чёрный перец, тушите под крышкой на слабом огне 10 минут и разомните толкушкой." = "Остудіть баклажани 5 хвилин, розріжте вздовж і виберіть м’якоть ложкою. Розігрійте олію в сотейнику на середньому вогні й обсмажуйте цибулю, моркву та перець 7–8 хвилин до м’якості. Додайте м’якоть баклажана, томатний сік, паприку, сушений часник, орегано, сіль і чорний перець, тушкуйте під кришкою на слабкому вогні 10 хвилин і розімніть товкачиком.";
"Вымойте листья салата и рукколу, тщательно обсушите и порвите салат на кусочки. Черри разрежьте пополам, сливы разрежьте, выньте косточки и нарежьте дольками, сыр с белой плесенью нарежьте кубиками 1,5 см." = "Помийте листя салату й руколу, ретельно обсушіть і порвіть салат на шматочки. Черрі розріжте навпіл, сливи розріжте, вийміть кісточки й наріжте часточками, сир із білою пліснявою наріжте кубиками 1,5 см.";
"В чашке размешайте горчицу, лимонный сок, кунжутное масло, соевый соус, базилик, орегано, соль и чёрный перец до однородности. Полейте заправкой листья, черри и сливы, аккуратно перемешайте, а сыр разложите сверху." = "У чашці розмішайте гірчицю, лимонний сік, кунжутну олію, соєвий соус, базилік, орегано, сіль і чорний перець до однорідності. Полийте заправкою листя, черрі й сливи, обережно перемішайте, а сир розкладіть зверху.";
"Свёклу очистите, нарежьте кубиками 1 см и варите в небольшой кастрюле в кипящей воде на среднем огне 15–20 минут, пока нож не будет входить легко. Слейте воду и остудите свёклу на тарелке 15 минут. Тем временем вымойте и обсушите листья салата, черри разрежьте пополам, солёные огурцы нарежьте кубиками, а лук — тонкими полукольцами." = "Буряк очистіть, наріжте кубиками 1 см і варіть у невеликій каструлі в окропі на середньому вогні 15–20 хвилин, доки ніж не входитиме легко. Злийте воду й остудіть буряк на тарілці 15 хвилин. Тим часом помийте й обсушіть листя салату, черрі розріжте навпіл, солоні огірки наріжте кубиками, а цибулю — тонкими півкільцями.";
"Чеснок очистите, мелко натрите и взбейте вилкой с ореховым маслом и яблочным уксусом. Сложите в миску листья, черри, огурцы, лук и свёклу, полейте заправкой и перемешайте, а сверху раскрошите фету." = "Часник очистіть, дрібно натріть і збийте виделкою з горіховою олією та яблучним оцтом. Складіть у миску листя, черрі, огірки, цибулю й буряк, полийте заправкою й перемішайте, а зверху розкришіть фету.";
"Говядину и свинину нарежьте кубиками около 2 см, баклажан — кубиками 3 см, томаты — кубиками 1,5 см. Лук и чеснок очистите и мелко нарежьте. Налейте растительное масло в толстостенную кастрюлю и прогрейте на среднем огне 2 минуты." = "Яловичину й свинину наріжте кубиками близько 2 см, баклажан — кубиками 3 см, помідори — кубиками 1,5 см. Цибулю й часник очистіть і дрібно наріжте. Налийте олію в товстостінну каструлю й прогрійте на середньому вогні 2 хвилини.";
"Выложите мясо в кастрюлю и обжаривайте 8–10 минут, помешивая, пока куски не подрумянятся со всех сторон. Добавьте лук, чеснок, томаты, баклажан, прованские травы, кориандр, лавровый лист, соль и чёрный перец и влейте немного горячей воды, чтобы покрыть дно. Накройте крышкой и томите на слабом огне 50–60 минут, помешивая раз в 15 минут, пока говядина не станет мягкой." = "Викладіть м’ясо в каструлю й обсмажуйте 8–10 хвилин, помішуючи, доки шматки не підрум’яняться з усіх боків. Додайте цибулю, часник, помідори, баклажан, прованські трави, коріандр, лавровий лист, сіль і чорний перець і влийте трохи гарячої води, щоб покрити дно. Накрийте кришкою й тушкуйте на слабкому вогні 50–60 хвилин, помішуючи раз на 15 хвилин, доки яловичина не стане м’якою.";
"Снимите кастрюлю с огня, выньте лавровый лист и попробуйте рагу на соль. Мелко порубите зелень, разложите рагу по тарелкам и посыпьте зеленью." = "Зніміть каструлю з вогню, вийміть лавровий лист і скуштуйте рагу на сіль. Дрібно посічіть зелень, розкладіть рагу по тарілках і посипте зеленню.";
"Поставьте духовку греться на 190 °C. Цукини натрите на крупной тёрке и крепко отожмите руками от сока. Шампиньоны и лук мелко порубите, сложите в миску вместе с цукини, мясным фаршем, яйцом, рисовой мукой, солью и чёрным перцем и вымешивайте 1–2 минуты до однородности." = "Поставте духовку грітися на 190 °C. Цукіні натріть на великій тертці й міцно відіжміть руками від соку. Печериці й цибулю дрібно посічіть, складіть у миску разом із цукіні, м’ясним фаршем, яйцем, рисовим борошном, сіллю та чорним перцем і вимішуйте 1–2 хвилини до однорідності.";
"Застелите противень пергаментом, мокрыми руками сформуйте небольшие котлеты толщиной 2 см и выложите с промежутками. Смажьте их сверху растительным маслом с помощью кисточки. Запекайте на среднем уровне 25–30 минут, пока котлеты не подрумянятся; в центре 74 °C, сок прозрачный, на разрезе нет розового." = "Застеліть деко пергаментом, мокрими руками сформуйте невеликі котлети завтовшки 2 см і викладіть із проміжками. Змастіть їх зверху олією за допомогою пензлика. Запікайте на середньому рівні 25–30 хвилин, доки котлети не підрум’яняться; у центрі 74 °C, сік прозорий, на розрізі немає рожевого.";
"Промойте печень индейки, обсушите бумажным полотенцем, срежьте плёнки и прожилки и нарежьте кусочками около 3 см. Лук очистите и нарежьте тонкими полукольцами. Яблоко вымойте, разрежьте на четвертинки, удалите сердцевину и нарежьте дольками толщиной 1 см." = "Промийте печінку індички, обсушіть паперовим рушником, зріжте плівки й прожилки та наріжте шматочками близько 3 см. Цибулю очистіть і наріжте тонкими півкільцями. Яблуко помийте, розріжте на чвертинки, видаліть серцевину й наріжте часточками завтовшки 1 см.";
"Разогрейте растительное масло в большой сковороде на среднем огне и обжаривайте лук 5–6 минут, помешивая, пока он не станет мягким. Добавьте печень и жарьте 6–8 минут, переворачивая, затем положите яблоки, соль и чёрный перец и готовьте ещё 5 минут. Печень готова, когда на разрезе нет розового, сок прозрачный, а в самой толстой части 74 °C." = "Розігрійте олію у великій сковороді на середньому вогні й обсмажуйте цибулю 5–6 хвилин, помішуючи, доки вона не стане м’якою. Додайте печінку й смажте 6–8 хвилин, перевертаючи, потім покладіть яблука, сіль і чорний перець і готуйте ще 5 хвилин. Печінка готова, коли на розрізі немає рожевого, сік прозорий, а в найтовщій частині 74 °C.";
"Вымойте листья салата, обсушите и порвите на крупные кусочки, томаты нарежьте дольками. Чеснок очистите, мелко порубите ножом и смешайте в чашке с солью и чёрным перцем." = "Помийте листя салату, обсушіть і порвіть на великі шматочки, помідори наріжте часточками. Часник очистіть, дрібно посічіть ножем і змішайте в чашці із сіллю та чорним перцем.";
"Разложите листья и томаты по тарелкам. Сверху выложите ложкой зернистый творог небольшими горками и посыпьте всё чесночной смесью; масло и соус не добавляйте." = "Розкладіть листя й помідори по тарілках. Зверху викладіть ложкою зернистий сир невеликими гірками й посипте все часниковою сумішшю; олію та соус не додавайте.";
"Тыкву, морковь и лук очистите и нарежьте кубиками 1,5 см, чеснок мелко порубите. Сложите овощи в кастрюлю вместе с промытым рисом, влейте мясной бульон и долейте горячей воды, чтобы она покрывала овощи на 1 см. Доведите до кипения и варите под крышкой на слабом огне 15 минут." = "Гарбуз, моркву й цибулю очистіть і наріжте кубиками 1,5 см, часник дрібно посічіть. Складіть овочі в каструлю разом із промитим рисом, влийте м’ясний бульйон і долийте гарячої води, щоб вона покривала овочі на 1 см. Доведіть до кипіння й варіть під кришкою на слабкому вогні 15 хвилин.";
"Добавьте соцветия брокколи и стручковую фасоль, нарезанную кусочками 3 см, и варите ещё 8–10 минут, пока все овощи не станут мягкими. Снимите кастрюлю с огня и измельчите суп погружным блендером в пюре, затем вмешайте тёртый сыр, соль и чёрный перец. Разлейте по тарелкам и посыпьте мелко нарубленной зеленью." = "Додайте суцвіття броколі та стручкову квасолю, нарізану шматочками 3 см, і варіть ще 8–10 хвилин, доки всі овочі не стануть м’якими. Зніміть каструлю з вогню й подрібніть суп заглибним блендером у пюре, потім вмішайте тертий сир, сіль і чорний перець. Розлийте по тарілках і посипте дрібно посіченою зеленню.";
"Укроп вымойте, обсушите и мелко порубите. В миске взбейте вилкой яйца с молоком, укропом и солью 1 минуту, чтобы не осталось сгустков белка. Поставьте антипригарную сковороду диаметром 20–24 см на средний огонь и прогрейте 2 минуты." = "Кріп помийте, обсушіть і дрібно посічіть. У мисці збийте виделкою яйця з молоком, кропом і сіллю 1 хвилину, щоб не залишилося згустків білка. Поставте антипригарну сковороду діаметром 20–24 см на середній вогонь і прогрійте 2 хвилини.";
"Налейте на сухую сковороду немного смеси и сразу наклоните её, чтобы смесь тонким слоем покрыла дно. Готовьте 1–2 минуты, пока верх не схватится, переверните лопаткой и держите ещё 30 секунд, чтобы блинчик стал плотным, без жидкой части. Складывайте готовые блинчики стопкой и разделите на порции." = "Налийте на суху сковороду трохи суміші й одразу нахиліть її, щоб суміш тонким шаром укрила дно. Готуйте 1–2 хвилини, доки верх не схопиться, переверніть лопаткою й тримайте ще 30 секунд, щоб млинець став щільним, без рідкої частини. Складайте готові млинці стосиком і розділіть на порції.";
"Нагрейте духовку до 200 °C, на это уйдёт около 10 минут. Очистите картофель и лук и натрите их вместе с цукини на мелкой тёрке, затем крепко отожмите массу руками и слейте жидкость. Натрите сыр, мелко порубите укроп и вмешайте их в овощи вместе с яйцом, солью и чёрным перцем." = "Нагрійте духовку до 200 °C, на це піде близько 10 хвилин. Очистіть картоплю й цибулю та натріть їх разом із цукіні на дрібній тертці, потім міцно відіжміть масу руками й злийте рідину. Натріть сир, дрібно посічіть кріп і вмішайте їх в овочі разом з яйцем, сіллю та чорним перцем.";
"Застелите противень пергаментом, выкладывайте массу ложкой и разравнивайте в тонкие оладьи толщиной около 1 см. Запекайте на среднем уровне 15 минут, пока низ не схватится и не подрумянится, затем переверните лопаткой и пеките ещё 10–12 минут. Драники готовы, когда картофель внутри мягкий, края зарумянились, а в центре 74 °C." = "Застеліть деко пергаментом, викладайте масу ложкою й розрівнюйте в тонкі оладки завтовшки близько 1 см. Запікайте на середньому рівні 15 хвилин, доки низ не схопиться й не підрум’яниться, потім переверніть лопаткою й печіть ще 10–12 хвилин. Деруни готові, коли картопля всередині м’яка, краї зарум’янилися, а в центрі 74 °C.";
"Чеснок очистите и мелко натрите, смешайте в чашке с йогуртом и майонезом. Подайте горячие драники, а соус поставьте рядом в отдельной пиалке." = "Часник очистіть і дрібно натріть, змішайте в чашці з йогуртом і майонезом. Подайте гарячі деруни, а соус поставте поруч в окремій піалі.";
"Включите духовку на 180 °C. Цукини натрите на крупной тёрке и отожмите, морковь, шампиньоны и лук нарежьте кубиками 0,5 см, у сладкого перца удалите семена и нарежьте его так же. Тушите овощи в антипригарной сковороде с небольшим количеством воды под крышкой на среднем огне 8–10 минут до мягкости, затем выложите в миску и остудите 5 минут." = "Увімкніть духовку на 180 °C. Цукіні натріть на великій тертці й відіжміть, моркву, печериці й цибулю наріжте кубиками 0,5 см, із солодкого перцю видаліть насіння й наріжте його так само. Тушкуйте овочі в антипригарній сковороді з невеликою кількістю води під кришкою на середньому вогні 8–10 хвилин до м’якості, потім викладіть у миску й остудіть 5 хвилин.";
"Вмешайте в остывшие овощи яйца, рисовую муку, базилик, прованские травы, соль и чёрный перец. Застелите противень пергаментом и распределите массу ровным прямоугольником толщиной около 1 см. Запекайте 20–25 минут, пока пласт не схватится, а края не зарумянятся; в центре 74 °C." = "Вмішайте в охололі овочі яйця, рисове борошно, базилік, прованські трави, сіль і чорний перець. Застеліть деко пергаментом і розподіліть масу рівним прямокутником завтовшки близько 1 см. Запікайте 20–25 хвилин, доки пласт не схопиться, а краї не зарум’яняться; у центрі 74 °C.";
"Натрите сыр на мелкой тёрке и разотрите вилкой с брынзой, йогуртом, майонезом, измельчённым чесноком и мелко нарезанными петрушкой и укропом. Смажьте этой начинкой ещё тёплый овощной пласт и плотно сверните его рулетом, приподнимая пергамент за край. Оставьте рулет швом вниз на 5 минут, чтобы он уплотнился, и нарежьте ломтиками 2 см." = "Натріть твердий сир на дрібній тертці й розітріть виделкою з бринзою, йогуртом, майонезом, подрібненим часником і дрібно нарізаними петрушкою та кропом. Змастіть цією начинкою ще теплий овочевий пласт і щільно згорніть його рулетом, піднімаючи пергамент за край. Залиште рулет швом донизу на 5 хвилин, щоб він ущільнився, і наріжте скибочками 2 см.";
"Сыр натрите на мелкой тёрке. В миске разотрите вилкой творог с сыром и ржаной мукой и замесите руками плотное тесто, которое не липнет к ладоням. Раскатайте его на присыпанном мукой столе в жгуты толщиной 2 см и нарежьте кусочками по 2 см." = "Твердий сир натріть на дрібній тертці. У мисці розітріть виделкою кисломолочний сир із твердим сиром і житнім борошном і замісіть руками щільне тісто, яке не липне до долонь. Розкачайте його на присипаному борошном столі в джгути завтовшки 2 см і наріжте шматочками по 2 см.";
"Вскипятите воду в широкой кастрюле и добавьте соль. Опускайте вареники партиями, сразу помешайте, чтобы они не прилипли ко дну, и варите на среднем огне 2–3 минуты после того, как они всплывут. Достаньте их шумовкой и подайте с йогуртом." = "Закип’ятіть воду в широкій каструлі й додайте сіль. Опускайте вареники партіями, одразу помішайте, щоб вони не прилипли до дна, і варіть на середньому вогні 2–3 хвилини після того, як вони спливуть. Дістаньте їх шумівкою й подайте з йогуртом.";
"Включите духовку на 190 °C, за 10 минут подготовки курицы она прогреется. В миске смешайте горчицу, вино, паприку, соль и чёрный перец, обсушите окорочка бумажным полотенцем и натрите их этой смесью со всех сторон. Уложите окорочка в форму для запекания и налейте на дно немного воды, слоем 0,5 см, а остальную воду оставьте для крупы." = "Увімкніть духовку на 190 °C, за 10 хвилин підготовки курки вона прогріється. У мисці змішайте гірчицю, вино, паприку, сіль і чорний перець, обсушіть окорочка паперовим рушником і натріть їх цією сумішшю з усіх боків. Покладіть окорочка у форму для запікання й налийте на дно трохи води, шаром 0,5 см, а решту води залиште для крупи.";
"Запекайте окорочка на среднем уровне 45–55 минут, пока кожа не зарумянится; в самой толстой части 74 °C, термометр не касается кости, сок прозрачный. За 20 минут до конца промойте гречку, залейте её в кастрюле оставшейся водой, посолите и доведите до кипения. Убавьте огонь до слабого и варите под крышкой 15 минут, пока вода не впитается." = "Запікайте окорочка на середньому рівні 45–55 хвилин, доки шкірка не зарум’яниться; у найтовщій частині 74 °C, термометр не торкається кістки, сік прозорий. За 20 хвилин до кінця промийте гречку, залийте її в каструлі рештою води, посоліть і доведіть до кипіння. Зменште вогонь до слабкого й варіть під кришкою 15 хвилин, доки вода не вбереться.";
"Переложите окорочка на доску и дайте остыть 5 минут, затем снимите мясо с костей и разберите его на кусочки. Томаты нарежьте дольками. Разложите по тарелкам гречку, курицу и томаты." = "Перекладіть окорочка на дошку й дайте охолонути 5 хвилин, потім зніміть м’ясо з кісток і розберіть його на шматочки. Помідори наріжте часточками. Розкладіть по тарілках гречку, курятину й помідори.";
"Свиные ножки поскоблите ножом, затем вместе с говядиной на кости и голенями индейки тщательно промойте и уберите мелкие осколки костей. Сложите всё в большую кастрюлю, залейте холодной водой и доведите до кипения на сильном огне. В первые 10 минут кипения снимайте шумовкой всю пену." = "Свинячі ніжки пошкребіть ножем, потім разом з яловичиною на кістці та гомілками індички ретельно промийте й приберіть дрібні уламки кісток. Складіть усе у велику каструлю, залийте холодною водою й доведіть до кипіння на сильному вогні. У перші 10 хвилин кипіння знімайте шумівкою всю піну.";
"Убавьте огонь до самого слабого, чтобы бульон едва булькал, накройте крышкой со щелью и варите 4–5 часов, пока мясо не начнёт легко отходить от костей. За час до конца положите очищенные целые лук и морковь, соль, чёрный перец горошком, душистый перец, гвоздику и лавровый лист." = "Зменште вогонь до найслабшого, щоб бульйон ледь булькав, накрийте кришкою зі щілиною й варіть 4–5 годин, доки м’ясо не почне легко відходити від кісток. За годину до кінця покладіть очищені цілі цибулю й моркву, сіль, чорний перець горошком, запашний перець, гвоздику й лавровий лист.";
"Выньте мясо шумовкой на большой поднос и дайте остыть 15 минут, чтобы его можно было взять руками. Отделите мякоть, переберите её пальцами и выбросьте все кости и хрящи, мясо мелко нарежьте и разложите в неглубокие контейнеры. Процедите бульон через сито с марлей, снимите ложкой лишний жир и залейте мясо." = "Вийміть м’ясо шумівкою на велику тацю й дайте охолонути 15 хвилин, щоб його можна було взяти руками. Відокремте м’якоть, переберіть її пальцями й викиньте всі кістки та хрящі, м’ясо дрібно наріжте й розкладіть у неглибокі контейнери. Процідіть бульйон через сито з марлею, зніміть ложкою зайвий жир і залийте м’ясо.";
"Начните охлаждать холодец сразу: поставьте контейнеры в раковину с ледяной водой на 20 минут. Уберите их в холодильник не позже чем через 2 часа после варки, а если в комнате жарче 32 °C — не позже чем через час. Держите в холодильнике 3–3,5 часа, пока холодец полностью не застынет." = "Почніть охолоджувати холодець одразу: поставте контейнери в мийку з крижаною водою на 20 хвилин. Приберіть їх у холодильник не пізніше ніж через 2 години після варіння, а якщо в кімнаті спекотніше за 32 °C — не пізніше ніж через годину. Тримайте в холодильнику 3–3,5 години, доки холодець повністю не застигне.";
"Вымойте яблоко и сливы. Яблоко разрежьте на четвертинки, удалите сердцевину и нарежьте тонкими ломтиками, сливы разрежьте пополам, выньте косточки и нарежьте дольками." = "Помийте яблуко й сливи. Яблуко розріжте на чвертинки, видаліть серцевину й наріжте тонкими скибочками, сливи розріжте навпіл, вийміть кісточки й наріжте часточками.";
"Зернистый творог слегка разомните вилкой, чтобы зёрна остались целыми, и разложите по тарелкам. Сверху или рядом выложите яблоко и сливы и сразу подавайте, пока яблоко не потемнело." = "Зернистий сир злегка розімніть виделкою, щоб зерна залишилися цілими, і розкладіть по тарілках. Зверху або поруч викладіть яблуко й сливи та одразу подавайте, поки яблуко не потемніло.";
"Нагрейте духовку до 190 °C, пока замешиваете тесто, около 10 минут. В миске разотрите вилкой творог с йогуртом, ржаной мукой, солью и специями в однородное мягкое тесто. Застелите противень пергаментом и мокрыми руками сформуйте овальные лепёшки толщиной 1 см с бортиками около 1 см, вдавив середину пальцами." = "Нагрійте духовку до 190 °C, поки замішуєте тісто, близько 10 хвилин. У мисці розітріть виделкою кисломолочний сир із йогуртом, житнім борошном, сіллю та спеціями в однорідне м’яке тісто. Застеліть деко пергаментом і мокрими руками сформуйте овальні коржики завтовшки 1 см із бортиками близько 1 см, вдавивши середину пальцями.";
"Натрите сыр и распределите его по углублениям лепёшек. Пеките на среднем уровне 20–25 минут, пока тесто не схватится, а сыр и края не зарумянятся. Посыпьте горячие хачапури мелко нарубленной зеленью и подайте тёплыми." = "Натріть твердий сир і розподіліть його в заглибини коржиків. Печіть на середньому рівні 20–25 хвилин, доки тісто не схопиться, а сир і краї не зарум’яняться. Посипте гарячі хачапурі дрібно посіченою зеленню й подайте теплими.";
"Включите духовку на 200 °C, чтобы подпечь баклажан. Срежьте у баклажана плодоножку, нарежьте его вдоль пластами толщиной 0,5 см, выложите на противень с пергаментом и запекайте 12–15 минут, пока пласты не станут мягкими и гибкими. Тем временем измельчите куриное филе блендером в фарш или очень мелко порубите ножом, у слив выньте косточки и нарежьте их кубиками 0,5 см." = "Увімкніть духовку на 200 °C, щоб підпекти баклажан. Зріжте з баклажана плодоніжку, наріжте його вздовж пластинами завтовшки 0,5 см, викладіть на деко з пергаментом і запікайте 12–15 хвилин, доки пластини не стануть м’якими й гнучкими. Тим часом подрібніть куряче філе блендером у фарш або дуже дрібно посічіть ножем, зі слив вийміть кісточки й наріжте їх кубиками 0,5 см.";
"Смешайте куриный фарш с творожным сыром, сливами, измельчённым чесноком и солью. Положите немного начинки на широкий край каждого пласта баклажана, сверните рулетиком и уложите швом вниз в жаропрочную форму. Смажьте рулетики йогуртом и посыпьте тёртым сыром." = "Змішайте курячий фарш із крем-сиром, сливами, подрібненим часником і сіллю. Покладіть трохи начинки на широкий край кожної пластини баклажана, згорніть рулетиком і покладіть швом донизу в жаростійку форму. Змастіть рулетики йогуртом і посипте тертим сиром.";
"Убавьте духовку до 190 °C и запекайте рулетики 20 минут, пока сыр сверху не зарумянится. Воткните термометр в середину самого толстого рулетика: в куриной начинке должно быть 74 °C, а выступающий сок прозрачный. Если меньше, запекайте ещё 5 минут и проверьте снова." = "Зменште температуру духовки до 190 °C і запікайте рулетики 20 хвилин, доки сир зверху не зарум’яниться. Встроміть термометр у середину найтовщого рулетика: у курячій начинці має бути 74 °C, а сік, що виступає, прозорий. Якщо менше, запікайте ще 5 хвилин і перевірте знову.";
"Свёклу очистите и натрите на крупной тёрке, лук нарежьте мелкими кубиками, у сладкого перца удалите семена и нарежьте его кубиками 0,5 см. Сложите овощи в сотейник с толстым дном, влейте воду, положите лавровый лист, соль и чёрный перец и перемешайте." = "Буряк очистіть і натріть на великій тертці, цибулю наріжте дрібними кубиками, із солодкого перцю видаліть насіння й наріжте його кубиками 0,5 см. Складіть овочі в сотейник із товстим дном, влийте воду, покладіть лавровий лист, сіль і чорний перець і перемішайте.";
"Доведите до кипения на среднем огне, убавьте огонь до слабого и тушите под крышкой 25–30 минут, помешивая каждые 5 минут, пока свёкла не станет мягкой. Если дно начинает подсыхать, подлейте немного горячей воды. Выньте лавровый лист, вмешайте измельчённый чеснок и подайте икру тёплой или остывшей с рисовыми хлебцами." = "Доведіть до кипіння на середньому вогні, зменште вогонь до слабкого й тушкуйте під кришкою 25–30 хвилин, помішуючи кожні 5 хвилин, доки буряк не стане м’яким. Якщо дно починає підсихати, підлийте трохи гарячої води. Вийміть лавровий лист, вмішайте подрібнений часник і подайте ікру теплою або охололою з рисовими хлібцями.";
"Поставьте духовку прогреваться на 190 °C, это займёт 10 минут. Свиную вырезку нарежьте поперёк волокон медальонами толщиной 2 см, накройте плёнкой и слегка отбейте до 1 см. Тыкву очистите и нарежьте пластинами 0,5 см, лук — тонкими полукольцами; в чашке смешайте йогурт с измельчённым чесноком, прованскими травами, солью и чёрным перцем." = "Поставте духовку прогріватися на 190 °C, це займе 10 хвилин. Свинячу вирізку наріжте впоперек волокон медальйонами завтовшки 2 см, накрийте плівкою й злегка відбийте до 1 см. Гарбуз очистіть і наріжте пластинами 0,5 см, цибулю — тонкими півкільцями; у чашці змішайте йогурт із подрібненим часником, прованськими травами, сіллю та чорним перцем.";
"Смажьте форму для запекания оливковым маслом, выложите мясо одним слоем, сверху тыкву и лук и покройте всё йогуртовым соусом. Запекайте на среднем уровне 20–25 минут, затем посыпьте натёртым сыром и запекайте ещё 5 минут, пока он не расплавится и не зарумянится." = "Змастіть форму для запікання оливковою олією, викладіть м’ясо одним шаром, зверху гарбуз і цибулю та вкрийте все йогуртовим соусом. Запікайте на середньому рівні 20–25 хвилин, потім посипте тертим сиром і запікайте ще 5 хвилин, доки він не розплавиться й не зарум’яниться.";
"Проверьте тыкву ножом: он должен входить легко. Воткните термометр в самый толстый кусок свинины, там должно быть минимум 63 °C. Дайте блюду постоять 3 минуты и только потом раскладывайте по тарелкам." = "Перевірте гарбуз ножем: він має входити легко. Встроміть термометр у найтовщий шматок свинини, там має бути щонайменше 63 °C. Дайте страві постояти 3 хвилини й лише потім розкладайте по тарілках.";
"Разберите брокколи на соцветия размером около 3 см и промойте. Опустите их в кастрюлю с кипящей водой и варите 3–4 минуты, пока они не станут яркими и чуть мягкими, но ещё хрустящими. Откиньте на дуршлаг, сразу облейте холодной водой и обсушите полотенцем." = "Розберіть броколі на суцвіття розміром близько 3 см і промийте. Опустіть їх у каструлю з окропом і варіть 3–4 хвилини, доки вони не стануть яскравими й трохи м’якими, але ще хрумкими. Відкиньте на друшляк, одразу облийте холодною водою й обсушіть рушником.";
"Зелёный лук, укроп и петрушку мелко порубите и смешайте в миске с йогуртом, солью и чёрным перцем. Добавьте остывшую брокколи, перемешайте и разложите по тарелкам." = "Зелену цибулю, кріп і петрушку дрібно посічіть і змішайте в мисці з йогуртом, сіллю та чорним перцем. Додайте охололу броколі, перемішайте й розкладіть по тарілках.";
"Очень мелко нарежьте лук, кубиками около 3 мм. В миске вымешайте фарш с яйцом, луком, солью и чёрным перцем руками 1–2 минуты, до однородной липкой массы. Мокрыми руками скатайте фрикадельки размером с крупную вишню, около 2,5 см." = "Дуже дрібно наріжте цибулю кубиками приблизно 3 мм. У мисці вимісіть руками фарш із яйцем, цибулею, сіллю та чорним перцем 1–2 хвилини, до однорідної липкої маси. Мокрими руками скачайте фрикадельки завбільшки з велику вишню, приблизно 2,5 см.";
"Вскипятите воду в небольшой кастрюле на сильном огне, опустите фрикадельки по одной и убавьте огонь до слабого. Варите при лёгком кипении 12–14 минут, снимая пену ложкой: фрикадельки всплывут, в центре будет 74 °C, внутри не останется розового. Мелко порубите зелень и посыпьте суп в тарелках." = "Закип'ятіть воду в невеликій каструлі на сильному вогні, опустіть фрикадельки по одній і зменште вогонь до слабкого. Варіть на ледь помітному кипінні 12–14 хвилин, знімаючи піну ложкою: фрикадельки спливуть, у центрі буде 74 °C, а всередині не залишиться рожевого. Дрібно посічіть зелень і посипте суп у тарілках.";
"Измельчите овсяные хлопья в блендере в мелкую крошку, 30–40 секунд. В миске взбейте вилкой яйцо с водой, всыпьте овсяную крошку и перемешайте без комков. Оставьте тесто на 5 минут, чтобы хлопья набухли." = "Подрібніть вівсяні пластівці в блендері на дрібну крихту, 30–40 секунд. У мисці збийте виделкою яйце з водою, всипте вівсяну крихту й перемішайте без грудочок. Залиште тісто на 5 хвилин, щоб пластівці набухли.";
"Разогрейте сковороду диаметром 20–22 см на среднем огне и смажьте её оливковым маслом с помощью бумажного полотенца. Вылейте тесто и разровняйте ложкой в тонкий круг. Жарьте 3 минуты, пока низ не зарумянится, а верх не схватится, затем переверните лопаткой и жарьте ещё 2 минуты." = "Розігрійте сковороду діаметром 20–22 см на середньому вогні та змастіть її оливковою олією за допомогою паперового рушника. Вилийте тісто й розрівняйте ложкою в тонке коло. Смажте 3 хвилини, доки низ не підрум'яниться, а верх не схопиться, потім переверніть лопаткою і смажте ще 2 хвилини.";
"Убавьте огонь до слабого. На одну половину блина выложите промытый шпинат, сверху — моцареллу, нарезанную тонкими ломтиками. Сложите блин пополам, накройте сковороду крышкой и держите 3–4 минуты, пока шпинат не опадёт, а сыр не расплавится." = "Зменште вогонь до слабкого. На одну половину млинця викладіть промитий шпинат, зверху — моцарелу, нарізану тонкими скибочками. Складіть млинець навпіл, накрийте сковороду кришкою і тримайте 3–4 хвилини, доки шпинат не зів'яне, а сир не розплавиться.";
"Измельчите овсяные хлопья в блендере в муку, около 30 секунд. Очистите банан и разомните его вилкой в миске в гладкое пюре. Добавьте яйцо, молоко и овсяную муку и перемешайте до густого теста без комков." = "Подрібніть вівсяні пластівці в блендері на борошно, приблизно 30 секунд. Очистіть банан і розімніть його виделкою в мисці на гладке пюре. Додайте яйце, молоко та вівсяне борошно й перемішайте до густого тіста без грудочок.";
"Разогрейте сковороду на среднем огне и тонко смажьте её оливковым маслом бумажным полотенцем. Выкладывайте тесто ложкой кружками около 8 см и жарьте 2–3 минуты, пока на поверхности не появятся пузырьки, затем переверните и жарьте ещё 2 минуты. Надломите один панкейк: внутри тесто должно быть пропечённым, не жидким." = "Розігрійте сковороду на середньому вогні та тонко змастіть її оливковою олією паперовим рушником. Викладайте тісто ложкою кружечками приблизно 8 см і смажте 2–3 хвилини, доки на поверхні не з'являться бульбашки, потім переверніть і смажте ще 2 хвилини. Розломіть один панкейк: усередині тісто має бути пропеченим, не рідким.";
"Сложите горячие панкейки стопкой на тарелку. Рядом положите йогурт или полейте им панкейки сверху и сразу подавайте." = "Складіть гарячі панкейки стосом на тарілку. Поруч покладіть йогурт або полийте ним панкейки зверху й одразу подавайте.";
"Переберите гречку и промойте в сите под холодной водой. Пересыпьте в небольшую кастрюлю, залейте водой, добавьте щепотку соли и доведите до кипения на сильном огне. Накройте крышкой и варите на слабом огне 15–17 минут, пока вода не впитается, а зёрна не станут мягкими." = "Переберіть гречку й промийте в ситі під холодною водою. Пересипте в невелику каструлю, залийте водою, додайте дрібку солі й доведіть до кипіння на сильному вогні. Накрийте кришкою і варіть на слабкому вогні 15–17 хвилин, доки вода не вбереться, а зерна не стануть м'якими.";
"Снимите кастрюлю с огня, разрыхлите гречку вилкой и оставьте без крышки остывать 3 минуты. Тем временем вымойте яблоко, разрежьте на четвертинки, удалите сердцевину и нарежьте кубиками 1 см." = "Зніміть каструлю з вогню, розпушіть гречку виделкою і залиште без кришки остигати 3 хвилини. Тим часом вимийте яблуко, розріжте на четвертинки, видаліть серцевину й наріжте кубиками 1 см.";
"Выложите тёплую гречку в глубокую тарелку, сверху — йогурт и кубики яблока. Грецкие орехи крупно порубите ножом и посыпьте боул вместе с корицей." = "Викладіть теплу гречку в глибоку тарілку, зверху — йогурт і кубики яблука. Волоські горіхи великими шматочками посічіть ножем і посипте боул разом із корицею.";
"Промойте булгур в сите под холодной водой, пересыпьте в небольшую кастрюлю, залейте водой и посолите. Доведите до кипения на сильном огне, накройте крышкой и варите на слабом огне 12 минут, пока вода не впитается, а зёрна не станут мягкими. Снимите с огня и оставьте под крышкой." = "Промийте булгур у ситі під холодною водою, пересипте в невелику каструлю, залийте водою й посоліть. Доведіть до кипіння на сильному вогні, накрийте кришкою і варіть на слабкому вогні 12 хвилин, доки вода не вбереться, а зерна не стануть м'якими. Зніміть з вогню й залиште під кришкою.";
"Вскипятите чайник, положите яйцо в маленькую кастрюлю, залейте кипятком и варите на среднем огне 9 минут, затем переложите в холодную воду. Пока яйцо варится, нарежьте томаты кубиками 1 см, а укроп мелко порубите и смешайте в миске с йогуртом." = "Закип'ятіть чайник, покладіть яйце в маленьку каструлю, залийте окропом і варіть на середньому вогні 9 хвилин, потім перекладіть у холодну воду. Поки яйце вариться, наріжте помідори кубиками 1 см, а кріп дрібно посічіть і змішайте в мисці з йогуртом.";
"Очистите яйцо и разрежьте на четвертинки. Выложите булгур в тарелку, полейте оливковым маслом, сверху положите яйцо и томаты, а рядом — йогуртовый соус с укропом." = "Очистіть яйце й розріжте на четвертинки. Викладіть булгур у тарілку, полийте оливковою олією, зверху покладіть яйце та помідори, а поруч — йогуртовий соус із кропом.";
"Включите духовку на 180 °C. Промойте пшено в сите горячей водой 2–3 раза, пересыпьте в небольшую кастрюлю, залейте водой, добавьте щепотку соли и доведите до кипения. Накройте крышкой и варите на слабом огне 15 минут, пока вода не впитается, а зёрна не станут мягкими." = "Увімкніть духовку на 180 °C. Промийте пшоно в ситі гарячою водою 2–3 рази, пересипте в невелику каструлю, залийте водою, додайте дрібку солі й доведіть до кипіння. Накрийте кришкою і варіть на слабкому вогні 15 хвилин, доки вода не вбереться, а зерна не стануть м'якими.";
"В миске разомните творог вилкой, вбейте яйцо, влейте молоко и вмешайте пшено до однородной массы. Переложите в небольшую форму, застеленную пергаментом, и разровняйте. Сливы вымойте, разрежьте пополам, выньте косточки и уложите сверху срезом вверх." = "У мисці розімніть кисломолочний сир виделкою, вбийте яйце, влийте молоко й вмішайте пшоно до однорідної маси. Перекладіть у невелику форму, застелену пергаментом, і розрівняйте. Сливи вимийте, розріжте навпіл, вийміть кісточки й викладіть зверху зрізом догори.";
"Поставьте форму на средний уровень духовки и запекайте 18–20 минут. Запеканка готова, когда середина не дрожит при покачивании формы, а края слегка зарумянились. Дайте ей постоять 2 минуты и нарежьте." = "Поставте форму на середній рівень духовки й запікайте 18–20 хвилин. Запіканка готова, коли середина не тремтить, якщо похитати форму, а краї злегка підрум'янилися. Дайте їй постояти 2 хвилини й наріжте.";
"Сначала включите духовку на 180 °C. Цукини вымойте, натрите на крупной тёрке и отожмите руками от сока. В миске взбейте вилкой яйца с творогом 1 минуту, добавьте цукини и томаты, нарезанные кубиками 1 см, и перемешайте." = "Спершу увімкніть духовку на 180 °C. Цукіні вимийте, натріть на великій тертці й відіжміть руками від соку. У мисці збийте виделкою яйця з кисломолочним сиром 1 хвилину, додайте цукіні та помідори, нарізані кубиками 1 см, і перемішайте.";
"Смажьте небольшую форму оливковым маслом, вылейте смесь и разровняйте. Запекайте на среднем уровне 18–20 минут, пока края не зарумянятся. Воткните нож в центр: если он выходит чистым, без жидкого яйца, фриттата готова." = "Змастіть невелику форму оливковою олією, вилийте суміш і розрівняйте. Запікайте на середньому рівні 18–20 хвилин, доки краї не підрум'яняться. Встроміть ніж у центр: якщо він виходить чистим, без рідкого яйця, фритата готова.";
"Подсушите хлеб в тостере или на сухой сковороде на среднем огне по 1–2 минуты с каждой стороны, пока он не станет хрустящим. Нарежьте фриттату кусками и подавайте с тёплым хлебом." = "Підсушіть хліб у тостері або на сухій сковороді на середньому вогні по 1–2 хвилини з кожного боку, доки він не стане хрустким. Наріжте фритату шматками й подавайте з теплим хлібом.";
"В миске взбейте вилкой яйцо с водой и почти половиной йогурта, затем всыпьте ржаную муку. Перемешайте до густого теста без комков, похожего на густую сметану. Остальной йогурт оставьте для подачи." = "У мисці збийте виделкою яйце з водою та майже половиною йогурту, потім всипте житнє борошно. Перемішайте до густого тіста без грудочок, схожого на густу сметану. Решту йогурту залиште для подачі.";
"Разогрейте сковороду на среднем огне и смажьте оливковым маслом при помощи кисточки. Выкладывайте тесто ложкой небольшими оладьями диаметром около 7 см. Жарьте по 2–3 минуты с каждой стороны, пока обе стороны не подрумянятся, а середина не станет упругой, без сырого теста." = "Розігрійте сковороду на середньому вогні й змастіть оливковою олією за допомогою пензлика. Викладайте тісто ложкою невеликими оладками діаметром приблизно 7 см. Смажте по 2–3 хвилини з кожного боку, доки обидва боки не підрум'яняться, а середина не стане пружною, без сирого тіста.";
"Ягоды промойте в сите и обсушите на бумажном полотенце. Выложите оладьи на тарелку, сверху положите оставшийся йогурт и ягоды." = "Ягоди промийте в ситі й обсушіть на паперовому рушнику. Викладіть оладки на тарілку, зверху покладіть решту йогурту та ягоди.";
"Накануне вечером залейте нут холодной водой в миске и поставьте на ночь в холодильник. Затем слейте воду, промойте нут, переложите в кастрюлю, залейте свежей водой и доведите до кипения на сильном огне. Убавьте огонь до слабого и варите под приоткрытой крышкой 60–80 минут, пока нут не станет мягким и легко не раздавится пальцами." = "Напередодні ввечері залийте нут холодною водою в мисці й поставте на ніч у холодильник. Потім злийте воду, промийте нут, перекладіть у каструлю, залийте свіжою водою й доведіть до кипіння на сильному вогні. Зменште вогонь до слабкого і варіть під прочиненою кришкою 60–80 хвилин, доки нут не стане м'яким і легко не розчавлюватиметься пальцями.";
"Слейте нут через сито, сохранив немного отвара в чашке. Пока нут горячий, разомните его вилкой или пробейте блендером с лимонным соком и оливковым маслом 1–2 минуты. Если паста получилась густой и не намазывается, вмешайте немного отвара." = "Злийте нут через сито, зберігши трохи відвару в чашці. Поки нут гарячий, розімніть його виделкою або збийте блендером із лимонним соком та оливковою олією 1–2 хвилини. Якщо паста вийшла густою й не намазується, вмішайте трохи відвару.";
"Подсушите хлеб в тостере или на сухой сковороде на среднем огне по 2 минуты с каждой стороны, до хруста. Огурец нарежьте тонкими кружками, фету раскрошите пальцами. Намажьте хлеб нутовой пастой, сверху разложите огурец и фету." = "Підсушіть хліб у тостері або на сухій сковороді на середньому вогні по 2 хвилини з кожного боку, до хрусткості. Огірок наріжте тонкими кружальцями, фету розкришіть пальцями. Намажте хліб нутовою пастою, зверху розкладіть огірок і фету.";
"Включите духовку на 190 °C. Промойте чечевицу, пересыпьте в кастрюлю, залейте водой и доведите до кипения, затем варите на слабом огне 15 минут, помешивая, пока она не разварится в густое пюре и вода не впитается. Переложите в миску, остудите 3 минуты и вмешайте яйцо и морковь, натёртую на мелкой тёрке." = "Увімкніть духовку на 190 °C. Промийте сочевицю, пересипте в каструлю, залийте водою й доведіть до кипіння, потім варіть на слабкому вогні 15 хвилин, помішуючи, доки вона не розвариться на густе пюре, а вода не вбереться. Перекладіть у миску, остудіть 3 хвилини й вмішайте яйце та моркву, натерту на дрібній тертці.";
"Застелите противень пергаментом и выложите массу ложкой котлетками диаметром около 6 см и толщиной 1,5 см, разровняв их мокрой ложкой. Смажьте верх оливковым маслом и запекайте на среднем уровне 18–20 минут, перевернув лопаткой на середине. Котлетки готовы, когда обе стороны зарумянились, а внутри они плотные." = "Застеліть деко пергаментом і викладіть масу ложкою котлетками діаметром приблизно 6 см і завтовшки 1,5 см, розрівнявши їх мокрою ложкою. Змастіть верх оливковою олією й запікайте на середньому рівні 18–20 хвилин, перевернувши лопаткою посередині. Котлетки готові, коли обидва боки підрум'янилися, а всередині вони щільні.";
"Переложите котлетки лопаткой на тарелку и подавайте тёплыми. Йогурт поставьте рядом в мисочке, чтобы макать в него котлетки." = "Перекладіть котлетки лопаткою на тарілку й подавайте теплими. Йогурт поставте поруч у мисочці, щоб умочати в нього котлетки.";
"Сначала включите духовку на 190 °C. Индейку нарежьте кусками, цветную капусту разберите на соцветия, лук очистите и разрежьте на четвертинки, затем измельчите всё в блендере в фарш, 1–2 минуты. Вмешайте взбитое яйцо и мокрыми руками сформуйте тефтели размером с грецкий орех." = "Спершу увімкніть духовку на 190 °C. Індичку наріжте шматками, цвітну капусту розберіть на суцвіття, цибулю очистіть і розріжте на четвертинки, потім подрібніть усе в блендері на фарш, 1–2 хвилини. Вмішайте збите яйце й мокрими руками сформуйте тефтелі завбільшки з волоський горіх.";
"Томаты нарежьте кубиками 1,5 см, разложите по дну формы и полейте оливковым маслом, сверху уложите тефтели в один слой. Накройте крышкой или фольгой и запекайте на среднем уровне 25 минут. Тефтели готовы, когда в центре 74 °C, а сок прозрачный." = "Помідори наріжте кубиками 1,5 см, розкладіть по дну форми й полийте оливковою олією, зверху викладіть тефтелі в один шар. Накрийте кришкою або фольгою і запікайте на середньому рівні 25 хвилин. Тефтелі готові, коли в центрі 74 °C, а сік прозорий.";
"Промойте гречку, пересыпьте в небольшую кастрюлю, залейте водой, посолите и доведите до кипения на сильном огне. Накройте крышкой и варите гречку на слабом огне 15 минут, пока она не впитает всю воду. Разложите гречку по тарелкам, рядом — тефтели с томатным соусом из формы." = "Промийте гречку, пересипте в невелику каструлю, залийте водою, посоліть і доведіть до кипіння на сильному вогні. Накрийте кришкою і варіть гречку на слабкому вогні 15 хвилин, доки вона не вбере всю воду. Розкладіть гречку по тарілках, поруч — тефтелі з томатним соусом із форми.";
"Промойте пшено в сите под горячим краном 1 минуту, перетирая зёрна пальцами. Куриное филе нарежьте кубиками 2 см, морковь — кружками толщиной 0,5 см, лук и сельдерей — кубиками 1 см." = "Промийте пшоно в ситі під гарячим краном 1 хвилину, перетираючи зерна пальцями. Куряче філе наріжте кубиками 2 см, моркву — кружальцями завтовшки 0,5 см, цибулю й селеру — кубиками 1 см.";
"Налейте воду в кастрюлю, посолите и доведите до кипения на сильном огне. Опустите курицу, пшено и овощи, снова доведите до кипения, снимите пену и варите под крышкой на слабом огне 20–22 минуты. Суп готов, когда пшено мягкое, а курица в самом толстом кусочке прогрелась до 74 °C." = "Налийте воду в каструлю, посоліть і доведіть до кипіння на сильному вогні. Опустіть курку, пшоно й овочі, знову доведіть до кипіння, зніміть піну й варіть під кришкою на слабкому вогні 20–22 хвилини. Суп готовий, коли пшоно м'яке, а курка в найтовщому шматочку прогрілася до 74 °C.";
"Снимите кастрюлю с огня, влейте оливковое масло и посыпьте мелко порубленным укропом. Накройте крышкой на 2 минуты и разлейте суп по тарелкам." = "Зніміть каструлю з вогню, влийте оливкову олію й посипте дрібно посіченим кропом. Накрийте кришкою на 2 хвилини й розлийте суп по тарілках.";
"Промойте бурый рис в сите, пересыпьте в небольшую кастрюлю, залейте водой, посолите и доведите до кипения. Накройте крышкой и варите на слабом огне 35–40 минут, пока зёрна не станут мягкими; остаток воды слейте. Пока рис варится, проверьте минтай пальцами на кости и разберите брокколи на соцветия по 3 см. За 10 минут до конца включите духовку на 190 °C." = "Промийте бурий рис у ситі, пересипте в невелику каструлю, залийте водою, посоліть і доведіть до кипіння. Накрийте кришкою і варіть на слабкому вогні 35–40 хвилин, доки зерна не стануть м'якими; залишок води злийте. Поки рис вариться, перевірте минтай пальцями на кісточки й розберіть броколі на суцвіття по 3 см. За 10 хвилин до кінця увімкніть духовку на 190 °C.";
"В миске размешайте рисовую муку с молоком венчиком до гладкости, без комков. Уложите минтай и брокколи в форму в один слой и залейте молочной смесью. Натрите сыр на крупной тёрке и посыпьте сверху." = "У мисці розмішайте рисове борошно з молоком віничком до гладкості, без грудочок. Викладіть минтай і броколі у форму в один шар і залийте молочною сумішшю. Натріть сир на великій тертці й посипте зверху.";
"Запекайте форму на среднем уровне 22–25 минут, пока сыр не зарумянится, а соус не загустеет. Рыба готова, когда в самой толстой части 63 °C и мякоть легко расслаивается вилкой. Подавайте с бурым рисом." = "Запікайте форму на середньому рівні 22–25 хвилин, доки сир не підрум'яниться, а соус не загусне. Риба готова, коли в найтовщій частині 63 °C і м'якоть легко розшаровується виделкою. Подавайте з бурим рисом.";
"Говядину нарежьте кубиками 2 см, лук — мелкими кубиками, томаты — кубиками 1,5 см. Сложите в кастрюлю с толстым дном, добавьте оливковое масло и половину воды и доведите до кипения на среднем огне. Накройте крышкой и тушите на слабом огне 55 минут, пока мясо не станет почти мягким. Тем временем нарежьте цукини кубиками 2 см." = "Яловичину наріжте кубиками 2 см, цибулю — дрібними кубиками, помідори — кубиками 1,5 см. Складіть у каструлю з товстим дном, додайте оливкову олію та половину води й доведіть до кипіння на середньому вогні. Накрийте кришкою і тушкуйте на слабкому вогні 55 хвилин, доки м'ясо не стане майже м'яким. Тим часом наріжте цукіні кубиками 2 см.";
"Добавьте цукини к мясу, перемешайте и тушите под крышкой на слабом огне ещё 8–10 минут. Готово, когда говядина легко разделяется вилкой, а цукини мягкие, но не развалились. Если соус почти выкипел, подлейте немного горячей воды из чайника." = "Додайте цукіні до м'яса, перемішайте й тушкуйте під кришкою на слабкому вогні ще 8–10 хвилин. Готово, коли яловичина легко розділяється виделкою, а цукіні м'які, але не розвалилися. Якщо соус майже википів, підлийте трохи гарячої води з чайника.";
"Промойте булгур, всыпьте в небольшую кастрюлю, залейте оставшейся водой, посолите и доведите до кипения. Накройте и варите на слабом огне 12 минут, пока вода не впитается. Разложите булгур по тарелкам, сверху — говядину с цукини и соусом." = "Промийте булгур, всипте в невелику каструлю, залийте рештою води, посоліть і доведіть до кипіння. Накрийте й варіть на слабкому вогні 12 хвилин, доки вода не вбереться. Розкладіть булгур по тарілках, зверху — яловичину з цукіні та соусом.";
"Промойте чечевицу в сите под краном, пока стекающая струя не станет прозрачной. Тыкву очистите от кожуры и семечек и нарежьте кубиками 2 см, морковь — кружками 0,5 см, лук и томаты — кубиками 1,5 см." = "Промийте сочевицю в ситі під краном, доки струмінь, що стікає, не стане прозорим. Гарбуз очистіть від шкірки й насіння та наріжте кубиками 2 см, моркву — кружальцями 0,5 см, цибулю й помідори — кубиками 1,5 см.";
"Сложите чечевицу и овощи в кастрюлю, залейте водой, посолите и доведите до кипения на сильном огне. Варите под крышкой на слабом огне 20 минут, пока тыква и чечевица не станут совсем мягкими. Снимите с огня, влейте оливковое масло и измельчите суп погружным блендером до гладкого пюре." = "Складіть сочевицю й овочі в каструлю, залийте водою, посоліть і доведіть до кипіння на сильному вогні. Варіть під кришкою на слабкому вогні 20 хвилин, доки гарбуз і сочевиця не стануть зовсім м'якими. Зніміть з вогню, влийте оливкову олію й подрібніть суп заглибним блендером до гладкого пюре.";
"Дайте супу постоять 2–3 минуты, чтобы он перестал бурлить, и разлейте по тарелкам. В каждую положите сверху йогурт и слегка размешайте ложкой." = "Дайте супу постояти 2–3 хвилини, щоб він перестав булькати, і розлийте по тарілках. У кожну покладіть зверху йогурт і злегка розмішайте ложкою.";
"Бурый рис промойте, всыпьте в кастрюлю с кипятком, посолите и варите на среднем огне 20 минут, чтобы зёрна остались твёрдыми в середине, затем откиньте на сито. Тем временем отделите от капусты крупные листья, опустите их на 3–4 минуты в другую кастрюлю с кипятком, пока не станут гибкими, и срежьте толстые жилки. Индейку и лук измельчите в блендере и смешайте с рисом." = "Бурий рис промийте, всипте в каструлю з окропом, посоліть і варіть на середньому вогні 20 хвилин, щоб зерна залишилися твердими всередині, потім відкиньте на сито. Тим часом відокремте від капусти великі листки, опустіть їх на 3–4 хвилини в іншу каструлю з окропом, доки не стануть гнучкими, і зріжте товсті прожилки. Індичку й цибулю подрібніть у блендері та змішайте з рисом.";
"Выложите начинку на каждый лист у толстого края, подверните бока и плотно сверните рулетом. Морковь натрите на крупной тёрке, томаты нарежьте кубиками 1 см и половину овощей разложите по дну кастрюли. Сверху уложите голубцы швом вниз, накройте оставшимися овощами, влейте воду и оливковое масло." = "Викладіть начинку на кожен листок біля товстого краю, підгорніть боки й щільно згорніть рулетом. Моркву натріть на великій тертці, помідори наріжте кубиками 1 см і половину овочів розкладіть по дну каструлі. Зверху викладіть голубці швом донизу, накрийте рештою овочів, влийте воду й оливкову олію.";
"Доведите до кипения на среднем огне, накройте крышкой и тушите на слабом огне 35 минут. Голубцы готовы, когда капуста мягкая и легко прокалывается ножом, а в центре начинки 74 °C и сок прозрачный." = "Доведіть до кипіння на середньому вогні, накрийте кришкою і тушкуйте на слабкому вогні 35 хвилин. Голубці готові, коли капуста м'яка й легко проколюється ножем, а в центрі начинки 74 °C і сік прозорий.";
"Промойте гречку, пересыпьте в небольшую кастрюлю, залейте водой, посолите и доведите до кипения. Накройте крышкой и варите на слабом огне 15 минут, пока вода не впитается. Тем временем включите духовку на 190 °C, разрежьте цукини вдоль пополам и выньте ложкой мякоть, оставив стенки около 1 см." = "Промийте гречку, пересипте в невелику каструлю, залийте водою, посоліть і доведіть до кипіння. Накрийте кришкою і варіть на слабкому вогні 15 хвилин, доки вода не вбереться. Тим часом увімкніть духовку на 190 °C, розріжте цукіні вздовж навпіл і вийміть ложкою м'якоть, залишивши стінки приблизно 1 см.";
"Курицу, вынутую мякоть цукини, томаты и лук нарежьте мелкими кубиками 0,5–1 см. Смешайте их в миске с гречкой и оливковым маслом, посолите и плотно наполните лодочки горкой." = "Курку, вийняту м'якоть цукіні, помідори й цибулю наріжте дрібними кубиками 0,5–1 см. Змішайте їх у мисці з гречкою та оливковою олією, посоліть і щільно наповніть човники з гіркою.";
"Уложите лодочки на противень с пергаментом, посыпьте сыром, натёртым на мелкой тёрке, и запекайте на среднем уровне 25–30 минут. Готово, когда цукини мягкие, сыр зарумянился, а начинка в центре прогрелась до 74 °C." = "Викладіть човники на деко з пергаментом, посипте сиром, натертим на дрібній тертці, і запікайте на середньому рівні 25–30 хвилин. Готово, коли цукіні м'які, сир підрум'янився, а начинка в центрі прогрілася до 74 °C.";
"Говядину нарежьте кубиками 2 см, лук — мелкими кубиками. Сложите в кастрюлю с толстым дном, добавьте оливковое масло и чуть больше половины воды и доведите до кипения на среднем огне. Накройте крышкой и тушите на слабом огне 60–65 минут, пока мясо не станет мягким и легко не разделится вилкой." = "Яловичину наріжте кубиками 2 см, цибулю — дрібними кубиками. Складіть у каструлю з товстим дном, додайте оливкову олію та трохи більше половини води й доведіть до кипіння на середньому вогні. Накрийте кришкою і тушкуйте на слабкому вогні 60–65 хвилин, доки м'ясо не стане м'яким і легко не розділятиметься виделкою.";
"Сладкий перец очистите от семян и нарежьте полосками 1 см, морковь — кружками 0,5 см. Булгур промойте в сите. Добавьте овощи и булгур к мясу, влейте оставшуюся воду, посолите и перемешайте." = "Солодкий перець очистіть від насіння й наріжте смужками 1 см, моркву — кружальцями 0,5 см. Булгур промийте в ситі. Додайте овочі й булгур до м'яса, влийте решту води, посоліть і перемішайте.";
"Снова доведите до кипения, накройте крышкой и готовьте на слабом огне ещё 12–14 минут, не помешивая. Блюдо готово, когда булгур впитал жидкость и стал мягким, а перец — нежным." = "Знову доведіть до кипіння, накрийте кришкою й готуйте на слабкому вогні ще 12–14 хвилин, не помішуючи. Страва готова, коли булгур увібрав рідину й став м'яким, а перець — ніжним.";
"Включите духовку на 190 °C и поставьте чайник. Промойте бурый рис в сите 1 минуту, до прозрачной струи. Курицу нарежьте кубиками 2 см, тыкву очистите и нарежьте кубиками 1,5 см, лук — мелкими кубиками, морковь — кружками 0,5 см." = "Увімкніть духовку на 190 °C і поставте чайник. Промийте бурий рис у ситі 1 хвилину, до прозорого струменя. Курку наріжте кубиками 2 см, гарбуз очистіть і наріжте кубиками 1,5 см, цибулю — дрібними кубиками, моркву — кружальцями 0,5 см.";
"В глубокой форме смешайте рис, курицу и овощи с оливковым маслом, посолите и разровняйте слоем. Залейте горячей водой из чайника и плотно накройте крышкой или фольгой." = "У глибокій формі змішайте рис, курку й овочі з оливковою олією, посоліть і розрівняйте шаром. Залийте гарячою водою з чайника й щільно накрийте кришкою або фольгою.";
"Запекайте на среднем уровне 50 минут, не открывая. Проверьте: рис должен быть мягким, а курица в самом толстом кусочке — 74 °C, сок прозрачный. Если жидкость впиталась, а рис ещё твёрдый, подлейте немного горячей воды и запекайте под фольгой ещё 5 минут." = "Запікайте на середньому рівні 50 хвилин, не відкриваючи. Перевірте: рис має бути м'яким, а курка в найтовщому шматочку — 74 °C, сік прозорий. Якщо рідина вбралася, а рис ще твердий, підлийте трохи гарячої води й запікайте під фольгою ще 5 хвилин.";
"Разогрейте духовку до 190 °C. Разрежьте куриное филе вдоль на пласты толщиной 1 см, накройте пищевой плёнкой и отбейте молоточком до 0,5 см, 1–2 минуты. Выложите на каждый пласт листья шпината и ломтики моцареллы, плотно сверните рулетом и скрепите зубочисткой." = "Розігрійте духовку до 190 °C. Розріжте куряче філе вздовж на пласти завтовшки 1 см, накрийте харчовою плівкою й відбийте молоточком до 0,5 см, 1–2 хвилини. Викладіть на кожен пласт листя шпинату та скибочки моцарели, щільно згорніть рулетом і скріпіть зубочисткою.";
"Томаты нарежьте кубиками 1,5 см, выложите в форму и полейте оливковым маслом, сверху уложите рулетики швом вниз. Запекайте на среднем уровне 25 минут. Рулетики готовы, когда в самой толстой части 74 °C, а сок при надрезе прозрачный." = "Помідори наріжте кубиками 1,5 см, викладіть у форму й полийте оливковою олією, зверху покладіть рулетики швом донизу. Запікайте на середньому рівні 25 хвилин. Рулетики готові, коли в найтовщій частині 74 °C, а сік на розрізі прозорий.";
"Промойте булгур в сите, всыпьте в кастрюлю, залейте водой, посолите и доведите до кипения. Накройте крышкой и держите на слабом огне 12 минут, пока булгур не впитает воду. Выньте зубочистки из рулетиков и подавайте их с булгуром и томатами из формы." = "Промийте булгур у ситі, всипте в каструлю, залийте водою, посоліть і доведіть до кипіння. Накрийте кришкою і тримайте на слабкому вогні 12 хвилин, доки булгур не вбере воду. Вийміть зубочистки з рулетиків і подавайте їх із булгуром та помідорами з форми.";
"Поставьте духовку греться на 190 °C. Индейку нарежьте кубиками 2,5 см, цукини — полукружьями толщиной 1 см. Чеснок очистите, натрите на мелкой тёрке и смешайте в миске с кефиром и щепоткой соли, залейте этим индейку и оставьте на 3 минуты." = "Поставте духовку грітися на 190 °C. Індичку наріжте кубиками 2,5 см, цукіні — півкружальцями завтовшки 1 см. Часник очистіть, натріть на дрібній тертці й змішайте в мисці з кефіром і дрібкою солі, залийте цим індичку й залиште на 3 хвилини.";
"Переложите индейку с кефиром и цукини в форму и перемешайте. Накройте крышкой или фольгой и запекайте на среднем уровне 25–28 минут. Индейка готова, когда в самом толстом кубике 74 °C, а сок прозрачный." = "Перекладіть індичку з кефіром і цукіні у форму й перемішайте. Накрийте кришкою або фольгою і запікайте на середньому рівні 25–28 хвилин. Індичка готова, коли в найтовщому кубику 74 °C, а сік прозорий.";
"Мелко порубите укроп и посыпьте индейку. Разложите по тарелкам вместе с кефирным соусом со дна формы." = "Дрібно посічіть кріп і посипте індичку. Розкладіть по тарілках разом із кефірним соусом із дна форми.";
"Включите духовку на 190 °C и, пока она греется, за 5 минут подготовьте продукты. Проверьте филе хека пальцами и выньте пинцетом мелкие кости. Лук нарежьте тонкими полукольцами и выложите на дно формы, сверху — промытый шпинат, а на него рыбу." = "Увімкніть духовку на 190 °C і, поки вона гріється, за 5 хвилин підготуйте продукти. Перевірте філе хека пальцями й вийміть пінцетом дрібні кісточки. Цибулю наріжте тонкими півкільцями й викладіть на дно форми, зверху — промитий шпинат, а на нього рибу.";
"Влейте в форму воду, полейте рыбу оливковым маслом и посолите. Накройте крышкой или фольгой и запекайте на среднем уровне 20 минут. Рыба готова, когда в самой толстой части 63 °C, а мякоть белая и легко расслаивается вилкой." = "Влийте у форму воду, полийте рибу оливковою олією й посоліть. Накрийте кришкою або фольгою і запікайте на середньому рівні 20 хвилин. Риба готова, коли в найтовщій частині 63 °C, а м'якоть біла й легко розшаровується виделкою.";
"Лопаткой переложите рыбу вместе со шпинатом и луком на тарелку. Сразу полейте её лимонным соком, пока рыба горячая." = "Лопаткою перекладіть рибу разом зі шпинатом і цибулею на тарілку. Одразу полийте її лимонним соком, поки риба гаряча.";
"Разогрейте духовку до 180 °C. Разберите брокколи на мелкие соцветия по 2 см. Положите их в сито над кастрюлей с кипящей водой или в пароварку, накройте крышкой и готовьте на пару 3–4 минуты, пока брокколи не станет ярко-зелёной." = "Розігрійте духовку до 180 °C. Розберіть броколі на дрібні суцвіття по 2 см. Покладіть їх у сито над каструлею з киплячою водою або в пароварку, накрийте кришкою й готуйте на парі 3–4 хвилини, доки броколі не стане яскраво-зеленою.";
"В миске разомните творог вилкой, вбейте яйцо, добавьте йогурт и перемешайте до однородности. Вмешайте брокколи и переложите массу в небольшую форму, разровняв верх ложкой." = "У мисці розімніть кисломолочний сир виделкою, вбийте яйце, додайте йогурт і перемішайте до однорідності. Вмішайте броколі й перекладіть масу в невелику форму, розрівнявши верх ложкою.";
"Запекайте на среднем уровне 22–25 минут, пока верх не зарумянится, а середина не перестанет дрожать при покачивании формы. Мелко порубите укроп и посыпьте запеканку перед подачей." = "Запікайте на середньому рівні 22–25 хвилин, доки верх не підрум'яниться, а середина не перестане тремтіти, якщо похитати форму. Дрібно посічіть кріп і посипте запіканку перед подачею.";
"Гречку промойте, залейте в кастрюле тремя четвертями воды, посолите и доведите до кипения, затем варите под крышкой на слабом огне 15 минут. Тем временем нарежьте шампиньоны пластинками, фасоль — по 3 см. Тушите их в сковороде с оливковым маслом и остальной водой под крышкой на среднем огне 8–10 минут, до мягкости фасоли." = "Гречку промийте, залийте в каструлі трьома чвертями води, посоліть і доведіть до кипіння, потім варіть під кришкою на слабкому вогні 15 хвилин. Тим часом наріжте печериці пластинками, квасолю — по 3 см. Тушкуйте їх на сковороді з оливковою олією та рештою води під кришкою на середньому вогні 8–10 хвилин, до м'якості квасолі.";
"В миске разомните творог вилкой с йогуртом до гладкого густого соуса, похожего на сметану. Мелко порубите укроп и вмешайте в соус." = "У мисці розімніть кисломолочний сир виделкою з йогуртом до гладкого густого соусу, схожого на сметану. Дрібно посічіть кріп і вмішайте в соус.";
"Разложите гречку по тарелкам и выложите рядом горячие грибы с фасолью. Сверху полейте творожным соусом." = "Розкладіть гречку по тарілках і викладіть поруч гарячі печериці з квасолею. Зверху полийте сирним соусом.";
"Нагрейте духовку до 190 °C. Вымойте свёклу щёткой, не очищая, заверните в фольгу и запекайте на среднем уровне 50–55 минут, пока нож не будет входить легко. Переложите в холодную воду на 2 минуты и снимите кожуру руками." = "Нагрійте духовку до 190 °C. Вимийте буряк щіткою, не очищаючи, загорніть у фольгу й запікайте на середньому рівні 50–55 хвилин, доки ніж не входитиме легко. Перекладіть у холодну воду на 2 хвилини й зніміть шкірку руками.";
"Натрите свёклу на крупной тёрке. В миске разомните творог вилкой с йогуртом и мелко порубленным укропом до мягкой пасты." = "Натріть буряк на великій тертці. У мисці розімніть кисломолочний сир виделкою з йогуртом і дрібно посіченим кропом до м'якої пасти.";
"Намажьте ржаные криспы творожной пастой и разложите сверху свёклу. Грецкие орехи порубите ножом и посыпьте хлебцы." = "Намажте житні кріспи сирною пастою й розкладіть зверху буряк. Волоські горіхи посічіть ножем і посипте хлібці.";
"Включите духовку на 180 °C и, пока она греется, за 4–5 минут подготовьте яблоко. Вымойте его, разрежьте пополам и выньте ложкой сердцевину с семечками, оставив стенки около 1 см." = "Увімкніть духовку на 180 °C і, поки вона гріється, за 4–5 хвилин підготуйте яблуко. Вимийте його, розріжте навпіл і вийміть ложкою серцевину з насінням, залишивши стінки приблизно 1 см.";
"Грецкие орехи порубите ножом и смешайте в миске с творогом. Уложите половинки яблока в форму срезом вверх, наполните их начинкой горкой, а остаток выложите рядом. Запекайте на среднем уровне 25 минут, пока яблоко не станет мягким и нож не будет легко входить в мякоть." = "Волоські горіхи посічіть ножем і змішайте в мисці з кисломолочним сиром. Покладіть половинки яблука у форму зрізом догори, наповніть їх начинкою з гіркою, а залишок викладіть поруч. Запікайте на середньому рівні 25 хвилин, доки яблуко не стане м'яким і ніж не входитиме в м'якоть легко.";
"Переложите яблоко на тарелку, полейте йогуртом и посыпьте корицей. Подавайте тёплым." = "Перекладіть яблуко на тарілку, полийте йогуртом і посипте корицею. Подавайте теплим.";
"Промойте бурый рис, всыпьте в небольшую кастрюлю, залейте водой, посолите и доведите до кипения. Накройте крышкой и варите на слабом огне 35–40 минут, пока зёрна не станут мягкими, а вода не впитается. За 10 минут до конца включите духовку на 180 °C, натрите цукини на крупной тёрке и отожмите руками от сока." = "Промийте бурий рис, всипте в невелику каструлю, залийте водою, посоліть і доведіть до кипіння. Накрийте кришкою і варіть на слабкому вогні 35–40 хвилин, доки зерна не стануть м'якими, а вода не вбереться. За 10 хвилин до кінця увімкніть духовку на 180 °C, натріть цукіні на великій тертці й відіжміть руками від соку.";
"В миске смешайте рис, цукини, яйцо, раскрошенную фету и томаты, нарезанные кубиками 1 см. Смажьте небольшую форму оливковым маслом, выложите массу и разровняйте ложкой." = "У мисці змішайте рис, цукіні, яйце, розкришену фету й помідори, нарізані кубиками 1 см. Змастіть невелику форму оливковою олією, викладіть масу й розрівняйте ложкою.";
"Запекайте на среднем уровне 20 минут, пока верх не зарумянится, а яйцо внутри не схватится и масса не станет плотной. Дайте постоять 2 минуты и нарежьте." = "Запікайте на середньому рівні 20 хвилин, доки верх не підрум'яниться, а яйце всередині не схопиться й маса не стане щільною. Дайте постояти 2 хвилини й наріжте.";
"Положите яйцо в маленькую кастрюлю, залейте кипятком из чайника и варите на среднем огне 9 минут, затем остудите в холодной воде 1 минуту. Пока яйцо варится, нарежьте огурец и сладкий перец тонкой соломкой. Очистите яйцо и нарежьте вдоль полосками." = "Покладіть яйце в маленьку каструлю, залийте окропом із чайника й варіть на середньому вогні 9 хвилин, потім остудіть у холодній воді 1 хвилину. Поки яйце вариться, наріжте огірок і солодкий перець тонкою соломкою. Очистіть яйце й наріжте вздовж смужками.";
"В миске смешайте творог с йогуртом и мелко порубленным укропом. Положите лист нори блестящей стороной вниз и тонко распределите по нему творог, оставив свободной полосу 2 см у дальнего края." = "У мисці змішайте кисломолочний сир із йогуртом і дрібно посіченим кропом. Покладіть аркуш норі блискучим боком донизу й тонко розподіліть по ньому сир, залишивши вільною смугу 2 см біля дальнього краю.";
"У ближнего края выложите в ряд полоски яйца, огурца и перца. Плотно сверните рулет от себя, смочите свободный край водой, чтобы он склеился, и нарежьте острым ножом на 6 кусочков. Подавайте сразу, пока нори не размокла." = "Біля ближнього краю викладіть у ряд смужки яйця, огірка й перцю. Щільно згорніть рулет від себе, змочіть вільний край водою, щоб він склеївся, і наріжте гострим ножем на 6 шматочків. Подавайте одразу, поки норі не розмокла.";
"Промойте чечевицу в сите под проточной струёй 1 минуту. Цукини нарежьте кубиками 1,5 см, морковь — кружками 0,5 см, томаты — кубиками 1 см, лук — мелкими кубиками." = "Промийте сочевицю в ситі під проточним струменем 1 хвилину. Цукіні наріжте кубиками 1,5 см, моркву — кружальцями 0,5 см, помідори — кубиками 1 см, цибулю — дрібними кубиками.";
"Переложите чечевицу и овощи в кастрюлю, залейте водой и посолите. Доведите до кипения на сильном огне и снимите пену. Убавьте огонь до слабого и варите под крышкой 15–17 минут, пока чечевица не разварится, а морковь не станет мягкой. Снимите с огня и вмешайте оливковое масло." = "Перекладіть сочевицю й овочі в каструлю, залийте водою й посоліть. Доведіть до кипіння на сильному вогні й зніміть піну. Зменште вогонь до слабкого і варіть під кришкою 15–17 хвилин, доки сочевиця не розвариться, а морква не стане м'якою. Зніміть з вогню й вмішайте оливкову олію.";
"Дайте супу постоять 2 минуты, чтобы он перестал бурлить. Разлейте по тарелкам и положите в каждую йогурт." = "Дайте супу постояти 2 хвилини, щоб він перестав булькати. Розлийте по тарілках і покладіть у кожну йогурт.";
"Проверьте минтай пальцами на кости и измельчите в блендере или мелко порубите ножом. Натрите цукини и морковь на мелкой тёрке и отожмите руками от сока. В миске смешайте рыбу, овощи, овсяные хлопья и взбитое яйцо." = "Перевірте минтай пальцями на кісточки й подрібніть у блендері або дрібно посічіть ножем. Натріть цукіні та моркву на дрібній тертці й відіжміть руками від соку. У мисці змішайте рибу, овочі, вівсяні пластівці та збите яйце.";
"Оставьте фарш на 5 минут, чтобы хлопья набухли, и мокрыми руками сформуйте котлетки толщиной 2 см. Уложите их в пароварку или в сито над кастрюлей с кипящей водой, накройте крышкой и готовьте на пару 20 минут. Котлетки готовы, когда они плотные, а в центре 71 °C." = "Залиште фарш на 5 хвилин, щоб пластівці набухли, і мокрими руками сформуйте котлетки завтовшки 2 см. Викладіть їх у пароварку або в сито над каструлею з киплячою водою, накрийте кришкою й готуйте на парі 20 хвилин. Котлетки готові, коли вони щільні, а в центрі 71 °C.";
"Мелко порубите укроп и вмешайте в йогурт. Разложите котлетки по тарелкам и подавайте с йогуртовым соусом." = "Дрібно посічіть кріп і вмішайте в йогурт. Розкладіть котлетки по тарілках і подавайте з йогуртовим соусом.";
"Разогрейте духовку до 200 °C. Картофель вымойте и нарежьте дольками толщиной 1,5 см, разложите на противне с пергаментом в один слой, сбрызните маслом и посолите. Запекайте на среднем уровне 15–17 минут, пока дольки не начнут румяниться по краям." = "Розігрійте духовку до 200 °C. Картоплю вимийте й наріжте часточками завтовшки 1,5 см, розкладіть на деку з пергаментом в один шар, збризніть олією й посоліть. Запікайте на середньому рівні 15–17 хвилин, доки часточки не почнуть рум'янитися по краях.";
"Разберите брокколи на соцветия по 3 см. Сдвиньте картофель к краю, выложите на противень лосось кожей вниз и брокколи, посолите и запекайте ещё 12 минут. Лосось готов, когда в самой толстой части 63 °C и мякоть легко расслаивается." = "Розберіть броколі на суцвіття по 3 см. Відсуньте картоплю до краю, викладіть на деко лосось шкірою донизу та броколі, посоліть і запікайте ще 12 хвилин. Лосось готовий, коли в найтовщій частині 63 °C і м'якоть легко розшаровується.";
"Выжмите сок лимона в йогурт и размешайте. Разложите картофель, брокколи и лосось по тарелкам, а соус подайте отдельно в мисочке." = "Вичавіть сік лимона в йогурт і розмішайте. Розкладіть картоплю, броколі й лосось по тарілках, а соус подайте окремо в мисочці.";
"Лук нарежьте мелкими кубиками 0,5 см, морковь натрите на крупной тёрке. Разогрейте в кастрюле немного растительного масла на среднем огне и обжаривайте лук с морковью 5 минут, помешивая, пока лук не станет мягким и прозрачным." = "Цибулю наріжте дрібними кубиками 0,5 см, моркву натріть на великій тертці. Розігрійте в каструлі трохи олії на середньому вогні й обсмажуйте цибулю з морквою 5 хвилин, помішуючи, доки цибуля не стане м'якою та прозорою.";
"Томаты нарежьте кубиками 1,5 см, чечевицу промойте в сите. Добавьте их в кастрюлю, влейте горячую воду так, чтобы она покрывала продукты на 3–4 см, и доведите до кипения. Убавьте огонь до слабого, накройте крышкой и готовьте 15–17 минут, пока чечевица не станет совсем мягкой и не начнёт распадаться." = "Помідори наріжте кубиками 1,5 см, сочевицю промийте в ситі. Додайте їх у каструлю, влийте гарячу воду так, щоб вона покривала продукти на 3–4 см, і доведіть до кипіння. Зменште вогонь до слабкого, накрийте кришкою й готуйте 15–17 хвилин, доки сочевиця не стане зовсім м'якою й не почне розпадатися.";
"Посолите и поперчите суп по вкусу и снимите кастрюлю с огня. Для более нежной текстуры пройдитесь погружным блендером 3–4 раза по 2 секунды: часть супа станет пюре, а кусочки овощей останутся." = "Посоліть і поперчіть суп до смаку та зніміть каструлю з вогню. Для ніжнішої текстури пройдіться заглибним блендером 3–4 рази по 2 секунди: частина супу стане пюре, а шматочки овочів залишаться.";
"Переберите гречку, промойте в сите и пересыпьте в кастрюлю. Залейте холодной водой, посолите и доведите до кипения на сильном огне. Накройте крышкой и варите на слабом огне 15 минут, пока вода не впитается, а зёрна не станут мягкими, затем снимите с огня и не открывайте." = "Переберіть гречку, промийте в ситі й пересипте в каструлю. Залийте холодною водою, посоліть і доведіть до кипіння на сильному вогні. Накрийте кришкою і варіть на слабкому вогні 15 хвилин, доки вода не вбереться, а зерна не стануть м'якими, потім зніміть з вогню й не відкривайте.";
"Куриное филе нарежьте полосками толщиной 1,5 см и посолите. Разогрейте сковороду с небольшим количеством масла на среднем огне и обжаривайте курицу 7–8 минут, переворачивая, пока она не подрумянится со всех сторон. Разрежьте самый толстый кусочек: внутри не должно быть розового, а в центре — 74 °C." = "Куряче філе наріжте смужками завтовшки 1,5 см і посоліть. Розігрійте сковороду з невеликою кількістю олії на середньому вогні й обсмажуйте курку 7–8 хвилин, перевертаючи, доки вона не підрум'яниться з усіх боків. Розріжте найтовщий шматочок: усередині не має бути рожевого, а в центрі — 74 °C.";
"Огурец вымойте и нарежьте полукружьями толщиной 0,5 см. Разложите гречку и курицу по тарелкам, огурец положите рядом." = "Огірок вимийте й наріжте півкружальцями завтовшки 0,5 см. Розкладіть гречку й курку по тарілках, огірок покладіть поруч.";
"Вскипятите чайник, перелейте кипяток в большую кастрюлю, доведите до бурного кипения на сильном огне и посолите. Всыпьте макароны, сразу перемешайте и варите без крышки 8–10 минут, пока они не станут мягкими, но чуть упругими в середине. Откиньте на дуршлаг, не промывая." = "Закип'ятіть чайник, перелийте окріп у велику каструлю, доведіть до бурхливого кипіння на сильному вогні й посоліть. Всипте макарони, одразу перемішайте й варіть без кришки 8–10 хвилин, доки вони не стануть м'якими, але трохи пружними всередині. Відкиньте на друшляк, не промиваючи.";
"Кабачок нарежьте кубиками 1,5 см, томаты — кубиками 1 см. Сложите в сковороду, посолите и тушите под крышкой на среднем огне 6 минут, помешивая, пока кабачок не станет мягким, а томаты не пустят сок." = "Кабачок наріжте кубиками 1,5 см, помідори — кубиками 1 см. Складіть у сковороду, посоліть і тушкуйте під кришкою на середньому вогні 6 хвилин, помішуючи, доки кабачок не стане м'яким, а помідори не пустять сік.";
"Переложите макароны в сковороду с овощами и перемешайте на слабом огне 1 минуту. Разложите по тарелкам и посыпьте сыром, натёртым на мелкой тёрке." = "Перекладіть макарони у сковороду з овочами й перемішайте на слабкому вогні 1 хвилину. Розкладіть по тарілках і посипте сиром, натертим на дрібній тертці.";
"Промойте рис в сите до прозрачной струи, пересыпьте в небольшую кастрюлю, залейте холодной водой и посолите. Доведите до кипения на сильном огне, накройте крышкой и варите на самом слабом огне 15 минут, не открывая. Снимите с огня и оставьте под крышкой до подачи." = "Промийте рис у ситі до прозорого струменя, пересипте в невелику каструлю, залийте холодною водою й посоліть. Доведіть до кипіння на сильному вогні, накрийте кришкою і варіть на найслабшому вогні 15 хвилин, не відкриваючи. Зніміть з вогню й залиште під кришкою до подачі.";
"Индейку нарежьте кубиками 2 см на отдельной доске. Морковь нарежьте тонкими кружками толщиной 3 мм, кабачок — кубиками 1,5 см." = "Індичку наріжте кубиками 2 см на окремій дошці. Моркву наріжте тонкими кружальцями завтовшки 3 мм, кабачок — кубиками 1,5 см.";
"Разогрейте сковороду с небольшим количеством масла на среднем огне и обжаривайте индейку 4 минуты, помешивая. Добавьте морковь и кабачок, посолите, накройте крышкой и жарьте ещё 5 минут, пока овощи не станут мягкими, а индейка внутри — без розового, 74 °C в самом толстом кубике. Подавайте с рисом." = "Розігрійте сковороду з невеликою кількістю олії на середньому вогні й обсмажуйте індичку 4 хвилини, помішуючи. Додайте моркву й кабачок, посоліть, накрийте кришкою і смажте ще 5 хвилин, доки овочі не стануть м'якими, а індичка всередині — без рожевого, 74 °C у найтовщому кубику. Подавайте з рисом.";
"Лук нарежьте мелкими кубиками, сладкий перец очистите от семян и нарежьте полосками 1 см. Прогрейте их в кастрюле с небольшим количеством масла на среднем огне 4 минуты, помешивая, пока лук не станет мягким." = "Цибулю наріжте дрібними кубиками, солодкий перець очистіть від насіння й наріжте смужками 1 см. Прогрійте їх у каструлі з невеликою кількістю олії на середньому вогні 4 хвилини, помішуючи, доки цибуля не стане м'якою.";
"Нарежьте томаты кубиками 1,5 см, а чечевицу промойте в сите до прозрачной струи. Добавьте их к луку с перцем, залейте водой, посолите и доведите до кипения на сильном огне, около 2 минут." = "Наріжте помідори кубиками 1,5 см, а сочевицю промийте в ситі до прозорого струменя. Додайте їх до цибулі з перцем, залийте водою, посоліть і доведіть до кипіння на сильному вогні, приблизно 2 хвилини.";
"Убавьте огонь до слабого, накройте крышкой и тушите 15–17 минут, помешивая раз в 5 минут, чтобы не пригорело. Рагу готово, когда чечевица мягкая и почти развалилась, а соус загустел." = "Зменште вогонь до слабкого, накрийте кришкою й тушкуйте 15–17 хвилин, помішуючи кожні 5 хвилин, щоб не пригоріло. Рагу готове, коли сочевиця м'яка й майже розпалася, а соус загус.";
"Накануне вечером замочите нут в большой миске холодной воды и уберите в холодильник на ночь. Затем слейте воду, промойте нут, переложите в кастрюлю и залейте свежей водой. Доведите до кипения на сильном огне и варите под приоткрытой крышкой на слабом огне 60–70 минут, пока нут не станет мягким; лишний отвар слейте в чашку." = "Напередодні ввечері замочіть нут у великій мисці з холодною водою й поставте в холодильник на ніч. Потім злийте воду, промийте нут, перекладіть у каструлю й залийте свіжою водою. Доведіть до кипіння на сильному вогні й варіть під прочиненою кришкою на слабкому вогні 60–70 хвилин, доки нут не стане м'яким; зайвий відвар злийте в чашку.";
"Лук нарежьте мелкими кубиками, чеснок — тонкими пластинками. В сковороде с высокими бортами разогрейте оливковое масло на среднем огне и обжарьте лук с чесноком 2–3 минуты до мягкости. Добавьте томаты, нарезанные кубиками 1,5 см, паприку и соль, накройте и тушите на слабом огне 10 минут, пока томаты не превратятся в соус." = "Цибулю наріжте дрібними кубиками, часник — тонкими пластинками. У сковороді з високими бортиками розігрійте оливкову олію на середньому вогні й обсмажте цибулю з часником 2–3 хвилини до м'якості. Додайте помідори, нарізані кубиками 1,5 см, паприку й сіль, накрийте й тушкуйте на слабкому вогні 10 хвилин, доки помідори не перетворяться на соус.";
"Добавьте нут и промытый шпинат, перемешайте и прогрейте под крышкой 3–4 минуты, пока шпинат не опадёт. Если соус слишком густой, влейте немного отвара нута и размешайте." = "Додайте нут і промитий шпинат, перемішайте й прогрійте під кришкою 3–4 хвилини, доки шпинат не зів'яне. Якщо соус надто густий, влийте трохи відвару нуту й розмішайте.";
"Включите духовку на 200 °C. В миске смешайте оливковое масло, лимонный сок, мелко натёртый чеснок, орегано и соль — это заправка. Половиной заправки натрите куриное филе со всех сторон и оставьте на 5 минут, а вторую половину отложите в чистую чашку для подачи." = "Увімкніть духовку на 200 °C. У мисці змішайте оливкову олію, лимонний сік, дрібно натертий часник, орегано й сіль — це заправка. Половиною заправки натріть куряче філе з усіх боків і залиште на 5 хвилин, а другу половину відкладіть у чисту чашку для подачі.";
"Выложите курицу в форму и запекайте на среднем уровне 20 минут. Через 10 минут добавьте в форму брокколи, разобранную на соцветия по 3 см. Курица готова, когда в самой толстой части 74 °C, а сок прозрачный." = "Викладіть курку у форму й запікайте на середньому рівні 20 хвилин. Через 10 хвилин додайте у форму броколі, розібрану на суцвіття по 3 см. Курка готова, коли в найтовщій частині 74 °C, а сік прозорий.";
"Промойте булгур, всыпьте в кастрюлю, залейте водой и доведите до кипения на сильном огне. Накройте крышкой и держите на слабом огне 12 минут, пока булгур не впитает всю воду. Разложите булгур, курицу и брокколи по тарелкам и полейте отложенной заправкой, которая не касалась сырой курицы." = "Промийте булгур, всипте в каструлю, залийте водою й доведіть до кипіння на сильному вогні. Накрийте кришкою і тримайте на слабкому вогні 12 хвилин, доки булгур не вбере всю воду. Розкладіть булгур, курку й броколі по тарілках і полийте відкладеною заправкою, яка не торкалася сирої курки.";
"Промойте чечевицу в сите, всыпьте в кастрюлю, залейте холодной водой и доведите до кипения на сильном огне. Убавьте огонь и варите без крышки 25 минут, пока зёрна не станут мягкими, но сохранят форму, затем откиньте на сито. За 10 минут до конца варки включите духовку на 200 °C." = "Промийте сочевицю в ситі, всипте в каструлю, залийте холодною водою й доведіть до кипіння на сильному вогні. Зменште вогонь і варіть без кришки 25 хвилин, доки зерна не стануть м'якими, але збережуть форму, потім відкиньте на сито. За 10 хвилин до кінця варіння увімкніть духовку на 200 °C.";
"Выложите лосось кожей вниз на противень с пергаментом и запекайте на среднем уровне 12–15 минут, пока в самой толстой части не будет 63 °C, а мякоть не начнёт легко расслаиваться. Пока рыба запекается, промойте овощи и листья салата: огурец нарежьте полукружьями 0,5 см, черри — пополам, а листья порвите руками." = "Викладіть лосось шкірою донизу на деко з пергаментом і запікайте на середньому рівні 12–15 хвилин, доки в найтовщій частині не буде 63 °C, а м'якоть не почне легко розшаровуватися. Поки риба запікається, промийте овочі та листя салату: огірок наріжте півкружальцями 0,5 см, черрі — навпіл, а листя порвіть руками.";
"В большой миске смешайте чечевицу, огурец, черри и листья салата с оливковым маслом, лимонным соком и солью. Разложите по тарелкам, а сверху — кусочки лосося без кожи и костей." = "У великій мисці змішайте сочевицю, огірок, черрі й листя салату з оливковою олією, лимонним соком і сіллю. Розкладіть по тарілках, а зверху — шматочки лосося без шкіри й кісточок.";
"Нут замочите заранее: вечером залейте его холодной водой и оставьте на ночь в холодильнике. Слейте воду, промойте нут, переложите в кастрюлю, залейте свежей водой и доведите до кипения на сильном огне. Варите под приоткрытой крышкой на слабом огне 60–70 минут, пока нут не станет мягким, затем откиньте на сито и остудите 10 минут." = "Нут замочіть заздалегідь: увечері залийте його холодною водою й залиште на ніч у холодильнику. Злийте воду, промийте нут, перекладіть у каструлю, залийте свіжою водою й доведіть до кипіння на сильному вогні. Варіть під прочиненою кришкою на слабкому вогні 60–70 хвилин, доки нут не стане м'яким, потім відкиньте на сито й остудіть 10 хвилин.";
"Томаты нарежьте кубиками 2 см, огурец — полукружьями толщиной 1 см, лук — тонкими полукольцами. Фету раскрошите руками на кусочки около 1 см." = "Помідори наріжте кубиками 2 см, огірок — півкружальцями завтовшки 1 см, цибулю — тонкими півкільцями. Фету розкришіть руками на шматочки приблизно 1 см.";
"Если в оливках есть косточки, выньте их и разрежьте оливки пополам. В большой миске соедините нут, овощи, фету и оливки, полейте оливковым маслом и лимонным соком, посыпьте орегано и аккуратно перемешайте. Попробуйте и только потом посолите: фета и оливки уже солёные." = "Якщо в оливках є кісточки, вийміть їх і розріжте оливки навпіл. У великій мисці з'єднайте нут, овочі, фету й оливки, полийте оливковою олією та лимонним соком, посипте орегано й обережно перемішайте. Скуштуйте й лише потім посоліть: фета й оливки вже солоні.";
"Разогрейте духовку до 200 °C. Баклажан вымойте и нарежьте кружками толщиной 1 см, выложите на противень с бумагой для выпечки и смажьте с обеих сторон половиной оливкового масла. Запекайте 15 минут, пока кружки не станут мягкими и слегка не зарумянятся." = "Розігрійте духовку до 200 °C. Баклажан помийте, наріжте кружальцями завтовшки 1 см, викладіть на деко з папером для випікання й змастіть з обох боків половиною оливкової олії. Запікайте 15 хвилин, доки кружальця не стануть м’якими й злегка не зарум’яняться.";
"Пока баклажан запекается, мелко нарежьте лук и чеснок и обжарьте их в сотейнике на остальном масле на среднем огне 3 минуты. Добавьте нарезанные кубиками томаты, промытую красную чечевицу, воду, орегано и соль. Накройте крышкой и тушите на слабом огне 15–20 минут, помешивая, пока чечевица не разварится и соус не загустеет." = "Поки баклажан запікається, дрібно наріжте цибулю й часник і обсмажте їх у сотейнику на решті олії на середньому вогні 3 хвилини. Додайте нарізані кубиками томати, промиту червону сочевицю, воду, орегано й сіль. Накрийте кришкою й тушкуйте на слабкому вогні 15–20 хвилин, помішуючи, доки сочевиця не розвариться, а соус не загусне.";
"Выложите в небольшую форму половину кружков баклажана, сверху чечевичную начинку, затем остальные кружки. Моцареллу нарежьте ломтиками и разложите сверху. Запекайте при 200 °C 10 минут, пока сыр не расплавится и не начнёт румяниться." = "Викладіть у невелику форму половину кружалець баклажана, зверху сочевичну начинку, потім решту кружалець. Моцарелу наріжте скибочками й розкладіть зверху. Запікайте при 200 °C 10 хвилин, доки сир не розплавиться й не почне рум’янитися.";
"Вскипятите воду в большой кастрюле на сильном огне. Всыпьте пасту, перемешайте и варите без крышки 8–10 минут, пока она не станет мягкой, но упругой в середине. Отлейте в кружку немного отвара, остальную воду слейте через дуршлаг." = "Закип’ятіть воду у великій каструлі на сильному вогні. Всипте пасту, перемішайте й варіть без кришки 8–10 хвилин, доки вона не стане м’якою, але пружною всередині. Відлийте в кухлик трохи відвару, решту води злийте через друшляк.";
"Чеснок нарежьте тонкими пластинками и прогрейте в широкой сковороде на оливковом масле на среднем огне 1 минуту, не давая потемнеть. Добавьте очищенные креветки и разрезанные пополам томаты черри. Жарьте 3–4 минуты, помешивая, пока креветки не станут розовыми и непрозрачными." = "Часник наріжте тонкими пластинками й прогрійте в широкій сковороді на оливковій олії на середньому вогні 1 хвилину, не даючи потемніти. Додайте очищені креветки й розрізані навпіл томати черрі. Смажте 3–4 хвилини, помішуючи, доки креветки не стануть рожевими й непрозорими.";
"Добавьте в сковороду шпинат и сваренную пасту, влейте лимонный сок, посыпьте солью и перемешайте. Прогрейте 1–2 минуты, пока шпинат не осядет. Если паста суховата, подлейте немного отвара из кружки и перемешайте ещё раз." = "Додайте в сковороду шпинат і зварену пасту, влийте лимонний сік, посипте сіллю й перемішайте. Прогрійте 1–2 хвилини, доки шпинат не осяде. Якщо паста сухувата, підлийте трохи відвару з кухлика й перемішайте ще раз.";
"Разогрейте духовку до 200 °C. Кабачок и сладкий перец нарежьте кубиками 1,5 см, томаты — дольками. Перемешайте овощи с оливковым маслом прямо на противне, разложите в один слой и запекайте 18–20 минут, пока края не зарумянятся, а кабачок не станет мягким." = "Розігрійте духовку до 200 °C. Кабачок і солодкий перець наріжте кубиками 1,5 см, томати — часточками. Перемішайте овочі з оливковою олією просто на деку, розкладіть в один шар і запікайте 18–20 хвилин, доки краї не зарум’яняться, а кабачок не стане м’яким.";
"Пока овощи в духовке, вскипятите воду в небольшой кастрюле, добавьте соль и всыпьте булгур. Накройте крышкой и варите на слабом огне 12 минут, пока зёрна не впитают всю воду и не станут мягкими. Снимите с огня и разрыхлите вилкой." = "Поки овочі в духовці, закип’ятіть воду в невеликій каструлі, додайте сіль і всипте булгур. Накрийте кришкою й варіть на слабкому вогні 12 хвилин, доки зерна не вберуть усю воду й не стануть м’якими. Зніміть з вогню й розпушіть виделкою.";
"Выложите горячую крупу на тарелку, сверху — запечённые овощи. Петрушку мелко порубите, фету раскрошите руками и посыпьте ими блюдо перед подачей." = "Викладіть гарячу крупу на тарілку, зверху — запечені овочі. Петрушку дрібно посічіть, фету розкришіть руками й посипте ними страву перед подачею.";
"Разбейте яйца в миску, влейте молоко и взбейте вилкой около 1 минуты до однородной массы без прожилок белка. Шпинат промойте в холодной воде, стряхните капли, а крупные листья порвите руками." = "Розбийте яйця в миску, влийте молоко й збийте виделкою близько 1 хвилини до однорідної маси без прожилок білка. Шпинат промийте в холодній воді, струсіть краплі, а великі листки порвіть руками.";
"Разогрейте оливковое масло в сковороде на среднем огне, выложите шпинат и прогревайте 1 минуту, пока листья не осядут. Влейте яичную смесь, накройте крышкой, убавьте огонь до слабого и готовьте 4–5 минут. Омлет готов, когда верх полностью схватился и не блестит, около 75 °C в центре." = "Розігрійте оливкову олію в сковороді на середньому вогні, викладіть шпинат і прогрівайте 1 хвилину, доки листя не осяде. Влийте яєчну суміш, накрийте кришкою, зменшіть вогонь до слабкого й готуйте 4–5 хвилин. Омлет готовий, коли верх повністю схопився й не блищить, близько 75 °C у центрі.";
"Посыпьте одну половину омлета раскрошенной фетой и накройте её второй половиной с помощью лопатки. Томаты вымойте и нарежьте дольками. Переложите омлет на тарелку и выложите томаты рядом." = "Посипте одну половину омлету розкришеною фетою й накрийте її другою половиною за допомогою лопатки. Томати помийте й наріжте часточками. Перекладіть омлет на тарілку й викладіть томати поруч.";
"Налейте воду в небольшую кастрюлю, доведите до кипения и убавьте огонь, чтобы вода едва булькала. Разбейте каждое яйцо в чашку и аккуратно вылейте в воду. Варите 5–6 минут, пока белок и желток не станут плотными." = "Налийте воду в невелику каструлю, доведіть до кипіння й зменшіть вогонь, щоб вода ледь булькала. Розбийте кожне яйце в чашку й обережно вилийте у воду. Варіть 5–6 хвилин, доки білок і жовток не стануть щільними.";
"Пока яйца варятся, подсушите хлеб в тостере или на сухой сковороде 2–3 минуты до хруста. В другой сковороде разогрейте оливковое масло на среднем огне, выложите шпинат, добавьте соль и прогревайте 1–2 минуты, помешивая, пока листья не станут мягкими." = "Поки яйця варяться, підсушіть хліб у тостері або на сухій сковороді 2–3 хвилини до хрусткості. В іншій сковороді розігрійте оливкову олію на середньому вогні, викладіть шпинат, додайте сіль і прогрівайте 1–2 хвилини, помішуючи, доки листя не стане м’яким.";
"Разложите прогретые листья по тостам. Достаньте яйца шумовкой, дайте стечь воде и положите сверху. Томаты черри вымойте и подайте рядом." = "Розкладіть прогріте листя на тости. Дістаньте яйця шумівкою, дайте стекти воді й покладіть зверху. Томати черрі помийте й подайте поруч.";
"Разогрейте духовку до 190 °C, выложите куриное филе в небольшую форму и запекайте 18–20 минут. Курица готова, когда в самой толстой части 74 °C, а на разрезе мясо белое, без розового. Дайте ей постоять 3 минуты; подойдёт и филе, запечённое накануне." = "Розігрійте духовку до 190 °C, викладіть куряче філе в невелику форму й запікайте 18–20 хвилин. Курка готова, коли в найтовщій частині 74 °C, а на розрізі м’ясо біле, без рожевого. Дайте їй постояти 3 хвилини; підійде й філе, запечене напередодні.";
"Хлеб подрумяньте в тостере или на сухой сковороде по 1–2 минуты с каждой стороны. Авокадо разрежьте пополам, выньте косточку и ложкой переложите мякоть в миску. Разомните её вилкой с лимонным соком и солью до гладкой пасты." = "Хліб підрум’яньте в тостері або на сухій сковороді по 1–2 хвилини з кожного боку. Авокадо розріжте навпіл, вийміть кісточку й ложкою перекладіть м’якуш у миску. Розімніть його виделкою з лимонним соком і сіллю до гладкої пасти.";
"Намажьте пасту толстым слоем на тосты. Мясо нарежьте поперёк волокон тонкими ломтиками и разложите сверху. Огурец нарежьте кружками толщиной 0,5 см и подайте рядом." = "Намажте пасту товстим шаром на тости. М’ясо наріжте впоперек волокон тонкими скибочками й розкладіть зверху. Огірок наріжте кружальцями завтовшки 0,5 см і подайте поруч.";
"Включите духовку на 200 °C. Пока она нагревается, нарежьте моцареллу и томаты ломтиками толщиной 0,5 см, это займёт 2–3 минуты. Ломтики томатов положите на бумажное полотенце, чтобы стёк лишний сок." = "Увімкніть духовку на 200 °C. Поки вона нагрівається, наріжте моцарелу й томати скибочками завтовшки 0,5 см, це займе 2–3 хвилини. Скибочки томатів покладіть на паперовий рушник, щоб стік зайвий сік.";
"Разложите хлеб на противень и накройте каждый ломтик моцареллой. Запекайте 4–5 минут, пока сыр не расплавится, а края хлеба не подрумянятся." = "Розкладіть хліб на деко й накрийте кожну скибку моцарелою. Запікайте 4–5 хвилин, доки сир не розплавиться, а краї хліба не підрум’яняться.";
"Листья базилика промойте и обсушите. Выложите на горячие тосты ломтики помидоров и базилик, сбрызните оливковым маслом и посыпьте молотым чёрным перцем. Подавайте сразу, пока сыр мягкий." = "Листя базиліку промийте й обсушіть. Викладіть на гарячі тости скибочки помідорів і базилік, збризніть оливковою олією й посипте меленим чорним перцем. Подавайте одразу, поки сир м’який.";
"Шампиньоны протрите влажным полотенцем и нарежьте пластинками толщиной 0,5 см. Разогрейте оливковое масло в сковороде на среднем огне и жарьте грибы 6–7 минут, помешивая, пока жидкость не испарится и они не подрумянятся." = "Печериці протріть вологим рушником і наріжте пластинками завтовшки 0,5 см. Розігрійте оливкову олію в сковороді на середньому вогні й смажте гриби 6–7 хвилин, помішуючи, доки рідина не випарується, а вони не підрум’яняться.";
"Разбейте яйца в миску, добавьте соль и взбейте вилкой. Влейте их в сковороду к грибам и мешайте лопаткой на среднем огне 2–3 минуты, пока не останется жидких участков. Яйца должны стать плотными, около 75 °C." = "Розбийте яйця в миску, додайте сіль і збийте виделкою. Влийте їх у сковороду до грибів і перемішуйте лопаткою на середньому вогні 2–3 хвилини, доки не залишиться рідких ділянок. Яйця мають стати щільними, близько 75 °C.";
"Натрите сыр на мелкой тёрке, зелёный лук мелко нарежьте. Посыпьте ими яйца, снимите сковороду с огня и подождите 1 минуту, пока сыр не растает. Ломтик хлеба подсушите в тостере и подайте рядом." = "Натріть сир на дрібній тертці, зелену цибулю дрібно наріжте. Посипте ними яйця, зніміть сковороду з вогню й зачекайте 1 хвилину, доки сир не розтане. Скибку хліба підсушіть у тостері й подайте поруч.";
"Влейте молоко в небольшую кастрюлю и доведите до лёгкого кипения на среднем огне. Всыпьте овсяные хлопья, убавьте огонь до слабого и варите 5–6 минут, часто помешивая, пока каша не загустеет." = "Влийте молоко в невелику каструлю й доведіть до легкого кипіння на середньому вогні. Всипте вівсяні пластівці, зменшіть вогонь до слабкого й варіть 5–6 хвилин, часто помішуючи, доки каша не загусне.";
"Сливы вымойте, разрежьте пополам, удалите косточки и нарежьте тонкими дольками. Грецкие орехи крупно порубите ножом на доске." = "Сливи помийте, розріжте навпіл, видаліть кісточки й наріжте тонкими часточками. Волоські горіхи грубо посічіть ножем на дошці.";
"Переложите кашу в тарелку, сверху выложите греческий йогурт, дольки слив и орехи. Посыпьте корицей и подавайте тёплой." = "Перекладіть кашу в тарілку, зверху викладіть грецький йогурт, часточки слив і горіхи. Посипте корицею й подавайте теплою.";
"Разбейте яйцо в миску, влейте молоко и взбейте венчиком. Постепенно всыпайте рисовую муку, всё время размешивая, пока тесто не станет жидким и гладким, без комков. Оставьте его на 5 минут, чтобы мука набухла." = "Розбийте яйце в миску, влийте молоко й збийте вінчиком. Поступово всипайте рисове борошно, весь час розмішуючи, доки тісто не стане рідким і гладеньким, без грудочок. Залиште його на 5 хвилин, щоб борошно набухло.";
"Разогрейте сковороду на среднем огне и смажьте её растительным маслом с помощью бумажного полотенца. Налейте немного теста и наклоните сковороду, чтобы оно растеклось тонким слоем. Жарьте по 1–2 минуты с каждой стороны до золотистых краёв и так испеките всё тесто." = "Розігрійте сковороду на середньому вогні й змастіть її рослинною олією за допомогою паперового рушника. Налийте трохи тіста й нахиліть сковороду, щоб воно розтеклося тонким шаром. Смажте по 1–2 хвилини з кожного боку до золотистих країв і так випечіть усе тісто.";
"Разложите творог полоской по краю каждого блинчика и сверните трубочкой. Ягоды промойте в сите, дайте стечь воде и выложите рядом с блинчиками." = "Розкладіть кисломолочний сир смужкою по краю кожного млинця й згорніть трубочкою. Ягоди промийте в ситі, дайте стекти воді й викладіть поруч із млинцями.";
"Морковь очистите, натрите на мелкой тёрке и отожмите руками лишний сок. В миске разомните творог вилкой, добавьте морковь, яйцо, рисовую муку и корицу и перемешайте до однородной массы." = "Моркву очистіть, натріть на дрібній тертці й відтисніть руками зайвий сік. У мисці розімніть кисломолочний сир виделкою, додайте моркву, яйце, рисове борошно й корицю та перемішайте до однорідної маси.";
"Включите духовку на 190 °C и застелите противень бумагой для выпечки. Пока духовка нагревается, мокрыми руками скатайте из массы шарики размером с грецкий орех и приплюсните до толщины 1,5 см, на это уйдёт 4–5 минут. Выложите сырники на противень с промежутками." = "Увімкніть духовку на 190 °C і застеліть деко папером для випікання. Поки духовка нагрівається, мокрими руками скачайте з маси кульки завбільшки з волоський горіх і сплющте до товщини 1,5 см, на це піде 4–5 хвилин. Викладіть сирники на деко з проміжками.";
"Запекайте 18–20 минут, через 10 минут переверните сырники лопаткой. Они готовы, когда обе стороны зарумянились, а при нажатии сырник упругий. Подавайте тёплыми с натуральным йогуртом." = "Запікайте 18–20 хвилин, через 10 хвилин переверніть сирники лопаткою. Вони готові, коли обидва боки зарум’янилися, а сирник при натисканні пружний. Подавайте теплими з натуральним йогуртом.";
"Разогрейте духовку до 200 °C. Картофель очистите и нарежьте ломтиками толщиной 3 мм, сладкий перец и лук — мелкими кубиками. Перемешайте овощи с оливковым маслом в небольшой форме и запекайте 15 минут, пока картофель не станет мягким и нож не будет входить легко." = "Розігрійте духовку до 200 °C. Картоплю очистіть і наріжте скибочками завтовшки 3 мм, солодкий перець і цибулю — дрібними кубиками. Перемішайте овочі з оливковою олією в невеликій формі й запікайте 15 хвилин, доки картопля не стане м’якою, а ніж не входитиме легко.";
"Разбейте яйца в миску, всыпьте соль и взбейте вилкой до однородности. Залейте ими горячие овощи прямо в форме и запекайте ещё 12–15 минут. Тортилья готова, когда центр стал плотным и не дрожит, если покачать форму." = "Розбийте яйця в миску, всипте сіль і збийте виделкою до однорідності. Залийте ними гарячі овочі просто у формі й запікайте ще 12–15 хвилин. Тортилья готова, коли центр став щільним і не тремтить, якщо похитати форму.";
"Дайте тортилье постоять 3 минуты, чтобы она осела и её было удобно резать. Огурец нарежьте тонкими ломтиками. Разрежьте тортилью на треугольники и подайте с огурцом." = "Дайте тортильї постояти 3 хвилини, щоб вона осіла і її було зручно різати. Огірок наріжте тонкими скибочками. Розріжте тортилью на трикутники й подайте з огірком.";
"Возьмите готовый нут, консервированный или сваренный накануне. Откиньте его на сито, слейте жидкость и промойте под холодной водой 1 минуту, чтобы смыть рассол. Оставьте стекать." = "Візьміть готовий нут, консервований або зварений напередодні. Відкиньте його на сито, злийте рідину й промийте під холодною водою 1 хвилину, щоб змити розсіл. Залиште стікати.";
"Курицу нарежьте кусочками 2–3 см, лук и чеснок — мелко, томаты — кубиками. Сложите всё в сотейник, добавьте паприку и немного воды, чтобы покрыть дно. Накройте крышкой и тушите на слабом огне 15 минут, помешивая каждые 5 минут." = "Курку наріжте шматочками 2–3 см, цибулю й часник — дрібно, томати — кубиками. Складіть усе в сотейник, додайте паприку й трохи води, щоб покрити дно. Накрийте кришкою й тушкуйте на слабкому вогні 15 хвилин, помішуючи кожні 5 хвилин.";
"Добавьте нут и шпинат, перемешайте и тушите без крышки ещё 5 минут, пока шпинат не осядет. В самом толстом кусочке курицы должно быть 74 °C, сок прозрачный. Добавьте соль, полейте оливковым маслом и подавайте." = "Додайте нут і шпинат, перемішайте й тушкуйте без кришки ще 5 хвилин, доки шпинат не осяде. У найтовщому шматочку курки має бути 74 °C, сік прозорий. Додайте сіль, полийте оливковою олією й подавайте.";
"Индейку нарежьте кусками и вместе с половиной лука пропустите через мясорубку или измельчите в блендере. Добавьте яйцо и соль и вымешивайте фарш рукой 1–2 минуты до однородности. Мокрыми руками скатайте тефтели размером с грецкий орех." = "Індичку наріжте шматками й разом із половиною цибулі прокрутіть через м’ясорубку або подрібніть у блендері. Додайте яйце й сіль і вимішуйте фарш рукою 1–2 хвилини до однорідності. Мокрими руками скачайте тефтелі завбільшки з волоський горіх.";
"Остальной лук мелко нарежьте, морковь натрите на крупной тёрке. Сложите их в сотейник, влейте немного воды и тушите под крышкой на среднем огне 5 минут до мягкости. Добавьте нарезанные кубиками томаты и томатную пасту, перемешайте и доведите до кипения." = "Решту цибулі дрібно наріжте, моркву натріть на великій тертці. Складіть їх у сотейник, влийте трохи води й тушкуйте під кришкою на середньому вогні 5 хвилин до м’якості. Додайте нарізані кубиками томати й томатну пасту, перемішайте й доведіть до кипіння.";
"Опустите тефтели в кипящий соус, накройте крышкой и тушите на слабом огне 20 минут. Внутри тефтели должны прогреться до 74 °C и стать светлыми, без розового. Сбрызните оливковым маслом и посыпьте мелко нарезанной зеленью." = "Опустіть тефтелі в киплячий соус, накрийте кришкою й тушкуйте на слабкому вогні 20 хвилин. Усередині тефтелі мають прогрітися до 74 °C і стати світлими, без рожевого. Збризніть оливковою олією й посипте дрібно нарізаною зеленню.";
"Лук натрите на мелкой тёрке. В миске смешайте куриный фарш с луком, яйцом, солью и чёрным перцем и вымешайте до однородности. Мокрыми руками сформуйте небольшие котлеты толщиной около 2 см." = "Цибулю натріть на дрібній тертці. У мисці змішайте курячий фарш із цибулею, яйцем, сіллю й чорним перцем і вимішайте до однорідності. Мокрими руками сформуйте невеликі котлети завтовшки близько 2 см.";
"Брокколи и цветную капусту разберите на небольшие соцветия, морковь очистите и нарежьте брусочками толщиной 1 см. Налейте воду в нижнюю часть пароварки или в кастрюлю под вставку для пара и доведите до кипения, около 3 минут. Выложите котлеты и овощи на решётку в один слой." = "Броколі й цвітну капусту розберіть на невеликі суцвіття, моркву очистіть і наріжте брусочками завтовшки 1 см. Налийте воду в нижню частину пароварки або в каструлю під вставку для пари й доведіть до кипіння, близько 3 хвилин. Викладіть котлети й овочі на решітку в один шар.";
"Накройте крышкой и готовьте на пару на среднем огне 20–25 минут. Котлеты готовы, когда в центре 74 °C, а сок прозрачный; морковь должна легко протыкаться ножом. Подавайте горячими." = "Накрийте кришкою й готуйте на пару на середньому вогні 20–25 хвилин. Котлети готові, коли в центрі 74 °C, а сік прозорий; морква має легко протикатися ножем. Подавайте гарячими.";
"Курицу нарежьте кусками 3 см, лук — полукольцами, морковь — кружками толщиной 0,5 см. В сотейнике разогрейте растительное масло на среднем огне и обжарьте лук с морковью 5 минут, помешивая, пока лук не станет мягким и золотистым." = "Курку наріжте шматками 3 см, цибулю — півкільцями, моркву — кружальцями завтовшки 0,5 см. У сотейнику розігрійте рослинну олію на середньому вогні й обсмажте цибулю з морквою 5 хвилин, помішуючи, доки цибуля не стане м’якою й золотистою.";
"Добавьте курицу и жарьте 2 минуты, пока кусочки не побелеют со всех сторон. Разведите томатную пасту в воде и влейте в сотейник, положите лавровый лист, соль и чёрный перец. Доведите до кипения на сильном огне." = "Додайте курку й смажте 2 хвилини, доки шматочки не побіліють з усіх боків. Розведіть томатну пасту у воді й влийте в сотейник, покладіть лавровий лист, сіль і чорний перець. Доведіть до кипіння на сильному вогні.";
"Убавьте огонь до слабого, накройте крышкой и тушите 20 минут, пока морковь не станет мягкой. В самом толстом куске курицы должно быть 74 °C, сок прозрачный. Перед подачей выньте лавровый лист." = "Зменшіть вогонь до слабкого, накрийте кришкою й тушкуйте 20 хвилин, доки морква не стане м’якою. У найтовщому шматку курки має бути 74 °C, сік прозорий. Перед подачею вийміть лавровий лист.";
"Разогрейте духовку до 190 °C и запекайте куриное филе в небольшой форме 20 минут, пока в самой толстой части не будет 74 °C, а мясо на разрезе не побелеет. Тем временем положите яйцо в кастрюлю с холодной водой, доведите до кипения и варите 10 минут, затем остудите в холодной воде." = "Розігрійте духовку до 190 °C і запікайте куряче філе в невеликій формі 20 хвилин, доки в найтовщій частині не буде 74 °C, а м’ясо на розрізі не побіліє. Тим часом покладіть яйце в каструлю з холодною водою, доведіть до кипіння й варіть 10 хвилин, потім остудіть у холодній воді.";
"Листья салата промойте, обсушите и порвите руками. Огурец нарежьте полукружиями, томаты — дольками. В маленькой миске размешайте вилкой оливковое масло, лимонный сок и соль: это заправка." = "Листя салату промийте, обсушіть і порвіть руками. Огірок наріжте півкружальцями, томати — часточками. У маленькій мисці розмішайте виделкою оливкову олію, лимонний сік і сіль: це заправка.";
"Тёплое филе нарежьте ломтиками, яйцо очистите и разрежьте пополам. Выложите овощи на тарелку, сверху мясо и половинки яйца, полейте заправкой и сразу подавайте." = "Тепле філе наріжте скибочками, яйце очистіть і розріжте навпіл. Викладіть овочі на тарілку, зверху м’ясо й половинки яйця, полийте заправкою й одразу подавайте.";
"Промойте бурый рис в сите под холодной водой. Вскипятите воду в кастрюле, добавьте соль, всыпьте рис, накройте крышкой и варите на слабом огне 35–40 минут. Рис готов, когда зёрна мягкие, а вода впиталась; снимите кастрюлю с огня и не открывайте крышку." = "Промийте бурий рис у ситі під холодною водою. Закип’ятіть воду в каструлі, додайте сіль, всипте рис, накрийте кришкою й варіть на слабкому вогні 35–40 хвилин. Рис готовий, коли зерна м’які, а вода вбралася; зніміть каструлю з вогню й не відкривайте кришку.";
"Лук нарежьте полукольцами, морковь — тонкими кружками, сладкий перец — полосками, томаты — кубиками. Сложите овощи в сотейник, влейте немного воды, накройте крышкой и тушите на среднем огне 8–10 минут, пока морковь не начнёт размягчаться. Сверху выложите минтай, нарезанный кусками 4–5 см." = "Цибулю наріжте півкільцями, моркву — тонкими кружальцями, солодкий перець — смужками, томати — кубиками. Складіть овочі в сотейник, влийте трохи води, накрийте кришкою й тушкуйте на середньому вогні 8–10 хвилин, доки морква не почне м’якнути. Зверху викладіть минтай, нарізаний шматками 4–5 см.";
"Снова накройте крышкой и тушите на слабом огне 10 минут. Рыба готова, когда стала непрозрачной, легко расслаивается вилкой и в толстой части прогрелась до 63 °C. Разложите по тарелкам с рисом, сбрызните оливковым маслом и посыпьте рубленым укропом." = "Знову накрийте кришкою й тушкуйте на слабкому вогні 10 хвилин. Риба готова, коли стала непрозорою, легко розшаровується виделкою, а в товстій частині прогрілася до 63 °C. Розкладіть по тарілках із рисом, збризніть оливковою олією й посипте посіченим кропом.";
"Сразу включите духовку на 200 °C, чтобы она прогрелась к следующему шагу. Вскипятите в небольшой кастрюле воду, по объёму вдвое больше, чем булгура, добавьте соль и всыпьте булгур. Накройте крышкой и варите на слабом огне 12 минут, пока вода не впитается, затем снимите с огня и оставьте под крышкой." = "Одразу ввімкніть духовку на 200 °C, щоб вона прогрілася до наступного кроку. Закип’ятіть у невеликій каструлі воду, за об’ємом удвічі більше, ніж булгуру, додайте сіль і всипте булгур. Накрийте кришкою й варіть на слабкому вогні 12 хвилин, доки вода не вбереться, потім зніміть з вогню й залиште під кришкою.";
"Выложите лосось кожей вниз на противень с бумагой для выпечки и запекайте 10–12 минут. Он готов, когда мякоть стала непрозрачной, легко разделяется вилкой на слои и в самой толстой части прогрелась до 63 °C." = "Викладіть лосось шкірою донизу на деко з папером для випікання й запікайте 10–12 хвилин. Він готовий, коли м’якуш став непрозорим, легко ділиться виделкою на шари, а в найтовщій частині прогрівся до 63 °C.";
"Брокколи разберите на соцветия и варите в кипящей воде или на пару 4–5 минут, пока стебли не станут мягкими, но ярко-зелёными. Разложите булгур, рыбу и брокколи по тарелкам, полейте оливковым маслом и лимонным соком, посыпьте рубленым укропом." = "Броколі розберіть на суцвіття й варіть в окропі або на пару 4–5 хвилин, доки стебла не стануть м’якими, але яскраво-зеленими. Розкладіть булгур, рибу й броколі по тарілках, полийте оливковою олією й лимонним соком, посипте посіченим кропом.";
"Говядину нарежьте кубиками 1,5 см, сложите в кастрюлю и залейте холодной водой. Доведите до кипения на сильном огне, снимите пену шумовкой, убавьте огонь до слабого и варите под крышкой 40 минут, пока мясо не станет мягким." = "Яловичину наріжте кубиками 1,5 см, складіть у каструлю й залийте холодною водою. Доведіть до кипіння на сильному вогні, зніміть піну шумівкою, зменшіть вогонь до слабкого й варіть під кришкою 40 хвилин, доки м’ясо не стане м’яким.";
"Пока мясо варится, нарежьте морковь, лук и сельдерей кубиками 1 см, томаты — мелко. Чечевицу промойте в сите до прозрачной воды. Добавьте всё в кастрюлю и варите ещё 20 минут, пока чечевица не разварится." = "Поки м’ясо вариться, наріжте моркву, цибулю й селеру кубиками 1 см, томати — дрібно. Сочевицю промийте в ситі до прозорої води. Додайте все в каструлю й варіть ще 20 хвилин, доки сочевиця не розвариться.";
"Добавьте соль и молотый кориандр, перемешайте и варите ещё 2 минуты. Разлейте суп по тарелкам горячим; кусочки говядины должны легко разжёвываться." = "Додайте сіль і мелений коріандр, перемішайте й варіть ще 2 хвилини. Розлийте суп по тарілках гарячим; шматочки яловичини мають легко розжовуватися.";
"Пшено промойте в сите горячей водой, пока вода не станет прозрачной. Вскипятите воду в кастрюле, посолите, всыпьте пшено, накройте крышкой и варите на слабом огне 20 минут, пока вода не впитается и крупа не станет рассыпчатой. Через 10 минут после начала варки включите духовку на 200 °C." = "Пшоно промийте в ситі гарячою водою, доки вода не стане прозорою. Закип’ятіть воду в каструлі, посоліть, всипте пшоно, накрийте кришкою й варіть на слабкому вогні 20 хвилин, доки вода не вбереться, а крупа не стане розсипчастою. Через 10 хвилин після початку варіння ввімкніть духовку на 200 °C.";
"Тыкву очистите от кожуры и семян и нарежьте кубиками 2 см, лук — дольками, индейку — кусочками 3 см. Сложите всё на противень, добавьте оливковое масло, соль и чёрный перец, перемешайте руками и разложите в один слой." = "Гарбуз очистіть від шкірки й насіння та наріжте кубиками 2 см, цибулю — часточками, індичку — шматочками 3 см. Складіть усе на деко, додайте оливкову олію, сіль і чорний перець, перемішайте руками й розкладіть в один шар.";
"Запекайте в духовке 20 минут, перемешав один раз на середине. Тыква должна легко протыкаться ножом, а в самом толстом кусочке индейки быть 74 °C, сок прозрачный. Подавайте вместе с горячим пшеном." = "Запікайте в духовці 20 хвилин, перемішавши один раз посередині. Гарбуз має легко протикатися ножем, а в найтовщому шматочку індички має бути 74 °C, сік прозорий. Подавайте разом із гарячим пшоном.";
"Курицу нарежьте кусочками 2 см, сложите в кастрюлю и залейте холодной водой. Доведите до кипения на сильном огне, снимите пену шумовкой, убавьте огонь до слабого и варите 15 минут." = "Курку наріжте шматочками 2 см, складіть у каструлю й залийте холодною водою. Доведіть до кипіння на сильному вогні, зніміть піну шумівкою, зменшіть вогонь до слабкого й варіть 15 хвилин.";
"Пока курица варится, тонко нашинкуйте капусту, натрите морковь на крупной тёрке, мелко нарежьте лук, томаты — кубиками. Добавьте овощи и лавровый лист в кастрюлю и варите на слабом огне 20 минут, пока капуста не станет мягкой." = "Поки курка вариться, тонко нашаткуйте капусту, натріть моркву на великій тертці, дрібно наріжте цибулю, томати — кубиками. Додайте овочі й лавровий лист у каструлю й варіть на слабкому вогні 20 хвилин, доки капуста не стане м’якою.";
"Добавьте соль, перемешайте и выньте лавровый лист. Разлейте щи по тарелкам, в каждую положите натуральный йогурт и посыпьте мелко нарезанным укропом." = "Додайте сіль, перемішайте й вийміть лавровий лист. Розлийте щі по тарілках, у кожну покладіть натуральний йогурт і посипте дрібно нарізаним кропом.";
"Лук нарежьте полукольцами, морковь — соломкой, курицу — кусочками 2–3 см. В толстостенной кастрюле разогрейте растительное масло на среднем огне и обжарьте лук 3 минуты. Добавьте курицу и морковь и жарьте ещё 5 минут, помешивая, пока курица не побелеет." = "Цибулю наріжте півкільцями, моркву — соломкою, курку — шматочками 2–3 см. У товстостінній каструлі розігрійте рослинну олію на середньому вогні й обсмажте цибулю 3 хвилини. Додайте курку й моркву та смажте ще 5 хвилин, помішуючи, доки курка не побіліє.";
"Бурый рис промойте в сите и высыпьте ровным слоем поверх курицы, не перемешивая. Посыпьте специями для плова, добавьте соль, влейте горячую воду и воткните в рис неочищенные зубчики чеснока. Доведите до кипения, около 2 минут." = "Бурий рис промийте в ситі й висипте рівним шаром поверх курки, не перемішуючи. Посипте спеціями для плову, додайте сіль, влийте гарячу воду й устроміть у рис неочищені зубчики часнику. Доведіть до кипіння, близько 2 хвилин.";
"Убавьте огонь до самого слабого, плотно накройте крышкой и томите 40 минут, не перемешивая, пока рис не впитает всю воду и не станет мягким. Выключите огонь и оставьте под крышкой ещё 5 минут, затем перемешайте плов." = "Зменшіть вогонь до найслабшого, щільно накрийте кришкою й томіть 40 хвилин, не перемішуючи, доки рис не вбере всю воду й не стане м’яким. Вимкніть вогонь і залиште під кришкою ще 5 хвилин, потім перемішайте плов.";
"Включите духовку на 200 °C, она прогреется примерно за 10 минут, пока вы готовите продукты. Готовый нут, консервированный или сваренный заранее, откиньте на сито и промойте холодной водой. Томаты нарежьте кубиками 1,5 см, чеснок — мелко." = "Увімкніть духовку на 200 °C, вона прогріється приблизно за 10 хвилин, поки ви готуєте продукти. Готовий нут, консервований або зварений заздалегідь, відкиньте на сито й промийте холодною водою. Томати наріжте кубиками 1,5 см, часник — дрібно.";
"Смешайте нут, томаты, чеснок и соль прямо в жаропрочной форме и разровняйте. Сверху положите филе хека и сбрызните его лимонным соком." = "Змішайте нут, томати, часник і сіль просто у формі для запікання й розрівняйте. Зверху покладіть філе хека й збризніть його лимонним соком.";
"Запекайте 18–20 минут. Хек готов, когда стал непрозрачным, легко расслаивается вилкой и в толстой части прогрелся до 63 °C. Полейте оливковым маслом, посыпьте рубленой петрушкой и подавайте." = "Запікайте 18–20 хвилин. Хек готовий, коли став непрозорим, легко розшаровується виделкою, а в товстій частині прогрівся до 63 °C. Полийте оливковою олією, посипте посіченою петрушкою й подавайте.";
"Курицу нарежьте кубиками 2,5 см и сложите в миску. Добавьте половину йогурта, паприку, соль и лимонный сок, перемешайте и оставьте мариноваться на 10 минут. Тем временем включите духовку на 220 °C." = "Курку наріжте кубиками 2,5 см і складіть у миску. Додайте половину йогурту, паприку, сіль і лимонний сік, перемішайте й залиште маринуватися на 10 хвилин. Тим часом увімкніть духовку на 220 °C.";
"Сладкий перец, цукини и лук нарежьте кусочками 2,5 см. Нанижите на шпажки, чередуя курицу с овощами, выложите на противень с бумагой и сбрызните оливковым маслом. Запекайте 12–15 минут, перевернув один раз; в самом толстом кубике курицы должно быть 74 °C, мясо на разрезе белое." = "Солодкий перець, цукіні й цибулю наріжте шматочками 2,5 см. Нанизайте на шпажки, чергуючи курку з овочами, викладіть на деко з папером і збризніть оливковою олією. Запікайте 12–15 хвилин, перевернувши один раз; у найтовщому кубику курки має бути 74 °C, м’ясо на розрізі біле.";
"Пока шашлычки в духовке, вскипятите в небольшой кастрюле воду, по объёму вдвое больше, чем булгура, и всыпьте булгур. Варите под крышкой на слабом огне 12 минут, пока вода не впитается. Выложите булгур на тарелку, сверху шашлычки, и полейте оставшимся йогуртом." = "Поки шашлички в духовці, закип’ятіть у невеликій каструлі воду, за об’ємом удвічі більше, ніж булгуру, і всипте булгур. Варіть під кришкою на слабкому вогні 12 хвилин, доки вода не вбереться. Викладіть булгур на тарілку, зверху шашлички, і полийте рештою йогурту.";
"Лук очистите и натрите на мелкой тёрке. Половину лука смешайте в миске с фаршем, яйцом, солью и чёрным перцем и вымешайте рукой 1–2 минуты. Сформуйте мокрыми руками небольшие тефтели диаметром 3 см." = "Цибулю очистіть і натріть на дрібній тертці. Половину цибулі змішайте в мисці з фаршем, яйцем, сіллю й чорним перцем і вимішуйте рукою 1–2 хвилини. Сформуйте мокрими руками невеликі тефтелі діаметром 3 см.";
"Капусту тонко нашинкуйте, морковь натрите на крупной тёрке. В широком сотейнике разогрейте растительное масло на среднем огне и обжарьте оставшийся лук с морковью 4–5 минут. Добавьте капусту, томатную пасту и немного воды, чтобы покрыть дно, и перемешайте." = "Капусту тонко нашаткуйте, моркву натріть на великій тертці. У широкому сотейнику розігрійте рослинну олію на середньому вогні й обсмажте решту цибулі з морквою 4–5 хвилин. Додайте капусту, томатну пасту й трохи води, щоб покрити дно, і перемішайте.";
"Выложите тефтели на капусту, накройте крышкой и тушите на слабом огне 25–30 минут, перемешав капусту один раз в середине. Капуста должна стать мягкой, а тефтели внутри прогреться до 71 °C и потерять розовый цвет." = "Викладіть тефтелі на капусту, накрийте кришкою й тушкуйте на слабкому вогні 25–30 хвилин, перемішавши капусту один раз посередині. Капуста має стати м’якою, а тефтелі всередині прогрітися до 71 °C і втратити рожевий колір.";
"Включите духовку на 200 °C. Пока она нагревается, мелко порубите укроп, петрушку и чеснок, это займёт около 5 минут. Смешайте зелень в миске с оливковым маслом, лимонным соком, солью и чёрным перцем." = "Увімкніть духовку на 200 °C. Поки вона нагрівається, дрібно посічіть кріп, петрушку й часник, це займе близько 5 хвилин. Змішайте зелень у мисці з оливковою олією, лимонним соком, сіллю й чорним перцем.";
"Филе минтая обсушите бумажным полотенцем и выложите в жаропрочную форму. Равномерно покройте рыбу травяной смесью со всех сторон." = "Філе минтаю обсушіть паперовим рушником і викладіть у форму для запікання. Рівномірно вкрийте рибу трав’яною сумішшю з усіх боків.";
"Запекайте 12–15 минут. Минтай готов, когда стал непрозрачным, легко расслаивается вилкой и в толстой части прогрелся до 63 °C. Подавайте горячим." = "Запікайте 12–15 хвилин. Минтай готовий, коли став непрозорим, легко розшаровується виделкою, а в товстій частині прогрівся до 63 °C. Подавайте гарячим.";
"Положите яйца в кастрюлю с холодной водой, доведите до кипения и варите 9–10 минут, затем переложите в холодную воду. В другой кастрюле вскипятите воду, опустите стручковую фасоль и варите 6–7 минут, пока она не станет мягкой, но хрустящей, и слейте воду." = "Покладіть яйця в каструлю з холодною водою, доведіть до кипіння й варіть 9–10 хвилин, потім перекладіть у холодну воду. В іншій каструлі закип’ятіть воду, опустіть стручкову квасолю й варіть 6–7 хвилин, доки вона не стане м’якою, але хрусткою, і злийте воду.";
"Лук нарежьте тонкими полукольцами, помидоры черри разрежьте пополам, зелень мелко порубите. Очистите яйца и разрежьте каждое на четвертинки." = "Цибулю наріжте тонкими півкільцями, помідори черрі розріжте навпіл, зелень дрібно посічіть. Очистіть яйця й розріжте кожне на четвертинки.";
"В миске смешайте тёплую фасоль с луком и томатами, полейте оливковым маслом и лимонным соком, добавьте соль и перемешайте. Сверху выложите четвертинки яиц и посыпьте зеленью." = "У мисці змішайте теплу квасолю з цибулею й томатами, полийте оливковою олією та лимонним соком, додайте сіль і перемішайте. Зверху викладіть четвертинки яєць і посипте зеленню.";
"Включите духовку на 200 °C. Цукини нарежьте кружками толщиной 1 см, в форме перемешайте их с половиной оливкового масла и солью и разложите одним слоем, на всё уйдёт около 5 минут. Между кружками положите целые помидоры черри." = "Увімкніть духовку на 200 °C. Цукіні наріжте кружальцями завтовшки 1 см, у формі перемішайте їх із половиною оливкової олії та сіллю й розкладіть одним шаром, на все піде близько 5 хвилин. Між кружальцями покладіть цілі помідори черрі.";
"Положите лосось сверху на овощи кожей вниз. Сбрызните его оставшимся маслом и лимонным соком и посыпьте орегано." = "Покладіть лосось зверху на овочі шкірою донизу. Збризніть його рештою олії та лимонним соком і посипте орегано.";
"Запекайте 15–18 минут. Лосось готов, когда мякоть стала непрозрачной, легко делится вилкой и в толстой части прогрелась до 63 °C, а помидоры начали лопаться. Подавайте сразу." = "Запікайте 15–18 хвилин. Лосось готовий, коли м’якуш став непрозорим, легко ділиться виделкою, а в товстій частині прогрівся до 63 °C і помідори почали лопатися. Подавайте одразу.";
"Включите духовку на 180 °C. Тыкву очистите и нарежьте кубиками 0,5–1 см. В миске разотрите творог вилкой с яйцом, рисовой мукой и корицей до однородной массы, на это уйдёт 3–4 минуты." = "Увімкніть духовку на 180 °C. Гарбуз очистіть і наріжте кубиками 0,5–1 см. У мисці розітріть кисломолочний сир виделкою з яйцем, рисовим борошном і корицею до однорідної маси, на це піде 3–4 хвилини.";
"Вмешайте тыкву в творожную массу. Выложите её в небольшую форму и разровняйте поверхность ложкой." = "Вмішайте гарбуз у сирну масу. Викладіть її в невелику форму й розрівняйте поверхню ложкою.";
"Запекайте 35–40 минут, пока сверху не появится золотистая корочка, а центр не станет плотным и перестанет дрожать. Дайте запеканке постоять 2–3 минуты, нарежьте и подайте тёплой с натуральным йогуртом." = "Запікайте 35–40 хвилин, доки зверху не з’явиться золотиста скоринка, а центр не стане щільним і перестане тремтіти. Дайте запіканці постояти 2–3 хвилини, наріжте й подайте теплою з натуральним йогуртом.";
"Цукини нарежьте овощечисткой на тонкие длинные ленты. Креветки очистите от панциря и удалите тёмную жилку на спинке. Чеснок нарежьте тонкими пластинками." = "Цукіні наріжте овочечисткою на тонкі довгі стрічки. Креветки очистіть від панцира й видаліть темну жилку на спинці. Часник наріжте тонкими пластинками.";
"Разогрейте половину оливкового масла в сковороде на среднем огне. Обжарьте чеснок и креветки 3–4 минуты, помешивая, пока креветки не станут розовыми и непрозрачными. Добавьте ленты цукини и прогрейте ещё 1 минуту." = "Розігрійте половину оливкової олії в сковороді на середньому вогні. Обсмажте часник і креветки 3–4 хвилини, помішуючи, доки креветки не стануть рожевими й непрозорими. Додайте стрічки цукіні й прогрійте ще 1 хвилину.";
"Листья салата промойте, обсушите и выложите на тарелку, рядом — разрезанные пополам помидоры черри. Сверху разложите тёплые креветки с цукини. Смешайте оставшееся масло с лимонным соком и солью и полейте салат." = "Листя салату промийте, обсушіть і викладіть на тарілку, поруч — розрізані навпіл помідори черрі. Зверху розкладіть теплі креветки з цукіні. Змішайте решту олії з лимонним соком і сіллю та полийте салат.";
"Включите духовку на 200 °C. Курицу нарежьте кусочками 3 см, брокколи разберите на небольшие соцветия. В миске смешайте йогурт с чесноком, выдавленным через пресс, солью и чёрным перцем, на подготовку уйдёт 5–6 минут." = "Увімкніть духовку на 200 °C. Курку наріжте шматочками 3 см, броколі розберіть на невеликі суцвіття. У мисці змішайте йогурт із часником, видавленим через прес, сіллю й чорним перцем, на підготовку піде 5–6 хвилин.";
"Выложите курицу и брокколи в форму в один слой. Полейте йогуртовым соусом и натрите сверху сыр на крупной тёрке." = "Викладіть курку й броколі у форму в один шар. Полийте йогуртовим соусом і натріть зверху сир на великій тертці.";
"Запекайте 20–25 минут, пока сыр не покроется румяной корочкой. Проверьте самый крупный кусочек курицы: внутри 74 °C, мясо белое, сок прозрачный. Подавайте горячей." = "Запікайте 20–25 хвилин, доки сир не вкриється рум’яною скоринкою. Перевірте найбільший шматочок курки: усередині 74 °C, м’ясо біле, сік прозорий. Подавайте гарячою.";
"Включите духовку на 200 °C. Лук мелко нарежьте, томаты — кубиками 1 см, шпинат промойте и стряхните воду. Смешайте овощи с оливковым маслом и солью в небольшой форме, на это уйдёт 3–4 минуты." = "Увімкніть духовку на 200 °C. Цибулю дрібно наріжте, томати — кубиками 1 см, шпинат промийте й струсіть воду. Змішайте овочі з оливковою олією та сіллю в невеликій формі, на це піде 3–4 хвилини.";
"Поставьте форму в духовку на 8 минут, чтобы шпинат осел, а томаты пустили сок. Достаньте форму, сделайте ложкой в овощах по углублению на каждое яйцо и аккуратно вбейте в них яйца." = "Поставте форму в духовку на 8 хвилин, щоб шпинат осів, а томати пустили сік. Дістаньте форму, зробіть ложкою в овочах по заглибленню на кожне яйце й обережно вбийте в них яйця.";
"Посыпьте раскрошенной фетой и запекайте ещё 10–12 минут. Блюдо готово, когда белок полностью схватился, а желток стал плотным. Подавайте прямо в форме." = "Посипте розкришеною фетою й запікайте ще 10–12 хвилин. Страва готова, коли білок повністю схопився, а жовток став щільним. Подавайте просто у формі.";
"Вскипятите воду в кастрюле, посолите, опустите куриное филе, убавьте огонь до слабого и варите 15–18 минут. Курица готова, когда в самой толстой части 74 °C, а на разрезе мясо белое. Остудите её 3 минуты на доске и разберите двумя вилками на тонкие волокна." = "Закип’ятіть воду в каструлі, посоліть, опустіть куряче філе, зменшіть вогонь до слабкого й варіть 15–18 хвилин. Курка готова, коли в найтовщій частині 74 °C, а на розрізі м’ясо біле. Остудіть її 3 хвилини на дошці й розберіть двома виделками на тонкі волокна.";
"Пекинскую капусту тонко нашинкуйте поперёк кочана, огурец нарежьте тонкой соломкой, зелёный лук мелко порубите. Сложите овощи в большую миску." = "Пекінську капусту тонко нашаткуйте впоперек качана, огірок наріжте тонкою соломкою, зелену цибулю дрібно посічіть. Складіть овочі у велику миску.";
"В маленькой миске размешайте йогурт с горчицей и солью. Добавьте к овощам курицу, полейте соусом и перемешайте. Подавайте сразу, пока капуста хрустит." = "У маленькій мисці розмішайте йогурт із гірчицею та сіллю. Додайте до овочів курку, полийте соусом і перемішайте. Подавайте одразу, поки капуста хрумтить.";
"Готовый нут, консервированный или сваренный накануне, откиньте на сито и промойте холодной водой. Цукини, баклажан и томаты нарежьте кубиками 1,5 см, лук и чеснок — мелко." = "Готовий нут, консервований або зварений напередодні, відкиньте на сито й промийте холодною водою. Цукіні, баклажан і томати наріжте кубиками 1,5 см, цибулю й часник — дрібно.";
"Сложите лук и чеснок в сотейник, влейте немного воды и тушите на среднем огне 3 минуты до мягкости. Добавьте баклажан и цукини, через 2 минуты — томаты и соль. Накройте крышкой и тушите на слабом огне 20 минут, помешивая раз в 5 минут, пока баклажан не станет мягким." = "Складіть цибулю й часник у сотейник, влийте трохи води й тушкуйте на середньому вогні 3 хвилини до м’якості. Додайте баклажан і цукіні, через 2 хвилини — томати й сіль. Накрийте кришкою й тушкуйте на слабкому вогні 20 хвилин, помішуючи раз на 5 хвилин, доки баклажан не стане м’яким.";
"Вмешайте нут и прогрейте без крышки 5 минут. Перед подачей полейте рагу оливковым маслом и посыпьте листьями базилика, порванными руками." = "Вмішайте нут і прогрійте без кришки 5 хвилин. Перед подачею полийте рагу оливковою олією й посипте листям базиліку, порваним руками.";
"Включите духовку на 200 °C. Индейку нарежьте кусочками 3 см, цветную капусту разберите на соцветия. Опустите соцветия в кипящую воду на 4 минуты, затем откиньте на дуршлаг." = "Увімкніть духовку на 200 °C. Індичку наріжте шматочками 3 см, цвітну капусту розберіть на суцвіття. Опустіть суцвіття в окріп на 4 хвилини, потім відкиньте на друшляк.";
"Выложите индейку и капусту в форму в один слой и посыпьте солью. Полейте йогуртом, сверху натрите сыр и посыпьте паприкой." = "Викладіть індичку й капусту у форму в один шар і посипте сіллю. Полийте йогуртом, зверху натріть сир і посипте паприкою.";
"Запекайте 20–25 минут, пока сверху не появится золотистая корочка. Индейка готова, когда в самом крупном кусочке 74 °C, а сок прозрачный. Подавайте сразу из духовки." = "Запікайте 20–25 хвилин, доки зверху не з’явиться золотиста скоринка. Індичка готова, коли в найбільшому шматочку 74 °C, а сік прозорий. Подавайте одразу з духовки.";
"Морковь очистите и вместе с цукини нарежьте овощечисткой на тонкие ленты. Хек обсушите бумажным полотенцем, посыпьте солью и сбрызните лимонным соком." = "Моркву очистіть і разом із цукіні наріжте овочечисткою на тонкі стрічки. Хек обсушіть паперовим рушником, посипте сіллю й збризніть лимонним соком.";
"Налейте воду в пароварку или в кастрюлю под вставку для пара и доведите до кипения. Выложите ленты овощей на решётку, сверху положите рыбу, накройте крышкой и готовьте на среднем огне 12–15 минут. Хек готов, когда стал непрозрачным и в толстой части прогрелся до 63 °C." = "Налийте воду в пароварку або в каструлю під вставку для пари й доведіть до кипіння. Викладіть стрічки овочів на решітку, зверху покладіть рибу, накрийте кришкою й готуйте на середньому вогні 12–15 хвилин. Хек готовий, коли став непрозорим, а в товстій частині прогрівся до 63 °C.";
"Переложите овощи и рыбу на тарелку лопаткой. Полейте оливковым маслом, посыпьте мелко нарезанным укропом и подавайте сразу." = "Перекладіть овочі й рибу на тарілку лопаткою. Полийте оливковою олією, посипте дрібно нарізаним кропом і подавайте одразу.";
"Разогрейте духовку до 200 °C. Свёклу вымойте щёткой, плотно заверните в фольгу и запекайте 45–50 минут, пока нож не будет легко входить до середины. Разверните фольгу, остудите свёклу под холодной водой 2–3 минуты и снимите кожицу руками." = "Розігрійте духовку до 200 °C. Буряк помийте щіткою, щільно загорніть у фольгу й запікайте 45–50 хвилин, доки ніж не входитиме легко до середини. Розгорніть фольгу, остудіть буряк під холодною водою 2–3 хвилини й зніміть шкірку руками.";
"Нарежьте свёклу кубиками 1,5 см. Фету раскрошите руками, грецкие орехи крупно порубите ножом. Листья салата вымойте, обсушите полотенцем и порвите на крупные куски." = "Наріжте буряк кубиками 1,5 см. Фету розкришіть руками, волоські горіхи грубо посічіть ножем. Листя салату помийте, обсушіть рушником і порвіть на великі шматки.";
"Выложите листья на тарелку, сверху свёклу, фету и орехи. Смешайте оливковое масло с лимонным соком и солью и полейте салат перед подачей." = "Викладіть листя на тарілку, зверху буряк, фету й горіхи. Змішайте оливкову олію з лимонним соком і сіллю та полийте салат перед подачею.";
"Куриное филе нарежьте кусочками 1,5 см, сложите в кастрюлю и залейте холодной водой. Доведите до кипения на сильном огне, снимите пену, убавьте огонь до слабого и варите 10 минут." = "Куряче філе наріжте шматочками 1,5 см, складіть у каструлю й залийте холодною водою. Доведіть до кипіння на сильному вогні, зніміть піну, зменшіть вогонь до слабкого й варіть 10 хвилин.";
"Цветную капусту разберите на соцветия, лук нарежьте крупно. Добавьте их в кастрюлю и варите 15 минут, пока капуста не станет совсем мягкой. Выньте курицу шумовкой в миску." = "Цвітну капусту розберіть на суцвіття, цибулю наріжте великими шматками. Додайте їх у каструлю й варіть 15 хвилин, доки капуста не стане зовсім м’якою. Вийміть курку шумівкою в миску.";
"Влейте молоко, добавьте соль и пробейте суп погружным блендером до гладкости. Верните курицу и прогрейте на слабом огне 3–4 минуты, не доводя до бурного кипения, чтобы в кусочках было 74 °C. Разлейте по тарелкам и посыпьте рубленым укропом." = "Влийте молоко, додайте сіль і збийте суп занурювальним блендером до гладкості. Поверніть курку й прогрійте на слабкому вогні 3–4 хвилини, не доводячи до бурхливого кипіння, щоб у шматочках було 74 °C. Розлийте по тарілках і посипте посіченим кропом.";
"Включите духовку на 200 °C. Положите каждое куриное филе на доску, прижмите ладонью и разрежьте вдоль на два тонких пласта. Посыпьте солью, смажьте форму оливковым маслом и выложите в неё курицу, на всё уйдёт 4–5 минут." = "Увімкніть духовку на 200 °C. Покладіть кожне куряче філе на дошку, притисніть долонею й розріжте вздовж на два тонкі пласти. Посипте сіллю, змастіть форму оливковою олією й викладіть у неї курку, на все піде 4–5 хвилин.";
"Томаты нарежьте кружками толщиной 0,5 см, моцареллу — тонкими ломтиками, и разложите их на курице внахлёст. Запекайте 18–20 минут, пока сыр не расплавится. В самой толстой части курицы должно быть 74 °C, сок прозрачный." = "Томати наріжте кружальцями завтовшки 0,5 см, моцарелу — тонкими скибочками й розкладіть їх на курці внапуск. Запікайте 18–20 хвилин, доки сир не розплавиться. У найтовщій частині курки має бути 74 °C, сік прозорий.";
"Листья салата промойте, обсушите и выложите на тарелку. Рядом положите курицу, посыпьте её листьями базилика и подавайте, пока сыр мягкий." = "Листя салату промийте, обсушіть і викладіть на тарілку. Поруч покладіть курку, посипте її листям базиліку й подавайте, поки сир м’який.";

