/* Household cooking steps. Glasses are speech; the grams in parentheses stay the recipe amount. */
"На эту готовку: %@." = "На це готування: %@.";
"Промойте, залейте и варите под крышкой на слабом огне около %d минут, пока вода не впитается." = "Промийте, залийте і варіть під кришкою на слабкому вогні близько %d хвилин, поки вода не вбереться.";
"Разогрейте сковороду со столовой ложкой масла и жарьте, пока внутри не останется сырого, около %d минут." = "Розігрійте пательню зі столовою ложкою олії і смажте, поки всередині не залишиться сирого, близько %d хвилин.";
"Разогрейте сковороду и жарьте, пока внутри не останется сырого, около %d минут." = "Розігрійте пательню і смажте, поки всередині не залишиться сирого, близько %d хвилин.";
"Сложите в кастрюлю и тушите под крышкой, пока не станет мягким, около %d минут." = "Складіть у каструлю і тушкуйте під кришкою, поки не стане м’яким, близько %d хвилин.";
"На %@ возьмите большую кастрюлю воды, %@, чтобы она свободно двигалась. Посолите, вскипятите и варите до мягкости, около %d минут." = "На %@ візьміть велику каструлю води, %@, щоб вона вільно рухалася. Посоліть, доведіть до кипіння і варіть до м’якості, близько %d хвилин.";
"Посолите по вкусу." = "Посоліть за смаком.";
"Посолите и поперчите по вкусу." = "Посоліть і поперчіть за смаком.";
"Залейте таким же объёмом кипятка, накройте и подождите около %d минут." = "Залийте таким самим об’ємом окропу, накрийте і зачекайте близько %d хвилин.";
"Соль всыпьте в холодную воду до закипания: %@. Размешайте и только потом включайте сильный огонь." = "Сіль всипте в холодну воду до закипання: %@. Розмішайте і лише потім вмикайте сильний вогонь.";
"Эту соль всыпьте в холодную воду до закипания, потом включайте огонь." = "Цю сіль всипте в холодну воду до закипання, а тоді вмикайте вогонь.";
"Посолите и поперчите со всех сторон до сковороды: щепотка соли и щепотка перца. На тарелке соль уже не пройдёт внутрь." = "Посоліть і поперчіть з усіх боків до пательні: дрібка солі і дрібка перцю. На тарілці сіль уже не пройде всередину.";
"Соль кладите, когда закипит, не в холодную воду: %@. За пять минут до конца попробуйте, при тушении соль чувствуется сильнее." = "Сіль кладіть, коли закипить, не в холодну воду: %@. Скуштуйте за п’ять хвилин до кінця, під час тушкування сіль відчувається сильніше.";
"Эту соль кладите, когда закипит, и попробуйте за пять минут до конца." = "Цю сіль кладіть, коли закипить, і скуштуйте за п’ять хвилин до кінця.";
"Посолите до духовки, не после: щепотка соли на куски. Противень поставьте на средний уровень уже горячей духовки." = "Посоліть до духовки, не після: дрібка солі на шматки. Деко поставте на середній рівень уже гарячої духовки.";
"Если соли мало, досолите в общей посуде и перемешайте. В тарелке соль останется сверху." = "Якщо солі мало, досоліть у спільному посуді й перемішайте. На тарілці сіль лишиться зверху.";
"Переберите крупу и промойте, пока вода не станет прозрачной. Залейте, на сильном огне доведите до кипения, снимите пену, накройте и варите на слабом огне около %d минут, пока вода не впитается, а крупа не станет мягкой. Снимите с огня и подержите под крышкой ещё 5 минут, затем разрыхлите вилкой." = "Переберіть крупу і промийте, поки вода не стане прозорою. Залийте, на сильному вогні доведіть до кипіння, зніміть піну, накрийте і варіть на слабкому вогні близько %d хвилин, поки вода не вбереться, а крупа не стане м’якою. Зніміть з вогню і потримайте під кришкою ще 5 хвилин, тоді розпушіть виделкою.";
"Залейте холодной водой так, чтобы она покрывала продукты на два пальца. На сильном огне доведите до кипения, снимите пену, убавьте и варите около %d минут, пока середина не станет мягкой." = "Залийте холодною водою так, щоб вона вкривала продукти на два пальці. На сильному вогні доведіть до кипіння, зніміть піну, зменшіть вогонь і варіть близько %d хвилин, поки середина не стане м’якою.";
"Обсушите куски. Разогрейте сковороду со столовой ложкой масла, пока оно не станет жидким и подвижным. Выложите в один слой и не двигайте, пока снизу не появится корочка, затем переверните. Внутри не должно остаться сырого. Около %d минут. Дайте минуту отдохнуть." = "Обсушіть шматки. Розігрійте пательню зі столовою ложкою олії, поки вона не стане рідкою й рухливою. Викладіть в один шар і не рухайте, поки знизу не з’явиться шкоринка, тоді переверніть. Усередині не повинно лишитися сирого. Близько %d хвилин. Дайте хвилину відпочити.";
"Обсушите куски. Разогрейте сковороду, выложите в один слой и не двигайте, пока снизу не появится корочка, затем переверните. Внутри не должно остаться сырого. Около %d минут. Дайте минуту отдохнуть." = "Обсушіть шматки. Розігрійте пательню, викладіть в один шар і не рухайте, поки знизу не з’явиться шкоринка, тоді переверніть. Усередині не повинно лишитися сирого. Близько %d хвилин. Дайте хвилину відпочити.";
"Нарежьте куски одного размера. Сначала доведите лук до прозрачности на ложке масла, затем добавьте остальное. Накройте и тушите на слабом огне около %d минут, иногда помешивая, пока нож не входит легко. Если жидкость выкипела раньше, подлейте пару ложек горячей воды." = "Наріжте шматки одного розміру. Спочатку доведіть цибулю до прозорості на ложці олії, тоді додайте решту. Накрийте і тушкуйте на слабкому вогні близько %d хвилин, іноді помішуючи, поки ніж не входить легко. Якщо рідина википіла раніше, підлийте пару ложок гарячої води.";
"Нарежьте куски одного размера. Накройте и тушите на слабом огне около %d минут, иногда помешивая, пока нож не входит легко. Если жидкость выкипела раньше, подлейте пару ложек горячей воды." = "Наріжте шматки одного розміру. Накрийте і тушкуйте на слабкому вогні близько %d хвилин, іноді помішуючи, поки ніж не входить легко. Якщо рідина википіла раніше, підлийте пару ложок гарячої води.";
"На %@ возьмите большую кастрюлю воды, %@, чтобы она свободно двигалась. Когда вода бурно кипит, опустите пасту, сразу перемешайте и варите без крышки до мягкости, около %d минут. Откиньте, не промывайте." = "На %@ візьміть велику каструлю води, %@, щоб вона вільно рухалася. Коли вода бурхливо кипить, опустіть пасту, одразу перемішайте і варіть без кришки до м’якості, близько %d хвилин. Відкиньте, не промивайте.";
"Залейте крупу таким же объёмом кипятка, накройте и подождите около %d минут. Не мешайте, пока вода не впитается, затем разрыхлите вилкой." = "Залийте крупу таким самим об’ємом окропу, накрийте і зачекайте близько %d хвилин. Не мішайте, поки вода не вбереться, тоді розпушіть виделкою.";
"Духовку разогрейте заранее. Противень поставьте на средний уровень и готовьте около %d минут, пока край не зарумянится, а середина не схватится. В первую половину времени дверцу не открывайте." = "Духовку розігрійте заздалегідь. Деко поставте на середній рівень і готуйте близько %d хвилин, поки край не зарум’яниться, а середина не схопиться. У першу половину часу дверцята не відкривайте.";
"Режьте куски одного размера, около 2 см: так они дойдут одновременно. Крупное останется сырым, когда мелкое уже размякнет." = "Ріжте шматки одного розміру, близько 2 см: так вони дійдуть одночасно. Велике лишиться сирим, коли дрібне вже розм’якне.";
"Мешайте до ровного вида, проходясь по дну и стенкам, пока не останется сухих комков." = "Мішайте до рівного вигляду, проходячись по дну і стінках, поки не залишиться сухих грудок.";
"Разложите сразу и подавайте, не давая постоять." = "Розкладіть одразу і подавайте, не даючи постояти.";
"Нарежьте и положите в последнюю очередь, к уже готовому. Не держите это на огне." = "Наріжте і покладіть в останню чергу, до вже готового. Не тримайте це на вогні.";
"Готово, когда середина мягкая и без сырого вкуса, а жидкость впиталась или почти выкипела." = "Готово, коли середина м’яка і без сирого смаку, а рідина ввібралася або майже википіла.";
"Эту соль вмешайте сейчас и попробуйте. Крышку снова закройте, огонь оставьте слабым." = "Цю сіль вмішайте зараз і скуштуйте. Кришку знову закрийте, вогонь лишіть слабким.";
"Попробуйте сейчас. Если соли мало, досолите и размешайте. Крышку держите закрытой, огонь слабый." = "Скуштуйте зараз. Якщо солі мало, досоліть і розмішайте. Кришку тримайте закритою, вогонь слабкий.";
"Крышку держите закрытой, огонь слабый. Жидкость должна едва кипеть. Загляните один раз и снова накройте. Около %d минут, пока середина не станет мягкой." = "Кришку тримайте закритою, вогонь слабкий. Рідина має ледь кипіти. Зазирніть один раз і знову накрийте. Близько %d хвилин, поки середина не стане м’якою.";
"Сковороду прогрейте до горячей, без масла. Выложите в один слой и не двигайте, пока низ не схватится, затем переверните. Около %d минут. Дайте минуту отдохнуть." = "Пательню прогрійте до гарячої, без олії. Викладіть в один шар і не рухайте, поки низ не схопиться, тоді переверніть. Близько %d хвилин. Дайте хвилину відпочити.";
"Разогрейте сковороду с уже взятым маслом. Выложите в один слой и не двигайте, пока снизу не появится корочка, затем переверните. Около %d минут. Дайте минуту отдохнуть." = "Розігрійте пательню з уже взятою олією. Викладіть в один шар і не рухайте, поки знизу не з’явиться шкоринка, тоді переверніть. Близько %d хвилин. Дайте хвилину відпочити.";
"Разогрейте сковороду со столовой ложкой масла, пока оно не станет жидким. Выложите в один слой и не двигайте, пока снизу не появится корочка, затем переверните. Около %d минут. Дайте минуту отдохнуть." = "Розігрійте пательню зі столовою ложкою олії, поки вона не стане рідкою. Викладіть в один шар і не рухайте, поки знизу не з’явиться шкоринка, тоді переверніть. Близько %d хвилин. Дайте хвилину відпочити.";
"Налейте воду так, чтобы она не касалась продуктов. Накройте и держите пар. Готово, когда середина плотная, около %d минут." = "Налийте воду так, щоб вона не торкалася продуктів. Накрийте і тримайте пару. Готово, коли середина щільна, близько %d хвилин.";
"Держите слабый огонь и закрытую крышку. Жидкость должна едва кипеть, не булькать во весь рост. Загляните один раз и снова накройте. Около %d минут." = "Тримайте слабкий вогонь і закриту кришку. Рідина має ледь кипіти, не булькати на весь зріст. Зазирніть один раз і знову накрийте. Близько %d хвилин.";
"Держите куски одного размера, как написано выше. Крупное останется сырым, когда мелкое уже размякнет. Кости, если они есть, выньте пальцами до нарезки." = "Тримайте шматки одного розміру, як написано вище. Велике лишиться сирим, коли дрібне вже розм’якне. Кістки, якщо вони є, вийміть пальцями до нарізання.";
"Разложите сразу и перемешайте только перед едой, иначе фрукты дадут сок." = "Розкладіть одразу і перемішайте лише перед їжею, інакше фрукти пустять сік.";
"Накройте и уберите в холодильник. На столе готовую еду не держите дольше двух часов. Достаньте незадолго до подачи." = "Накрийте і приберіть у холодильник. На столі готову їжу не тримайте довше двох годин. Дістаньте незадовго до подавання.";
"Снимите с огня и дайте постоять, пока пар ослабнет. Йогурт, сметану и сырые фрукты кладите в тёплую, не кипящую еду." = "Зніміть з вогню і дайте постояти, поки пара ослабне. Йогурт, сметану і сирі фрукти кладіть у теплу, не киплячу їжу.";
"Подсушите на сухой сковороде или в тостере, пока хлеб не станет сухим и слегка румяным. Не отходите: он сгорает меньше чем за минуту." = "Підсушіть на сухій пательні або в тостері, поки хліб не стане сухим і злегка рум’яним. Не відходьте: він згорає менше ніж за хвилину.";
"Разомните вилкой до ровной массы, без крупных кусков. Лимон и соль из этого шага вмешайте сейчас, пока масса ещё рыхлая." = "Розімніть виделкою до рівної маси, без великих шматків. Лимон і сіль із цього кроку вмішайте зараз, поки маса ще пухка.";
"Держите средний огонь и мешайте. Масло должно стать подвижным, а куски прогреться в середине, без чёрной корочки. Около %d минут." = "Тримайте середній вогонь і мішайте. Олія має стати рухливою, а шматки прогрітися всередині, без чорної шкоринки. Близько %d хвилин.";
"Сформуйте куски одного размера и толщины мокрыми руками, чтобы они дошли одновременно." = "Сформуйте шматки одного розміру і товщини мокрими руками, щоб вони дійшли одночасно.";
"Отбейте через плёнку до одной толщины. Посолите с обеих сторон до нагрева и сразу сверните, пока начинка не вытекла." = "Відбийте через плівку до однієї товщини. Посоліть з обох боків до нагріву і одразу зверніть, поки начинка не витекла.";
"Промойте холодной водой и хорошо обсушите. Мокрые ягоды, зелень и рыба испортят вкус и не подрумянятся. Косточки и сердцевину удалите до готовки." = "Промийте холодною водою і добре обсушіть. Мокрі ягоди, зелень і риба зіпсують смак і не підрум’яняться. Кісточки і серцевину видаліть до готування.";
"Соль и перец из списка вмешайте в общую посуду. Сыр и зелень разложите по тарелкам в конце, иначе зелень потемнеет." = "Сіль і перець зі списку вмішайте у спільний посуд. Сир і зелень розкладіть по тарілках наприкінці, інакше зелень потемніє.";
"Форму смажьте ложкой масла или застелите пергаментом. Разложите ровным слоем: соус и сыр сверху, чтобы край не высох раньше середины." = "Форму змастіть ложкою олії або застеліть пергаментом. Розкладіть рівним шаром: соус і сир зверху, щоб край не висох раніше за середину.";
"Полейте в самом конце, уже без огня. В кипящей еде сок горчит." = "Полийте на самому кінці, уже без вогню. У киплячій їжі сік гірчить.";
"Снимите с огня. Сыр и соус вмешайте в конце и оставьте на минуту под крышкой, пока сыр не начнёт тянуться." = "Зніміть з вогню. Сир і соус вмішайте наприкінці і залиште на хвилину під кришкою, поки сир не почне тягнутися.";
"По плану" = "За планом";
"Съедено" = "З'їдено";
"Статистика" = "Статистика";
"Источник" = "Джерело";
"ккал" = "ккал";
"Нутриент" = "Нутрієнт";
"Источник норм" = "Джерело норм";
"Нормы — RDA/AI Национальных академий США для возраста и пола (NIH ODS). Расчёт идёт по известным ингредиентам рецептов, это ориентир, а не анализ и не назначение добавок." = "Норми — RDA/AI Національних академій США для віку та статі (NIH ODS). Розрахунок іде за відомими інгредієнтами рецептів: це орієнтир, а не аналіз і не призначення добавок.";
"Ориентир: ~%d ккал в день" = "Орієнтир: ~%d ккал на день";
"Укажите возраст в профиле, чтобы увидеть ориентир." = "Вкажіть вік у профілі, щоб побачити орієнтир.";
"В среднем ~%d ккал в день · %d%% ориентира" = "У середньому ~%d ккал на день · %d%% орієнтира";
