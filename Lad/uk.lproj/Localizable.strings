"Яйцо · Молоко · Шпинат" = "Яйце · Молоко · Шпинат";
"Омлет со шпинатом, фетой и томатами" = "Омлет зі шпинатом, фетою та томатами";
"Взбейте яйца с молоком вилкой до однородности. Шпинат промойте, крупные листья порвите руками." = "Збийте яйця з молоком виделкою до однорідності. Шпинат промийте, великі листки порвіть руками.";
"Разогрейте масло в сковороде, прогрейте шпинат 1 минуту, влейте яйца и готовьте под крышкой до полного схватывания, около 75 °C." = "Розігрійте олію на сковороді, прогрійте шпинат 1 хвилину, влийте яйця й готуйте під кришкою до повного схоплювання, близько 75 °C.";
"Посыпьте половину омлета раскрошенной фетой, сложите пополам и подайте с нарезанными свежими томатами." = "Посипте половину омлету розкришеною фетою, складіть навпіл і подайте з нарізаними свіжими томатами.";
"Хлеб · Яйцо · Шпинат" = "Хліб · Яйце · Шпинат";
"Тосты с яйцом пашот и шпинатом" = "Тости з яйцем пашот і шпинатом";
"Доведите воду в небольшой кастрюле до лёгкого кипения. Аккуратно опустите яйца и варите 4–5 минут, пока белок и желток не станут плотными." = "Доведіть воду в невеликій каструлі до легкого кипіння. Обережно опустіть яйця й варіть 4–5 хвилин, доки білок і жовток не стануть щільними.";
"Пока варятся яйца, подсушите хлеб в тостере, а шпинат прогрейте на сковороде с маслом и щепоткой соли до мягкости." = "Поки варяться яйця, підсушіть хліб у тостері, а шпинат прогрійте на сковороді з олією та дрібкою солі до м'якості.";
"Разложите шпинат по тостам, сверху положите яйца шумовкой. Подайте с вымытыми помидорами черри." = "Розкладіть шпинат на тости, зверху покладіть яйця шумівкою. Подайте з вимитими помідорами чері.";
"Хлеб · Куриное филе · Авокадо" = "Хліб · Куряче філе · Авокадо";
"Тосты с курицей, авокадо и огурцом" = "Тости з куркою, авокадо та огірком";
"Запеките куриное филе при 190 °C около 20 минут до 74 °C в центре. Можно взять филе, запечённое накануне." = "Запечіть куряче філе при 190 °C близько 20 хвилин до 74 °C у центрі. Можна взяти філе, запечене напередодні.";
"Подсушите хлеб. Разомните авокадо вилкой с лимонным соком и щепоткой соли до пасты." = "Підсушіть хліб. Розімніть авокадо виделкою з лимонним соком і дрібкою солі до пасти.";
"Намажьте тосты авокадо, сверху разложите тонко нарезанную курицу. Огурец нарежьте кружками и подайте рядом." = "Намажте тости авокадо, зверху розкладіть тонко нарізану курку. Огірок наріжте кружальцями й подайте поруч.";
"Хлеб · Моцарелла · Томаты" = "Хліб · Моцарела · Помідори";
"Тосты капрезе с моцареллой и томатами" = "Тости капрезе з моцарелою та томатами";
"Нарежьте моцареллу и томаты ломтиками толщиной около полсантиметра, базилик промойте и обсушите." = "Наріжте моцарелу й томати скибочками завтовшки близько пів сантиметра, базилік промийте й обсушіть.";
"Разложите моцареллу на хлеб и запекайте в духовке при 200 °C 4–5 минут, пока сыр не расплавится." = "Розкладіть моцарелу на хліб і запікайте в духовці при 200 °C 4–5 хвилин, доки сир не розплавиться.";
"Сверху положите томаты и листья базилика, сбрызните оливковым маслом и поперчите. Подавайте тёплыми." = "Зверху покладіть томати й листя базиліку, збризніть оливковою олією та поперчіть. Подавайте теплими.";
"Яйцо · Шампиньоны · Сыр" = "Яйце · Печериці · Твердий сир";
"Скрэмбл с шампиньонами и сыром" = "Скрембл із печерицями та сиром";
"Шампиньоны нарежьте пластинками и обжарьте на масле 6–7 минут, пока не уйдёт жидкость и они не подрумянятся." = "Печериці наріжте пластинками й обсмажте на олії 6–7 хвилин, доки не випарується рідина і вони не підрум'яняться.";
"Влейте взбитые с солью яйца и помешивайте лопаткой на среднем огне, пока они не станут плотными, около 75 °C." = "Влийте збиті з сіллю яйця й помішуйте лопаткою на середньому вогні, доки вони не стануть щільними, близько 75 °C.";
"Посыпьте тёртым сыром и рубленым зелёным луком, дайте сыру растаять. Подайте с подсушенным ломтиком хлеба." = "Посипте тертим сиром і нарізаною зеленою цибулею, дайте сиру розтанути. Подайте з підсушеною скибкою хліба.";
"Овсяные хлопья · Молоко · Сливы" = "Вівсяні пластівці · Молоко · Сливи";
"Овсянка со сливами, йогуртом и грецкими орехами" = "Вівсянка зі сливами, йогуртом і волоськими горіхами";
"Залейте овсяные хлопья молоком и варите на слабом огне 5–6 минут, помешивая, пока каша не загустеет." = "Залийте вівсяні пластівці молоком і варіть на слабкому вогні 5–6 хвилин, помішуючи, доки каша не загусне.";
"Сливы вымойте, удалите косточки и нарежьте дольками. Грецкие орехи крупно порубите ножом." = "Сливи вимийте, видаліть кісточки й наріжте часточками. Волоські горіхи крупно порубайте ножем.";
"Переложите кашу в миску, сверху выложите йогурт, сливы и орехи, посыпьте корицей. Сахар и мёд не добавляются." = "Перекладіть кашу в миску, зверху викладіть йогурт, сливи й горіхи, посипте корицею. Цукор і мед не додаються.";
"Рисовая мука · Яйцо · Молоко" = "Рисове борошно · Яйце · Молоко";
"Рисовые блинчики с творогом и ягодами" = "Рисові млинці з сиром і ягодами";
"Взбейте яйцо с молоком, постепенно вмешайте рисовую муку до жидкого теста без комков и оставьте на 5 минут." = "Збийте яйце з молоком, поступово вмішайте рисове борошно до рідкого тіста без грудочок і залиште на 5 хвилин.";
"Смажьте тонкие блинчики на сковороде, смазанной маслом, по 1–2 минуты с каждой стороны до золотистого цвета." = "Смажте тонкі млинці на сковороді, змащеній олією, по 1–2 хвилини з кожного боку до золотистого кольору.";
"Разложите творог по блинчикам, сверните их и подайте с промытыми ягодами. Сахар в начинку не добавляется." = "Розкладіть сир на млинці, згорніть їх і подайте з промитими ягодами. Цукор у начинку не додається.";
"Творог · Яйцо · Морковь" = "Кисломолочний сир · Яйце · Морква";
"Морковные сырники с йогуртом" = "Морквяні сирники з йогуртом";
"Натрите морковь на мелкой тёрке и отожмите. Смешайте с творогом, яйцом, рисовой мукой и корицей." = "Натріть моркву на дрібній тертці й відіжміть. Змішайте з сиром, яйцем, рисовим борошном і корицею.";
"Мокрыми руками сформуйте небольшие сырники и выложите на противень с бумагой для выпечки." = "Мокрими руками сформуйте невеликі сирники й викладіть на деко з папером для випікання.";
"Запекайте при 190 °C 18–20 минут, переверните один раз. Подайте тёплыми с натуральным йогуртом." = "Запікайте при 190 °C 18–20 хвилин, переверніть один раз. Подайте теплими з натуральним йогуртом.";
"Яйцо · Картофель · Сладкий перец" = "Яйце · Картопля · Солодкий перець";
"Тортилья с картофелем и сладким перцем" = "Тортилья з картоплею та солодким перцем";
"Картофель нарежьте тонкими ломтиками, перец и лук — мелко. Перемешайте с маслом и запекайте при 200 °C 15 минут до мягкости." = "Картоплю наріжте тонкими скибочками, перець і цибулю — дрібно. Перемішайте з олією й запікайте при 200 °C 15 хвилин до м'якості.";
"Взбейте яйца с солью, залейте овощи в небольшой форме и запекайте ещё 12–15 минут, пока центр не станет плотным." = "Збийте яйця з сіллю, залийте овочі в невеликій формі й запікайте ще 12–15 хвилин, доки центр не стане щільним.";
"Дайте тортилье постоять 3 минуты, чтобы яйцо осело и её было удобно резать. Нарежьте клином и подайте с ломтиками свежего огурца." = "Дайте тортильї постояти 3 хвилини, щоб яйце осіло і її було зручно різати. Наріжте клином і подайте зі скибочками свіжого огірка.";
"Куриное филе · Нут · Томаты" = "Куряче філе · Нут · Помідори";
"Курица с нутом и шпинатом в томатах" = "Курка з нутом і шпинатом у томатах";
"Нут замочите на ночь и отварите до мягкости, воду слейте. Подойдёт и готовый нут без рассола." = "Нут замочіть на ніч і зваріть до м'якості, воду злийте. Підійде й готовий нут без розсолу.";
"Курицу нарежьте кусочками, лук и чеснок мелко. Тушите их с нарезанными томатами и паприкой под крышкой 15 минут." = "Курку наріжте шматочками, цибулю й часник дрібно. Тушкуйте їх із нарізаними томатами й паприкою під кришкою 15 хвилин.";
"Добавьте нут и шпинат, прогрейте 5 минут до 74 °C в курице. Посолите, полейте оливковым маслом и подавайте." = "Додайте нут і шпинат, прогрійте 5 хвилин до 74 °C у курці. Посоліть, полийте оливковою олією й подавайте.";
"Филе индейки · Лук · Яйцо" = "Філе індички · Цибуля · Яйце";
"Тефтели из индейки в томатном соусе" = "Тефтелі з індички в томатному соусі";
"Индейку и половину лука пропустите через мясорубку, добавьте яйцо и соль, вымесите и скатайте небольшие тефтели." = "Індичку й половину цибулі пропустіть через м'ясорубку, додайте яйце й сіль, вимісіть і скачайте невеликі тефтелі.";
"Остальной лук и тёртую морковь потушите 5 минут, добавьте нарезанные томаты и томатную пасту, доведите до кипения." = "Решту цибулі й терту моркву потушкуйте 5 хвилин, додайте нарізані томати й томатну пасту, доведіть до кипіння.";
"Опустите тефтели в соус и тушите под крышкой 20 минут до 74 °C в центре. Подайте с маслом и рубленой зеленью." = "Опустіть тефтелі в соус і тушкуйте під кришкою 20 хвилин до 74 °C у центрі. Подайте з олією та нарізаною зеленню.";
"Куриный фарш · Лук · Яйцо" = "Курячий фарш · Цибуля · Яйце";
"Куриные котлеты на пару с овощами" = "Курячі котлети на парі з овочами";
"Смешайте куриный фарш с мелко натёртым луком, яйцом, солью и перцем. Мокрыми руками сформуйте 3 котлеты." = "Змішайте курячий фарш із дрібно натертою цибулею, яйцем, сіллю й перцем. Мокрими руками сформуйте 3 котлети.";
"Брокколи и цветную капусту разберите на соцветия, морковь нарежьте брусочками и выложите в пароварку вместе с котлетами." = "Броколі й цвітну капусту розберіть на суцвіття, моркву наріжте брусочками й викладіть у пароварку разом із котлетами.";
"Готовьте на пару 20–25 минут, пока котлеты не прогреются до 74 °C, а овощи не станут мягкими. Подавайте горячими." = "Готуйте на парі 20–25 хвилин, доки котлети не прогріються до 74 °C, а овочі не стануть м'якими. Подавайте гарячими.";
"Курица, тушённая с морковью и луком" = "Курка, тушкована з морквою та цибулею";
"Курицу нарежьте крупными кусочками, лук полукольцами, морковь кружками. Слегка обжарьте лук и морковь на масле 5 минут." = "Курку наріжте великими шматочками, цибулю півкільцями, моркву кружальцями. Злегка обсмажте цибулю й моркву на олії 5 хвилин.";
"Добавьте курицу, томатную пасту, разведённую в воде, лавровый лист, соль и перец. Доведите до кипения." = "Додайте курку, томатну пасту, розведену у воді, лавровий лист, сіль і перець. Доведіть до кипіння.";
"Тушите под крышкой на слабом огне 20 минут до 74 °C в курице. Лавровый лист перед подачей уберите." = "Тушкуйте під кришкою на слабкому вогні 20 хвилин до 74 °C у курці. Лавровий лист перед подачею приберіть.";
"Куриное филе · Яйцо · Листья салата" = "Куряче філе · Яйце · Листя салату";
"Тёплый салат с курицей, яйцом и овощами" = "Теплий салат із куркою, яйцем та овочами";
"Запеките куриное филе при 190 °C около 20 минут до 74 °C в центре. Яйцо сварите вкрутую за 10 минут и остудите." = "Запечіть куряче філе при 190 °C близько 20 хвилин до 74 °C у центрі. Яйце зваріть круто за 10 хвилин і остудіть.";
"Листья салата порвите руками, огурец и томаты нарежьте. Смешайте масло, лимонный сок и соль для заправки." = "Листя салату порвіть руками, огірок і томати наріжте. Змішайте олію, лимонний сік і сіль для заправки.";
"Выложите овощи на тарелку, сверху тёплую нарезанную курицу и половинки яйца, полейте заправкой и подавайте сразу." = "Викладіть овочі на тарілку, зверху теплу нарізану курку й половинки яйця, полийте заправкою й подавайте одразу.";
"Минтай · Бурый рис · Морковь" = "Минтай · Бурий рис · Морква";
"Минтай с овощами и бурым рисом" = "Минтай з овочами та бурим рисом";
"Промойте бурый рис и варите его в подсоленной воде 30–35 минут до мягкости, лишнюю воду слейте." = "Промийте бурий рис і варіть його в підсоленій воді 30–35 хвилин до м'якості, зайву воду злийте.";
"Лук, морковь и перец нарежьте, тушите с нарезанными томатами под крышкой 10 минут. Сверху выложите куски минтая." = "Цибулю, моркву й перець наріжте, тушкуйте з нарізаними томатами під кришкою 10 хвилин. Зверху викладіть шматки минтаю.";
"Тушите ещё 10–12 минут, пока рыба не станет непрозрачной и не начнёт расслаиваться. Подайте с рисом, маслом и укропом." = "Тушкуйте ще 10–12 хвилин, доки риба не стане непрозорою й не почне розшаровуватися. Подайте з рисом, олією та кропом.";
"Лосось · Булгур · Брокколи" = "Лосось · Булгур · Броколі";
"Лосось с булгуром и брокколи" = "Лосось із булгуром і броколі";
"Залейте булгур двойным объёмом подсоленной воды, варите 12 минут на слабом огне и оставьте под крышкой." = "Залийте булгур подвійним об'ємом підсоленої води, варіть 12 хвилин на слабкому вогні й залиште під кришкою.";
"Лосось запекайте при 200 °C 12–15 минут, пока мякоть не станет непрозрачной и не начнёт легко разделяться." = "Лосось запікайте при 200 °C 12–15 хвилин, доки м'якоть не стане непрозорою й не почне легко розділятися.";
"Брокколи отварите или приготовьте на пару 5 минут. Подайте с булгуром, полейте маслом и лимонным соком, посыпьте укропом." = "Броколі зваріть або приготуйте на парі 5 хвилин. Подайте з булгуром, полийте олією й лимонним соком, посипте кропом.";
"Говядина · Чечевица красная · Морковь" = "Яловичина · Червона сочевиця · Морква";
"Суп из красной чечевицы с говядиной" = "Суп із червоної сочевиці з яловичиною";
"Говядину нарежьте мелкими кусочками, залейте водой и варите 40 минут на слабом огне, снимая пену." = "Яловичину наріжте дрібними шматочками, залийте водою й варіть 40 хвилин на слабкому вогні, знімаючи піну.";
"Добавьте промытую чечевицу, нарезанные морковь, лук, сельдерей и томаты. Варите ещё 20 минут, пока чечевица не разварится." = "Додайте промиту сочевицю, нарізані моркву, цибулю, селеру й томати. Варіть ще 20 хвилин, доки сочевиця не розвариться.";
"Посолите, добавьте молотый кориандр и проварите 2 минуты. Подавайте горячим, мясо должно быть мягким." = "Посоліть, додайте мелений коріандр і проваріть 2 хвилини. Подавайте гарячим, м'ясо має бути м'яким.";
"Филе индейки · Пшено · Тыква" = "Філе індички · Пшоно · Гарбуз";
"Индейка с тыквой и пшеном" = "Індичка з гарбузом і пшоном";
"Пшено промойте горячей водой и варите в подсоленной воде 20 минут до рассыпчатости." = "Пшоно промийте гарячою водою й варіть у підсоленій воді 20 хвилин до розсипчастості.";
"Тыкву нарежьте кубиками, лук дольками, индейку кусочками. Перемешайте с маслом, солью и перцем, выложите на противень." = "Гарбуз наріжте кубиками, цибулю часточками, індичку шматочками. Перемішайте з олією, сіллю й перцем, викладіть на деко.";
"Запекайте при 200 °C 20–25 минут до мягкости тыквы и 74 °C в индейке. Подайте вместе с пшеном." = "Запікайте при 200 °C 20–25 хвилин до м'якості гарбуза й 74 °C в індичці. Подайте разом із пшоном.";
"Куриное филе · Капуста · Морковь" = "Куряче філе · Капуста · Морква";
"Щи из свежей капусты с курицей" = "Капусняк зі свіжої капусти з куркою";
"Курицу нарежьте кусочками, залейте водой, доведите до кипения и варите 15 минут, снимая пену." = "Курку наріжте шматочками, залийте водою, доведіть до кипіння й варіть 15 хвилин, знімаючи піну.";
"Добавьте нашинкованную капусту, тёртую морковь, лук, нарезанные томаты и лавровый лист. Варите 20 минут до мягкости капусты." = "Додайте нашаткувану капусту, терту моркву, цибулю, нарізані томати й лавровий лист. Варіть 20 хвилин до м'якості капусти.";
"Посолите, уберите лавровый лист. Подавайте с ложкой натурального йогурта и рубленым укропом." = "Посоліть, приберіть лавровий лист. Подавайте з ложкою натурального йогурту та нарізаним кропом.";
"Куриное филе · Бурый рис · Морковь" = "Куряче філе · Бурий рис · Морква";
"Плов с курицей и бурым рисом" = "Плов із куркою та бурим рисом";
"Лук нарежьте полукольцами, морковь соломкой, курицу кусочками. Обжарьте лук на масле 3 минуты, добавьте курицу и морковь." = "Цибулю наріжте півкільцями, моркву соломкою, курку шматочками. Обсмажте цибулю на олії 3 хвилини, додайте курку й моркву.";
"Через 5 минут всыпьте промытый бурый рис ровным слоем, добавьте специи, соль и воду, воткните целые зубчики чеснока." = "Через 5 хвилин всипте промитий бурий рис рівним шаром, додайте спеції, сіль і воду, встроміть цілі зубчики часнику.";
"Томите под крышкой на слабом огне 40 минут, не перемешивая, пока рис не впитает воду. Перемешайте перед подачей." = "Томіть під кришкою на слабкому вогні 40 хвилин, не перемішуючи, доки рис не вбере воду. Перемішайте перед подачею.";
"Хек · Нут · Томаты" = "Хек · Нут · Помідори";
"Хек с нутом и томатами" = "Хек із нутом і томатами";
"Нут замочите на ночь и отварите до мягкости, воду слейте. Томаты нарежьте кубиками, чеснок мелко." = "Нут замочіть на ніч і зваріть до м'якості, воду злийте. Томати наріжте кубиками, часник дрібно.";
"Смешайте нут, томаты, чеснок и соль в форме для запекания, сверху положите хек и сбрызните его лимонным соком." = "Змішайте нут, томати, часник і сіль у формі для запікання, зверху покладіть хек і збризніть його лимонним соком.";
"Запекайте при 200 °C 15–18 минут, пока рыба не станет непрозрачной. Полейте оливковым маслом и посыпьте петрушкой." = "Запікайте при 200 °C 15–18 хвилин, доки риба не стане непрозорою. Полийте оливковою олією й посипте петрушкою.";
"Куриное филе · Сладкий перец · Цукини" = "Куряче філе · Солодкий перець · Цукіні";
"Куриные шашлычки с овощами и булгуром" = "Курячі шашлички з овочами та булгуром";
"Курицу нарежьте кубиками, перемешайте с половиной йогурта, паприкой, солью и лимонным соком, оставьте на 15 минут." = "Курку наріжте кубиками, перемішайте з половиною йогурту, паприкою, сіллю й лимонним соком, залиште на 15 хвилин.";
"Нанижите курицу на шпажки вместе с кусочками перца, цукини и лука, сбрызните маслом и запекайте при 220 °C 15–18 минут до 74 °C." = "Нанизайте курку на шпажки разом зі шматочками перцю, цукіні й цибулі, збризніть олією й запікайте при 220 °C 15–18 хвилин до 74 °C.";
"Булгур залейте двойным объёмом воды и варите 12 минут. Подайте шашлычки на булгуре с остальным йогуртом как соусом." = "Булгур залийте подвійним об'ємом води й варіть 12 хвилин. Подайте шашлички на булгурі з рештою йогурту як соусом.";
"Мясной фарш · Лук · Яйцо" = "М'ясний фарш · Цибуля · Яйце";
"Говяжьи тефтели с тушёной капустой" = "Яловичі тефтелі з тушкованою капустою";
"Смешайте фарш с половиной мелко натёртого лука, яйцом, солью и перцем. Скатайте небольшие тефтели." = "Змішайте фарш із половиною дрібно натертої цибулі, яйцем, сіллю й перцем. Скачайте невеликі тефтелі.";
"Остальной лук и тёртую морковь слегка обжарьте на масле, добавьте нашинкованную капусту и томатную пасту с половиной стакана воды." = "Решту цибулі й терту моркву злегка обсмажте на олії, додайте нашатковану капусту й томатну пасту з половиною склянки води.";
"Выложите тефтели на капусту и тушите под крышкой 25–30 минут до мягкости капусты и 71 °C в тефтелях." = "Викладіть тефтелі на капусту й тушкуйте під кришкою 25–30 хвилин до м'якості капусти й 71 °C у тефтелях.";
"Минтай, запечённый с травами и лимоном" = "Минтай, запечений із травами та лимоном";
"Мелко порубите укроп, петрушку и чеснок, смешайте с оливковым маслом, лимонным соком, солью и перцем." = "Дрібно порубайте кріп, петрушку й часник, змішайте з оливковою олією, лимонним соком, сіллю й перцем.";
"Выложите филе минтая в форму и равномерно покройте травяной смесью со всех сторон." = "Викладіть філе минтаю у форму й рівномірно вкрийте трав'яною сумішшю з усіх боків.";
"Запекайте при 200 °C 15–18 минут, пока рыба не станет непрозрачной и не начнёт расслаиваться. Подавайте горячей." = "Запікайте при 200 °C 15–18 хвилин, доки риба не стане непрозорою й не почне розшаровуватися. Подавайте гарячою.";
"Стручковая фасоль · Яйцо · Томаты черри" = "Стручкова квасоля · Яйце · Помідори чері";
"Тёплый салат со стручковой фасолью и яйцом" = "Теплий салат зі стручковою квасолею та яйцем";
"Сварите яйца вкрутую за 10 минут и остудите в холодной воде. Стручковую фасоль отварите 6–7 минут и слейте воду." = "Зваріть яйця круто за 10 хвилин і остудіть у холодній воді. Стручкову квасолю зваріть 6–7 хвилин і злийте воду.";
"Лук нарежьте тонкими полукольцами, помидоры черри разрежьте пополам, зелень порубите." = "Цибулю наріжте тонкими півкільцями, помідори чері розріжте навпіл, зелень порубайте.";
"Смешайте тёплую фасоль с луком, томатами, маслом, лимонным соком и солью. Сверху выложите четвертинки яиц и зелень." = "Змішайте теплу квасолю з цибулею, томатами, олією, лимонним соком і сіллю. Зверху викладіть четвертинки яєць і зелень.";
"Лосось · Цукини · Томаты черри" = "Лосось · Цукіні · Помідори чері";
"Лосось, запечённый с цукини и томатами черри" = "Лосось, запечений із цукіні та томатами чері";
"Цукини нарежьте кружками, перемешайте с половиной масла и солью и выложите в форму одним слоем вместе с помидорами черри." = "Цукіні наріжте кружальцями, перемішайте з половиною олії й сіллю та викладіть у форму одним шаром разом із помідорами чері.";
"Сверху положите лосось, сбрызните оставшимся маслом и лимонным соком, посыпьте орегано." = "Зверху покладіть лосось, збризніть рештою олії та лимонним соком, посипте орегано.";
"Запекайте при 200 °C 15–18 минут, пока рыба не станет непрозрачной, а помидоры не лопнут. Подавайте сразу." = "Запікайте при 200 °C 15–18 хвилин, доки риба не стане непрозорою, а помідори не лопнуть. Подавайте одразу.";
"Творог · Тыква · Яйцо" = "Кисломолочний сир · Гарбуз · Яйце";
"Творожная запеканка с тыквой" = "Сирна запіканка з гарбузом";
"Тыкву нарежьте мелким кубиком. Творог разотрите с яйцом, рисовой мукой и корицей до однородной массы." = "Гарбуз наріжте дрібним кубиком. Сир розітріть з яйцем, рисовим борошном і корицею до однорідної маси.";
"Вмешайте тыкву, выложите массу в небольшую форму и разровняйте поверхность ложкой." = "Вмішайте гарбуз, викладіть масу в невелику форму й розрівняйте поверхню ложкою.";
"Запекайте при 180 °C 35–40 минут до золотистой корочки и плотного центра. Подайте тёплой с йогуртом." = "Запікайте при 180 °C 35–40 хвилин до золотистої скоринки й щільного центру. Подайте теплою з йогуртом.";
"Креветки · Цукини · Листья салата" = "Креветки · Цукіні · Листя салату";
"Тёплый салат с креветками и цукини" = "Теплий салат із креветками та цукіні";
"Цукини нарежьте тонкими лентами овощечисткой. Креветки очистите, чеснок нарежьте пластинками." = "Цукіні наріжте тонкими стрічками овочечисткою. Креветки очистіть, часник наріжте пластинками.";
"Обжарьте чеснок и креветки на половине масла 3–4 минуты, пока креветки не станут розовыми и непрозрачными. Добавьте цукини на 1 минуту." = "Обсмажте часник і креветки на половині олії 3–4 хвилини, доки креветки не стануть рожевими й непрозорими. Додайте цукіні на 1 хвилину.";
"Выложите на листья салата с половинками помидоров черри, полейте оставшимся маслом с лимонным соком и солью." = "Викладіть на листя салату з половинками помідорів чері, полийте рештою олії з лимонним соком і сіллю.";
"Куриное филе · Брокколи · Сыр" = "Куряче філе · Броколі · Твердий сир";
"Курица с брокколи под сыром" = "Курка з броколі під сиром";
"Курицу нарежьте кусочками, брокколи разберите на соцветия. Смешайте йогурт с давленым чесноком, солью и перцем." = "Курку наріжте шматочками, броколі розберіть на суцвіття. Змішайте йогурт із чавленим часником, сіллю й перцем.";
"Выложите курицу и брокколи в форму, полейте йогуртовым соусом и посыпьте тёртым сыром." = "Викладіть курку й броколі у форму, полийте йогуртовим соусом і посипте тертим сиром.";
"Запекайте при 200 °C 20–25 минут до румяной корочки и 74 °C в курице. Подавайте горячей." = "Запікайте при 200 °C 20–25 хвилин до рум'яної скоринки й 74 °C у курці. Подавайте гарячою.";
"Яйцо · Шпинат · Томаты" = "Яйце · Шпинат · Помідори";
"Яйца, запечённые со шпинатом и томатами" = "Яйця, запечені зі шпинатом і томатами";
"Лук мелко нарежьте, томаты нарежьте кубиками, шпинат промойте. Смешайте их с маслом и солью в небольшой форме." = "Цибулю дрібно наріжте, томати наріжте кубиками, шпинат промийте. Змішайте їх з олією й сіллю в невеликій формі.";
"Прогрейте овощи в духовке при 200 °C 8 минут, пока шпинат не осядет. Сделайте ложкой два углубления и вбейте яйца." = "Прогрійте овочі в духовці при 200 °C 8 хвилин, доки шпинат не осяде. Зробіть ложкою дві заглибини й вбийте яйця.";
"Посыпьте раскрошенной фетой и запекайте ещё 10–12 минут, пока белок и желток не станут плотными." = "Посипте розкришеною фетою й запікайте ще 10–12 хвилин, доки білок і жовток не стануть щільними.";
"Пекинская капуста · Куриное филе · Огурец" = "Пекінська капуста · Куряче філе · Огірок";
"Салат с пекинской капустой, курицей и огурцом" = "Салат із пекінською капустою, куркою та огірком";
"Отварите куриное филе в подсоленной воде 20 минут до 74 °C в центре, остудите и разберите на волокна." = "Відваріть куряче філе в підсоленій воді 20 хвилин до 74 °C у центрі, остудіть і розберіть на волокна.";
"Пекинскую капусту тонко нашинкуйте, огурец нарежьте соломкой, зелёный лук порубите." = "Пекінську капусту тонко нашаткуйте, огірок наріжте соломкою, зелену цибулю порубайте.";
"Смешайте йогурт с горчицей и солью, заправьте овощи и курицу. Подавайте сразу, пока капуста хрустит." = "Змішайте йогурт із гірчицею й сіллю, заправте овочі й курку. Подавайте одразу, поки капуста хрустка.";
"Нут · Цукини · Баклажан" = "Нут · Цукіні · Баклажан";
"Рагу из цукини, баклажана и нута" = "Рагу з цукіні, баклажана та нуту";
"Нут замочите на ночь и отварите до мягкости, воду слейте. Цукини, баклажан и томаты нарежьте кубиками." = "Нут замочіть на ніч і зваріть до м'якості, воду злийте. Цукіні, баклажан і томати наріжте кубиками.";
"Лук и чеснок потушите в сотейнике 3 минуты, добавьте баклажан и цукини, затем томаты и соль. Тушите под крышкой 20 минут." = "Цибулю й часник потушкуйте в сотейнику 3 хвилини, додайте баклажан і цукіні, потім томати й сіль. Тушкуйте під кришкою 20 хвилин.";
"Вмешайте нут и прогрейте 5 минут. Перед подачей полейте оливковым маслом и посыпьте порванными листьями базилика." = "Вмішайте нут і прогрійте 5 хвилин. Перед подачею полийте оливковою олією й посипте порваним листям базиліку.";
"Филе индейки · Цветная капуста · Йогурт натуральный" = "Філе індички · Цвітна капуста · Натуральний йогурт";
"Индейка с цветной капустой в духовке" = "Індичка з цвітною капустою в духовці";
"Индейку нарежьте кусочками, цветную капусту разберите на соцветия и отварите 4 минуты, воду слейте." = "Індичку наріжте шматочками, цвітну капусту розберіть на суцвіття й зваріть 4 хвилини, воду злийте.";
"Выложите индейку и капусту в форму, посолите, полейте йогуртом и посыпьте тёртым сыром и паприкой." = "Викладіть індичку й капусту у форму, посоліть, полийте йогуртом і посипте тертим сиром і паприкою.";
"Запекайте при 200 °C 20–25 минут до 74 °C в индейке и золотистой корочки. Подавайте горячей." = "Запікайте при 200 °C 20–25 хвилин до 74 °C в індичці та золотистої скоринки. Подавайте гарячою.";
"Хек · Морковь · Цукини" = "Хек · Морква · Цукіні";
"Хек на пару с морковью и цукини" = "Хек на парі з морквою та цукіні";
"Морковь и цукини нарежьте тонкими лентами овощечисткой. Хек посолите и сбрызните лимонным соком." = "Моркву й цукіні наріжте тонкими стрічками овочечисткою. Хек посоліть і збризніть лимонним соком.";
"Выложите овощи в пароварку, сверху положите рыбу. Готовьте на пару 12–15 минут, пока хек не станет непрозрачным." = "Викладіть овочі в пароварку, зверху покладіть рибу. Готуйте на парі 12–15 хвилин, доки хек не стане непрозорим.";
"Переложите на тарелку, полейте оливковым маслом и посыпьте рубленым укропом. Подавайте сразу." = "Перекладіть на тарілку, полийте оливковою олією й посипте нарізаним кропом. Подавайте одразу.";
"Свёкла · Фета · Грецкие орехи" = "Буряк · Фета · Волоські горіхи";
"Салат из печёной свёклы с фетой и грецкими орехами" = "Салат із печеного буряка з фетою та волоськими горіхами";
"Заверните вымытую свёклу в фольгу и запекайте при 200 °C 45–50 минут до мягкости. Остудите и очистите." = "Загорніть вимитий буряк у фольгу й запікайте при 200 °C 45–50 хвилин до м'якості. Остудіть і очистіть.";
"Нарежьте свёклу кубиками, фету раскрошите, грецкие орехи слегка порубите. Листья салата порвите руками." = "Наріжте буряк кубиками, фету розкришіть, волоські горіхи злегка порубайте. Листя салату порвіть руками.";
"Выложите свёклу на листья салата, сверху фету и орехи. Полейте маслом с лимонным соком и щепоткой соли." = "Викладіть буряк на листя салату, зверху фету й горіхи. Полийте олією з лимонним соком і дрібкою солі.";
"Цветная капуста · Куриное филе · Лук" = "Цвітна капуста · Куряче філе · Цибуля";
"Суп-пюре из цветной капусты с курицей" = "Суп-пюре з цвітної капусти з куркою";
"Куриное филе нарежьте мелкими кусочками, залейте водой и варите 10 минут, снимая пену." = "Куряче філе наріжте дрібними шматочками, залийте водою й варіть 10 хвилин, знімаючи піну.";
"Добавьте соцветия цветной капусты и нарезанный лук, варите 15 минут до мягкости. Курицу выньте шумовкой." = "Додайте суцвіття цвітної капусти й нарізану цибулю, варіть 15 хвилин до м'якості. Курку вийміть шумівкою.";
"Влейте молоко, пробейте овощи блендером до гладкости и посолите. Верните курицу, прогрейте до 74 °C и посыпьте укропом." = "Влийте молоко, збийте овочі блендером до гладкості й посоліть. Поверніть курку, прогрійте до 74 °C і посипте кропом.";
"Куриное филе · Томаты · Моцарелла" = "Куряче філе · Помідори · Моцарела";
"Куриное филе с томатами и моцареллой" = "Куряче філе з томатами та моцарелою";
"Разрежьте куриное филе вдоль на два тонких пласта, посолите и выложите в форму, смазанную маслом." = "Розріжте куряче філе вздовж на два тонкі пласти, посоліть і викладіть у форму, змащену олією.";
"Сверху разложите ломтики томатов и моцареллы. Запекайте при 200 °C 18–20 минут до 74 °C в курице." = "Зверху розкладіть скибочки томатів і моцарели. Запікайте при 200 °C 18–20 хвилин до 74 °C у курці.";
"Посыпьте листьями базилика и подайте с листьями салата. Расплавленный сыр не даёт курице пересохнуть." = "Посипте листям базиліку й подайте з листям салату. Розплавлений сир не дає курці пересохнути.";
